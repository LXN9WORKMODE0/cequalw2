    659 !  EL1  = ELW+(ELW-ELWS(ID-1))/(0.5*(DLX(ID)+DLX(ID-1))*DLX(ID)*0.5   ! SW 7/17/09
    660 !  ELSE
    661 !  EL1=ELW
    662 !  ENDIF
    663   KL   = KT+1
    664   DO K=KTWB(JJW)+1,KB(CDHS(JB))+1
    665     IDT = ID+1
