   1902 ENTRY INORGANIC_CARBON
   1903   TICAP(:,IU:ID) = 0.0; TICEP(:,IU:ID) = 0.0; TICBOD(:,IU:ID) = 0.0
   1904   ticmc(:,iu:id) = 0.0; ticzr(:,iu:id)=0.0  !v3.5
   1905   ticch4=0.0  ! CEMA
   1906   DO I=IU,ID
   1907     DO K=KT,KB(I)
   1908       DO JCB=1,NBOD
   1909         IF(BOD_CALC(JCB))TICBOD(K,I) = TICBOD(K,I)+CBODD(K,I,JCB)*CBOD(K,I,JCB)*BODC(JCB)
   1910       END DO
   1911       DO JA=1,NAL
   1912         IF(ALG_CALC(JA))TICAP(K,I) = TICAP(K,I)+AC(JA)*(ARR(K,I,JA)-AGR(K,I,JA))*ALG(K,I,JA)
   1913       END DO
   1914       DO JE=1,NEP
   1915         IF (EPIPHYTON_CALC(JW,JE))TICEP(K,I) = TICEP(K,I)+EC(JE)*(ERR(K,I,JE)-EGR(K,I,JE))*EPC(K,I,JE)
   1916       END DO
   1917       DO M=1,NMC
   1918         IF(MACROPHYTE_CALC(JW,M))THEN
   1919           IF(K.EQ.KT)THEN
   1920             JT=KTI(I)
   1921           ELSE
   1922             JT=K
   1923           END IF
   1924           JE=KB(I)
   1925           DO JJ=JT,JE
   1926             TICMC(K,I)=TICMC(K,I)+(MRR(K,I,M)-MGR(JJ,K,I,M))*MACRM(JJ,K,I,M)*MC(M)
   1927           END DO
   1928         END IF
   1929       END DO
   1930       TICMC(K,I) = TICMC(K,I)/(DLX(I)*BH2(K,I))              !8/2020
   1931       IF(ZOOPLANKTON_CALC)THEN
   1932       DO JZ = 1,NZP
   1933         TICZR(K,I)=TICZR(K,I)+ZRT(K,I,JZ)*ZOO(K,I,JZ)*ZC(JZ) !MLM
   1934       END DO
   1935       
   1936       ticCH4=ch4d(k,i)
   1937       
   1938       ENDIF
   1939 
   1940             IF(STANDING_BIOMASS_DECAY)THEN  ! SW 5/26/15
   1941                TICSS(K,I) = TICAP(K,I)+TICEP(K,I)+SEDDC(K,I)+ORGC(JW)*(LPOMD(K,I)+RPOMD(K,I)+LDOMD(K,I)+RDOMD(K,I))         

