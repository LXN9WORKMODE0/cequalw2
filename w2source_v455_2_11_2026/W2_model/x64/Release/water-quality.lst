   2648             JT=KTI(I)
   2649           ELSE
   2650             JT=K
   2651           END IF
   2652           JE=KB(I)
   2653           DO JJ=JT,JE
   2654             RPOMCMP(K,I) = RPOMCMP(K,I) + MPOM(M)*(1.0-LRPMAC(M))*MMR(K,I,M)*MACRM(JJ,K,I,M)*MC(M)
   2655           END DO
   2656         END IF
   2657       END DO
   2658       RPOMCMP(K,I) = RPOMCMP(K,I) / (DLX(I)*BH2(K,I))
   2659       RPOMCNS(K,I) = POMS(JW) * (RPOMC(K-1,I)-RPOMC(K,I)) * BI(K,I)/BH2(K,I)
   2660       RPOMCSS(K,I) = LRPOMCD(K,I) + RPOMCNS(K,I) - RPOMCD(K,I) + RPOMCMP(K,I) - RPOMCHD(K,I) 

