    749   REAL DAYTEST
    750   CHARACTER(1) :: INFORMAT,CHAR1
    751   CHARACTER(8) :: CHAR8
    752   CHARACTER(30):: CHAR30
    753 
    754 !**                                                   Task 2: Calculations                                                  
    754       **
    755 !***************************************************************************************************************************
    755 ********
    756       
    757       IFILE=1949
    758       TAVG=0.0
    759       TAVGW=0.0
    760       DO JB=1,NBR
    761         IF(NSTR(JB) > 0)THEN
    762         IFILE=IFILE+1
    763         WRITE (SEGNUM,'(I0)') JB
    764         SEGNUM = ADJUSTL(SEGNUM)
    765         L      = LEN_TRIM(SEGNUM)
    766 
    767         IF(RESTART_IN)THEN
    768                 OPEN  (IFILE,FILE='str_br'//segnum(1:l)//'.csv',POSITION='APPEND')
    769                 JDAY1=0.0
    770                 REWIND (IFILE)
    771                 READ   (IFILE,'(//)',END=13)
    772                 DO WHILE (JDAY1 < JDAY)
    773                 READ (IFILE,*,END=13) JDAY1            !READ (IFILE,'(F10.0)',END=13) JDAY1
    774                 END DO
    775                 BACKSPACE (IFILE)
    776                 13     JDAY1=0.0    
    777         ELSE
    778                 OPEN  (IFILE,FILE='str_br'//segnum(1:l)//'.csv',status='unknown')
    779                 WRITE(IFILE,*)'Branch:,',jb,', # of structures:,',nstr(jb),', outlet temperatures'
    780                 WRITE(IFILE,'("      JDAY,",<nstr(jb)>(6x,"T(C),"),<nstr(jb)>(3x,"Q(m3/s),"),<nstr(jb)>(4x,"ELEVCL,"))')
    781         ENDIF
    782         ENDIF
    783       END DO
    784  
    785       IF(NWD > 0)THEN
    786        IFILE=IFILE+1  
    787        IF(RESTART_IN)THEN
    788                 OPEN  (IFILE,FILE='wd_out.opt',POSITION='APPEND')
    789                 JDAY1=0.0
    790                 REWIND (IFILE)
    791                 READ   (IFILE,'(/)',END=14)
    792                 DO WHILE (JDAY1 < JDAY)
    793                 READ (IFILE,'(F10.0)',END=14) JDAY1

