    524 !*                                              S U B R O U T I N E    T R I D I A G                                        
    524       **
    525 !***************************************************************************************************************************
    525 ********
    526 
    527 SUBROUTINE TRIDIAG(A,V,C,D,S,E,N,U)
    528   USE TRIDIAG_V
    529   INTEGER,                             INTENT(IN)  :: S, E, N
    530   REAL(R8),              DIMENSION(:), INTENT(IN)  :: A(E),V(E),C(E),D(E)
    531   REAL(R8),              DIMENSION(:), INTENT(OUT) :: U(N)
    532 ! REAL(R8), ALLOCATABLE, DIMENSION(:)              :: BTA, GMA
    533 ! REAL(R8), DIMENSION(1000)              :: BTA, GMA
    534   INTEGER                                          :: I
    535 !  ALLOCATE (BTA(N),GMA(N))
    536 
    537   BTA1(S) = V(S)
    538   GMA1(S) = D(S)
    539   DO I=S+1,E
    540     BTA1(I) = V(I)-A(I)/BTA1(I-1)*C(I-1)
    541     GMA1(I) = D(I)-A(I)/BTA1(I-1)*GMA1(I-1)
    542   END DO
    543   U(E) = GMA1(E)/BTA1(E)
    544   DO I=E-1,S,-1
    545     U(I) = (GMA1(I)-C(I)*U(I+1))/BTA1(I)
    546   END DO
    547 !  DEALLOCATE (BTA, GMA)                                                                                             ! SW 10
    547 /17/05
    548 END SUBROUTINE TRIDIAG

