   2669 ENTRY MACROPHYTE(LLM)
   2670   M=LLM
   2671   DO I=IU,ID
   2672     IF(KTICOL(I))THEN
   2673       JT=KTI(I)
   2674     ELSE
   2675       JT=KTI(I)+1
   2676     END IF
   2677     JE=KB(I)
   2678     DO JJ=JT,JE
   2679       IF(JJ.LT.KT)THEN
   2680         COLB=EL(JJ+1,I)
   2681       ELSE
   2682         COLB=EL(KT+1,I)
   2683       END IF
   2684 !COLDEP=ELWS(I)-COLB
   2685        coldep=EL(KT,i)-Z(i)*COSA(JB)-colb  ! cb 3/7/16
   2686       IF(MACRC(JJ,KT,I,M).GT.MMAX(M))THEN
   2687         MGR(JJ,KT,I,M)=0.0
   2688       END IF
   2689       MACSS(JJ,KT,I,M) = (MGR(JJ,KT,I,M)-MMR(KT,I,M)-MRR(KT,I,M))*MACRC(JJ,KT,I,M)
   2690       MACRM(JJ,KT,I,M)   = MACRM(JJ,KT,I,M)+MACSS(JJ,KT,I,M)*DLT*COLDEP*CW(JJ,I)*DLX(I)
   2691     END DO
   2692 
   2693     DO K=KT+1,KB(I)
   2694       JT=K
   2695       JE=KB(I)
   2696       DO JJ=JT,JE
   2697         IF(MACRC(JJ,K,I,M).GT.MMAX(M))THEN
   2698           MGR(JJ,K,I,M)=0.0
   2699         END IF
   2700         MACSS(JJ,K,I,M) = (MGR(JJ,K,I,M)-MMR(K,I,M)-MRR(K,I,M))*MACRC(JJ,K,I,M)
   2701         IF(MACT(JJ,K,I).GT.MBMP(M).AND.MACT(JJ,K-1,I).LT.MBMP(M).AND.MACSS(JJ,K,I,M).GT.0.0)THEN
   2702           IF(K-1.EQ.KT)THEN
   2703             BMASS=MACSS(JJ,K,I,M)*DLT*H2(K,I)*CW(JJ,I)*DLX(I)
   2704             MACRM(JJ,K-1,I,M)=MACRM(JJ,K-1,I,M)+BMASS
   2705             COLB=EL(KT+1,I)
   2706 !COLDEP=ELWS(I)-COLB
   2707              coldep=EL(KT,i)-Z(i)*COSA(JB)-colb  ! cb 3/7/16
   2708             MACSS(JJ,K-1,I,M)=BMASS/DLT/(COLDEP*CW(JJ,I)*DLX(I)) + MACSS(JJ,K-1,I,M)
   2709           ELSE
   2710             BMASS=MACSS(JJ,K,I,M)*DLT*H2(K,I)*CW(JJ,I)*DLX(I)
   2711             MACRM(JJ,K-1,I,M)=MACRM(JJ,K-1,I,M)+BMASS
   2712             MACSS(JJ,K-1,I,M)=BMASS/DLT/(H2(K-1,I)*CW(JJ,I)*DLX(I))+ MACSS(JJ,K-1,I,M)
   2713           END IF
   2714           MACSS(JJ,K,I,M)=0.0
   2715         ELSE
   2716           BMASSTEST=MACRM(JJ,K,I,M)+MACSS(JJ,K,I,M)*DLT*H2(K,I)*CW(JJ,I)*DLX(I)
   2717           IF(BMASSTEST.GE.0.0)THEN

