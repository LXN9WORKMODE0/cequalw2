      6 SUBROUTINE RESTART_OUTPUT (RSOFN)
      7   USE GLOBAL; USE SCREENC; USE RSTART; USE GDAYC; USE GEOMC; USE KINETIC, ONLY:EPM,EPD,SEDC,SEDN,SEDP, SDKV; USE TVDC, ONLY:
      7 QSUM     
      8   USE KINETIC, ONLY:SED, PFLUXIN,NFLUXIN ; USE ZOOPLANKTONC, ONLY: ZOO; USE EDDY, ONLY: TKE; USE MAIN, ONLY:ENVIRPC,WARNING_
      8 OPEN,NXWL,NXFLOWBAL,NXNPBAL;USE ENVIRPMOD; USE LOGICC;USE STRUCTURES
      9   USE MACROPHYTEC
     10   IMPLICIT NONE
     11   
     12   CHARACTER(*) :: RSOFN
     13   OPEN  (RSO,FILE=RSOFN,FORM='UNFORMATTED',STATUS='UNKNOWN')
     14   WRITE (RSO) NIT,    NV,     KMIN,   IMIN,   NSPRF,  CMBRT,  ZMIN,   IZMIN,  START,  CURRENT
     15   WRITE (RSO) DLTDP,  SNPDP,  TSRDP,  VPLDP,  PRFDP,  CPLDP,  SPRDP,  RSODP,  SCRDP,  FLXDP,  WDODP
     16   WRITE (RSO) JDAY,    ELTM,   ELTMF,  DLT,    DLTAV,  DLTS,   MINDLT, JDMIN,  CURMAX
     17   WRITE (RSO) NXTMSN, NXTMTS, NXTMPR, NXTMCP, NXTMVP, NXTMRS, NXTMSC, NXTMSP, NXTMFL, NXTMWD, NXWL, NXFLOWBAL, NXNPBAL,NXTMW
     17 D_SEC, NXTMUK
     18   WRITE (RSO) VOLIN,  VOLOUT, VOLUH,  VOLDH,  VOLPR,  VOLTRB, VOLDT,  VOLWD,  VOLEV,  VOLSBR, VOLTR, VOLSR,VOLICE,ICEBANK
     19   WRITE (RSO) TSSEV,  TSSPR,  TSSTR,  TSSDT,  TSSWD,  TSSIN,  TSSOUT, TSSS,   TSSB,   TSSICE
     20   WRITE (RSO) TSSUH,  TSSDH,  TSSUH2, TSSDH2, CSSUH2, CSSDH2, VOLUH2, VOLDH2, QUH1
     21   WRITE (RSO) ESBR,   ETBR,   EBRI
     22   WRITE (RSO) Z,      SZ,     ELWS,   SAVH2,  SAVHR,  H2
     23   WRITE (RSO) KTWB,   KTI,    SKTI,   SBKT
     24   WRITE (RSO) ICE,    ICETH,  CUF,    QSUM
     25   WRITE (RSO) U,      W,      SU,     SW,     AZ,     SAZ,    DLTLIM, SELWS
     26   WRITE (RSO) T1,     T2,     C1,     C2,     C1S,    SED,    KFS,    CSSK
     27   WRITE (RSO) EPD,   EPM
     28   WRITE (RSO) MACMBRT,MACRC, MAC, MACRM,  MACSS
     29   WRITE (RSO) SEDC, SEDN, SEDP, ZOO, CD  ! mlm 10/06
     30   WRITE(RSO) SDKV                        ! MLM 6/10/07
     31   WRITE(RSO) TKE                         ! SW 10/4/07
     32   WRITE(RSO) BR_INACTIVE,WARNING_OPEN   ! SW 8/1/2018
     33   IF(ENVIRPC == '      ON')WRITE(RSO)T_CLASS,V_CLASS,C_CLASS,CD_CLASS,T_TOT,T_CNT,SUMVOLT,V_CNT,V_TOT,C_TOT,C_CNT,CD_TOT,CD_
     33 CNT
     34   IF(PIPES)WRITE(RSO)YS,VS,VST,YST,DTP,QOLD
     35   WRITE(RSO)TPOUT,TPTRIB,TPDTRIB,TPWD,TPPR,TPIN,TP_SEDSOD_PO4,PFLUXIN,TNOUT,TNTRIB,TNDTRIB,TNWD,TNPR,TNIN,TN_SEDSOD_NH4,NFLU
     35 XIN,ATMDEP_P,ATMDEP_N,NH3GASLOSS    !TP_SEDBURIAL,TN_SEDBURIAL,
     36 
     37   CLOSE (RSO)
     38 END SUBROUTINE RESTART_OUTPUT

