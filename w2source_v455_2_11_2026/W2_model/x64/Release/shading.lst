      7 SUBROUTINE SHADING
      8   USE SHADEC; USE GLOBAL; USE GDAYC; USE SURFHE; USE GEOMC; USE SCREENC; USE LOGICC
      9   IMPLICIT NONE
     10   CHARACTER(1) :: BANK
     11   REAL         :: LOCAL,STANDARD,HOUR,TAUD,SINAL,A02,AZ00,A0,AX,ANG1,ANG2,TOPOANG,SFACT,HT,CLINE,SRED,STLEN,EDGE,EDAZ,SN,AZT
     12   INTEGER      :: IDAY,J
     13 
     14 ! Calculate solar altitude, declination, and local hour angle when short-wave solar radiation is provided as input
     15 
     16   IF (READ_RADIATION(JW)) THEN
     17     LOCAL    =  LONGIT(JW)
     18     STANDARD =  15.0*INT(LONGIT(JW)/15.0)
     19     HOUR     = (JDAY-INT(JDAY))*24.0
     20     IDAY     =  JDAY-((INT(JDAY/365))*365)
     21 !IDAY     =  IDAY+INT(INT(JDAY/365)/4)    SR 12/2018 IDAY FIX
     22     IDAY     =  IDAY-INT(INT(JDAY/365)/4)
     23     TAUD     = (2*PI*(IDAY-1))/365
     24     EQTNEW   =  0.170*SIN(4*PI*(IDAY-80)/373)-0.129*SIN(2*PI*(IDAY-8)/355)
     25     HH(JW)   =  0.261799*(HOUR-(LOCAL-STANDARD)*0.0666667+EQTNEW-12.0)
     26     DECL(JW) =  0.006918-0.399912*COS(TAUD)+0.070257*SIN(TAUD)-0.006758*COS(2*TAUD)+0.000907*SIN(2*TAUD)-0.002697*COS(3*TAUD
     26 )      &
     27                 +0.001480*SIN(3*TAUD)
     28     SINAL    =  SIN(LAT(JW)*.0174533)*SIN(DECL(JW))+COS(LAT(JW)*.0174533)*COS(DECL(JW))*COS(HH(JW))
     29     A00(JW)  =  57.2957795*ASIN(SINAL)
     30   END IF
     31 
     32 ! If the sun is below the horizon, set SHADE(I) to 0
     33 
     34   IF (A00(JW) < 0.0) THEN
     35     SHADE(I) = 0.0
     36   ELSE
     37 
     38 !** Calculate solar azimuth angle
     39 
     40     A02 = A00(JW)/57.2957795
     41     AX  = (SIN(DECL(JW))*COS(LAT(JW)*0.017453)-COS(DECL(JW))*COS(HH(JW))*SIN(LAT(JW)*0.017453))/COS(A02)
     42     IF (AX >  1.0) AX =  1.0
     43     IF (AX < -1.0) AX = -1.0
     44     AZT = ACOS(AX)
     45     IF (HH(JW) < 0.0) THEN
     46      AZ00 = AZT
     47     ELSE
     48      AZ00 = 2.0*PI-AZT
     49     END IF
     50     A0 = A02
     51 
     52 !** Interpolate the topographic shade angle
     53 

Page 2           Source Listing                  SHADING
2026-03-30 08:47                                 ..\..\..\shading.f90

     54     DO J=1,IANG-1
     55       IF (AZ00 > ANG(J) .AND. AZ00 <= ANG(J+1)) THEN
     56         ANG1    =  AZ00-ANG(J)
     57         ANG2    = (TOPO(I,J+1)-TOPO(I,J))/GAMA                 ! SW 10/17/05
     58         TOPOANG =  TOPO(I,J)+ANG2*ANG1
     59       END IF
     60     END DO
     61     IF (AZ00 > ANG(IANG) .AND. AZ00 <= 2*PI) THEN
     62       ANG1    =  AZ00-ANG(IANG)
     63       ANG2    = (TOPO(I,1)-TOPO(I,IANG))/GAMA                  ! SW 10/17/05
     64       TOPOANG =  TOPO(I,IANG)+ANG2*ANG1
     65     END IF
     66 
     67 !** Complete topographic shading if solar altitude less than topo angle
     68 
     69     IF (A0 <= TOPOANG) THEN
     70       SFACT = 0.90
     71       GO TO 100
     72     END IF
     73 
     74 !** No vegetative shading if azimuth angle is oriented parallel to stream
     75 
     76     IF (AZ00 == PHI0(I) .OR. AZ00 == PHI0(I)+PI .OR. AZ00+PI == PHI0(I)) THEN
     77       SFACT = 0.0
     78       GO TO 100
     79     END IF
     80 
     81 !** Bank with the controlling vegetation
     82 
     83     IF (PHI0(I) > 0.0 .AND. PHI0(I) <= PI) THEN
     84       IF (AZ00 > PHI0(I)     .AND. AZ00 <= PHI0(I)+PI) BANK = 'L'
     85       IF (AZ00 > 0.0         .AND. AZ00 <= PHI0(I))    BANK = 'R'
     86       IF (AZ00 > PHI0(I)+PI  .AND. AZ00 <  2.0*PI)     BANK = 'R'
     87     ELSE IF (PHI0(I) > PI .AND. PHI0(I) <= 2.0*PI) THEN
     88       IF (AZ00 >= PHI0(I)    .AND. AZ00 < 2.0*PI)      BANK = 'L'
     89       IF (AZ00 >= 0.0        .AND. AZ00 < PHI0(I)-PI)  BANK = 'L'
     90       IF (AZ00 >= PHI0(I)-PI .AND. AZ00 < PHI0(I))     BANK = 'R'
     91     END IF
     92 
     93 !** No topographic shading
     94 
     95     IF (BANK == 'L') THEN
     96       IF (TTLB(I) < ELWS(I)) THEN
     97         SFACT = 0.0
     98         GO TO 100
     99       ELSE
    100         HT    = TTLB(I)-ELWS(I)
    101         CLINE = CLLB(I)
    102         SRED  = SRLB2(I)
    103         IF (JDAYG > SRFJD1(I) .AND. JDAYG <= SRFJD2(I)) SRED = SRLB1(I)
    104       END IF
    105     ELSE
    106       IF (TTRB(I) < ELWS(I)) THEN
    107         SFACT = 0.0
    108         GO TO 100
    109       ELSE
    110         HT    = TTRB(I)-ELWS(I)

Page 3           Source Listing                  SHADING
2026-03-30 08:47                                 ..\..\..\shading.f90

    111         CLINE = CLRB(I)
    112         SRED  = SRRB2(I)
    113         IF (JDAYG > SRFJD1(I) .AND. JDAYG <= SRFJD2(I)) SRED = SRRB1(I)
    114       END IF
    115     END IF
    116     STLEN = HT/TAN (A0)
    117     EDGE  = MAX (0.0,CLINE-BI(KT,I)/2.0)
    118 
    119 !** Distance from vegetation to water edge on line parallel to azimuth
    120 
    121     EDAZ = EDGE/ABS(SIN(PHI0(I)-AZ00))
    122     IF (STLEN <= EDAZ) THEN
    123       SFACT = 0.0
    124       GO TO 100
    125     END IF
    126 
    127 !** Distance shadow extends over water (perpendicular to segment orientation)
    128 
    129     SN    = MIN (HT*ABS (SIN (ABS (PHI0(I)-AZ00)))/TAN (A0)-EDGE,BI(KT,I))
    130     SFACT = SRED*SN/BI(KT,I)
    131 100 CONTINUE
    132     SHADE(I) = MAX (0.0,1.0-SFACT)
    133     SHADE(I) = MIN(ABS(SHADEI(I)),SHADE(I))              ! SW 10/2/2017 Allows for fixed canopy cover over top of channel - 
    133 only used if shade is less than shadei only valid for -0.99 and 0.0
    134   END IF
    135   RETURN
    136 END SUBROUTINE SHADING


