    223 ENTRY TEMPERATURE_RATES
    224   DO I=IU,ID
    225     DO K=KT,KB(I)
    226       LAM1        = FR(T1(K,I),NH4T1(JW),NH4T2(JW),NH4K1(JW),NH4K2(JW))
    227       NH4TRM(K,I) = LAM1/(1.0+LAM1-NH4K1(JW))
    228       LAM1        = FR(T1(K,I),NO3T1(JW),NO3T2(JW),NO3K1(JW),NO3K2(JW))
    229       NO3TRM(K,I) = LAM1/(1.0+LAM1-NO3K1(JW))
    230       LAM1        = FR(T1(K,I),OMT1(JW),OMT2(JW),OMK1(JW),OMK2(JW))
    231       OMTRM(K,I)  = LAM1/(1.0+LAM1-OMK1(JW))
    232       LAM1        = FR(T1(K,I),SODT1(JW),SODT2(JW),SODK1(JW),SODK2(JW))
    233       SODTRM(K,I) = LAM1/(1.0+LAM1-SODK1(JW))
    234       DO JA=1,NAL
    235         IF(ALG_CALC(JA))THEN
    236         LAM1          = FR(T1(K,I),AT1(JA),AT2(JA),AK1(JA),AK2(JA))
    237         LAM2          = FF(T1(K,I),AT3(JA),AT4(JA),AK3(JA),AK4(JA))
    238         ATRMR(K,I,JA) = LAM1/(1.0+LAM1-AK1(JA))
    239         ATRMF(K,I,JA) = LAM2/(1.0+LAM2-AK4(JA))
    240         ATRM(K,I,JA)  = ATRMR(K,I,JA)*ATRMF(K,I,JA)
    241         ENDIF
    242       END DO
    243       DO JE=1,NEP
    244         IF (EPIPHYTON_CALC(JW,JE))then
    245         LAM1          = FR(T1(K,I),ET1(JE),ET2(JE),EK1(JE),EK2(JE))
    246         LAM2          = FF(T1(K,I),ET3(JE),ET4(JE),EK3(JE),EK4(JE))
    247         ETRMR(K,I,JE) = LAM1/(1.0+LAM1-EK1(JE))
    248         ETRMF(K,I,JE) = LAM2/(1.0+LAM2-EK4(JE))
    249         ETRM(K,I,JE)  = ETRMR(K,I,JE)*ETRMF(K,I,JE)
    250         endif
    251       END DO
    252       DO M=1,NMC
    253       IF(MACROPHYTE_CALC(JW,M))THEN
    254         LAM1    = FR(T1(K,I),MT1(M),MT2(M),MK1(M),MK2(M))
    255         LAM2    = FF(T1(K,I),MT3(M),MT4(M),MK3(M),MK4(M))
    256         MACTRMR(K,I,M) = LAM1/(1.0+LAM1-MK1(M))
    257         MACTRMF(K,I,M) = LAM2/(1.0+LAM2-MK4(M))
    258         MACTRM(K,I,M)  = MACTRMR(K,I,M)*MACTRMF(K,I,M)
    259       endif
    260       end do
    261       IF(ZOOPLANKTON_CALC)THEN
    262 	    DO JZ = 1, NZP
    263           LAM1       = FR(T1(K,I),ZT1(JZ),ZT2(JZ),ZK1(JZ),ZK2(JZ))
    264           LAM2       = FF(T1(K,I),ZT3(JZ),ZT4(JZ),ZK3(JZ),ZK4(JZ))
    265           ZOORMR(K,I,JZ)= LAM1/(1.+LAM1-ZK1(JZ))
    266           ZOORMF(K,I,JZ)= LAM2/(1.+LAM2-ZK4(JZ))

Page 7           Source Listing                  
2026-03-30 08:47                                 ..\..\..\water-quality.f90

    267           ZOORM(K,I,JZ) = ZOORMR(K,I,JZ)*ZOORMF(K,I,JZ)
    268         END DO
    269 	  end if
    270     END DO
    271   END DO
    272 RETURN
