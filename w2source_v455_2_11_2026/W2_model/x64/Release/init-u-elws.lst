    286       SUBROUTINE NORMAL_DEPTH(FLOW)
    287       
    288       USE GLOBAL; USE GEOMC
    289                   
    290       INTEGER, PARAMETER ::JMAX=40    
    291       REAL(R8)   :: FLOW
    292       REAL :: X1, X2, FUNCVAL1, FUNCVAL2, XACC, FMID, FUNC1, RTBIS, DX, XMID     
    293       INTEGER :: JJ,J  
    294                   
    295 ! FIRST, BRACKETING ROOT
    296       X1=0.001
    297       X2=1.0
    298       CALL MANNINGS_EQN(FLOW,X1,FUNCVAL1)
    299       CALL MANNINGS_EQN(FLOW,X2,FUNCVAL2)
    300                   
    301       DO JJ=1,JMAX
    302         IF(FUNCVAL1*FUNCVAL2 > 0.0)THEN
    303           IF(ABS(FUNCVAL1)  < ABS(FUNCVAL2))THEN
    304             X1=X1/2.0
    305             CALL MANNINGS_EQN(FLOW,X1,FUNCVAL1)            
    306           ELSE
    307             X2=X2+1.5*(X2-X1)
    308             CALL MANNINGS_EQN(FLOW,X2,FUNCVAL2)
    309           END IF                                          
    310         ELSE
    311           EXIT
    312         END IF      
    313       END DO                 
    314       
    315 ! FINDING ROOT BY BISECTION
    316       XACC=0.01
    317       CALL MANNINGS_EQN(FLOW,X2,FMID)
    318       CALL MANNINGS_EQN(FLOW,X1,FUNC1)      
    319 !    IF(FUNC1*FMID.GE.0.) PAUSE 'ROOT MUST BE BRACKETED IN RTBIS'
    320       IF(FUNC1.LT.0.)THEN
    321         RTBIS=X1
    322         DX=X2-X1
    323       ELSE
    324         RTBIS=X2
    325         DX=X1-X2
    326       ENDIF
    327       DO J=1,JMAX
    328         DX=DX*.5
    329         XMID=RTBIS+DX
    330         CALL MANNINGS_EQN(FLOW,XMID,FMID)        
    331         IF(FMID.LE.0.)RTBIS=XMID
    332         IF(ABS(DX).LT.XACC .OR. FMID.EQ.0.)THEN          
    333           ELWS(I)=RTBIS+EL(KB(I)+1,I)                                      ! SW 4/5/13
    334           RETURN

Page 10          Source Listing                  NORMAL_DEPTH
2026-03-30 08:47                                 ..\..\..\init-u-elws.f90

    335         END IF
    336       END DO
    337 !    PAUSE 'TOO MANY BISECTIONS IN RTBIS'
    338       END SUBROUTINE NORMAL_DEPTH


