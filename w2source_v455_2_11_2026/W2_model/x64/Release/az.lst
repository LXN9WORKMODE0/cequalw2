     90 SUBROUTINE CALCULATE_TKE
     91   USE AZ_LOCAL
     92   IMPLICIT NONE
     93   SAVE
     94   USTAR = SQRT(1.25*CZ(I)*WIND10(I)**2/RHO(KT,I))
     95   IF (MANNINGS_N(JW)) THEN
     96    HRAD = BH1(KT,I)/(B(KTI(I),I)-B(KT+1,I)+2.*AVH1(KT,I))      ! HRAD = BHR1(KT,I)/(BR(KTI(I),I)-BR(KT+1,I)+2.*AVH1(KT,I))  
     96 SW 10/5/07  These calculations are at the segment centers and vertical center of a layer
     97     if(macrophyte_on.and.mannings_n(jw))then
     98       call macrophyte_friction(hrad,fric(i),effric,kt,i)
     99       gc2=g*effric*effric/hrad**0.33333333
    100     else if(.not.macrophyte_on.and.mannings_n(jw))then
    101       gc2=g*fric(i)*fric(i)/hrad**0.33333333
    102     end if
    103   ELSE
    104     GC2 = 0.0
    105     IF (FRIC(I) /= 0.0) GC2 = G/(FRIC(I)*FRIC(I))
    106   END IF
    107   USTARBKT     = SQRT(GC2)*ABS(0.5*(U(KT,I)+U(KT,I-1)))                                                 ! SG 10/4/07
    108   TKE(KT,I,1) = (3.33*(USTAR*USTAR+USTARBKT*USTARBKT))*BHRATIO(KT,I)   !(BH2(KT,I)/BH1(KT,I))                            ! S
    108 G 10/4/07
    109   TKE(KT,I,2) = (USTAR*USTAR*USTAR+USTARBKT*USTARBKT*USTARBKT)*5.0/H1(KT,I)*BHRATIO(KT,I)   !*(BH2(KT,I)/BH1(KT,I))       ! 
    109 SG 10/4/07
    110   DO K=KT+1,KB(I)-1
    111     BOUK = MAX(AZ(K,I)*G*(RHO(K+1,I)-RHO(K,I))/(H(K,JW)*RHOW),0.0)
    112     PRDK = AZ(K,I)*(0.5*(U(K,I)+U(K,I-1)-U(K+1,I)-U(K+1,I-1))/(H(K,JW)*0.5 + H(K+1,JW)*0.5))**2.0       ! SG 10/4/07
    113     PRHE = 10.0*GC2**1.25*ABS(0.5*(U(K,I)+U(K,I-1)))**4.0/(0.5*B(K,I))**2.0
    114     IF (MANNINGS_N(JW)) THEN
    115       HRAD = BH(K,I)/(B(K,I)-B(K+1,I)+2.0*H(K,JW))          ! HRAD = BHR(K,I)/(BR(K,I)-BR(K+1,I)+2.0*H(K,JW))  SW 10/5/07
    116       if(macrophyte_on.and.mannings_n(jw))then
    117         call macrophyte_friction(hrad,fric(i),effric,k,i)
    118         gc2=g*effric*effric/hrad**0.33333333
    119       else if (.not.macrophyte_on.and.mannings_n(jw))then
    120         gc2=g*fric(i)*fric(i)/hrad**0.33333333
    121       end if
    122     END IF
    123     PRHK       = GC2/(0.5*B(K,I))*ABS(0.5*(U(K,I)+U(K,I-1)))**3.0
    124     UNST       = PRDK-TKE(K,I,2)
    125     UNSE       = 1.44*TKE(K,I,2)/TKE(K,I,1)*PRDK-1.92*(TKE(K,I,2)/TKE(K,I,1)*TKE(K,I,2))
    126     TKE(K,I,1) = TKE(K,I,1)+DLT*(UNST+PRHK-BOUK)
    127     TKE(K,I,2) = TKE(K,I,2)+DLT*(UNSE+PRHE)
    128   END DO
    129   USTARB         = SQRT(GC2)*ABS(0.5*(U(KB(I),I)+U(KB(I),I-1)))
    130   TKE(KB(I),I,1) = 0.5*(3.33*USTARB*USTARB+TKE(KB(I),I,1))
    131   TKE(KB(I),I,2) = 0.5*(USTARB*USTARB*USTARB*5.0/H(KB(I),JW)+TKE(KB(I),I,2))
    132 
    133   DO J=1,2                                                    ! SG 10/4/07 Series of bug fixes for TKE
    134 	  K=KT			
    135 	  AT(K,I) = 0.0
    136 	  CT(K,I) = 0.0
    137 	  VT(K,I) = 1.0
    138 	  DT(K,I) = TKE(K,I,J)	
    139 	  DO K = KT+1,KB(I)-1
    140       AT(K,I) = -DLT/BH1(K,I)*BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I)
    141       CT(K,I) = -DLT/BH1(K,I)*BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I)
    142       VT(K,I) =  1.0-AT(K,I)-CT(K,I)

Page 8           Source Listing                  CALCULATE_TKE
2026-03-30 08:47                                 ..\..\..\az.f90

    143       DT(K,I) =  TKE(K,I,J)
    144     END DO
    145 	  K = KB(I)
    146 	  AT(K,I) = 0.0
    147 	  CT(K,I) = 0.0
    148 	  VT(K,I) = 1.0
    149 	  DT(K,I) = TKE(K,I,J)
    150 	  CALL TRIDIAG(AT(:,I),VT(:,I),CT(:,I),DT(:,I),KT,KB(I),KMX,TKE(:,I,J))
    151   END DO
    152 
    153   DO K=KT,KB(I)
    154     TKE(K,I,1) = MAX(TKE(K,I,1),TKEMIN1)
    155     TKE(K,I,2) = MAX(TKE(K,I,2),TKEMIN2)
    156     AZT(K,I)     = 0.09*TKE(K,I,1)*TKE(K,I,1)/TKE(K,I,2)
    157   END DO
    158 
    159   DO K=KT,KB(I)-1
    160     AZ(K,I) = 0.5*(AZT(K,I)+AZT(K+1,I))
    161     AZ(K,I) = MAX(AZMIN,AZ(K,I))
    162     AZ(K,I) = MIN(AZMAX(JW),AZ(K,I))
    163     DZ(K,I) = MAX(DZMIN,FRAZDZ*AZ(K,I))            ! No need to average DZ further since defined at cell, center bottom. AZ 
    163 needs to be averaged to RHS of cell.
    164   END DO
    165   AZ(KB(I),I) = AZMIN
    166   AZT(KB(I),I)= AZMIN
    167   RETURN
    168     END SUBROUTINE CALCULATE_TKE


