   3794 
   3795   if (j2pref == 0) j2pref = 1                                                 ! Preferred outlet number, if not sharing
   3796   excess_frac = 0.0                                                           ! Excess flow above maximum release rates
   3797   nexcess     = 0                                                             ! Number of group 2 outlets exceeding maximum 
   3797 rates
   3798 
   3799 ! Set and rebalance release fractions for group 2 structures
   3800   if (tspltcntr(j) == '      ST') then
   3801     do n=1,ng2                                                                ! Find maxed-out outlets in group 2; set flows
   3801  to max
   3802       jst = jstsplt(j,nout2(n))
   3803       if (.not. share_flow(j) .and. ng2 > 1) then                             ! Direct flow to preferred outlet if not share
   3803 d
   3804         if (n == j2pref) then
   3805           qstrfrac(jst,jb) = qfrac2 - sum_minfrac2 + minfrac2(n)
   3806         else
   3807           qstrfrac(jst,jb) = minfrac2(n)
   3808         end if
   3809       else
   3810         qstrfrac(jst,jb) = minfrac2(n) + (qfrac2 - sum_minfrac2) / ng2
   3811       end if
   3812       if (qstrfrac(jst,jb) > maxfrac2(n)) then
   3813         nexcess = nexcess + 1
   3814         excess_frac = excess_frac + qstrfrac(jst,jb) - maxfrac2(n)
   3815         qstrfrac(jst,jb) = maxfrac2(n)
   3816       end if
   3817     end do
   3818     if (excess_frac > 0.0 .and. ng2 - nexcess > 0) then                       ! Redistribute excess flow to other outlets in
   3818  group
   3819       do nj=1,ng2                                                             ! Iterative process, in case others get maxed-
   3819 out
   3820         if (ng2 == nexcess .or. excess_frac <= 0.00001) exit
   3821         addfrac = excess_frac / (ng2 - nexcess)
   3822         do n=1,ng2
   3823           jst = jstsplt(j,nout2(n))
   3824           if (maxfrac2(n) - qstrfrac(jst,jb) > 0.00001) then
   3825             if (qstrfrac(jst,jb) + addfrac > maxfrac2(n)) then
   3826               nexcess = nexcess + 1
   3827               excess_frac = excess_frac - (maxfrac2(n) - qstrfrac(jst,jb))
   3828               qstrfrac(jst,jb) = maxfrac2(n)
   3829             else
   3830               excess_frac = excess_frac - addfrac
   3831               qstrfrac(jst,jb) = qstrfrac(jst,jb) + addfrac
   3832             end if
   3833           end if
   3834         end do
   3835       end do
   3836     end if
