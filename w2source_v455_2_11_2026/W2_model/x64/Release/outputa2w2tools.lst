     71 ),DS(JB)),JB=RIVER_CONTOUR_BR1(JJ),RIVER_CONTOUR_BR2(JJ))
     72                   ENDIF
     73                     IF(OXYGEN_DEMAND)THEN
     74                     IF(RIVER_CONTOUR_FORMAT == 1)THEN
     75                     DO JB=RIVER_CONTOUR_BR1(JJ),RIVER_CONTOUR_BR2(JJ)
     76                     DO I=US(JB),DS(JB)
     77                       WRITE(LAKE_RIVER_CONTOUR+30+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,X1(I),C2(KTWB(JW_RIVER_CONTOUR(JJ)),I,
