    331 	  IF(JJ==1)THEN 	
    332 		AT(KT,I) = 0.0
    333 		CT(KT,I) =-1.0
    334 		VT(KT,I) = 1.0
    335 		DT(KT,I) = 0.0
    336 	  ELSEIF(JJ==2)THEN
    337 		IF(TKE(KT,I,1)*0.3<(USTAR*USTAR))THEN
    338 		  TKE(KT,I,1) = (USTAR*USTAR)*3.33333*BHRATIO(KT,I)   !*BH2(KT,I)/BH1(KT,I)
    339 		  AT(KT,I) = 0.0
    340 		  CT(KT,I) = 0.0
    341 		  VT(KT,I) = 1.0
    342 		  DT(KT,I) = TKE(KT,I,J)
    343 		  DO K = KT+1,KB(I)-1
    344 			TKE(K,I,1) = TKE(K,I,3)
    345 		  ENDDO
    346 		ELSE
    347 		  AT(KT,I) = 0.0
    348 		  CT(KT,I) =-1.0
    349 		  VT(KT,I) = 1.0
    350 		  DT(KT,I) = 0.0		
    351 		ENDIF
    352 	  ENDIF
    353 	  IF(JJ==3)THEN
    354 		TKE(KT,I,2) = (TKE(KT,I,1)*0.3)**(1.5)/(0.41*(H2(KT,I)*0.5 + ARODI(JW)*DEPTH*   &
    355 		              (1-(USTAR*USTAR)/(TKE(KT,I,1)*0.3))))*BHRATIO(KT,I)   !*BH2(KT,I)/BH1(KT,I)		   !
    355 3.0/2.0    /2.0
    356 		AT(KT,I) = 0.0
    357 		CT(KT,I) = 0.0
    358 		VT(KT,I) = 1.0
    359 		DT(KT,I) = TKE(KT,I,2)
    360 	  ENDIF
    361 	  DO K = KT+1,KB(I)-1
    362 		 IF(IMPTKE(JW)=='     IMP')THEN
    363 		   AT(K,I) =  -DLT/BH1(K,I)*(BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) + 0.5*W(K-1,I)*BB(K-1,I))
    364 		   CT(K,I) =  -DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) - 0.5*W(K,I)*BB(K,I))
    365 		   VT(K,I) =  1 +&
    366 				      DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) +&
    367 				      BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) +&
    368 					  0.5*(W(K,I)*BB(K,I)-W(K-1,I)*BB(K-1,I)))
    369 		   DT(K,I) =  TKE(K,I,J)
    370 		 ELSE
    371 		   AT(K,I) = -DLT/BH1(K,I)*BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I)
    372 		   CT(K,I) = -DLT/BH1(K,I)*BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I)
    373 		   VT(K,I) =  1.0-AT(K,I)-CT(K,I)
    374 		   DT(K,I) =  TKE(K,I,J)
    375 		 ENDIF
    376 	  END DO
    377 	  K = KB(I)
    378 	  AT(K,I) = 0.0
    379 	  CT(K,I) = 0.0
    380 	  VT(K,I) = 1.0
    381 	  DT(K,I) = TKE(K,I,J)
    382 	  CALL TRIDIAG(AT(:,I),VT(:,I),CT(:,I),DT(:,I),KT,KB(I),KMX,TKE(:,I,J))
    383 	END DO
    384   ELSEIF(TKEBC(JW)==3)THEN
    385 !CEQUALW2 WIND
    386 ! TOP LAYER BC

