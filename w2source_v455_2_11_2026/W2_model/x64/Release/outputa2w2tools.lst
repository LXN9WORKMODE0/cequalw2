     34 IF(LAKE_RIVER_CONTOUR_ON=='ON')THEN    ! SW 2/28/2020
     35           DO JJ=1,NUM_LAKE_CONTOUR
     36               IF(JDAY >= NXT_LAKE_CONTOUR(JJ))THEN
     37                   NXT_LAKE_CONTOUR(JJ)=NXT_LAKE_CONTOUR(JJ)+LAKE_CONTOUR_FREQ(JJ)
     38                   TBLANK=-99.0
     39                   IF(LAKE_CONTOUR_FORMAT == 1)THEN
     40                   WRITE(LAKE_RIVER_CONTOUR+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,ELWS(LAKE_CONTOUR_SEG(JJ))+0.1,TBLANK
     41                    WRITE(LAKE_RIVER_CONTOUR+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,ELWS(LAKE_CONTOUR_SEG(JJ)),T2(KTWB(JW_LAKE_C
     41 ONTOUR(JJ)),LAKE_CONTOUR_SEG(JJ))
     42                   DO K=KTWB(JW_LAKE_CONTOUR(JJ))+1,KB(LAKE_CONTOUR_SEG(JJ))
     43                       WRITE(LAKE_RIVER_CONTOUR+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,(EL(K,LAKE_CONTOUR_SEG(JJ))+EL(K,LAKE_CON
     43 TOUR_SEG(JJ)))*0.5,T2(K,LAKE_CONTOUR_SEG(JJ))
     44                   ENDDO
     45                   ELSE
     46                   WRITE(LAKE_RIVER_CONTOUR+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,(TBLANK,K=2,KTWB(JW_LAKE_CONTOUR(JJ))-1),(T2(
     46 K,LAKE_CONTOUR_SEG(JJ)),K=KTWB(JW_LAKE_CONTOUR(JJ)),KB(LAKE_CONTOUR_SEG(JJ)))
     47                   ENDIF
     48                   IF(OXYGEN_DEMAND)THEN
     49                     IF(LAKE_CONTOUR_FORMAT == 1)THEN
     50                     WRITE(LAKE_RIVER_CONTOUR+10+JJ-1,'(F10.4,",",*(F8.2,","))')JDAY,ELWS(LAKE_CONTOUR_SEG(JJ))+0.1,TBLANK

