   1420 
   1421 
   1422       SUBROUTINE INTERFLOWF
   1423 
   1424       Use FISHY; USE GLOBAL; Use GEOMC; Use SCREENC; USE MAIN, ONLY: KBI
   1425       IMPLICIT NONE
   1426       
   1427       REAL        UVERT,HVERT,WHORZ,DLXHO
   1428       REAL        XV,FDDU,FDDW,LASTJDAY
   1429       REAL        XRANGE,YRANGE
   1430 
   1431       INTEGER     WB,NN,KK,II
   1432       INTEGER     N,JJZ,J,K
   1433 
   1434       PARAMETER(N=3)                            ! The order of the Newton Interpolating Polynomial
   1435 
   1436       SAVE        LASTJDAY
   1437 
   1438       DIMENSION   UVERT(N+1),HVERT(N+1),WHORZ(N+1),DLXHO(N+1),FDDU(N+1,N+1),FDDW(N+1,N+1)
   1439                   
   1440       NN = 0                                                       ! NN = Global Node # (UpperLeft Corner of cell(K,I))
   1441 ! WB = Water Body # / NWB = Total # of Water Bodies
   1442       DO WB=1,NWB
   1443 ! JB = Branch #

