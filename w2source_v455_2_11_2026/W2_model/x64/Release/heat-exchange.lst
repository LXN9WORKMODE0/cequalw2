     25 
     26 ENTRY SHORT_WAVE_RADIATION (JDAY)
     27   IF(I_SW==1)THEN
     28       CALL MEEUS
     29   ELSE
     30       
     31   LOCAL    =  LONGIT(JW)
     32   STANDARD =  15.0*INT(LONGIT(JW)/15.0)
     33   HOUR     = (JDAY-INT(JDAY))*24.0
     34   IDAY     =  JDAY-((INT(JDAY/365))*365)
     35 !IDAY     =  IDAY+INT(INT(JDAY/365)/4)  ! SR 12/2018 IDAY FIX
     36   IDAY     =  IDAY-INT(INT(JDAY/365)/4)
     37   TAUD     = (2.*PI*(IDAY-1))/365.
     38   EQTNEW   =  0.170*SIN(4.*PI*(IDAY-80)/373.)-0.129*SIN(2.*PI*(IDAY-8)/355.)
     39   HH(JW)   =  0.261799*(HOUR-(LOCAL-STANDARD)*0.0666667+EQTNEW-12.0)
     40   DECL(JW) =  0.006918-0.399912*COS(TAUD)+0.070257*SIN(TAUD)-0.006758*COS(2.*TAUD)+0.000907*SIN(2.*TAUD)-0.002697*COS(3.*TAU
     40 D)        &
     41               +0.001480*SIN(3.*TAUD)
     42   SINAL    =  SIN(LAT(JW)*.0174533)*SIN(DECL(JW))+COS(LAT(JW)*.0174533)*COS(DECL(JW))*COS(HH(JW))
     43   A00(JW)  =  57.2957795*ASIN(SINAL)
     44   A0       =  A00(JW)
     45   if(.not.Met_Regions)then
     46   IF (A0 > 0.0) THEN
     47     SRON(JW) = (1.0-CC_SW*CLOUD(JW)*CLOUD(JW))*24.0*(2.044*A0+0.1296*A0**2-1.941E-3*A0**3+7.591E-6*A0**4)*BTU_FT2_DAY_TO_W_M
     47 2
     48   ELSE
     49     SRON(JW) = 0.0

