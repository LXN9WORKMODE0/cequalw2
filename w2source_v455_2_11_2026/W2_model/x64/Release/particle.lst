   2102 Subroutine findbranch(seg)
   2103 
   2104      Use Fishy; USE GLOBAL
   2105      IMPLICIT NONE
   2106      
   2107     real seg
   2108     integer iseg,j
   2109 
   2110      iseg=int(seg)
   2111       do j=1,NBR
   2112       if(iseg.ge.us(j).and.iseg.le.ds(j))exit
   2113       end do
   2114       fnbp=j
   2115       return
   2116 
   2117 End Subroutine findbranch


