    214           n2sat=1.5568D06*0.79*(PALT(ID)-EA)*(1.8816D-5 - 4.116D-7 * Tavg(js,jb) + 4.6D-9 * Tavg(js,jb)**2)
    215           cdavg(js,jb,TDG_DER)  = 100.*(0.79*(cavg(js,jb,NN2)/n2sat) + 0.21*(cavg(js,jb,ndo)/dosat))
    216       ELSE IF(CAC(NDGP)== '      ON') THEN
    217           cdavg(js,jb,TDG_DER)  = cavg(js,jb,NDGP)/palt(id)*100.0
