   3651 
   3652           else if (tcomp < tctemp(j) .and. ncountcw(jwd) .gt. 1) then
   3653 ! to prevent this happening at each time it checks it and hence oscillating back and forth - check the temp at the upper out
   3653 let also
   3654             if (tciseg(j) > 0) then
   3655               tmod = t2(k,tciseg(j))
   3656               if (tmod < tctemp(j) .and. tcelev(j,ncountcw(jwd)-1) < elws(iwd(jwd))) then
   3657 ! making sure that the next upper structure for a particular 'j' is found
   3658                 do nj=ncountcw(jwd)-1,1,-1
   3659                   if (tcelev(j,nj) > ewd(jwd)) then
   3660                     ncountcw(jwd) = nj
