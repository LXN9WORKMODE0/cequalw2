    928       SUBROUTINE FINDNEWBR
    929       
    930     Use Fishy; Use GEOMC; USE GLOBAL;Use SCREENC
    931     
    932     IMPLICIT NONE
    933     integer trib
    934 
    935    81 TRIB = 1                                              ! TRIB = Tributary (or Branch)
    936    80 IF ((FIMP.GE.US(TRIB)).AND.(FIMP.LE.DS(TRIB))) THEN
    937         FNBP = TRIB
    938       ELSE
    939         TRIB = TRIB + 1
    940         IF (TRIB.GT.NBR) THEN                                 ! CHECK: TRIB can't be more
    941           IF (DEBUG)WRITE(DATADEBUGFN,*) 'ERROR: Finding new FNBP in Subroutine'  !        than NBR # BRANCHES
    942           IF (DEBUG)WRITE(DATADEBUGFN,*) 'ERROR: FIMP=',FIMP,' JDAY=',JDAY
    943           IF (DEBUG)WRITE(DATADEBUGFN,*) 'FIMP=FIMP-1'
    944           FIMP=FIMP-1
    945           GO TO 81
    946 !STOP
    947         ELSE
    948           GOTO 80
    949         END IF
    950       END IF
    951 
    952       RETURN
    953       END

