    112 SUBROUTINE SPILLWAY_FLOW
    113   USE STRUCTURES; USE GLOBAL; USE GEOMC
    114   IMPLICIT NONE
    115     INTEGER :: JS,ISUB
    116     REAL(R8):: ELIU,ELID,HTAIL,HENERGY,DLEL
    117 
    118   DO JS=1,NSP
    119     IF (LATERAL_SPILLWAY(JS)) THEN
    120        ELIU =  ELWS(IUSP(JS))                                        !EL(KTWB(JWUSP(JS)),IUSP(JS))-Z(IUSP(JS))*COSA(BS(JWUSP
    120 (JS)))
    121     ELSE
    122 ! ELIU =  ELWS(IUSP(JS))-SINA(JBUSP(JS))*DLX(IUSP(JS))*0.5      !EL(KTWB(JWUSP(JS)),IUSP(JS))-Z(IUSP(JS))*COSA(BS(JWUSP(JS))
    122 )-SINA(JBUSP(JS))*DLX(IUSP(JS))*0.5
    123         ELIU= ELWS(IUSP(JS)) + (ELWS(IUSP(JS))-ELWS(IUSP(JS)-1))/(0.5*(DLX(IUSP(JS))+DLX(IUSP(JS)-1)))*DLX(IUSP(JS))*0.5    
    123  ! LINEAR INTERPOLATION OF THE WATER LEVEL TO THE EDGE
    124     END IF
    125     IF (IDSP(JS) /= 0) THEN
    126       IF (US(JBDSP(JS)) /= IDSP(JS)) THEN
    127          ELID = ELWS(IDSP(JS))                                       !EL(KTWB(JWDSP(JS)),IDSP(JS))-Z(IDSP(JS))*COSA(BS(JWDSP
    127 (JS)))
    128       ELSE
    129 !   ELID = ELWS(IDSP(JS))+SINA(JBDSP(JS))*DLX(IDSP(JS))*0.5     !EL(KTWB(JWDSP(JS)),IDSP(JS))-Z(IDSP(JS))*COSA(BS(JWDSP(JS))
    129 )+SINA(JBDSP(JS))*DLX(IDSP(JS))*0.5
    130           ELID = ELWS(IDSP(JS)) - (ELWS(IDSP(JS)+1) - ELWS(IDSP(JS)))/(0.5*(DLX(IDSP(JS))+DLX(IDSP(JS)+1)))*DLX(IDSP(JS))*0.
    130 5  
    131       END IF
    132     ELSE
    133       ELID = -1.0
    134     END IF
    135     IF (ELID >= ESP(JS) .OR. ELIU >= ESP(JS)) THEN
    136       ISUB = 0
    137       IF (A2SP(JS) /= 0.0 .AND. IDSP(JS) /= 0) THEN
    138         HTAIL   =  ELID-ESP(JS)                                                 ! SW 5/10/05
    139         IF (HTAIL > 0) THEN
    140           HENERGY = (U(KTWB(JWUSP(JS)),IUSP(JS))**2)/(2.0*G)+ELIU-ESP(JS)       ! SW 5/10/05
    141           IF (HTAIL/HENERGY > 0.67) ISUB = 1
    142         END IF
    143       END IF
    144       IF (ISUB == 0) THEN
    145         DLEL = ELIU-ESP(JS)
    146         IF (DLEL < 0.0) THEN
    147           DLEL    = -DLEL
    148           QSP(JS) = -A1SP(JS)*DLEL**B1SP(JS)
    149         ELSE
    150           QSP(JS) =  A1SP(JS)*DLEL**B1SP(JS)
    151         END IF
    152       ELSE IF (ELID > ELIU) THEN
    153         DLEL    =  ELID-ELIU
    154         QSP(JS) = -A2SP(JS)*DLEL**B2SP(JS)

