    414 SUBROUTINE BirdModel
    415   USE Bird_Meeus; USE GEOMC
    416   USE GLOBAL; USE GDAYC; USE SURFHE; USE TVDC; USE SHADEC; USE MetFileRegion; USE MAIN, ONLY:SW_ALBEDO,SW_BA,SW_K1,AOD380NM,
    416 AOD500NM
    417   IMPLICIT NONE
    418 
    419     Real AM, tauA, TR, Toh, TUM, Tw, TA, AMP, Xo,uw,xw
    420     Real TAA, rs, mp, numI, denI, Ias, BirdETR
    421 
    422 ! Atmospheric Pressure
    423 !     P         = 1013
    424 ! Ratio of forward-scattered irradiance to the total scattered, see SERI pages 8 & 9
    425 !     Ba        = 0.84  --> input variable SW_BA
    426 ! Constant used in Bird Model associated with aerosol absorptance, see SERI pages 7 & 9
    427 !     K1        = 0.10   --> input variable SW_K1
    428 ! Used same albdeo from other code for Methods 1 to 3
    429 !     albedo    = 0.10   --> input variable SW_ALBEDO
    430 ! NREL solar constant of 1367 W/m^2
    431 !     SROCON    = 1367.00
    432 ! Bras/TVA (Io=Wo(sin(solaralt))/r2, Equation 2.9 on page 26) adjustment of ETR normal to beam for earth sun distance
    433      birdETR   = 1367.0/(r*r)
    434 ! broadband aerosol optical depth from surface in a vertical path (broadband turbidity)
    435      tauA      = 0.2758*AOD380nm + 0.35*AOD500nm
    436 !     tauA      = 0.05
    437     if(RToD*solarzen < 89.0)then
    438 ! Relative Optical Air Mass, SERI, pg 8
    439      AM      = (((288.0-0.0065*ELWS(DS(BE(JW))))/288.)**5.256)/(Sin(DToR*solaralt)+0.1500*(solaralt+3.885)**-1.253)         
    439            ! Equation 23, optical air mass
    440 ! Pressure corrected air mass
    441      AMP       = AM*1013.0/1013                     !Atm Pressure assumed==1013.
    442 ! Total amount of ozone in a slanted path (cm)
    443      Xo        = Uo*AM
    444 ! Amount of Precipitable water in a vertical column  from surface (cm), used 1.50 cm for Mt Vernon, range from MLS and USS m
    444 odels 1.42 to 2.93
    445      if(.not.Met_Regions)then
    446      Uw        = exp(-0.0592+0.06912*TDEW(JW))           
    447      else
    448      Uw        = exp(-0.0592+0.06912*TDEW(NMET))     
    449      endif
    450 ! Equation 27, mean hourly precipitable water content, cm
    451 ! Total amount of precipitable water in a slanted path (cm)
    452      Xw        = Uw*AM
    453 ! Transmittance of Rayleigh Scattering, SERI, pg 8
    454      TR        = Exp(-0.0903*(AMP**0.84)*(1+AMP-AMP**1.01))
    455 ! Transmittance of ozone absorptance, SERI, pg 8
    456      Toh       = 1-0.1611*Xo*(1+139.48*Xo)**-0.3035-0.002715*Xo/(1+0.044*Xo+0.0003*Xo*Xo)
    457 ! Transmittance of absorptance of uniformly mixed gases (carbon dioxide and oxygen)
    458      TUM       = Exp(-0.0127*AMP**0.26)
    459 ! Transmittance of water vapor absoptance (1-aw)
    460      Tw        = 1-2.4959*Xw/((1 + 79.034*Xw)**0.6828+6.385*Xw)
    461 ! Transmittance of aerosol aborptance and scattering
    462      TA        = Exp(-(tauA**0.873)*(1+tauA-tauA**0.7088)*AM**0.9108)
    463 ! Transmittance of aerosol aborptance
    464      TAA       = 1-SW_K1*(1-AM+AM**1.06)*(1-TA)
    465 ! Sky, or atmospheric, albedo

Page 20          Source Listing                  BIRDMODEL
2026-03-30 08:47                                 ..\..\..\heat-exchange.f90

    466      rs        = 0.0685+(1-SW_Ba)*(1-(TA/TAA))
    467 ! Direct solar irradiance on a horizontal ground surface (W/m^2)
    468      if(RToD*solarzen < 90.0)then
    469       directHz = birdETR*Cos(solarzen)*0.9662*TA*Tw*TUM*Toh*TR
    470      else
    471       directHz = 0.0
    472      end if
    473 ! Solar irradiance on a horizontal surface from atmospheric scattering (W/m2)
    474      numI      = 0.5*(1-TR)+ SW_Ba * (1-(TA/TAA))
    475      denI      = 1-AM+AM**1.02
    476      Ias       = birdETR*Cos(solarzen)*0.79*Toh*TUM*Tw*TAA*(numI/DenI)
    477    else
    478      AM = 0.0; TR = 0.0; Toh = 0.0; TUM = 0.0; Tw = 0.0; TA = 0.0; TAA = 0.0; rs = 0.0; Ias = 0.0; AMP = 0.0
    479      Xw = 0.0; Xo = 0.0; mp = 0.0
    480    end if
    481 
    482 !global radiation on a horizontal ground surface (W/m^2)
    483    if(AM > 0.0)then
    484     globalHz   = (directHz+Ias)/(1-SW_albedo*rs)
    485    else
    486     globalHz   = 0.0
    487    end if
    488 
    489 !diffuse radiation on a horizontal ground surface (W/m^2)
    490    diffuseHz = globalHz - directHz
    491    
    492 !   if(debug_Meeus==1)then
    493 !    write(9596,'(25(f14.6,","))')jdaym,Uo,AM,diffuseHz,globalhz,directHz,Ias,toh,tum,tw,taa,am,tr,ta,birdetr,rs,Uw,tdew(jw)
    493 ,sw_BA,sw_albedo,ELWS(DS(BE(JW))),sw_k1
    494 !endif
    495 
    496 
    497 END SUBROUTINE BirdModel

