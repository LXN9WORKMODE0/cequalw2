   1602       IF(ALG_CALC(JA))THEN
   1603         PSIAM(K,I) = PSIAM(K,I)+AMR(K,I,JA)*ALG(K,I,JA)*ASI(JA)     !   PSI(K,I)   HA-Z  12/2016
   1604       ENDIF
