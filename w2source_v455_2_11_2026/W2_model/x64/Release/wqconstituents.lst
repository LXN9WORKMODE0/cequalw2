     58 !********* INITIAL CONCENTRATION IF COLUMN DEPTH IS GREATER THAN 'THRKTI'
     59             IF(.NOT.KTICOL(I).AND.DEPKTI.GE.THRKTI)THEN
     60               KTICOL(I)=.TRUE.
     61               JT=KTI(I)
     62               MACT(JT,KT,I)=0.0
     63               DO M=1,NMC
     64 !MACRC(JT,KT,I,M)=MACWBCI(JW,M)
     65                 IF (ISO_macrophyte(JW,m))  macrc(jt,kt,I,m) = macwbci(JW,m)     ! cb 3/7/16
     66                 IF (VERT_macrophyte(JW,m)) macrc(jt,kt,I,m) = 0.1
     67                 IF (long_macrophyte(JW,m)) macrc(jt,kt,I,m) = 0.1
     68                 COLB=EL(KTI(I)+1,I)
     69                 COLDEP=ELWS(I)-COLB
     70 !MACRM(JT,KT,I,M)=MACWBCI(JW,M)*COLDEP*CW(JT,I)*DLX(I)
     71                 MACRM(JT,KT,I,M)=macrc(jt,kt,I,m)*COLDEP*CW(JT,I)*DLX(I)         ! cb 3/17/16
     72                 MACT(JT,KT,I)=MACT(JT,KT,I)+MACWBCI(JW,M)
     73                 MACMBRT(JB,M) = MACMBRT(JB,M)+MACRM(JT,KT,I,M)
     74               END DO
     75             END IF
     76 
     77 !****** MACROPHYTES, WHEN COLUMN DEPTH IS LESS THAN 'THRKTI', ZEROING OUT CONC.
     78             IF(KTICOL(I).AND.DEPKTI.LT.THRKTI)THEN
     79               KTICOL(I)=.FALSE.
     80               JT=KTI(I)
     81               MACT(JT,KT,I)=0.0
     82               DO M=1,NMC
     83                 MACMBRT(JB,M) = MACMBRT(JB,M)-MACRM(JT,KT,I,M)
     84                 MACRC(JT,KT,I,M)=0.0
     85                 MACRM(JT,KT,I,M)=0.0
     86               END DO
     87             END IF
     88           END DO
     89 
     90           DO M=1,NMC
     91             IF (MACROPHYTE_CALC(JW,M))THEN
     92               CALL MACROPHYTE(M)
     93             END IF
     94           END DO
     95         END IF
     96 
     97           IF (UPDATE_KINETICS) THEN
