      7 SUBROUTINE TRANSPORT
      8   USE GLOBAL; USE GEOMC; USE TVDC; USE TRANS; USE LOGICC; USE STRUCTURES; USE PREC
      9   IMPLICIT NONE
     10 
     11 ! Type declarations
     12 
     13   REAL(R8),     SAVE, ALLOCATABLE, DIMENSION(:)     :: RATD,   CURX1,  CURX2,  CURX3
     14 !  REAL,     SAVE, ALLOCATABLE, DIMENSION(:,:)   :: RATZ,   CURZ1,  CURZ2,  CURZ3
     15   REAL(R8),     SAVE, ALLOCATABLE, DIMENSION(:,:)   :: SF1X,   SF1Z,ALFA,RATS,CURS1,CURS2,CURS3,ALFAZ,RATSZ,CURS1Z,CURS2Z,CU
     15 RS3Z
     16   REAL(R8),     SAVE, ALLOCATABLE, DIMENSION(:,:,:) :: SF12X,  SF13X
     17   REAL(R8),     SAVE, ALLOCATABLE, DIMENSION(:,:,:) :: SF2X,   SF3X,   SF4X,   SF5X,   SF6X,   SF7X,   SF8X,   SF9X,   SF10X
     17 ,  SF11X
     18   REAL(R8),     SAVE, ALLOCATABLE, DIMENSION(:,:,:) :: SF2Z,   SF3Z,   SF4Z,   SF5Z,   SF6Z,   SF7Z,   SF8Z,   SF9Z,   SF10Z
     19   REAL(R8), SAVE, ALLOCATABLE, DIMENSION(:,:)   :: DX1,    DX2,    DX3
     20   REAL(R8), SAVE, ALLOCATABLE, DIMENSION(:,:)   :: AD1X,   AD2X,   AD3X,   AD1Z,   AD2Z,   AD3Z
     21 
     22   REAL(R8)                                      :: HT,HM,HB,HMIN,C2X,C3X,C1X,COUR,CART,CALF
     23   REAL(R8)                                      :: FLUX,FTEMP,CREF,CMAX1,CMIN1,C2Z,C1Z,C3Z,RATZI
     24   REAL(R8)                                      :: DELC,ADELC,ACURZ,RATDI,DLTDLXR
     25   REAL(R8)                                      :: DLXT,DLXMIN
     26   INTEGER                                       :: K
     27 
     28 ! Allocation declarations
     29 
     30   ALLOCATE (RATD(IMX),       CURX1(IMX),      CURX2(IMX),       CURX3(IMX))
     31   ALLOCATE (SF1X(KMX,IMX),   SF1Z(KMX,NWB))
     32 !  ALLOCATE (RATZ(KMX,NWB),   CURZ1(KMX,NWB),  CURZ2(KMX,NWB),   CURZ3(KMX,NWB))
     33   ALLOCATE (DX1(KMX,IMX),    DX2(KMX,IMX),    DX3(KMX,IMX))
     34   ALLOCATE (AD1X(KMX,IMX),   AD2X(KMX,IMX),   AD3X(KMX,IMX))
     35   ALLOCATE (AD1Z(KMX,IMX),   AD2Z(KMX,IMX),   AD3Z(KMX,IMX))
     36   ALLOCATE (RATS(KMX,IMX),   CURS1(KMX,IMX), CURS2(KMX,IMX), CURS3(KMX,IMX), ALFA(KMX,IMX))
     37   ALLOCATE (RATSZ(KMX,IMX),   CURS1Z(KMX,IMX), CURS2Z(KMX,IMX), CURS3Z(KMX,IMX), ALFAZ(KMX,IMX))
     38   ALLOCATE (SF2X(KMX,IMX,2), SF3X(KMX,IMX,2), SF4X(KMX,IMX,2),  SF5X(KMX,IMX,2),  SF6X(KMX,IMX,2),  SF7X(KMX,IMX,2))
     39   ALLOCATE (SF8X(KMX,IMX,2), SF9X(KMX,IMX,2), SF10X(KMX,IMX,2), SF11X(KMX,IMX,2), SF12X(KMX,IMX,2), SF13X(KMX,IMX,2))
     40   ALLOCATE (SF2Z(KMX,2,NWB), SF3Z(KMX,2,NWB), SF4Z(KMX,2,NWB),  SF5Z(KMX,2,NWB),  SF6Z(KMX,2,NWB),  SF7Z(KMX,2,NWB))
     41   ALLOCATE (SF8Z(KMX,2,NWB), SF9Z(KMX,2,NWB), SF10Z(KMX,2,NWB))
     42 
     43 ! Variable initialization
     44 
     45   CT   = 0.0; AT   = 0.0; VT   = 0.0; DT   = 0.0; DX1  = 0.0; DX2  = 0.0; DX3  = 0.0; ADZ  = 0.0; ADX  = 0.0;  AD1X = 0.0
     46   AD2X = 0.0; AD3X = 0.0; AD1Z = 0.0; AD2Z = 0.0; AD3Z = 0.0
     47 RETURN
     48 
