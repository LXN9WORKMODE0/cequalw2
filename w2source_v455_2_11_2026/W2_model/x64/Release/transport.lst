    184 ENTRY HORIZONTAL_MULTIPLIERS1
    185 
    186 ! Horizontal advection and diffusion multipliers FIRST PASS
    187 
    188   IF (UPWIND(JW)) THEN
    189     DO I=IU,ID-1
    190       DO K=KT,KB(I)
    191         IF (U(K,I) >= 0.0) THEN
    192           DX2(K,I) = -DX(K,I)/SF1X(K,I)
    193           DX3(K,I) =  DX(K,I)/SF1X(K,I)
    194         ELSE
    195           DX1(K,I) = -DX(K,I)/SF1X(K,I)
    196           DX2(K,I) =  DX(K,I)/SF1X(K,I)
    197         END IF
    198       END DO
    199     END DO
    200   ELSE
    201 !!$OMP PARALLEL DO
    202     DO I=IU,ID-1
    203       DLTDLXR=DLT/DLXR(I)
    204       DO K=KT,KB(I)
    205         COUR = U(K,I)*DLTDLXR
    206         IF (U(K,I) >= 0.0) THEN
    207           RATS(K,I)      =  RATD(I)
    208           CURS1(K,I)     =  CURX1(I)
    209           CURS2(K,I)     =  CURX2(I)
    210           CURS3(K,I)     =  CURX3(I)
    211           DX1(K,I)  =  DX(K,I)*SF11X(K,I,1)
    212           DX2(K,I)  =  DX(K,I)*SF12X(K,I,1)
    213           DX3(K,I)  =  DX(K,I)*SF13X(K,I,1)
    214           ALFA(K,I)      =  2.0D0*(DX(K,I)*DLT/(SF1X(K,I)*SF1X(K,I))-(1.0D0-COUR*COUR)*0.1666667D0)*SF3X(K,I,1)     !/6.0
    215           AD1X(K,I) = (ALFA(K,I)-COUR*SF8X(K,I,1)*0.5D0)/SF5X(K,I,1)

Page 5           Source Listing                  TRANSPORT
2026-03-30 08:47                                 ..\..\..\transport.f90

    216           AD2X(K,I) =  SF4X(K,I,1)+(ALFA(K,I)-COUR*SF9X(K,I,1) *0.5D0)/SF6X(K,I,1)
    217           AD3X(K,I) =  SF2X(K,I,1)+(ALFA(K,I)-COUR*SF10X(K,I,1)*0.5D0)/SF7X(K,I,1)
    218         ELSE
    219           RATS(K,I)      =  RATD(I+1)
    220           CURS1(K,I)     =  CURX1(I+1)
    221           CURS2(K,I)     =  CURX2(I+1)
    222           CURS3(K,I)     =  CURX3(I+1)
    223           DX1(K,I)  =  DX(K,I)*SF11X(K,I,2)
    224           DX2(K,I)  =  DX(K,I)*SF12X(K,I,2)
    225           DX3(K,I)  =  DX(K,I)*SF13X(K,I,2)
    226           ALFA(K,I)      =  2.0D0*(DX(K,I)*DLT/(SF1X(K,I)*SF1X(K,I))-(1.0D0-COUR*COUR)*0.1666667D0)*SF3X(K,I,2)    !/6.0
    227           AD1X(K,I) =  SF2X(K,I,2)+(ALFA(K,I)-COUR*SF8X(K,I,2)*0.5D0)/SF5X(K,I,2)
    228           AD2X(K,I) =  SF4X(K,I,2)+(ALFA(K,I)-COUR*SF9X(K,I,2)*0.5D0)/SF6X(K,I,2)
    229           AD3X(K,I) = (ALFA(K,I)-COUR*SF10X(K,I,2)*0.5D0)/SF7X(K,I,2)
    230         END IF
    231       END DO
    232     END DO
    233 !!$OMP END PARALLEL DO
    234   END IF
    235 RETURN
    236 
    237 ENTRY HORIZONTAL_MULTIPLIERS
    238 
    239 ! Horizontal advection and diffusion multipliers
    240 
    241   IF (UPWIND(JW)) THEN
    242     DO I=IU,ID-1
    243       DO K=KT,KB(I)
    244         IF (U(K,I) >= 0.0) THEN
    245           C2X      =  COLD(K,I)
    246           C3X      =  COLD(K,I+1)
    247           ADX(K,I) = (DX2(K,I)-U(K,I))*C2X+DX3(K,I)*C3X
    248         ELSE
    249           C1X      =  COLD(K,I)
    250           C2X      =  COLD(K,I+1)
    251           ADX(K,I) =  DX1(K,I)*C1X+(DX2(K,I)-U(K,I))*C2X
    252         END IF
    253       END DO
    254     END DO
    255   ELSE
    256 !!$OMP PARALLEL DO Private(K,COUR,C1X,C2X,C3X,CART,CALF,RATDI,DELC,ADELC,ACURZ,FLUX,FTEMP,CREF,CMAX1,CMIN1,DLTDLXR,IU,ID)
    257     DO I=IU,ID-1
    258     DLTDLXR=DLT/DLXR(I)
    259       DO K=KT,KB(I)
    260       COUR = U(K,I)*DLTDLXR
    261         IF (U(K,I) >= 0.0) THEN
    262           C1X = COLD(K,I-1)
    263           C2X = COLD(K,I)
    264           C3X = COLD(K,I+1)
    265           IF (U(K,I-1) <= 0.0 .OR. K > KB(I-1) .OR. INTERNAL_WEIR(K,I-1)) C1X = COLD(K,I)
    266           IF (INTERNAL_WEIR(K,I)) C3X = COLD(K,I)
    267           CART      =  C3X
    268           CALF      =  C1X
    269         ELSE
    270           C1X = COLD(K,I)
    271           C2X = COLD(K,I+1)
    272           C3X = COLD(K,I+2)

Page 6           Source Listing                  TRANSPORT
2026-03-30 08:47                                 ..\..\..\transport.f90

    273           IF (U(K,I+2) >= 0.0 .OR. K > KB(I+2) .OR. I == ID-1 .OR. INTERNAL_WEIR(K,I+1)) C3X = COLD(K,I+1)
    274           IF (INTERNAL_WEIR(K,I)) THEN
    275             C2X = COLD(K,I)
    276             C3X = COLD(K,I)
    277           END IF
    278           CART      =  C1X
    279           CALF      =  C3X
    280         END IF
    281         if( .not. ultimate(jw))then
    282         ADX(K,I) = (DX1(K,I)-U(K,I)*AD1X(K,I))*C1X+(DX2(K,I)-U(K,I)*AD2X(K,I))*C2X+(DX3(K,I)-U(K,I)*AD3X(K,I))*C3X
    283 !  IF (ULTIMATE(JW)) THEN    ! SW Code speedup 6/16/13
    284         else
    285           RATDI = 1.0/RATS(K,I)
    286           DELC  = RATS(K,I)*C3X+(RATDI-RATS(K,I))*C2X-RATDI*C1X
    287           DELC  = DSIGN(1.0,U(K,I))*DELC
    288           ADELC = DABS(DELC)
    289           ACURZ = DABS(CURS3(K,I)*C3X+CURS2(K,I)*C2X+CURS1(K,I)*C1X)
    290           IF (ACURZ <= 0.6*ADELC) THEN
    291             FLUX = AD1X(K,I)*C1X+AD2X(K,I)*C2X+AD3X(K,I)*C3X
    292           ELSE IF (ACURZ >= ADELC) THEN
    293             FLUX = C2X
    294           ELSE IF (ABS(COUR) > 0.0) THEN
    295             FTEMP = AD1X(K,I)*C1X+AD2X(K,I)*C2X+AD3X(K,I)*C3X
    296             CREF  = CALF+(C2X-CALF)/ABS(COUR)
    297             IF (DELC > 0.0) THEN
    298               CMAX1 = DMIN1(CREF,CART)
    299               IF (CREF < C2X) CMAX1 = CART
    300               FLUX = 0.5D0*(C2X+CMAX1)
    301               IF (FTEMP <= CMAX1 .AND. FTEMP >= C2X) FLUX = FTEMP
    302             ELSE
    303               CMIN1 = DMAX1(CREF,CART)
    304               IF (CREF > C2X) CMIN1 = CART
    305               IF (FTEMP >= CMIN1 .AND. FTEMP <= C2X) THEN
    306                 FLUX = FTEMP
    307               ELSE IF (FTEMP > 0.0) THEN
    308                 FLUX = 0.5D0*(C2X+CMIN1)
    309               ELSE
    310                 FLUX = 0.0D0
    311               END IF
    312             END IF
    313           ELSE
    314             FLUX = 0.0D0
    315           END IF
    316           ADX(K,I) = (DX1(K,I)*C1X+DX2(K,I)*C2X+DX3(K,I)*C3X)-U(K,I)*FLUX
    317         END IF
    318       END DO
    319     END DO
    320 !!$OMP END PARALLEL DO
    321   END IF
    322 RETURN
    323 
