   2409     SUBROUTINE HISTOGRAM_OUTPUT
   2410         USE Fishy; USE ENVIRPMOD, only: CONE
   2411         integer :: N,I
   2412         real :: TEMP_C,VEL_C,D_C
   2413         
   2414         if(HIST_T)then
   2415           DO N=1,NFISH
   2416           if(t_cnt(N).gt.0.0)then
   2417           t_avg(N)=t_tot(N)/t_cnt(N)
   2418           else
   2419           t_avg(N)=0.0
   2420           end if
   2421           ENDDO
   2422 
   2423         open(CONE,file='envrprf_t_particle.csv',status='unknown')
   2424         write(CONE,*)'Temperature interval,Fraction of time,Number of Particles:',nfish,','
   2425         write(CONE,'("Interval,",<NFISH>("Particle",i4,","))')(I,I=1,NFISH)   !"Interval,",<NFISH>("Particle",i4,",")
   2426         temp_c=temp_top
   2427           do i=1,numclass
   2428           write(CONE,125)temp_c,(t_class(N,i)/sumvolt(N),N=1,NFISH)
   2429           temp_c=temp_c-temp_int
   2430           DO N=1,NFISH
   2431           t_sum(N)=t_sum(N)+t_class(N,i)/sumvolt(N)
   2432           ENDDO
   2433           end do
