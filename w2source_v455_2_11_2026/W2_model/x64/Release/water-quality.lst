   2901      ALKT = ALK(K,I)/50044. ! SR 01/01/12
   2902      AMMT = NH4(K,I)/14006.74 ! SR 01/01/12
   2903      PHOST = PO4(K,I)/30973.762 ! SR 01/01/12
   2904      OMCT = (LDOM(K,I)+RDOM(K,I))*ORGC(JW)/12011. ! moles carbon per liter from DOM ! SR 01/01/12
   2905      IF (POM_BUFFERING) OMCT = OMCT + (LPOM(K,I)+RPOM(K,I))*ORGC(JW)/12011. ! SR 01/01/12
   2906 !**** Ionic strength
   2907      IF (FRESH_WATER(JW)) S2 = 2.5E-05*TDS(K,I)
   2908      IF (SALT_WATER(JW)) S2 = 1.47E-3+1.9885E-2*TDS(K,I)+3.8E-5*TDS(K,I)*TDS(K,I)
   2909 !**** Debye-Huckel terms and activity coefficients
   2910      SQRS2 = SQRT(S2)
   2911      DH1 = -0.5085*SQRS2/(1.0+1.3124*SQRS2)+4.745694E-03+4.160762E-02*S2-9.284843E-03*S2*S2
   2912      DH2 = -2.0340*SQRS2/(1.0+1.4765*SQRS2)+1.205665E-02+9.715745E-02*S2-2.067746E-02*S2*S2
   2913      DH3 = -4.5765*SQRS2/(1.0+1.3124*SQRS2) ! extended Debye-Huckel for PO4 ! SR 01/01/12
   2914      DHH = -0.5085*SQRS2/(1.0+2.9529*SQRS2) ! extended Debye-Huckel for H+ ion ! SR 01/01/12
   2915      H2CO3T = 10.0**(0.0755*S2)
   2916      HCO3T = 10.0**DH1
   2917      CO3T = 10.0**DH2
   2918      PO4T = 10.0**DH3 ! SR 01/01/12
   2919      HT = 10.0**DHH ! activity coefficient for H+ ! SR 01/01/12
   2920      HPO4T = CO3T ! tabled values similar to those for carbonate ! SR 01/01/12
   2921      OHT = HCO3T ! tabled values similar to those for bicarbonate ! SR 01/01/12
   2922      H2PO4T = HCO3T ! tabled values similar to those for bicarbonate ! SR 01/01/12
   2923      NH4T = HCO3T ! tabled values similar to those for bicarbonate ! SR 01/01/12
   2924      NH3T = H2CO3T ! neutral species, set coefficient to same as that for carbonic acid ! SR 01/01/12
   2925      H3PO4T = H2CO3T ! neutral species, set coefficient to same as that for carbonic acid ! SR 01/01/12
   2926 !**** Temperature adjustment
   2927      KW = 10.0**(-283.971 -0.05069842*T1K +13323.0/T1K +102.24447*LOG10(T1K) -1119669.0/(T1K*T1K))/OHT
   2928      K1 = 10.0**(-356.3094 -0.06091964*T1K +21834.37/T1K +126.8339 *LOG10(T1K) -1684915 /(T1K*T1K))*H2CO3T/HCO3T
   2929      K2 = 10.0**(-107.8871 -0.03252849*T1K + 5151.79/T1K + 38.92561*LOG10(T1K) - 563713.9/(T1K*T1K))*HCO3T/CO3T
   2930      KAMM = 10.0**(-0.09018 -2729.92/T1K)*NH4T/NH3T ! SR 01/01/12
   2931      KP1 = 10.0**(4.5535 -0.013486*T1K -799.31/T1K)*H3PO4T/H2PO4T ! Bates (1951) ! SR 01/21/12
   2932      KP2 = 10.0**(5.3541 -0.019840*T1K -1979.5/T1K)*H2PO4T/HPO4T ! Bates and Acree (1943) ! SR 01/21/12
   2933      KP3 = 10.0**(-12.38) *HPO4T/PO4T ! Dean (1985) ! SR 01/01/12
   2934 !**** pH evaluation

