     47 SUBROUTINE CALCULATE_AZ0
     48   USE AZ_LOCAL
     49   IMPLICIT NONE
     50   SAVE
     51 
     52   IF (K == KT) THEN
     53     DEPTHL = (ELWS(I)-EL(KB(I),I)    +H2(KB(I),I)  *COSA(JB))/COSA(JB)      !(EL(KT,I)  -Z(I)  *COSA(JB)-EL(KB(I),I)    +H2(
     53 KB(I),I)  *COSA(JB))/COSA(JB)
     54     DEPTHR = (ELWS(I+1)-EL(KB(I+1),I+1)+H2(KB(I+1),I)*COSA(JB))/COSA(JB)    !(EL(KT,I+1)-Z(I+1)*COSA(JB)-EL(KB(I+1),I+1)+H2(
     54 KB(I+1),I)*COSA(JB))/COSA(JB)
     55     ZDLR   =  DEPTHL-H2(KT,I)+DEPTHR-H2(KT,I+1)
     56     IF (AZC(JW) == '     RNG' .OR. AZC(JW) == '   PARAB') THEN
     57       DEPTH = (DEPTHR+DEPTHL)*0.5
     58       USTAR =  SQRT(G*DEPTH*SLOPEC(JB))
     59       IF (SLOPEC(JB) == 0.0) THEN
     60         USTAR = 0.0
     61         DO KL=KT,KBMIN(I)
     62           USTAR = USTAR+SQRT(AZ(KL-1,I)*SQRT(VSH(KL-1,I))/RHO(KL,I))
     63         END DO
     64         USTAR = USTAR/(KBMIN(I)-KT+1)
     65       END IF
     66     END IF
     67   ELSE
     68     ZDLR = (EL(K-1,I)-EL(KB(I),I)+H2(KB(I),I)*COSA(JB))/COSA(JB)+(EL(K-1,I+1)-EL(KB(I),I+1)+H2(KB(I+1),I)*COSA(JB))/COSA(JB)
     69   END IF
     70   ZD = ZDLR/(DEPTHL+DEPTHR)
     71   IF (AZC(JW) == '    NICK') THEN
     72     SLM = ((DEPTHR+DEPTHL)*0.5*(0.14-0.08*(1.0-ZD)**2-0.06*(1.0-ZD)**4))**2         ! SR 7/2024
     73     AZ0 =  MAX(AZMIN,SLM*SQRT(VSH(K,I)))
     74   ELSE IF (AZC(JW) == '     RNG') THEN
     75     VISCK = DEXP((T2(K,I)+495.691)/(-37.3877))
     76     IF (T2(K,I) > 30.0)  VISCK = DEXP((T2(K,I)+782.190)/(-57.7600))
     77     VISCF = MAX(0.0,0.08477*((ZDLR*0.5*USTAR/VISCK)**3)*((1.0-ZDLR*0.5/DEPTH)**3)-100.0)
     78     VISCF = (1.0+VISCF)**0.33333333333333
     79     AZ0   = MAX(AZMIN,VISCK*VISCF)
     80   ELSE IF (AZC(JW) == '   PARAB') THEN
     81     AZ0 = MAX(AZMIN,0.41*USTAR*ZDLR*0.5*(1.0-ZD))
     82   ELSE
     83     SLM = HMAX2
     84     IF (AZC(JW) == '     W2N') SLM = ((DEPTHR+DEPTHL)*0.5*(0.14-0.08*(1.0-ZD)**2-0.06*(1.0-ZD)**4))**2
     85     AZ0 = 0.4*SLM*SQRT(VSH(K,I)+((FRICBR(K,I)+WSHY(I)*DECAY(K,I))/(AZ(K,I)+NONZERO))**2)+AZMIN
     86   END IF
     87 RETURN
     88 END SUBROUTINE CALCULATE_AZ0

