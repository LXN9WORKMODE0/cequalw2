   1237             BHR1(KT,IU-1) =  BH1(KT,IU-1)+(BH1(KT,IU)-BH1(KT,IU-1))/(0.5*(DLX(I)+DLX(I+1)))*0.5*DLX(I)                 !SW 0
   1237 7/29/04
   1238                             IF(CONSTRICTION(KT,IU-1))THEN    ! SW 6/26/2018 Valid for all K
   1239                                         IF(BHR1(KT,IU-1) > BCONSTRICTION(IU-1)*H1(KT,IU-1))BHR1(KT,IU-1)= BCONSTRICTION(IU-1
   1239 )*H1(KT,IU-1)
   1240                              ENDIF
   1241             IF (UH_EXTERNAL(JB)) KB(IU-1) = KB(IU)
   1242             IF (UH_INTERNAL(JB)) THEN
   1243               IF (JBUH(JB) >= BS(JW) .AND. JBUH(JB) <= BE(JW)) THEN
   1244                 KB(IU-1) = MIN(KB(UHS(JB)),KB(IU))
   1245               ELSE
   1246                 DO KKB = KT, KMX
   1247                   IF (EL(KKB,IU) <= EL(KB(UHS(JB)),UHS(JB))) EXIT
   1248                 END DO
   1249                 KB(IU-1) = MIN(KKB,KB(IU))

Page 26          Source Listing                  LAYERADDSUB
2026-03-30 08:47                                 ..\..\..\layeraddsub.F90

   1250               END IF
   1251             END IF
   1252           END IF
   1253           IF (CONSTITUENTS) THEN      ! SW 5/15/06
   1254             CALL TEMPERATURE_RATES
   1255             CALL KINETIC_RATES
   1256           END IF
   1257 
   1258 
   1259 !******** Total active cells
   1260 
   1261           DO I=IU,ID
   1262             NTAC = NTAC-1
   1263           END DO
   1264           NTACMN = MIN(NTAC,NTACMN)
   1265         END DO
   1266         
   1267         CALL INTERPOLATION_MULTIPLIERS   
   1268         
   1269 !****** Additional layer subtractions
   1270 
   1271         ZMIN(JW) = -1000.0
   1272         DO JB=BS(JW),BE(JW)
   1273         IF(BR_INACTIVE(JB))CYCLE    ! SW 6/12/2017
   1274           DO I=CUS(JB),DS(JB)
   1275             ZMIN(JW) = MAX(ZMIN(JW),Z(I))
   1276           END DO
   1277         END DO
   1278         SUB_LAYER = ZMIN(JW) > 0.60*H(KT,JW) .AND. KT < KTMAX                                                         ! SR 1
   1278 0/17/05
   1279       END DO
   1280     END DO
   1281 
   1282 !** Temporary downstream head segment
   1283 
   1284     DO JB=1,NBR
   1285     IF(BR_INACTIVE(JB))CYCLE    ! SW 6/12/2017
   1286       IF (DHS(JB) > 0) THEN
   1287 !DO JJB=1,NBR
   1288 !  IF (DHS(JB) >= US(JJB) .AND. DHS(JB) <= DS(JJB)) EXIT
   1289 !END DO
   1290 !IF (CUS(JJB) > DHS(JB)) CDHS(JB) = CUS(JJB)
   1291         CDHS(JB) = MAX(DHS(JB),CUS(JBDH(JB)))                  ! SR 1/2024
   1292       END IF
   1293     END DO
   1294 RETURN
   1295 END SUBROUTINE LAYERADDSUB

