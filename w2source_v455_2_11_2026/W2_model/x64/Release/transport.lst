    328 ENTRY VERTICAL_MULTIPLIERS1    ! FIRST PASS
    329 
    330 ! Vertical advection multipliers
    331 
    332   IF (.NOT.UPWIND(JW)) THEN
    333 !!$OMP PARALLEL DO
    334     DO I=IU,ID
    335       DO K=KT,KB(I)-1
    336         IF (W(K,I) >= 0.0) THEN
    337           RATSZ(K,I)  = RATZ(K,JW)
    338           CURS1Z(K,I) = CURZ1(K,JW)
    339           CURS2Z(K,I) = CURZ2(K,JW)
    340           CURS3Z(K,I) = CURZ3(K,JW)
    341           IF (K <= KT+1) THEN
    342             HT    =  H1(KT,I)
    343             HM    =  H1(K,I)
    344             HB    =  H1(K+1,I)
    345             RATSZ(K,I)  =  AVH1(KT,I)/AVH1(K,I)
    346 !CURS1Z(K,I) =  2.0D0*HM*HM/(AVH1(KT,I)+AVH1(K,I))/AVH1(KT,I)
    347             CURS1Z(K,I) =  2.0D0*HM*HM/((AVH1(KT,I)+AVH1(K,I))*AVH1(KT,I))      ! SW 4/20/16 SPEED
    348             CURS2Z(K,I) = -2.0D0*HM*HM/(AVH1(KT,I)*AVH1(K,I))
    349 !CURS3Z(K,I) =  2.0D0*HM*HM/(AVH1(KT,I)+AVH1(K,I))/AVH1(K,I)
    350             CURS3Z(K,I) =  2.0D0*HM*HM/((AVH1(KT,I)+AVH1(K,I))*AVH1(K,I))       ! SW 4/20/16 SPEED
    351             IF (K == KT) THEN
    352               HM    =  H1(KT,I)
    353               RATSZ(K,I)  =  1.0D0
    354               CURS3Z(K,I) =  1.0D0
    355               CURS2Z(K,I) = -2.0D0
    356               CURS1Z(K,I) =  1.0D0
    357             END IF
    358             HMIN          =  DMIN1(HB,HM)
    359             SF1Z(K,JW)    = (HB+HM)*0.5D0
    360 !SF2Z(K,1,JW)  =  HM**2
    361             SF2Z(K,1,JW)  =  HM*HM        ! SW 4/20/16
    362             SF3Z(K,1,JW)  =  HM/(HM+HB)
    363             SF4Z(K,1,JW)  =  HB/(HM+HB)
    364             SF5Z(K,1,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HT+HM)
    365             SF6Z(K,1,JW)  = -0.25D0*(HM+HB)*(HT+HM)
    366             SF7Z(K,1,JW)  =  0.25D0*(HM+HB)*(HT+2.0D0*HM+HB)
    367             SF8Z(K,1,JW)  =  0.5D0*(HM-HB)*HMIN
    368             SF9Z(K,1,JW)  =  0.5D0*(HT+2.0D0*HM-HB)*HMIN
    369             SF10Z(K,1,JW) =  0.5D0*(HT+3.0D0*HM)*HMIN
    370           END IF
    371           COUR      =  W(K,I)*DLT/SF1Z(K,JW)
    372           ALFAZ(K,I) =  2.0D0*(DZQ(K,I)*DLT/(SF1Z(K,JW)*SF1Z(K,JW))-(1.0D0-COUR*COUR)*0.16666667D0)*SF2Z(K,1,JW)     !/6.0
    373           AD1Z(K,I) = (ALFAZ(K,I)-COUR*SF8Z(K,1,JW)*0.5D0)/SF5Z(K,1,JW)
    374           AD2Z(K,I) =  SF4Z(K,1,JW)+(ALFAZ(K,I)-COUR*SF9Z(K,1,JW) *0.5D0)/SF6Z(K,1,JW)
    375           AD3Z(K,I) =  SF3Z(K,1,JW)+(ALFAZ(K,I)-COUR*SF10Z(K,1,JW)*0.5D0)/SF7Z(K,1,JW)
    376         ELSE
    377           CURS3Z(K,I) = CURZ3(K+1,JW)
    378           CURS2Z(K,I) = CURZ2(K+1,JW)
    379           CURS1Z(K,I) = CURZ1(K+1,JW)
    380           RATSZ(K,I)  = AVH1(K,I)/AVH1(K+1,I)
    381           IF (K == KT) THEN
    382             HT            =  H1(KT,I)
    383             HM            =  H1(KT+1,I)

Page 8           Source Listing                  TRANSPORT
2026-03-30 08:47                                 ..\..\..\transport.f90

    384             HB            =  H1(KT+2,I)
    385             HMIN          =  DMIN1(HT,HM)
    386             RATSZ(K,I)          =  AVH1(KT,I)/AVH1(K,I)
    387 !CURS1Z(K,I)         =  2.0D0*HM*HM/(AVH1(KT,I)+AVH1(K,I))/AVH1(KT,I)        ! SW 4/20/16 SPEED
    388             CURS1Z(K,I)         =  2.0D0*HM*HM/((AVH1(KT,I)+AVH1(K,I))*AVH1(KT,I))       
    389             CURS2Z(K,I)         = -2.0D0*HM*HM/(AVH1(KT,I)*AVH1(K,I))
    390 !CURS3Z(K,I)         =  2.0D0*HM*HM/(AVH1(KT,I)+AVH1(K,I))/AVH1(K,I)          ! SW 4/20/16 SPEED
    391             CURS3Z(K,I)         =  2.0D0*HM*HM/((AVH1(KT,I)+AVH1(K,I))*AVH1(K,I))   
    392             SF1Z(K,JW)    = (HM+HT)*0.5D0
    393 !SF2Z(K,2,JW)  =  HM**2
    394             SF2Z(K,2,JW)  =  HM*HM      ! SW 4/20/16
    395             SF3Z(K,2,JW)  =  HM/(HT+HM)
    396             SF4Z(K,2,JW)  =  HT/(HT+HM)
    397             SF5Z(K,2,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HT+HM)
    398             SF6Z(K,2,JW)  = -0.25D0*(HM+HB)*(HT+HM)
    399             SF7Z(K,2,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HM+HB)
    400             SF8Z(K,2,JW)  = -0.5D0*(3.0D0*HM+HB)*HMIN
    401             SF9Z(K,2,JW)  =  0.5D0*(HT-2.0D0*HM-HB)*HMIN
    402             SF10Z(K,2,JW) =  0.5D0*(HT-HM)*HMIN
    403           END IF
    404           COUR      =  W(K,I)*DLT/SF1Z(K,JW)
    405           ALFAZ(K,I) =  2.0D0*(DZQ(K,I)*DLT/(SF1Z(K,JW)*SF1Z(K,JW))-(1.0D0-COUR*COUR)*0.16666667D0)*SF2Z(K,2,JW)    !/6.0
    406           AD1Z(K,I) =  SF3Z(K,2,JW)+(ALFAZ(K,I)-COUR*SF8Z(K,2,JW)*0.5D0)/SF5Z(K,2,JW)
    407           AD2Z(K,I) =  SF4Z(K,2,JW)+(ALFAZ(K,I)-COUR*SF9Z(K,2,JW)*0.5D0)/SF6Z(K,2,JW)
    408           AD3Z(K,I) = (ALFAZ(K,I)-COUR*SF10Z(K,2,JW)*0.5D0)/SF7Z(K,2,JW)
    409         END IF
    410       END DO
    411     END DO
    412 !$END PARALLEL DO
    413   END IF
    414 RETURN
    415 
    416 ENTRY VERTICAL_MULTIPLIERS
    417 
    418 ! Vertical advection multipliers
    419 
    420   IF (UPWIND(JW)) THEN
    421     DO I=IU,ID
    422       DO K=KT,KB(I)-1
    423         C2Z = COLD(K+1,I)
    424         IF (W(K,I) >= 0.0) C2Z = COLD(K,I)
    425         ADZ(K,I) = -W(K,I)*C2Z
    426       END DO
    427     END DO
    428   ELSE
    429 !!$OMP PARALLEL DO
    430     DO I=IU,ID
    431       DO K=KT,KB(I)-1
    432         IF (W(K,I) >= 0.0) THEN
    433           C1Z   = COLD(K-1,I)
    434           C2Z   = COLD(K,I)
    435           C3Z   = COLD(K+1,I)
    436           CART  = C3Z
    437           CALF  = C1Z
    438           IF (K <= KT+1) THEN
    439             C1Z   =  COLD(KT,I)
    440             CALF  =  C1Z

Page 9           Source Listing                  TRANSPORT
2026-03-30 08:47                                 ..\..\..\transport.f90

    441           END IF
    442         ELSE
    443           C1Z = COLD(K,I)
    444           C2Z = COLD(K+1,I)
    445           C3Z = COLD(K+2,I)
    446           IF (K == KB(I)-1) C3Z = COLD(K+1,I)
    447           CART  = C1Z
    448           CALF  = C3Z
    449         END IF
    450         if(.not.ultimate(jw))then
    451         ADZ(K,I) = -W(K,I)*(AD1Z(K,I)*C1Z+AD2Z(K,I)*C2Z+AD3Z(K,I)*C3Z)
    452         else
    453 !    IF (ULTIMATE(JW)) THEN    ! SW code speedup 6/16/13
    454           COUR  =  W(K,I)*DLT/SF1Z(K,JW)
    455           RATZI = 1.0D0/RATSZ(K,I)
    456           DELC  = RATSZ(K,I)*C3Z+(RATZI-RATSZ(K,I))*C2Z-RATZI*C1Z
    457           DELC  = DSIGN(1.0,W(K,I))*DELC
    458           ADELC = DABS(DELC)
    459           ACURZ = DABS(CURS3Z(K,I)*C3Z+CURS2Z(K,I)*C2Z+CURS1Z(K,I)*C1Z)
    460           IF (ACURZ <= 0.6*ADELC) THEN
    461             FLUX = AD1Z(K,I)*C1Z+AD2Z(K,I)*C2Z+AD3Z(K,I)*C3Z
    462           ELSE IF (ACURZ >= ADELC) THEN
    463             FLUX = C2Z
    464           ELSE IF (DABS(COUR) > 0.0) THEN
    465             FTEMP = AD1Z(K,I)*C1Z+AD2Z(K,I)*C2Z+AD3Z(K,I)*C3Z
    466             CREF  = CALF+(C2Z-CALF)/DABS(COUR)
    467             IF (DELC > 0.0) THEN
    468               CMAX1 = CART
    469               IF (CREF >= C2Z) CMAX1 = DMIN1(CREF,CART)
    470               FLUX = 0.5*(C2Z+CMAX1)
    471               IF (FTEMP <= CMAX1 .AND. FTEMP >= C2Z) FLUX = FTEMP
    472             ELSE
    473               CMIN1 = DMAX1(CREF,CART)
    474               IF (CREF > C2Z) CMIN1 = CART
    475               IF (FTEMP >= CMIN1 .AND. FTEMP <= C2Z) THEN
    476                 FLUX = FTEMP
    477               ELSE IF (FTEMP > 0.0) THEN
    478                 FLUX = 0.5D0*(C2Z+CMIN1)
    479               ELSE
    480                 FLUX = 0.0D0
    481               END IF
    482             END IF
    483           ELSE
    484             FLUX = 0.0D0
    485           END IF
    486           ADZ(K,I) = -W(K,I)*FLUX
    487         END IF
    488       END DO
    489     END DO
    490 !$END PARALLEL DO
    491   END IF
    492 RETURN
    493 
