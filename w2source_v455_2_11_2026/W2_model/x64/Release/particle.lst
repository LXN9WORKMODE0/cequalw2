2026-03-30 08:48                                 ..\..\..\particle.f90

   1444           DO JB=BS(WB),BE(WB)
   1445 ! K = Layer #
   1446               DO K=2,KMX
   1447 ! I = Segment #  SW 5/2015
   1448                DO I=US(JB),DS(JB)+1
   1449               IF ((K-1.LE.KBI(I)).OR.(K-1.LE.KBI(I-1))) THEN         ! All Nodes at or above Water Body Bottom     ((K-1.LE.
   1449 KB(I)).OR.(K-1.LE.KB(I-1)))
   1450                 NN = NN + 1                                        ! PRE-CHECK CALCULATION
   1451                 KK = NDINFO(NN,3)                                  ! PRE-CHECK CALCULATION
   1452                 II = NDINFO(NN,4)                                  ! PRE-CHECK CALCULATION
   1453                 IF ((I.NE.II).OR.(K.NE.KK)) THEN 
   1454                  IF (DEBUG)THEN      ! CHECK
   1455                   WRITE(DATADEBUGFN,*) 'ERROR: Nodes not matching up for Flowfield Interpolation'
   1456                   write(DATADEBUGFN,*)'WB=',wb,' JB=', JB
   1457                   write(DATADEBUGFN,*)'NN=',nn,' kk=',kk,' ii=',ii,' k=',k,' i=',i
   1458                 ENDIF
   1459 !STOP
   1460 !ELSE
   1461                 END IF
   1462 
   1463 !LINEAR INTERPOLATION of the Flow Field (i.e. Velocities)
   1464                 IF (LINEAR) THEN              ! LINEAR INTERPOLATION
   1465                   IF (K.LT.KTWB(WB)) THEN                           !Above Water Surface
   1466                     IF(K < KTI(I))THEN   ! SW 12/12/2018
   1467                     FLOWFIELD(K,I,1) = U(KTWB(WB),I-1)         ! SW 12/26/2018 was =0 before      !   Horiz. Vel.   IN AIR s
   1467 hould still be in the upper layer - nothing goes up into the air - corrected soon by BC
   1468                     FLOWFIELD(K,I,2) = 0.0                         !   Vert.  Vel.
   1469                     ELSE 
   1470                     FLOWFIELD(K,I,1) = U(KTWB(WB),I-1)             !   Horiz. Vel.  NOT IN AIR  SW 12/12/2018
   1471                     FLOWFIELD(K,I,2) = 0.0                         !   Vert.  Vel.
   1472                     ENDIF
   1473                   ELSE IF (K.EQ.KTWB(WB)) THEN                      !At Water Surface
   1474                     FLOWFIELD(K,I,1) = U(K,I-1)                    !   Horiz. Vel.
   1475                     FLOWFIELD(K,I,2) = 0.0                         !   Vert.  Vel.
   1476                   ELSE IF (K.EQ.KBI(I)+1) THEN                      !Water Body Bottom    (K.EQ.KB(I)+1)
   1477                     IF(KB(I) /= KBI(I))THEN
   1478                         FLOWFIELD(K,I,1) = U(KTWB(WB),I-1)    ! IN CASE WATER LEVELS ARE LOWERED IN A RIVER BELOW KB SW 8/20
   1478 /2018
   1479                         FLOWFIELD(K,I,2) = 0.0
   1480                     ELSE
   1481                         FLOWFIELD(K,I,1) = U(K-1,I-1)
   1482                         FLOWFIELD(K,I,2) = 0.0
   1483                     ENDIF
   1484                     
   1485                   ELSE IF (I.EQ.US(JB)) THEN                     !Upstream-most Nodes
   1486                     YRANGE = .5*H(K-1,WB)+.5*H(K,WB)
   1487                     FLOWFIELD(K,I,1) = (U(K-1,I-1)*(YRANGE-&
   1488                       .5*H(K-1,WB)) + U(K,I-1)*(YRANGE-.5*H(K,WB)))&
   1489                       /YRANGE
   1490                     FLOWFIELD(K,I,2) = W(K-1,I)
   1491                   ELSE IF (I.EQ.DS(JB)+1) THEN                   !Downstream-most Nodes
   1492                     YRANGE = .5*H(K-1,WB)+.5*H(K,WB)
   1493                     FLOWFIELD(K,I,1) = (U(K-1,I-1)*(YRANGE-&
   1494                       .5*H(K-1,WB)) + U(K,I-1)*(YRANGE-.5*H(K,WB)))&
   1495                       /YRANGE
   1496                     FLOWFIELD(K,I,2) = W(K-1,I-1)
   1497                   ELSE                                             !Analogous to Node 5 above (i.e., in the middle)

