      1 # 1 "..\..\..\systdg.f90"
      2 ! System Total Dissolved Gas (SYSTDG)
      3 ! Spillbay TDG production is calculated based on the regression equations included in SYSTDG
      4 ! SYSTDG equations were provided by Tammy Threadgill and Ron Thompson.
      5 ! Sponsored by USACE Portland District through the CRSO EIS
      6 !
      7 ! Three new ON/OFF controls are included in this version's control file
      8 ! 1) SYSTDG      - calculate Spillway TDG production (1 - 5 equations) and mixing downstream TDG
      9 ! 2) N2BDN/DOBND - specify saturation (%) for all inflow N2 and DO boundary conditions
     10 ! 3) TDGTA       - specify downstream or spillflow TDG target to reallocate spillflow into powerhouse to meet TDG targets
     11 !
     12 ! If SYSTDG = ON, a SYSTDG control input file (w2_systdg.npt) is required.
     13 ! If TDGTA  = ON, a TDG target control input file (w2_tdgtarget.npt) is required.
     14 !
     15 ! Developed from PSU W2V4.1 dated Sept 2, 2018
     16 ! Drs Zhonglong Zhang (PSU) and Hongda Wang (UCD); Revised by SWells Sept 2019 for inclusion in updated 4.2 code; August 202
     16 0 csv file format added SW
     17 !
     18 !
     19 MODULE modSYSTDG
     20  USE PREC,  ONLY: R8
     21  USE TDGAS; USE STRUCTURES; USE GLOBAL; USE MAIN, ONLY: EA, GTTYP, GTPC, Q, WBSEG, TEXT, ERROR_OPEN, SYSTDGC, N2BNDC, DOBNDC
     21 , TDGTAC,TMSTRT, CONTDG, TDG2BNDC
     22  USE TVDC, ONLY: TAIR, TDEW; USE KINETIC, ONLY: TDG
     23   IMPLICIT NONE
     24   REAL(R8), ALLOCATABLE, DIMENSION(:) :: TDG_PHS, TDG_FLS, TDG_TDP 
     25   REAL(R8), ALLOCATABLE, DIMENSION(:) :: BAYC, QBAY
     26   REAL(R8)                            :: qs, TDG_ROSP, TDG_TDG, TDG_REL
     27   REAL(R8)                            :: TDGP1, TDGP2, TDGP3, TDGP4, TDGP12, TDGP22, TDGP32, TDGP42, TDGE1, TDGE2, TDGE12, T
     27 DGE22, ROP1, ROP2, ROP3, ROP4
     28   REAL(R8)                            :: TWE, TWCE, TWE_TS, FBE, QSPILL, TDGSPMN
     29   INTEGER, ALLOCATABLE, DIMENSION(:)  :: POWGTNO, FLGTNO
     30   INTEGER                             :: POWNO, FLNO, BEGNO, ENDNO, NRO, NBAY
     31   INTEGER                             :: TWEMOD, TDGEQ, TDGROEQ, TDGENTEQ
     32   INTEGER                             :: ig, ip, ifl, ib
     33   LOGICAL,  ALLOCATABLE, DIMENSION(:) :: GTNAME
     34   CHARACTER(72)                       :: TITLESYSTDG(10)
     35   CHARACTER(8)                        :: TWETSC, TDGLOC
     36   CHARACTER(72)                       :: TWEFN 
     37   REAL                                :: NXTSPLIT3
     38 !
     39   CONTAINS
     40 !===========================================================================================================================
     41   SUBROUTINE INPUT_SYSTDG
     42 !USE MAIN, ONLY: TMSTRT, CONTDG       !, GTTYP, GTPC, SYSTDGC, N2BNDC, DOBNDC, TDGTAC
     43    IMPLICIT NONE
     44    CHARACTER(8) :: AID1
     45    LOGICAL      :: CSVFORMAT
     46    INTEGER      :: I, IG, N_POW, N_FLD, N_SPB
     47       NXTSPLIT3=TMSTRT
     48       open  (88888, FILE='TDG_output.csv', status='unknown')
     49       WRITE (88888, '(A, <NGT>("QGT-",I2,","))')'JDAY,TDG_TDG,SUM_QGT2,',(IG, IG = 1, NGT)
     50       NRO=0                                                 
     51       POWNO = 0
     52       FLNO  = 0
     53       NBAY  = 0
     54       

