   1432 
   1433 !     this function computes the flow of a culvert that has a
   1434 !     submerged entrance and whose tailwater height is greater than
   1435 !     its diameter
   1436 
   1437 REAL (R8) function type4(HEAD)    !(HEAD)
   1438       USE STRUCTURES; USE PIPE;USE GLOBAL, ONLY: G, PI
   1439       IMPLICIT NONE      
   1440       REAL(R8) :: HEAD
   1441       bao = pi*dia**2/4.
   1442       ro = bao/(pi*dia)
   1443       fl = (2.*g*dist*fman**2)/(cm**2*ro**(4./3.))
   1444       
   1445 !     type4=ec * bao * sqrt(2*g*(head+fall-hdn)/(1.+closs+fl))
   1446       type4=ec * bao * sqrt(2*g*hdif/(1.+closs+fl))
   1447 
   1448       end


