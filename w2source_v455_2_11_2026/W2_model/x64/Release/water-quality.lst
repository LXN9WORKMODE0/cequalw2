   3015 !CBODPt  = CBODPt+CBODp(K,I,IBOD)              ! cb 6/6/10
   3016 !BODTOT = BODTOT+CBOD(K,I,IBOD)
   3017             IF(BOD_CALC(IBOD))THEN      
   3018               CBODCT  = CBODCT+CBOD(K,I,IBOD)*RBOD(IBOD)*BODC(IBOD)                          
   3019               BODTOT  = BODTOT+CBOD(K,I,IBOD)*RBOD(IBOD)                                             
   3020             ENDIF
