   1610 
   1611 
   1612 Subroutine SelectiveInitUSGS
   1613 
   1614   Use Selective1USGS; USE MAIN
   1615   USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
   1616   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
   1617   IMPLICIT NONE
   1618   
   1619   integer      :: ifile, nj, N, JJ
   1620   REAL         :: DAYTEST
   1621   character(8) :: tsshare, AID1
   1622   CHARACTER(1) :: INFORMAT, CHAR1        
   1623   LOGICAL      :: CSVFORMAT
   1624   INTEGER      :: NoOutlets   !ZZ 4/2023 maximum no of blending outlets
   1625   
   1626   NoOutlets=20
   1627   ifile=1949
   1628   tavg=0.0
   1629   tavgw=0.0
   1630   do jb=1,nbr
   1631     if(nstr(jb) > 0)then
   1632       ifile=ifile+1
   1633       write (segnum,'(i0)') jb
   1634       segnum = adjustl(segnum)
   1635       l      = len_trim(segnum)
   1636 
   1637       IF(RESTART_IN)THEN
   1638         OPEN  (ifile,file='str_br'//segnum(1:l)//'.csv',POSITION='APPEND')
   1639         JDAY1=0.0
   1640         REWIND (IFILE)
   1641         READ   (IFILE,'(//)',END=13)
   1642         DO WHILE (JDAY1 < JDAY)
   1643           READ (IFILE,*,END=13) JDAY1                !'(F10.0)'
   1644         END DO
   1645         BACKSPACE (IFILE)
   1646 13      JDAY1=0.0
   1647       ELSE
   1648         open  (ifile,file='str_br'//segnum(1:l)//'.csv',status='unknown')
   1649         write (ifile,*)'Branch:,',jb,', # of structures:,',nstr(jb),', outlet temperatures'
   1650         write (ifile,'("      JDAY,",<nstr(jb)>(6x,"T(C),"),<nstr(jb)>(3x,"Q(m3/s),"),<nstr(jb)>(4x,"ELEVCL,"))')
   1651       ENDIF
   1652     endif
   1653   end do
   1654 
   1655   if(nwd > 0)then
   1656     ifile=ifile+1
   1657     IF(RESTART_IN)THEN
   1658       OPEN  (ifile,file='wd_out.opt',POSITION='APPEND')
   1659       JDAY1=0.0
   1660       REWIND (IFILE)
   1661       READ   (IFILE,'(/)',END=14)
   1662       DO WHILE (JDAY1 < JDAY)
   1663         READ (IFILE,'(F10.0)',END=14) JDAY1
   1664       END DO
   1665       BACKSPACE (IFILE)
   1666 14    JDAY1=0.0

Page 50          Source Listing                  SELECTIVEINITUSGS
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

   1667     ELSE
   1668       open  (ifile,file='wd_out.opt',status='unknown')
   1669       write (ifile,*)'Withdrawals: # of withdrawals:',nwd,' outlet temperatures'
   1670       write (ifile,'("      JDAY",<nwd>(6x,"T(C)"),<nwd>(3x,"Q(m3/s)"),<nwd>(4x,"ELEVCL"))')
   1671     ENDIF
   1672   end if
   1673 
   1674 !ZZ 4/2023, add a CSV format input
   1675   open (NUNIT,file='w2_selective.npt',status='old')   
   1676   READ (NUNIT,'(A)') AID1 
   1677   IF (INDEX(AID1, "$") == 0) THEN
   1678     CSVFORMAT=.FALSE.
   1679 ! Check for commas -- another sign that it is comma-delimited
   1680     READ (NUNIT,'(A)') CHAR30
   1681     DO J=1,30
   1682       IF (CHAR30(J:J)==',') THEN
   1683         CSVFORMAT=.TRUE.
   1684         EXIT
   1685       END IF
   1686     END DO
   1687     BACKSPACE(NUNIT)     
   1688   ELSE
   1689     CSVFORMAT=.TRUE.
   1690   END IF
   1691   IF (CSVFORMAT) THEN
   1692     READ (NUNIT,*)
   1693     READ (NUNIT,*)
   1694     READ (NUNIT,*) AID1, tfrqtmp
   1695     READ (NUNIT,*)
   1696     READ (NUNIT,*)    
   1697     READ (NUNIT,*) AID1, tempc, numtempc, tcdfreq
   1698     tempc=ADJUSTR(tempc)
   1699   ELSE  
   1700     read (NUNIT,'(//8x,f8.0)') tfrqtmp
   1701   read (NUNIT,'(//8x,a8,i8,f8.0)') tempc, numtempc, tcdfreq
   1702   END IF
   1703 !nxtstr   = tmstrt
   1704 !nxttcd   = tmstrt
   1705 !nxtsplit = tmstrt
   1706         IF(JDAY>TMSTRT)THEN   ! SW 8/10/2023  During restart this allows continuing output
   1707           NXTSTR=JDAY          
   1708           NXTTCD=JDAY   
   1709           NXTSPLIT=JDAY
   1710       ELSE
   1711           NXTSTR=TMSTRT
   1712           NXTTCD=TMSTRT   
   1713           NXTSPLIT=TMSTRT
   1714       ENDIF
   1715 
   1716   allocate (tcnelev(numtempc),tcjb(numtempc),tcjs(numtempc),tcelev(numtempc,100),tctemp(numtempc),tctend(numtempc),tctsrt(nu
   1716 mtempc))
   1717   allocate (ncountc(nst,nbr),tciseg(numtempc),tcklay(numtempc),tcelevcon(numtempc))
   1718   Allocate (tcyearly(numtempc), tcntr(numtempc))
