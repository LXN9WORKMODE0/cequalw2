   1941                  &
   1942                    +CO2R(JW)*SODD(K,I)*DO3(K,I)+TICBOD(K,I)+TICMC(K,I)+TICZR(K,I)  + ticch4               &
   1943                    +sedd1(k,i)*cbiom(jw) + sedd2(k,i)*cbiom(jw)             ! Amaila, cb 6/7/17
   1944 
   1945             ELSE
   1946                 TICSS(K,I) = TICAP(K,I)+TICEP(K,I)+SEDDC(K,I)+ORGC(JW)*(LPOMD(K,I)+RPOMD(K,I)+LDOMD(K,I)+RDOMD(K,I))        
   1946                   &
   1947               +CO2R(JW)*SODD(K,I)*DO3(K,I)+TICBOD(K,I)+TICMC(K,I)+TICZR(K,I) + ticch4      !!8/2020
   1948             ENDIF
   1949       
   1950     END DO
   1951     IF (.NOT. ICE(I)) THEN
   1952 ! IF (REAER(I) == 0.0) CALL GAS_TRANSFER
   1953       CO2EX       = REAER(I)*0.923
   1954       KHCO2=12000.*10**(2385.73/(T2(KT,I)+273.15)-14.0184+0.0152642*(T2(KT,I)+273.15))   ! KH CO2 in mg/l/atm as C    SW 8/1
