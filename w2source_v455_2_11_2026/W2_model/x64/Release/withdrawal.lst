   3615 
   3616 ! checking to see if the monitoring segment tciseg is in the same branch and water body as the withdrawal
   3617           DO JJB=1,NBR
   3618             IF (tciseg(j) >= US(JJB) .AND. tciseg(j) <= DS(JJB)) exit
