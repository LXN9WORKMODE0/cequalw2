    845       SUBROUTINE RANDOM(SEED,RNDX)             ! Random Number Generator Subroutine
    846       IMPLICIT NONE                            !   obtained from "STRUCTURED FORTRAN
    847 !   77 for Engineers and Scientists, 5th
    848       INTEGER   SEED                           !   Edition - Author: Delores M. Etter"
    849       REAL      RNDX                           !   The random # is between 0.0 and 1.0
    850       
    851 
    852       SEED = 2045*SEED + 1
    853       SEED = SEED - (SEED/1048576)*1048576
    854       RNDX = REAL(SEED+1)/1048577.0
    855 
    856       RETURN
    857       END


