   2119 Subroutine Part_transport
   2120 ! Compute passive particle transport including sedimentation
   2121     
   2122     Use Fishy
   2123     Use TRANS
   2124     USE GLOBAL
   2125     Use GEOMC
   2126     IMPLICIT NONE
   2127     
   2128     REAL :: DXMIN=0.0005, DZMIN1=0.0001,DZMAX1=0.5, COSTHETA, SINTHETA, DX1, DX2, DXAVG, RZ, RX, DZ1, DZ2, DZAVG, r1, r2
   2129     REAL :: DISPX, DISPZ, VEL
   2130 ! DXMIN,DZMIN1,DZMAX1 ! SW 2/01/01   in units of m2/s
   2131 
   2132         FXLOC = FXLOC + (FXVEL(5)) * (nfsfreq)*24.*3600.    ! New updated Part X-Location
   2133         FYLOC = FYLOC + (FYVEL) * (nfsfreq)*24.*3600.    ! New updated Part Y-Location
   2134         FZLOC = FZLOC + (FZVEL(5) + SEDVEL(FN)) * (nfsfreq)*24.*3600.    ! New updated Part Z-Location
   2135 
   2136         vel=sqrt(fxvel(5)*fxvel(5)+fzvel(5)*fzvel(5))
   2137 
   2138 ! Compute "Dispersion Processes"
   2139         if(vel.gt.1.0e-09)then
   2140         costheta=fxvel(5)/vel
   2141         sintheta=fzvel(5)/vel
   2142 !        Dispx=alphax*abs(fxvel(5))
   2143 !        Dispz=alphaz*abs(fzvel(5))
   2144 
   2145 ! average to segment centers - should be interpolated though   ! SW 2/01/01
   2146        DX1=DX(fkmp,fimp)
   2147        DX2=DX(fkmp,fimp-1)
   2148        if(dx1.le.0.0)dx1=dxmin
   2149        if(dx2.le.0.0)dx2=dxmin
   2150        DXAVG=0.5*(dx1+dx2)
   2151 
   2152        DZ1=DZ(fkmp,fimp)
   2153        if(fkmp.le.KTWBF)then
   2154        DZ2=DZ(fkmp,fimp)
   2155        else
   2156        DZ2=DZ(fkmp-1,fimp)
   2157        endif
   2158 ! Note during density inversions DZ is set to DZMAX1=1000. This leads to incredible
   2159 ! variations in RZ - constrain to DZ=0.5
   2160        if(dz1.gt.10.)dz1=dzmax1
   2161        if(dz2.gt.10.)dz2=dzmax1
   2162 
   2163        if(dz1.le.0.0)dz1=dzmin1
   2164        if(dz2.le.0.0)dz2=dzmin1
   2165        DZAVG=0.5*(dz1+dz2)
   2166 
   2167 !if(dzavg.gt.10)then
   2168 !write(DIAGFN,*)'DZAVG>10 JDAY:',jday,'dz1,dz2,fkmp,fimp,dz(fkmp,fimp),dz(fkmp-1,fimp)'
   2169 !write(DIAGFN,*)dz1,dz2,fkmp,fimp,dz(fkmp,fimp),dz(fkmp-1,fimp)
   2170 !end if
   2171 !if(dxavg.gt.20)then
   2172 !write(DIAGFN,*)'DXAVG>10 JDAY:',jday,'dx1,dx2,fkmp,fimp,dx(fkmp,fimp),dx(fkmp-1,fimp)'
   2173 !write(DIAGFN,*)dx1,dx2,fkmp,fimp,dx(fkmp,fimp),dx(fkmp,fimp-1)
   2174 !end if

Page 77          Source Listing                  PART_TRANSPORT
2026-03-30 08:48                                 ..\..\..\particle.f90

   2175 
   2176         IF(DXTHEORY==' ON')THEN
   2177             DISPX=5.84e-4*DLX(FIMP)**1.1
   2178             DISPZ=DZAVG
   2179         ELSE
   2180             Dispx=DXAVG  !*alphax            ! Note these should be interpolated rather than using nearest cell #
   2181             Dispz=DZAVG  !*alphaz
   2182         ENDIF
   2183 
   2184 ! COMPUTE DZ and DX by interpolating
   2185 
   2186         call random(seed,r1)
   2187         call random(seed,r2)
   2188 
   2189 !        r1=gasdev(seed)
   2190 !        r2=gasdev(seed)
   2191 
   2192         r1=(r1-0.5)*2.
   2193         r2=(r2-0.5)*2.
   2194 
   2195         RX=SQRT(6.0*Dispx*nfsfreq*86400.)*(r1*costheta-r2*sintheta)     ! DX is m2/s    nfsfreq is days
   2196         RZ=SQRT(6.0*Dispz*nfsfreq*86400.)*(r1*sintheta+r2*costheta)
   2197         
   2198 !write(9500,*)(r1*costheta-r2*sintheta),(r1*sintheta+r2*costheta)
   2199 
   2200 ! constrain random component to segment length and cell layer height
   2201         if(abs(rz).gt.h(KTWBF,fjr))rz=sign(1.0,rz)*h(KTWBF,fjr)   !.gt.h(fkmp,KTWBF))rz=sign(1.0,rz)*h(fkmp,KTWBF)    SW 7/1
   2201 /2017
   2202         if(abs(rx).gt.dlx(fimp))rx=sign(1.0,rx)*dlx(fimp)
   2203 
   2204 !if(rz.gt.2..or.rx.gt.1000.)then
   2205 !write(DIAGFN,*)'rx,rz,dispz,nfsfreq,r1,sintheta,r2,costheta,dzavg,alphaz,dxavg,alphax,dz1,dz2,dx1,dx2,vel,fxvel(5),fzvel(5)
   2205 '
   2206 !write(DIAGFN,*)rx,rz,dispz,nfsfreq,r1,sintheta,r2,costheta,dzavg,alphaz,dxavg,alphax,dz1,dz2,dx1,dx2,vel,fxvel(5),fzvel(5)
   2207 !end if
   2208 
   2209 !RX=SQRT(24.0*Dispx*nfsfreq)*(r1-0.5)
   2210 !RZ=SQRT(24.0*Dispz*nfsfreq)*(r2-0.5)
   2211 
   2212         else
   2213         RX=0.0
   2214         RZ=0.0
   2215 
   2216         end if
   2217 
   2218         FXLOC = FXLOC + RX   ! New updated Part X-Location
   2219         FYLOC = FYLOC + RX   ! New updated Part Y-Location
   2220         FZLOC = FZLOC + RZ    ! New updated Part Z-Location
   2221 
   2222 !if(rx.eq.0.0)then
   2223 !write(DIAGFN,*)'RX=0.0:rx,rz,dispx,r1,sintheta,r2,costheta,vel,fxvel(5)'  ! debug
   2224 !write(DIAGFN,*)rx,rz,dispx,r1,sintheta,r2,costheta,vel,fxvel(5)  ! debug
   2225 !end if
   2226 
   2227     return
   2228 
   2229 End Subroutine Part_transport

