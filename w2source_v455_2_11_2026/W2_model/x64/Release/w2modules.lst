     50 MODULE MSCLIB
     51   INTEGER(8) :: HTHREAD
     52   LOGICAL :: STOP_PUSHED, STOPPED, RESTART_PUSHED, RESTART_EXISTS
     53   INCLUDE "RESOURCE.FD"
    124   INTERFACE
    125     FUNCTION $BEGINTHREADEX (SECURITY,STACK_SIZE,START_ADDRESS,ARGLIST,INITFLAG,THRDADDR)
    126       USE DFWINTY, RENAMED => DLT
    127 !DEC$ ATTRIBUTES C,ALIAS : "__BEGINTHREADEX" :: $BEGINTHREADEX
    128 !DEC$ ATTRIBUTES REFERENCE,ALLOW_NULL        :: SECURITY
    129 !DEC$ ATTRIBUTES REFERENCE,IGNORE_LOC        :: THRDADDR
    130       INTEGER(UINT)                                :: $BEGINTHREADEX
    131       INTEGER(UINT),               INTENT(IN)      :: STACK_SIZE, INITFLAG
    132       INTEGER(PVOID),              INTENT(IN)      :: START_ADDRESS, ARGLIST
    133       INTEGER(UINT),               INTENT(OUT)     :: THRDADDR
    134       TYPE(T_SECURITY_ATTRIBUTES), INTENT(IN)      :: SECURITY
    135     END FUNCTION $BEGINTHREADEX
    136   END INTERFACE
    137   INTERFACE

