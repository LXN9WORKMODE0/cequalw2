   1951 
   1952 ! ************************ READ FISH INPUT DATA FILES
   1953 
   1954 Subroutine Read_Fish_Data
   1955 
   1956 Use Fishy; Use SCREENC, ONLY:JDAY; USE MAIN, ONLY: FISH_PARTICLE_EXIST 
   1957 IMPLICIT NONE
   1958 
   1959 character*3 ALINE
   1960 INTEGER :: I,J,NA, IDEBUG, NFISHLAST,ILINEAR,HTSTBOT,HTSTSIDE
   1961 
   1962             HIST_V=.FALSE.
   1963             HIST_T=.FALSE.
   1964             HIST_D=.FALSE.
   1965 
   1966     open(DIAGFN,file='w2_particle.csv',status='old')
   1967     READ(DIAGFN,*)
   1968     READ(DIAGFN,*)
   1969     READ(DIAGFN,*)PARTON,NFISHSEG,NFISHPCEL,ALINE,DXTHEORY,OUTFREQP,ILINEAR,HTSTBOT,HTSTSIDE,IDEBUG   !,ALPHAX,ALPHAZ     !'
   1969 (/10x,7x,a3,i10,i10,f10.0,(7x,a3),1f10.0,7X,A3)
   1970     If(PARTON.eq.'ON')then
   1971     PARTICLE=.true.
   1972     else
   1973     PARTICLE=.false.
   1974     FISH_PARTICLE_EXIST=.FALSE.  ! STOPS ALL FURTHER
   1975     RETURN
   1976     end if
   1977     If(ALINE.eq.'ON')then
   1978     LINE=.true.
   1979     else
   1980     LINE=.false.
   1981     end if
   1982     if(outfreqp==0.0)outfreqp=1.0   ! error trapping
   1983 
   1984 ! LINE: If LINE, distribute NFISHCEL not at a point but linearly along the line defined by IFISH and IFISHT and IFISHB; IF L
   1984 INE, FZLOC=0
   1985 ! PARTICLE = ON only "dumb" particle transport with random fluid motion + Sedimentation Vel (SEDVEL)
   1986 ! NFISHPCEL: # of particles added per cel
   1987 ! NFISHSEG: # of segements to add particles to
   1988 ! DATE:  Date particles are deposited
   1989     if(nfishseg.eq.0)nfishseg=1
