      6       SUBROUTINE POROSITY
      7 
      8       USE GEOMC;USE GLOBAL;USE MACROPHYTEC;USE POROSITYC;USE LOGICC
      9       USE SCREENC
     10       IMPLICIT NONE
     11 
     12       INTEGER :: K,M,KUP,IEXIT,K1,KDN,IUT
     13       REAL    :: B11,VSTOT,ELR,ELL,ELL1,ELL2,ELR2,EL1,EL2,ERR1,ERR2
     14 
     15     IF(NIT.EQ.0)THEN
     16 
     17  1040 FORMAT((8X,I8,3F8.0))
     18 
     19       DO JW=1,NWB
     20         KT = KTWB(JW)
     21         DO JB=BS(JW),BE(JW)
     22           IU   = CUS(JB)
     23           ID   = DS(JB)
     24           DO I=IU,ID
     25             DO K=2,KB(I)
     26               VOLI(K,I) = BH(K,I)*DLX(I)
     27             END DO
     28             VOLI(KT,I)    = BH2(KT,I)*DLX(I)
     29           END DO
     30         END DO
     31       END DO
     32 
     33     END IF
     34 
     35     DO JB=1,NBR
     36       COSA(JB)=COS(ALPHA(JB))
     37     END DO
     38 
     39 !C  CALCULATING # OF MACROPHYTE STEMS IN EACH CELL
     40 
     41     DO JW=1,NWB
     42       KT = KTWB(JW)
     43       DO JB=BS(JW),BE(JW)
     44         IU   = CUS(JB)
     45         ID   = DS(JB)
     46         DO I=IU,ID
     47 !          HKTI  = H(KT,JW)-Z(I)    REPLACED BY H1(KT,I)
     48           IF(KT.EQ.KTI(I))THEN
     49             VOLKTI(I)=H1(KT,I)*BIC(KT,I)*DLX(I)
     50           ELSE
     51             VOLKTI(I) = BIC(KTI(I),I)*(EL(KT,I)-EL(KTI(I)+1,I)-Z(I)*COSA(JB))/COSA(JB)*DLX(I)
     52           END IF
     53           DO K=KTI(I)+1,KT
     54             VOLKTI(I) = VOLKTI(I)+VOLI(K,I)
     55           END DO
     56 
     57           DO M=1,NMC

