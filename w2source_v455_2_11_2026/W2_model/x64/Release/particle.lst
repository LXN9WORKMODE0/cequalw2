    706             IF (DEBUG) WRITE(DATADEBUGFN,'(A,i5,f10.3,f10.3,i5,i5,f9.3)') 'ORDINARY FZLOC LT 0; fn,fzloc,fxloc,fimp,fkmp,jda
    706 y:', fn,fzloc,fxloc,fimp,fkmp,jday
    707             FKMP = FKMP - 1
    708             FZLOC = H(FKMP,FJR) + FZLOC
    709             IF (FZLOC.LT.0) GOTO 30                    ! Did fish move up more than one layer - must improve this.
    710             SURFCALC = 0 
