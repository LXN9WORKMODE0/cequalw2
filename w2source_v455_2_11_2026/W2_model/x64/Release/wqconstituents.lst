    549               DO K=KT,KB(I)      
    550               DT(K,I) = (C1S(K,I,JC)*BH2(K,I)/DLT+(ADX(K,I)*BHR1(K,I)-ADX(K,I-1)*BHR1(K,I-1))/DLX(I)+(1.0D0-THETA(JW))      
    550                &
    551                     *(ADZ(K,I)*BB(K,I)-ADZ(K-1,I)*BB(K-1,I))+CSSB(K,I,JC)/DLX(I))*DLT/BH1(K,I)+CSSK(K,I,JC)*DLT        ! CSS
    551 B g/s or ng/s if Hg   CSSK: g/m3/s or ng/m3/s for Hg
    552               END DO                                                    
    553             END DO
    554             DO I=IU,ID
    555 !      CALL TRIDIAG(AT(:,I),VT(:,I),CT(:,I),DT(:,I),KT,KB(I),KMX,CNEW(:,I))
    556                     BTA1(KT)=VT(KT,I)
    557                     GMA1(KT)=DT(KT,I)
    558                   DO K=KT+1,KB(I)
    559                            BTA1(K) = VT(K,I)-AT(K,I)/BTA1(K-1)*CT(K-1,I)
    560                     GMA1(K) = DT(K,I)-AT(K,I)/BTA1(K-1)*GMA1(K-1)
    561                   END DO
    562                   C1(KB(I),I,JC) = GMA1(KB(I))/BTA1(KB(I))
    563                   DO K=KB(I)-1,KT,-1
    564                     C1(K,I,JC) = (GMA1(K)-CT(K,I)*C1(K+1,I,JC))/BTA1(K)
    565                   END DO
    566             END DO
