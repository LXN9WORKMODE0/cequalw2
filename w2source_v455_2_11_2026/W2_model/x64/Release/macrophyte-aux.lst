    321 !************************************************************************
    322 !**               S U B R O U T I N E    MACROPHYTE_FRICTION           **
    323 !************************************************************************
    324 
    325     SUBROUTINE MACROPHYTE_FRICTION(HRAD,BEDFR,EFFRIC,K,II)
    326 
    327     USE GEOMC;USE GLOBAL;USE MACROPHYTEC;USE POROSITYC
    328     IMPLICIT NONE
    329       INTEGER :: K,M,II
    330       REAL(R8) :: BEDFR, EFFRIC, HRAD
    331       REAL     :: SAVOLRAT,XSAREA,TSAREA,ARTOT,SCTOT,CDAVG,FRIN
    332 
    333   DO M=1,NMC
    334     SAVOLRAT=DWV(M)/DWSA(M)     !CB 6/29/2006
    335     IF(K.EQ.KT)THEN
    336 !      SAREA(M)=VSTEMKT(II,M)*SAVOLRAT/PI
    337       SAREA(M)=VSTEMKT(II,M)*SAVOLRAT*ANORM(M)     !CB 6/29/2006
    338     ELSE
    339 !      SAREA(M)=VSTEM(K,II,M)*SAVOLRAT/PI
    340       SAREA(M)=VSTEM(K,II,M)*SAVOLRAT*ANORM(M)     !CB 6/29/2006
    341     END IF
    342   END DO
    343   XSAREA=BH2(K,II)
    344 
    345   TSAREA=0.0
    346   ARTOT=0.0
    347   SCTOT=0.0
    348   DO M=1,NMC
    349     ARTOT=ARTOT+SAREA(M)
    350     SCTOT=SCTOT+CDDRAG(M)*SAREA(M)
    351     TSAREA=TSAREA+SAREA(M)
    352   END DO
    353 
    354   IF(ARTOT.GT.0.0)THEN
    355     CDAVG=SCTOT/ARTOT
    356     FRIN=CDAVG*TSAREA*HRAD**(4./3.)/(2.0*G*XSAREA*DLX(II)*BEDFR**2)
    357     EFFRIC=BEDFR*SQRT(1.0+FRIN)
    358   ELSE
    359     EFFRIC=BEDFR
    360   END IF
    361 
    362   RETURN
    363   END SUBROUTINE MACROPHYTE_FRICTION

