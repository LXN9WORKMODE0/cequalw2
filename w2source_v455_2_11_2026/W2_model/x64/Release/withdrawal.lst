   3440             qwd(jwd) = qwdfrac(jwd) * qall
   3441             if (tsmaxflow(j,jj) > 0.0 .and. qwd(jwd) > tsmaxflow(j,jj)) qwd(jwd) = tsmaxflow(j,jj)
   3442           end do
   3443         end if
   3444       end if
   3445     end do
   3446   end if
   3447 
   3448 ! Output some results.
   3449   if (jday.ge.nxtstr) then
   3450     nxtstr = nxtstr+tfrqtmp
   3451     ifile=1949
   3452     do jb=1,nbr
   3453       if (nstr(jb) > 0) then
   3454         ifile=ifile+1
   3455         write (ifile,'(f10.4,",",<nstr(jb)>(f10.2,","),<nstr(jb)>(f10.2,","),<nstr(jb)>(f10.2,","))') jday,(tavg(i,jb),i=1,n
   3455 str(jb)),(qstr(i,jb),i=1,nstr(jb)),(estr(i,jb),i=1,nstr(jb))                   ! SW 8/28/2019
   3456       end if
   3457     end do
   3458     if (nwd > 0) then
   3459       ifile=ifile+1
   3460       write (ifile,'(f10.4,<nwd>f10.2,<nwd>f10.2,<nwd>f10.2)') jday,(tavgw(i),i=1,nwd),(qwd(i),i=1,nwd),(ewd(i),i=1,nwd)
   3461     end if
   3462 
   3463 ! computing reservoir volume and volume below 'tempcrit'
   3464     volmc=0.0
   3465     volm=0.0
   3466     DO JW=1,NWB
   3467       KT = KTWB(JW)
   3468       DO JB=BS(JW),BE(JW)
   3469         DO I=cus(jb),ds(jb)
   3470           volm(jw) = volm(jw) +BH2(KT,I)*DLX(I)
   3471           DO K=kt+1,kb(i)
   3472             volm(jw) = volm(jw)+BH(K,I)*DLX(I)
   3473           END DO
   3474           do kk=1,tempn
   3475             if(t2(kt,i).le.tempcrit(jw,kk))volmc(jw,kk) = volmc(jw,kk)+BH2(KT,I)*DLX(I)
   3476             DO K=kt+1,kb(i)
   3477               if(t2(k,i).le.tempcrit(jw,kk))volmc(jw,kk) = volmc(jw,kk)+BH(K,I)*DLX(I)
   3478             END DO
   3479           end do
   3480         end do
   3481       end do
   3482 
   3483       ifile=ifile+1
   3484       write(ifile,5315)jday,volm(jw),(volmc(jw,kk), kk=1,tempn)
   3485 5315  format(f8.2,100(g12.4,g12.4))
   3486     end do
   3487   end if
   3488 
   3489 ! Check elevations and status of temperature control towers.
   3490   if (tempc == '      ON' .and. jday .ge. nxttcd) then
   3491 
   3492 ! Update the temperature targets
   3493     DO J=1,NUMTEMPC
   3494       IF (DYNSEL(J) == '      ON') THEN
   3495         SELD(J)=1009+J

