   1204 ! REAER in units of s-1
   1205       DISGSS(KT,I) = -REAER(I)*DGPO2(JW)*(DGP(KT,I)-PALT(I))      ! this computation done in gas-transfer.f90 :*BI(KT,I)/BH2
   1205 (KT,I)
   1206     END IF
   1207 !
   1208     DO K=KT,KB(I)
   1209       TDG(K,I) = 100.*DGP(K,I)/PALT(I)
