    881 !**                                             S U B R O U T I N E   G R I D  A R E A 2                                    
    881       **
    882 !***************************************************************************************************************************
    882 ********
    883 
    884 SUBROUTINE GRID_AREA2
    885   USE GLOBAL; USE GEOMC; USE RSTART
    886   IMPLICIT NONE
    887 
    888   INTEGER   :: K
    889   REAL(R8)  :: AREA,SL,A_COEF,B_COEF,C_COEF
    890 
    891   AREA   = (EL(KT,I)-SZ(I)-(EL(KT,I)-Z(I)))*BI(KT,I)
    892   SL     = (B(KT,I)-BB(KT,I))/(0.5*H(KT,JW))
    893   A_COEF = -1.0
    894   B_COEF =  SZ(I)*2.+BI(KT,I)/(0.5*SL)
    895   C_COEF = -AREA/(0.5*SL)-SZ(I)**2-BI(KT,I)*2.*SZ(I)/SL
    896   Z(I)   = (-B_COEF+SQRT(B_COEF**2-4.*A_COEF*C_COEF))/(2.0*A_COEF)
    897   KTI(I) = 2
    898   DO K=2,KB(I)
    899     IF (EL(K,I) <= EL(KT,I)-Z(I)) THEN
    900       KTI(I) = K-1
    901       EXIT
    902     END IF
    903   END DO
    904   RETURN
    905 END SUBROUTINE

