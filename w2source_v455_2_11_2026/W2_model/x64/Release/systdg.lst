    197   
    198 !===========================================================================================================================
    199 ! TDG production calculation in SYSTDG
    200   SUBROUTINE UPDATE_TDGC (NSAT, P, N, T, TDGC)
    201       IMPLICIT NONE
    202       INTEGER          :: NSAT, N
    203       REAL(R8)         :: P, T, TDGC
    204       REAL(R8)         :: SAT
    205 ! CALCULATE SAT
    206       IF (NSAT == 0) THEN   ! O2 saturation
    207         SAT = EXP(7.7117 - 1.31403 * (LOG(T + 45.93))) * P
    208       ELSE IF (NSAT == 1) THEN            ! N2 saturation
    209         EA = DEXP(2.3026D0 * (7.5D0 * TDEW(WBSEG(IUGT(N))) / (TDEW(WBSEG(IUGT(N))) + 237.3D0) + 0.6609D0)) * 0.001316   ! mm
    209 Hg
    210         SAT = (1.5568D06 * 0.79 * (P - EA) * (1.8816D-5 - 4.116D-7 * T + 4.6D-9 * T*T)) 
    211       ELSE
    212         SAT = P  
    213       END IF
    214       TDGC = TDG_TDP(N) * SAT / 100.0
    215       IF (POWNO>0 .AND. TDGLOC=='     REL') THEN
    216          TDGC = TDG_TDG * SAT / 100.0
    217       END IF
    218     END SUBROUTINE UPDATE_TDGC


