    748 ! *** Cold Start Output File Initialization
    749       
    750     DO JW=1,NWB  ! moved so that x1 get initialized even if tecplot (and contour) OFF for first water body but ON for others
    750    ! cb 10/10/10
    751 !c calculating longitudinal distance of segments
    752       IF(JW == 1)DIST=0.0  
    753       DO JB=BS(JW),BE(JW)  
    754         X1(US(JB))=DIST+DLX(US(JB))/2.  
    755         DO I=US(JB)+1,DS(JB)  

Page 15          Source Listing                  OUTPUTINIT
2026-03-30 08:48                                 ..\..\..\outputinitw2tools.F90

    756           DIST=DIST+(DLX(I)+DLX(I-1))/2.0  
    757           X1(I)=DIST  
    758         END DO  
    759         DIST=DIST+DLX(DS(JB))  
    760         X1(DS(JB)+1)=DIST  
    761       ENDDO  
    762     END DO  
