    178 SUBROUTINE SCREEN_UPDATE (DLG)
    179   USE IFLOGM; USE DFLIB; USE MSCLIB; USE GEOMC; USE GLOBAL; USE GDAYC; USE SCREENC; USE SURFHE; USE TVDC; USE LOGICC; USE NA
    179 MESC    ! USE DFLOGM
    180   USE STRUCTURES; USE MAIN, ONLY:TMSTRT, TMEND; USE MetFileRegion
    181   IMPLICIT NONE
    182   CHARACTER(8)    :: TIME
    183   CHARACTER(3000) :: TEXT1
    184   TYPE(DIALOG)    :: DLG
    185   INTEGER         :: IPROG
    186   LOGICAL         :: RESULT
    187   TIME = CCTIME(1:2)//':'//CCTIME(3:4)//':'//CCTIME(5:6)
    188   CALL DATE_AND_TIME (CDATE,CCTIME)
    189   CALL CPU_TIME (CURRENT)
    190   WRITE (TEXT1,'(A," ",I0,", ",I0)')  MONTH,GDAY,YEAR;            RESULT = DLGSET (DLG,GREGORIAN_DAY,                    TEX
    190 T1)
    191   WRITE (TEXT1,'(I0)')                INT(JDAY);                  RESULT = DLGSET (DLG,JULIAN_DAY,                       TEX
    191 T1)
    192   WRITE (TEXT1,'(F0.2)')             (JDAY-INT(JDAY))*24.0;       RESULT = DLGSET (DLG,JULIAN_HOUR,                      TEX
    192 T1)
    193   WRITE (TEXT1,'(I0)')                INT(ELTMJD);                RESULT = DLGSET (DLG,ELAPSED_DAY,                      TEX
    193 T1)
    194   WRITE (TEXT1,'(F0.2)')             (ELTMJD-INT(ELTMJD))*24.0;   RESULT = DLGSET (DLG,ELAPSED_HOUR,                     TEX
    194 T1)
    195   WRITE (TEXT1,'(I0)')                INT(DLTS1);                 RESULT = DLGSET (DLG,TIMESTEP,                         TEX
    195 T1)
    196   WRITE (TEXT1,'("(",I0,",",I0,")")') KLOC,ILOC;                  RESULT = DLGSET (DLG,TIMESTEP_LOCATION,                TEX
    196 T1)
    197   WRITE (TEXT1,'(I0)')                INT(MINDLT);                RESULT = DLGSET (DLG,MIN_TIMESTEP,                     TEX
    197 T1)
    198   WRITE (TEXT1,'("(",I0,",",I0,")")') KMIN,IMIN;                  RESULT = DLGSET (DLG,MIN_TIMESTEP_LOCATION,            TEX
    198 T1)
    199   WRITE (TEXT1,'(I0)')                INT(JDMIN);                 RESULT = DLGSET (DLG,MIN_TIMESTEP_DAY,                 TEX
    199 T1)
    200   WRITE (TEXT1,'(F0.2)')             (JDMIN-INT(JDMIN))*24.0;     RESULT = DLGSET (DLG,MIN_TIMESTEP_HOUR,                TEX
    200 T1)
    201   WRITE (TEXT1,'(I0)')                INT(DLTAV);                 RESULT = DLGSET (DLG,AVERAGE_TIMESTEP,                 TEX
    201 T1)
    202   WRITE (TEXT1,'(I0)')                NIT;                        RESULT = DLGSET (DLG,ITERATIONS,                       TEX
    202 T1)
    203   WRITE (TEXT1,'(I0)')                NV;                         RESULT = DLGSET (DLG,TIMESTEP_VIOLATIONS,              TEX
    203 T1)
    204   WRITE (TEXT1,'(F0.2)')              FLOAT(NV)/FLOAT(NIT)*100.0; RESULT = DLGSET (DLG,PERCENT,                          TEX
    204 T1)
    205   
    206   if(.Not.Met_Regions)then
    207   WRITE (TEXT1,'(F0.2)')              TAIR(JW);                   RESULT = DLGSET (DLG,AIR_TEMPERATURE,                  TEX
    207 T1)
    208   WRITE (TEXT1,'(F0.2)')              TDEW(JW);                   RESULT = DLGSET (DLG,DEW_POINT_TEMPERATURE,            TEX
    208 T1)

Page 12          Source Listing                  SCREEN_UPDATE
2026-03-30 08:48                                 ..\..\..\screen_output_intel.f90

    209   WRITE (TEXT1,'(F0.2)')              WIND(JW);                   RESULT = DLGSET (DLG,WIND_SPEED,                       TEX
    209 T1)
    210   WRITE (TEXT1,'(F0.2)')              PHI(JW);                    RESULT = DLGSET (DLG,WIND_DIRECTION,                   TEX
    210 T1)
    211   WRITE (TEXT1,'(F0.2)')              CLOUD(JW);                  RESULT = DLGSET (DLG,CLOUD_COVER,                      TEX
    211 T1)
    212   else
    213   WRITE (TEXT1,'(F0.2)')              TAIR(1);                   RESULT = DLGSET (DLG,AIR_TEMPERATURE,                  TEXT
    213 1)
    214   WRITE (TEXT1,'(F0.2)')              TDEW(1);                   RESULT = DLGSET (DLG,DEW_POINT_TEMPERATURE,            TEXT
    214 1)
    215   WRITE (TEXT1,'(F0.2)')              WIND(1);                   RESULT = DLGSET (DLG,WIND_SPEED,                       TEXT
    215 1)
    216   WRITE (TEXT1,'(F0.2)')              PHI(1);                    RESULT = DLGSET (DLG,WIND_DIRECTION,                   TEXT
    216 1)
    217   WRITE (TEXT1,'(F0.2)')              CLOUD(1);                  RESULT = DLGSET (DLG,CLOUD_COVER,                      TEXT
    217 1)    
    218   endif
    219   
    220   
    221   WRITE (TEXT1,'(F0.1)')              ET(DS(JBDN(JW)));           RESULT = DLGSET (DLG,EQUILIBRIUM_TEMP,                 TEX
    221 T1)
    222   WRITE (TEXT1,'(F0.1)')              CSHE(DS(JBDN(JW)))*RHOWCP;  RESULT = DLGSET (DLG,SURFACE_HEAT_EXCHANGE,            TEX
    222 T1)
    223     if(.Not.Met_Regions)then
    224   WRITE (TEXT1,'(F0.1)')              SRON(JW);                   RESULT = DLGSET (DLG,SOLAR_RADIATION,                  TEX
    224 T1)
    225     else
    226   WRITE (TEXT1,'(F0.1)')              SRON(1);                    RESULT = DLGSET (DLG,SOLAR_RADIATION,                  TEX
    226 T1)
    227     endif
    228     
    229   WRITE (TEXT1,'(A)')                 TIME;                       RESULT = DLGSET (DLG,CURRENT_TIME,                     TEX
    229 T1)
    230   WRITE (TEXT1,'(I0)')                KTWB(JW);                   RESULT = DLGSET (DLG,SURFACE_LAYER,                    TEX
    230 T1)
    231   WRITE (TEXT1,'(F0.2)')              ELKT(JW);                   RESULT = DLGSET (DLG,SURFACE_ELEVATION,                TEX
    231 T1)
    232   WRITE (TEXT1,'(F0.2)')              ZMIN(JW);                   RESULT = DLGSET (DLG,MIN_DEVIATION,                    TEX
    232 T1)
    233   WRITE (TEXT1,'(I0)')                IZMIN(JW);                  RESULT = DLGSET (DLG,MIN_DEVIATION_SEGMENT,            TEX
    233 T1)
    234   WRITE (TEXT1,'(*(F0.2,2X))')        QIN;                        RESULT = DLGSET (DLG,BRANCH_INFLOW,                    TEX
    234 T1)
    235   WRITE (TEXT1,'(*(F0.2,2X))')        TIN;                        RESULT = DLGSET (DLG,BRANCH_INFLOW_TEMPERATURE,        TEX
    235 T1)
    236   WRITE (TEXT1,'(*(F0.2,2X))')        QDTR;                       RESULT = DLGSET (DLG,DIST_TRIBUTARY_INFLOW,            TEX
    236 T1)
    237   WRITE (TEXT1,'(*(F0.2,2X))')        TDTR;                       RESULT = DLGSET (DLG,DIST_TRIBUTARY_INFLOW_TEMPERATURE,TEX
    237 T1)
    238   WRITE (TEXT1,'(*(F0.3,2X))')        QTR;                        RESULT = DLGSET (DLG,TRIBUTARY_INFLOW,                 TEX
    238 T1)
    239   WRITE (TEXT1,'(*(F0.2,2X))')        TTR;                        RESULT = DLGSET (DLG,TRIBUTARY_INFLOW_TEMPERATURE,     TEX
    239 T1)
    240   WRITE (TEXT1,'(*(F0.2,2X))')        QSUM;                       RESULT = DLGSET (DLG,OUTFLOW,                          TEX
    240 T1)
    241   WRITE (TEXT1,'(*(F0.2,2X))')        QWD;                        RESULT = DLGSET (DLG,WITHDRAWAL,                       TEX

Page 13          Source Listing                  SCREEN_UPDATE
2026-03-30 08:48                                 ..\..\..\screen_output_intel.f90

    241 T1)
    242   WRITE (TEXT1,'(*(F0.2,2X))')        QPU;                        RESULT = DLGSET (DLG,PUMPFLOW,                         TEX
    242 T1)
    243   WRITE (TEXT1,'(*(F0.2,2X))')        QSP;                        RESULT = DLGSET (DLG,SPILLWAYFLOW,                     TEX
    243 T1)
    244   WRITE (TEXT1,'(*(F0.2,2X))')        QPI;                        RESULT = DLGSET (DLG,PIPEFLOW,                         TEX
    244 T1)
    245   WRITE (TEXT1,'(*(F0.2,2X))')        QGT;                        RESULT = DLGSET (DLG,GATEFLOW,                         TEX
    245 T1)
    246   WRITE (TEXT1,'(A180)')           MODDIR;                        RESULT = DLGSET (DLG,MODELDIRECTORY,                 TEXT1
    246 ) 
    247 
    248   WRITE (TEXT1,'(F0.2)')             (CURRENT)/60.0;              RESULT = DLGSET (DLG,CPU_TIMES,                        TEX
    248 T1)
    249   IF (MINDLT >= 1.0) WRITE (TEXT1,'(I0)') INT(MINDLT);            IF (MINDLT < 1.0) WRITE (TEXT1,'(F0.3)') MINDLT
    250   RESULT = DLGSET (DLG,MIN_TIMESTEP,                     TEXT1)
    251   
    252   IPROG=INT(((JDAY-TMSTRT)/(TMEND-TMSTRT))*100)   ! range is 0 to 100
    253   RESULT = DLGSET (DLG,PROGRESSBAR,IPROG,DLG_POSITION)
    254 RETURN
    255 
