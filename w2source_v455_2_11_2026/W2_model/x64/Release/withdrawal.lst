    162   ENDIF
    163   
    164   DO K=KTOP,KBOT
    165     QNEW(K)    = (VNORM(K)/VSUM)*QSTR(JS,JB)
    166     QOUT(K,JB) =  QOUT(K,JB)+QNEW(K)
    167     QDSW(K,ID) =  QDSW(K,ID)+QNEW(K)                     ! For layer-specific output; ID redefined for SP/PI/PU/GT    !SR 12
    167 /19/2022
    168     TAVG(JS,JB)=TAVG(JS,JB)+QNEW(K)*T2(K,ID)                  ! SW 7/30/09
    169     IF(CONSTITUENTS)CAVG(JS,JB,CN(1:NAC))=CAVG(JS,JB,CN(1:NAC))+QNEW(K)*C2(K,ID,CN(1:NAC))  
    170     IF(DERIVED_CALC)CDAVG(JS,JB,CDN(1:NACD(JW),JW))=CDAVG(JS,JB,CDN(1:NACD(JW),JW))+QNEW(K)*CD(K,ID,CDN(1:NACD(JW),JW))
    171     QSUMJS=QSUMJS+QNEW(K)
    172   END DO
    173 IF(QSUMJS.GT.0.0)THEN
    174   TAVG(JS,JB)=TAVG(JS,JB)/QSUMJS
    175   IF(CONSTITUENTS)then                    ! cb 1/16/13
    176     CAVG(JS,JB,CN(1:NAC))=CAVG(JS,JB,CN(1:NAC))/QSUMJS
    177     if(tdgon)then
    178      IF (nnsg==1) THEN                                ! nnsg==1 is gate flow
    179 !
    180 ! systedg
    181            IF (SYSTDG) THEN                          
    182                IF(GTNAME(jsg)) THEN                   
    183                   CALL  UPDATE_TDGC (0,palt(id),jsg,tavg(js,jb),cavg(js,jb,NDO))    
    184                   if(cac(nn2)=='      ON')CALL  UPDATE_TDGC (1,palt(id),jsg,tavg(js,jb),cavg(js,jb,NN2))  
    185                   if(cac(ndgp)=='      ON')CALL  UPDATE_TDGC (2,palt(id),jsg,tavg(js,jb),cavg(js,jb,NDGP))
    186                ELSE
    187                   call total_dissolved_gas (0,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDO))    
    188                   if(cac(nn2)=='      ON')call total_dissolved_gas (1,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NN2))     ! n
    188 2 GAS
    189                   if(cac(ndgp)=='      ON')call total_dissolved_gas (2,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDGP)) 
    190                END IF
    191            ELSE
    192                call total_dissolved_gas (0,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDO))    
    193                if(cac(nn2)=='      ON')call total_dissolved_gas (1,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NN2))     ! n2 G
    193 AS
    194                if(cac(ndgp)=='      ON')call total_dissolved_gas (2,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDGP))
    195            END IF
    196 !
    197       ELSE
    198       call total_dissolved_gas (0,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDO))    
    199       if(cac(nn2)=='      ON')call total_dissolved_gas (1,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NN2))     ! n2 GAS
    200       if(cac(ndgp)=='      ON')call total_dissolved_gas (2,palt(id),nnsg,jsg,tavg(js,jb),cavg(js,jb,NDGP))
    201       END IF
    202     end if
    203   end if
    204   IF(DERIVED_CALC)then                    ! cb 1/16/13
    205     CDAVG(JS,JB,CDN(1:NACD(JW),JW))=CDAVG(JS,JB,CDN(1:NACD(JW),JW))/QSUMJS
    206 !if(tdgon)then                  ! cb 11/6/17
    207 !cdavg(js,jb,16)  = (cavg(js,jb,ndo)/exp(7.7117-1.31403*(log(tavg(js,jb)+45.93)))*palt(id))*100.0
    208       dosat=exp(7.7117-1.31403*(log(tavg(js,jb)+45.93)))*palt(id)
    209       cdavg(js,jb,O2DG_DER)=(cavg(js,jb,ndo)/dosat)*100.0 
    210 !IF(ngctdg /= 0)THEN
