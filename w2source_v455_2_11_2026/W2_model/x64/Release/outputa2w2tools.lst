   1368 ! *** ACTIVE LAYERS
   1369         DO K = KTI(I),KB(I)
   1370           WDSI(K,I) = T2(K,I)
   1371           END DO  
   1372 ! *** BELOW ACTIVE LAYER
   1373         DO K = KB(I)+1,KMX  
   1374           WDSI(K,I) = -9999.  
   1375         END DO  
   1376       END DO  
   1377       WRITE(VPL(1)) ((WDSI(K,I),K=1,KMX),I=1,IMX)  
