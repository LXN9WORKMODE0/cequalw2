    243 ENTRY DOWNSTREAM_WATERBODY
    244   DO JJB=1,NBR
    245     IF (CDHS(JB) >= CUS(JJB) .AND. CDHS(JB) <= DS(JJB)) EXIT
    246   END DO
    247   DO JJW=1,NWB
    248     IF (JJB >= BS(JJW) .AND. JJB <= BE(JJW)) EXIT
    249   END DO
    250   KR = KTWB(JJW)+1
    251   DO K=KT,KB(ID)+1
    252     ELL(K) = EL(K,ID)-SINA(JB)*DLX(ID)*0.5
    253   END DO
    254   DO K=KTWB(JJW),KB(CDHS(JB))+1
    255     ELR(K) = EL(K,CDHS(JB))+SINA(JJB)*DLX(CDHS(JB))*0.5
    256   END DO
    257   ELW = ELWS(ID)                                             !EL(KTWB(JW),ID)-Z(ID)*COSA(JB)
    258   EL1  = ELW-SINA(JB)*DLX(ID)*0.5
    259 !   EL1  = ELW+(ELW-ELWS(ID-1))/(0.5*(DLX(ID)+DLX(ID-1))*DLX(ID)*0.5   ! SW 7/17/09
    260   IDT  = ID+1
    261   DO K=KT+1,KB(ID)+1
    262     IF (ELL(K) >= ELR(KR)) THEN
    263       T1(K-1,IDT)            = T1(KR-1,CDHS(JB))
    264       T2(K-1,IDT)            = T2(KR-1,CDHS(JB))
    265       C1S(K-1,IDT,CN(1:NAC)) = C1S(KR-1,CDHS(JB),CN(1:NAC))
    266       C1(K-1,IDT,CN(1:NAC))  = C1S(KR-1,CDHS(JB),CN(1:NAC))
    267       C2(K-1,IDT,CN(1:NAC))  = C1S(KR-1,CDHS(JB),CN(1:NAC))
    268       EL1                    = ELL(K)
    269       IF (ELL(K) == ELR(KR)) KR = KR+1
    270       IF (KR > KB(CDHS(JB))+1) EXIT
    271     ELSE
    272       BRTOT = 0.0
    273       CL    = 0.0

Page 6           Source Listing                  WATERBODY
2026-03-30 08:47                                 ..\..\..\waterbody.f90

    274       T1L   = 0.0
    275       T2L   = 0.0
    276       DO WHILE (ELL(K) <= ELR(KR))
    277         IF (KR == KTWB(JJW)+1 .AND. K == KT+1) THEN
    278           B1    = BH2(KTWB(JJW),CDHS(JB))
    279         ELSE
    280           B1    = B(KR-1,CDHS(JB))*(EL1-ELR(KR))
    281         END IF
    282         BRTOT = BRTOT+B1
    283         T1L           = T1L+B1*T1(KR-1,CDHS(JB))
    284         T2L           = T2L+B1*T2(KR-1,CDHS(JB))
    285         CL(CN(1:NAC)) = CL(CN(1:NAC))+B1*C1S(KR-1,CDHS(JB),CN(1:NAC))
    286         EL1           = ELR(KR)
    287         KR            = KR+1
    288         IF (KR > KB(CDHS(JB))+1) EXIT
    289       END DO
    290       IF (KR <= KB(CDHS(JB))+1) THEN     ! SR 1/2024
    291         B1 = B(KR-1,CDHS(JB))*(EL1-ELL(K))
    292       ELSE
    293         B1 = 0.0
    294       END IF
    295       BRTOT = BRTOT+B1
    296       IF (BRTOT == 0.0) EXIT
    297       T1(K-1,IDT)            = (T1L+B1*T1(KR-1,CDHS(JB)))/BRTOT
    298       T2(K-1,IDT)            = (T2L+B1*T2(KR-1,CDHS(JB)))/BRTOT
    299       C1S(K-1,IDT,CN(1:NAC)) = (CL(CN(1:NAC))+B1*C1S(KR-1,CDHS(JB),CN(1:NAC)))/BRTOT
    300       C1(K-1,IDT,CN(1:NAC))  =  C1S(K-1,IDT,CN(1:NAC))
    301       C2(K-1,IDT,CN(1:NAC))  =  C1S(K-1,IDT,CN(1:NAC))
    302       EL1                    =  ELL(K)
