      6 REAL(R8) FUNCTION DENSITY (T,TDS,SS)
      7   use PREC
      8   USE LOGICC, ONLY: SUSP_SOLIDS, FRESH_WATER, SALT_WATER; USE GLOBAL, ONLY:JW
      9   IMPLICIT NONE
     10   REAL(R8) :: T,TDS,SS
     11   IF(T <= 0.0) THEN    ! Suggested by Stewart Rounds
     12                              DENSITY = 0.842594D0
     13   IF (SUSP_SOLIDS)     DENSITY = DENSITY+6.2D-4*SS
     14   IF (FRESH_WATER(JW)) DENSITY = DENSITY+TDS*8.221D-4
     15   IF (SALT_WATER(JW))  DENSITY = DENSITY+TDS*0.824493D0                      &
     16                                  +(-5.72466D-3)*TDS**1.5D0+4.8314D-4*TDS*TDS
     17 
     18   ELSE
     19                        DENSITY = ((((6.536332D-9*T-1.120083D-6)*T+1.001685D-4)*T-9.09529D-3)*T+6.793952D-2)*T+0.842594D0
     20                        
     21   IF (SUSP_SOLIDS)     DENSITY = DENSITY+6.2D-4*SS
     22   IF (FRESH_WATER(JW)) DENSITY = DENSITY+TDS*((4.99D-8*T-3.87D-6)*T+8.221D-4)
     23   IF (SALT_WATER(JW))  DENSITY = DENSITY+TDS*((((5.3875D-9*T-8.2467D-7)*T+7.6438D-5)*T-4.0899D-3)*T+0.824493D0)             
     23          &
     24                                  +((-1.6546D-6*T+1.0227D-4)*T-5.72466D-3)*TDS**1.5D0+4.8314D-4*TDS*TDS
     25   ENDIF
     26   
     27   DENSITY = DENSITY+999.0D0
     28 END FUNCTION DENSITY

