   1484     END DO
   1485    END DO
   1486   ENDDO
   1487   
   1488 ! Withdrawals
   1489   
   1490 
   1491   DO JWD=1,NWD
   1492      DO J=1,NUMTEMPC
   1493       IF(TCJS(J) == JWD .AND.  TCNTR(J) == '      WD')THEN
   1494           IF(TCISEG(J).EQ.0)THEN
   1495 !           TCOMP=TOUT(JB)
