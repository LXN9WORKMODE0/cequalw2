    526 
    527 !!$OMP PARALLEL DO PRIVATE(I,JC,KT,JB,JW,DT,K,IU,ID,BTA1,GMA1)    !I,JC,KT,JW,JB,CNEW,SSB,SSK,COLD,AT,VT,CT,DT)
    528     
    529     DO JAC=1,NAC    !CONCURRENT(JAC=1:NAC)              !JAC=1,NAC
    530     JC   =  CN(JAC)
