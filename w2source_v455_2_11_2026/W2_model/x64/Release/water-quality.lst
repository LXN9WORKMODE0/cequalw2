   1264         CH4D(K,I) = -CH41DK(JW)*CH4Q10(JW)**(T1(K,I)-20.0)*CH4(K,I)  *DO3(K,I) 
   1265       ELSE
   1266         CH4D(K,I) = -CH41DK(JW)*CH4(K,I) *DO3(K,I) 
   1267       END IF
   1268       CH4SR(K,I)  = CH4R(JW)*SODD(K,I)*DO2(K,I)
   1269       CH4SS(K,I)  = CH4D(K,I) + CH4SR(K,I)
   1270     END DO
   1271 !
   1272     IF(.NOT. ICE(I))THEN
   1273       CH4REAER(KT,I) = 1.188*REAER(I)*(-CH4(KT,I))              !This computation is done in gas-transfer.f90:*BI(KT,I)/BH2(

