   3005         END DO
   3006         DO K=KTWB(JW),KB(I)
   3007           CBODCT = 0.0; CBODNT = 0.0; CBODPT = 0.0; BODTOT = 0.0; ALGP = 0.0; ALGN = 0.0; ZOOP=0.0; ZOON=0.0; POC(K,I)=0.0
   3008           DO JA=1,NAL
