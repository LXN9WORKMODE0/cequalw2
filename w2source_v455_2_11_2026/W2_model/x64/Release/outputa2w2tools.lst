    108 ! VOLUME WEIGHTING OF ACTIVE CONSTITUENTS     !MLM 18.07.06
    109         KLIM = MIN(KB(I),KTWB(JW)+5)  
    110         DO K=KTWB(JW),KLIM  
    111           DO JJC = 1,NAC  
    112             C2W(I,JJC) = C2W(I,JJC)+C2(K,I,CN(JJC))*CMULT(CN(JJC))*BH(K,I)  
    113           END DO  
    114 			     C2W(I,NAC+1) = C2W(I,NAC+1)+CD(K,I,PH_DER)*BH(K,I) !PH
    115 			     C2W(I,NAC+2) = C2W(I,NAC+2)+CD(K,I,TP_DER)*BH(K,I) ! TOTAL PHOSPHOROUS
    116 			 VOLROOS(I)=VOLROOS(I)+BH(K,I)                          ! VOLUME WEIGHTED
    117         END DO  
    118         DO JJC = 1,NAC+2  
    119           C2W(I,JJC) = C2W(I,JJC)/VOLROOS(I)  
    120         END DO  
    121           
    122         WRITE(WEIGHTNUM(J),'(F10.3,",",<NAC>(F9.3,","),2(F9.3,","))')JDAY,(C2W(I,JJC),JJC = 1,NAC+2)  
    123         VOLROOS = 0.0
    124           
    125       END DO  
    126     END IF  
    127   END IF  
