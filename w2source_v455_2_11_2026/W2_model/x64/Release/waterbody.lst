    311 ENTRY UPSTREAM_BRANCH
    312   DO JJW=1,NWB
    313     IF (JJB >=BS(JJW) .AND. JJB <= BE(JJW)) EXIT
    314   END DO
    315   DO K=KT,KB(I)+1
    316     ELL(K) = EL(K,I)
    317   END DO
    318   DO K=KTWB(JWUH(JB)),KB(CUS(JJB))+1
    319     ELR(K) = EL(K,CUS(JJB))+SINA(JJB)*DLX(CUS(JJB))*0.5
    320   END DO
    321   ELW  = ELWS(CUS(JJB))                               !EL(KTWB(JWUH(JB)),CUS(JJB))-Z(CUS(JJB))*COSA(JJB)
    322   EL1  = ELW+SINA(JJB)*DLX(CUS(JJB))*0.5
    323 !   EL1  = ELW-(ELWS(CUS(JJB)+1)-ELW)/(0.5*(DLX(CUS(JJB)+DLX(CUS(JJB)+1))*DLX(CUS(JJB))*0.5   ! SW 7/17/09
    324   KR   = KTWB(JWUH(JB))+1
    325   DO K=KT+1,KB(I)+1
    326     IF (ELL(K) >= ELR(KR)) THEN
    327       Q1 = VOLUH2(KR-1,JJB)/DLT

Page 7           Source Listing                  WATERBODY
2026-03-30 08:47                                 ..\..\..\waterbody.f90

    328       B1 = BHR(KR-1,CUS(JJB)-1)
    329       IF (KR == KTWB(JWUH(JB))+1) B1 = BHR2(KT,CUS(JJB)-1)
    330       U1 = U(KR-1,CUS(JJB)-1)*B1
    331       HT = H2(KR-1,JWUH(JB))
    332       IF (KR == KTWB(JWUH(JB))+1) HT = H2(KT,CUS(JJB))
    333       Q1 = Q1*((EL1-ELL(K))/HT)
    334       B2 = BHR(K-1,I)
    335       IF (K == KTWB(JW)+1) B2 = BHR2(KT,I)
    336       UXBR(K-1,I) = UXBR(K-1,I)+(ABS((U1/B2)*COS(BETABR)*Q1)/DLX(I))
    337       UYBR(K-1,I) = UYBR(K-1,I)+ABS(Q1*SIN(BETABR))
    338       EL1         = ELL(K)
    339       IF (ELL(K) == ELR(KR)) KR = KR+1
    340     ELSE
    341       U1    = 0.0
    342       Q1    = 0.0
    343       BRTOT = 0.0
    344       DO WHILE (ELL(K) <= ELR(KR))
    345         IF (KR /= KTWB(JWUH(JB))+1) THEN
    346           FRAC = (EL1-ELR(KR))/(H(KR-1,JWUH(JB)))
    347           B1   =  BHR(KR-1,CUS(JJB)-1)
    348         ELSE
    349           FRAC = (EL1-ELR(KR))/H2(KT,CUS(JJB))
    350           B1   =  BHR2(KT,CUS(JJB)-1)
    351         END IF
    352         U1  = U1+U(KR-1,CUS(JJB)-1)*B1*FRAC
    353         Q1  = Q1+VOLUH2(KR-1,JJB)/DLT*FRAC
    354         EL1 = ELR(KR)
    355         KR  = KR+1
    356         IF (KR > KB(CUS(JJB)+1)) EXIT
    357       END DO
    358       IF (K == KTWB(JW)+1) THEN
    359         B2 = BHR2(KT,I)
    360       ELSE
    361         B2 = BHR(K-1,I)
    362       END IF
    363       IF (H(KR-1,JWUH(JB)) /= 0.0) THEN
    364         IF (KR-1 == KTWB(JWUH(JB))) THEN
    365           HT = H2(KT,CUS(JJB))
    366         ELSE
    367           HT = H2(KR-1,JWUH(JB))
    368         END IF
    369         FRAC        = (EL1-ELL(KR-1))/HT
    370         Q1          =  Q1+FRAC*VOLUH2(KR-1,JJB)/DLT
    371         UXBR(K-1,I) =  UXBR(K-1,I)+(ABS((U1/B2)*COS(BETABR)*Q1)/DLX(I))
    372         UYBR(K-1,I) =  UYBR(K-1,I)+ABS(Q1*SIN(BETABR))
    373       END IF
    374       IF (KR > KB(CUS(JJB)+1)) EXIT
    375       EL1 = ELL(K)
    376     END IF
