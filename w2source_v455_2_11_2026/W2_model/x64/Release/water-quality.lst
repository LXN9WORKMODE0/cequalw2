   2591 ENTRY LABILE_POM_C
   2592   LPOMCAP(:,IU:ID) = 0.0; LPOMCEP(:,IU:ID)=0.0; LPOMCMP(:,IU:ID)=0.0; LPZOOINC(:,IU:ID)=0.0; LPZOOOUTC(:,IU:ID)=0.0
   2593   DO I=IU,ID
   2594     DO K=KT,KB(I)
   2595       DO JA=1,NAL
   2596         IF(ALG_CALC(JA)) LPOMCAP(K,I) = LPOMCAP(K,I) + APOM(JA)*(AMR(K,I,JA)*ALG(K,I,JA))*AC(JA)
   2597       END DO
   2598       DO JE=1,NEP
   2599         IF(EPIPHYTON_CALC(JW,JE)) LPOMCEP(K,I) = LPOMCEP(K,I) + EPOM(JE)*EMR(K,I,JE)*EPC(K,I,JE)*EC(JE)
   2600       END DO
   2601       DO M=1,NMC
   2602         IF(MACROPHYTE_CALC(JW,M))THEN
   2603           IF(K.EQ.KT)THEN
   2604             JT=KTI(I)
   2605           ELSE
   2606             JT=K

Page 52          Source Listing                  
2026-03-30 08:47                                 ..\..\..\water-quality.f90

   2607           END IF
   2608           JE=KB(I)
   2609           DO JJ=JT,JE
   2610             LPOMCMP(K,I) = LPOMCMP(K,I) + MPOM(M)*LRPMAC(M)*MMR(K,I,M)*MACRM(JJ,K,I,M)*MC(M)
   2611           END DO
   2612         END IF
   2613       END DO
   2614       LPOMCMP(K,I) = LPOMCMP(K,I)/(DLX(I)*BH2(K,I))
   2615 	    IF(ZOOPLANKTON_CALC)THEN
   2616 	      DO JZ = 1,NZP
   2617           IF(TGRAZE(K,I,JZ) > 0.0)THEN
   2618             LPZOOOUTC(K,I) = LPZOOOUTC(K,I) + ZOO(K,I,JZ)*(ZMT(K,I,JZ)+(ZMU(K,I,JZ)-(ZMU(K,I,JZ)*ZEFF(JZ))))*ZC(JZ)
   2619             IF(.NOT.ORGC_CALC)THEN     ! SW 7/8/2024
   2620 !IF(CAC(NLPOM) == '      ON')THEN
   2621               LPZOOINC(K,I) = LPZOOINC(K,I) + ZOO(K,I,JZ)*PREFP(JZ)*ZMU(K,I,JZ)*LPOM(K,I)/TGRAZE(K,I,JZ)*ZC(JZ)
   2622             ELSE
   2623               LPZOOINC(K,I) = LPZOOINC(K,I) + ZOO(K,I,JZ)*PREFP(JZ)*ZMU(K,I,JZ)*LPOMC(K,I)/ORGC(JW)/TGRAZE(K,I,JZ)*ZC(JZ)
   2624             END IF
   2625           ELSE
   2626             LPZOOOUTC(K,I) = LPZOOOUTC(K,I) + ZOO(K,I,JZ)*(ZMT(K,I,JZ)+(ZMU(K,I,JZ)-(ZMU(K,I,JZ)*ZEFF(JZ))))*ZC(JZ)
   2627             LPZOOINC(K,I) = 0.0
   2628           END IF
   2629 	      END DO
   2630 	    ENDIF
   2631       LPOMCNS(K,I) = POMS(JW) * (LPOMC(K-1,I)-LPOMC(K,I)) * BI(K,I)/BH2(K,I)
   2632       LPOMCSS(K,I) = LPOMCAP(K,I) + LPOMCEP(K,I) + LPOMCMP(K,I) - LPOMCD(K,I) + LPOMCNS(K,I) - LRPOMCD(K,I) - LPOMCHD(K,I)  
   2632  &
   2633                    + LPZOOOUTC(K,I) - LPZOOINC(K,I)
   2634     END DO
   2635   END DO
   2636 RETURN
