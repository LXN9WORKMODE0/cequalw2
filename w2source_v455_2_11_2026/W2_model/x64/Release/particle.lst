   2255 !**********************************
   2256    Subroutine lateral_velocity
   2257 ! SW 2/01/02   7/31/2017
   2258 
   2259    Use FISHY
   2260    USE GLOBAL
   2261    Use GEOMC
   2262    Use MAIN, only: EV, QPR, IWD
   2263    
   2264    IMPLICIT NONE
   2265    REAL :: XAREA
   2266    LOGICAL :: WITH_AT_PARTICLE_LOCATION
   2267    INTEGER :: IW
   2268    
   2269 ! Concept all QSS from each cell will be treated as a lateral withdrawal - each withdrawal will
   2270 ! be assigned a RHS or LHS looking downstream location; lateral velocity origin is the
   2271 ! segment/cell center. Velocities to the RHS are + and those to the LHS are -
   2272 !  IF RHS LOOKING DOWNSTREAM THEN VELOCITY IS POSITIVE, RIMPBR(I,1)>0
   2273 !  IF LHS LOOKING DOWNSTREAM THEN VELOCITY IS NEGATIVE, LIMPBR(I,1)>0
   2274 ! TRIBS AND INFLOWS IN QSS ARE ASSIGNED POSITIVE VALUES, WITHDRAWALS ARE NEGATIVE
   2275 !
   2276     WITH_AT_PARTICLE_LOCATION=.FALSE.
   2277 ! CHECK FOR WITHDRAWALS AT FIMP
   2278       DO IW=1,NWD
   2279           IF(FIMP==IWD(IW))THEN
   2280               WITH_AT_PARTICLE_LOCATION=.TRUE.
   2281               EXIT
   2282           ENDIF     
   2283       ENDDO
   2284 
   2285       IF(RIMPBR(FIMP,1) == 0 .AND. LIMPBR(FIMP,1) == 0 .AND. .NOT.WITH_AT_PARTICLE_LOCATION)THEN
   2286         FYVEL=0.0
   2287       ELSE
   2288           
   2289         if(fkmp.le.KTWB(fjr))then   
   2290             xarea=h1(KTWB(FJR),fimp)*dlx(fimp)
   2291             fyvel=(qss(KTWB(fjr),fimp)+ev(fimp)-QPR(FIMP))/xarea        ! ADD EVAPORATION AND REMOVE PRECIP BACK TO QSS...be
   2291  careful about evaporation which is also a -QSS flow
   2292 
   2293         IF(RIMPBR(FIMP,1) > 0)THEN
   2294             IF(BR_INACTIVE(RIMPBR(FIMP,2)))THEN
   2295                 FYVEL=0.0
   2296             ELSE
   2297                 fyvel=-fyvel  
   2298             ENDIF     
   2299         ELSEIF(LIMPBR(FIMP,1) > 0)THEN
   2300             IF(BR_INACTIVE(LIMPBR(FIMP,2)))THEN
   2301             FYVEL=0.0
   2302             ELSE
   2303             fyvel=fyvel   
   2304             ENDIF
   2305         ENDIF
   2306 
   2307         else
   2308         xarea=h1(fkmp,fIMP)*dlx(fimp)
   2309         fyvel=qss(fkmp,fimp)/xarea

Page 83          Source Listing                  LATERAL_VELOCITY
2026-03-30 08:48                                 ..\..\..\particle.f90

   2310         
   2311         IF(RIMPBR(FIMP,1) > 0)THEN
   2312             IF(.NOT.BR_INACTIVE(RIMPBR(FIMP,2)) .AND. FKMP <= KB(DS(RIMPBR(FIMP,2))))THEN
   2313             fyvel=-fyvel  
   2314             ELSE
   2315             FYVEL=0.0
   2316             ENDIF        
   2317         ELSEIF(LIMPBR(FIMP,1) > 0)THEN
   2318             IF(.NOT.BR_INACTIVE(LIMPBR(FIMP,2)) .AND. FKMP <= KB(DS(LIMPBR(FIMP,2))))THEN
   2319             fyvel=fyvel   
   2320             ELSE
   2321             FYVEL=0.0
   2322             ENDIF
   2323         ENDIF
   2324         
   2325         end if
   2326     ENDIF
   2327     
   2328     return
   2329     end


