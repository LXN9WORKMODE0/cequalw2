     58             VSTEMKT(I,M)=(MAC(KT,I,M)*VOLKTI(I))/DWV(M)    !CB 6/29/06
     59           END DO
     60 
     61           DO K=KT+1,KB(I)
     62             DO M=1,NMC
     63               VSTEM(K,I,M)=(MAC(K,I,M)*VOLI(K,I))/DWV(M)   !CB 6/29/06
     64             END DO
     65           END DO
     66         END DO
     67       END DO
     68     END DO
     69 
     70     POR=1.0
     71     DO JW=1,NWB
     72       KT = KTWB(JW)
     73       DO JB=BS(JW),BE(JW)
     74         IU = CUS(JB)
     75         ID = DS(JB)
     76 
     77         DO I=IU,ID
     78           DO K=KT,KB(I)
     79             IF(K.EQ.KT)THEN
     80               VSTOT=0.0
     81               DO M=1,NMC
     82                   VSTOT=VSTOT+VSTEMKT(I,M)
     83               END DO
     84               POR(KT,I)=(VOLKTI(I)-VSTOT)/VOLKTI(I)
     85             ELSE
     86               VSTOT=0.0
     87               DO M=1,NMC
     88                 VSTOT=VSTOT+VSTEM(K,I,M)
     89               END DO
     90               POR(K,I)=(VOLI(K,I)-VSTOT)/VOLI(K,I)
     91             END IF
     92           END DO
     93         END DO
     94 
     95         DO I=IU,ID
     96           DO K=KTI(I),KB(I)
     97             IF(K.LE.KT)THEN
     98               B(K,I)=POR(KT,I)*BIC(K,I)
     99             ELSE
    100               B(K,I)=POR(K,I)*BIC(K,I)
    101             END IF
    102 
    103           END DO
    104         END DO
    105 
    106       END DO
    107     END DO
    108 
    109 
    110 
    111 ! BOUNDARY WIDTHS
    112 
    113   DO JW=1,NWB
    114     KT = KTWB(JW)

