    567 SUBROUTINE CALCFRIC()
    568 USE GLOBAL;USE GEOMC;USE EDDY;USE KINETIC;USE LOGICC
    569 IMPLICIT NONE
    570 REAL(R8)    :: DEPTHL,DEPTHR,DEPTH,PERIMETER,AREA,UAVG
    571 INTEGER :: K
    572   DEPTHL = (ELWS(I)-EL(KB(I),I)    +H2(KB(I),I)  *COSA(JB))/COSA(JB)                                              !EL(KT,I) 
    572  -Z(I)  *COSA(JB)
    573   DEPTHR = (ELWS(I+1)-EL(KB(I+1),I+1)+H2(KB(I+1),I)*COSA(JB))/COSA(JB)                                                     !
    573 EL(KT,I+1)-Z(I+1)*COSA(JB)
    574   DEPTH = (DEPTHR+DEPTHL)*0.5
    575   PERIMETER = 0.0
    576   PERIMETER = BR(KB(I),I)+2.0*H(KB(I),JW)
    577   DO K=KT,KB(I)-1
    578     PERIMETER = PERIMETER + (B(K,I)-B(K+1,I)+2.0*H(K,JW))
    579   END DO
    580   AREA = 0.0
    581   DO K=KT,KB(I)
    582     AREA = AREA + BH1(K,I)
    583   END DO
    584   UAVG = 0.5*(QC(I)+QC(I-1))/AREA
    585   IF(ABS(UAVG)>NONZERO)THEN
    586     IF (MANNINGS_N(JW)) THEN
    587 	  FRIC(I) = (AREA/PERIMETER)**(0.16666666667)/SQRT(9.81*(UAVG/USTARBTKE(I))**2)                      !1.0/6.0   (9.8
    587 1/(USTARBTKE(I)/UAVG)**2)
    588 	ELSE
    589 	  FRIC(I) = SQRT(9.81*(UAVG/USTARBTKE(I))**2)
    590 	ENDIF
    591   ENDIF
    592 END SUBROUTINE

