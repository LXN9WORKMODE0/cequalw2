   1920 !*****************************************
   1921 Subroutine fishoutput
   1922 !*****************************************
   1923 ! Numerical Fish Surrogate Output
   1924 !*****************************************
   1925 
   1926 Use FISHY; USE GLOBAL
   1927 IMPLICIT NONE
   1928 
   1929 INTEGER ::  II, JF
   1930 
   1931 
   1932 ! final fish output
   1933    IF(NMONITORS<10)THEN
   1934        write(FINALFN,'(A214,<NMONITORS>(A11,I1,","))')'Part#,Seg#,XLocationwithinSegmentfromUpstreamSide(m),Layer#,VerticalD
   1934 istfromTop(m),LateralDistfromLeftBank,Branch#,ParticleInModel(=0),JDAYleftsystem,DetentionTime(days),RemovalMechanism,SedVel
   1934 ocity(m/d),DateStart,',('MonitorDate',I,I=1,NMONITORS) !Monitor2Date, Monitor3Date'
   1935    ELSE
   1936        write(FINALFN,'(A214,<NMONITORS>(A11,I2,","))')'Part#,Seg#,XLocationwithinSegmentfromUpstreamSide(m),Layer#,VerticalD
   1936 istfromTop(m),LateralDistfromLeftBank,Branch#,ParticleInModel(=0),JDAYleftsystem,DetentionTime(days),RemovalMechanism,SedVel
   1936 ocity(m/d),DateStart,',('MonitorDate',I,I=1,NMONITORS) !Monitor2Date, Monitor3Date'
   1937    ENDIF
   1938    
   1939     do jf=1,nfish     
   1940     write(FINALFN,'(i7,",",1x,10(f10.3,","),f8.4,",",f12.4,",",100(f10.3,","))')jf,fishes(jf,1),fishes(jf,2),fishes(jf,3),fi
   1940 shes(jf,4),fishes(jf,5),fishes(jf,6),fishes(jf,12),fishes(jf,14),fishes(jf,15),fishes(jf,16),sedvel(jf),delaydate(jf),(tmoni
   1940 tor(jf,ii),ii=1,nmonitors)
   1941     end do
   1942 
   1943     
   1944     CALL HISTOGRAM_OUTPUT
   1945     close(FINALFN)
   1946 ! End fish output section
   1947     CALL PARTICLE_DEALLOCATE                                           !FISH
   1948 
   1949       Return                                                               !FISH
   1950 End Subroutine FishOutput

