   1985 (K,I,JE)    ! cb 5/19/06
   1986       END DO
   1987       DO JD=1,NBOD
   1988         IF(BOD_CALC(JD))SEDCB(K,I) = SEDCB(K,I)+MAX(CBODS(JD),0.0)*CBOD(K,I,JD)*BIBH2(K,I)/O2OM(JW)           !BI(K,I)/BH2(K
   1988 ,I)*(1.0-BI(K+1,I)/BI(K,I))

