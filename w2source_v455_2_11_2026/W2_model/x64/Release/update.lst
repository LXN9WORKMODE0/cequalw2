    119 
    120   DO JW = 1,NWB 
    121     IF (ULTIMATE(JW)) THEN   ! SR 5/15/06
    122       IF(LAYERCHANGE(JW) == .TRUE.)THEN
    123       DO K=KTWB(JW),KMX    ! only need to update this for KT - if layer change then update for all variables to be safe esp 
    123 for seg additions                       !DO K=2,KMX   KTWB(JW),KMX
    124       RATZ(K,JW)  =  AVH2(K-1,DS(BE(JW)))/AVH2(K,DS(BE(JW)))                                         ! SW 5/20/05
    125       CURZ1(K,JW) =  2.0D0*H(K,JW)*H(K,JW)/((AVH2(K-1,DS(BE(JW)))+AVH2(K,DS(BE(JW))))*AVH2(K-1,DS(BE(JW))))   ! SW 5/20/05  
    125  4/20/16 SPEED
    126       CURZ2(K,JW) = -2.0D0*H(K,JW)*H(K,JW)/(AVH2(K-1,DS(BE(JW)))*AVH2(K,DS(BE(JW))))                          ! SW 5/20/05
    127       CURZ3(K,JW) =  2.0D0*H(K,JW)*H(K,JW)/((AVH2(K-1,DS(BE(JW)))+AVH2(K,DS(BE(JW))))*AVH2(K,DS(BE(JW))))     ! SW 5/20/05
    128       END DO
    129       ELSE
    130       DO K=KTWB(JW),KTWB(JW)+1
    131       RATZ(K,JW)  =  AVH2(K-1,DS(BE(JW)))/AVH2(K,DS(BE(JW)))                                         ! SW 5/20/05
    132       CURZ1(K,JW) =  2.0D0*H(K,JW)*H(K,JW)/((AVH2(K-1,DS(BE(JW)))+AVH2(K,DS(BE(JW))))*AVH2(K-1,DS(BE(JW))))   ! SW 5/20/05  
    132 4/20/16 SPEED
    133       CURZ2(K,JW) = -2.0D0*H(K,JW)*H(K,JW)/(AVH2(K-1,DS(BE(JW)))*AVH2(K,DS(BE(JW))))                        ! SW 5/20/05
    134       CURZ3(K,JW) =  2.0D0*H(K,JW)*H(K,JW)/((AVH2(K-1,DS(BE(JW)))+AVH2(K,DS(BE(JW))))*AVH2(K,DS(BE(JW))))     ! SW 5/20/05
    135       END DO
    136       ENDIF
    137     END IF
    138     END DO
    139     NIT     =  NIT+1
    140     ELTM    =  ELTM+DLT
    141     ELTMS   =  ELTMS+DLT
    142     ELTMF   =  ELTMF+DLT
    143     JDAY    =  ELTM/DAY
    144     ELTMJD  =  JDAY-TMSTRT
    145     END_RUN =  JDAY >= TMEND
    146     DLT     =  DMAX1(DLTMIN,DLTFF*CURMAX)    ! SW 7/13/2010
    147     DLT     =  DMIN1(DLT,1.1*DLTS)
    148     DLTAV   = (ELTM-TMSTRT*DAY)/NIT
    149     IF (DLT <  MINDLT) THEN
    150       MINDLT = DLTS
    151       JDMIN  = JDAY
    152     END IF
    153         IF (JDAY >= DLTD(DLTDP+1))THEN
    154         DLTDP = DLTDP+1
    155         DLTMAXX=DLTMAX(DLTDP)
    156         DLTFF=  DLTF(DLTDP)
    157         ENDIF
    158      IF(DLTDP < NDLT .AND. DLTINTER == '      ON')THEN              ! SW 7/13/2010
    159      DLTMAXX=DLTMAX(DLTDP)+((DLTMAX(DLTDP+1)-DLTMAX(DLTDP))/(DLTD(DLTDP+1)-DLTD(DLTDP)))*(JDAY-DLTD(DLTDP))
    160      DLTFF=DLTF(DLTDP)+((DLTF(DLTDP+1)-DLTF(DLTDP))/(DLTD(DLTDP+1)-DLTD(DLTDP)))*(JDAY-DLTD(DLTDP))
    161      ENDIF
    162 
    163     IF (DLT  >  DLTMAXX)DLT=DLTMAXX
    164     CURMAX = DLTMAXX/DLTFF           ! SW 7/13/2010

