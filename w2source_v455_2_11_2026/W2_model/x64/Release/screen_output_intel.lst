     58 SUBROUTINE RUN_W2 (DLG,CONTROL_NAME,ACTION)
     59   USE IFWIN, RENAMED => DLT; USE IFLOGM; USE MSCLIB; USE GLOBAL, ONLY: CDATE, CCTIME;  USE MAIN, ONLY: END_RUN              
     59  !Rename DLT in DFWIN   DFLOGM  DFWIN
     60   IMPLICIT NONE
     61   INTEGER                             :: ACTION, IDTHREAD, CONTROL_NAME, I
     62   LOGICAL                             :: RESULT
     63   CHARACTER(8)                        :: TIME
     64   CHARACTER(72)                       :: TEXT
     65   CHARACTER(1000)                     :: TEXT1
     66   TYPE(DIALOG)                        :: DLG
     67   TYPE(T_SECURITY_ATTRIBUTES),POINTER :: NULL_SA
     68   INTERFACE
     69     INTEGER FUNCTION CE_QUAL_W2 (H)
     70 !DEC$ATTRIBUTES STDCALL :: CE_QUAL_W2
     71       INTEGER :: H
     72     END FUNCTION
     73   END INTERFACE
     74 
     75   SELECT CASE (CONTROL_NAME)
     76     CASE (RUN)
     77       CALL BLANK_DIALOG  (DLG)
     78       CALL DATE_AND_TIME (CDATE,CCTIME)
     79       RESTART_PUSHED = .FALSE.
     80       STOP_PUSHED    = .FALSE.
     81       HTHREAD        =  CREATETHREAD (0,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))          !Start W2 in a new thread    CR
     81 EATETHREAD (NULL_SA,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))
     82       TIME           =  CCTIME(1:2)//':'//CCTIME(3:4)//':'//CCTIME(5:6)
     83       RESULT         =  DLGSET (DLG,RUN,           .FALSE.,DLG_ENABLE)                             !Disable 'Run'     button
     84       RESULT         =  DLGSET (DLG,CLOSE,         .FALSE.,DLG_ENABLE)                             !Disable 'Run'     button
     85       RESULT         =  DLGSET (DLG,RESTART,       .FALSE.,DLG_ENABLE)                             !Disable 'Restart' button
     86       RESULT         =  DLGSET (DLG,STOP_EXECUTION,.TRUE., DLG_ENABLE)                             !Enable  'Stop'    button
     87       RESULT         =  DLGSET (DLG,STARTING_TIME,TIME)                                            !Display starting time
     88       RESULT         =  DLGSET (DLG,STATUS,'Executing')                                            !Display execution status
     89     CASE (OUTPUT_DIALOG)
     90       CALL BLANK_DIALOG  (DLG)
     91       CALL DATE_AND_TIME (CDATE,CCTIME)
     92       RESTART_PUSHED = .FALSE.
     93       STOP_PUSHED    = .FALSE.
     94       HTHREAD        =  CREATETHREAD (0,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))          !Start W2 in a new thread    CR
     94 EATETHREAD (NULL_SA,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))
     95       TIME           =  CCTIME(1:2)//':'//CCTIME(3:4)//':'//CCTIME(5:6)
     96       RESULT         =  DLGSET (DLG,RUN,           .FALSE.,DLG_ENABLE)                             !Disable 'Run'     button
     97       RESULT         =  DLGSET (DLG,CLOSE,         .FALSE.,DLG_ENABLE)                             !Disable 'Run'     button
     98       RESULT         =  DLGSET (DLG,RESTART,       .FALSE.,DLG_ENABLE)                             !Disable 'Restart' button
     99       RESULT         =  DLGSET (DLG,STOP_EXECUTION,.TRUE., DLG_ENABLE)                             !Enable  'Stop'    button
    100       RESULT         =  DLGSET (DLG,STARTING_TIME,TIME)                                            !Display starting time
    101       RESULT         =  DLGSET (DLG,STATUS,'Executing')                                            !Display execution status
    102     CASE (STOP_EXECUTION)
    103       STOP_PUSHED = .TRUE.

Page 6           Source Listing                  RUN_W2
2026-03-30 08:48                                 ..\..\..\screen_output_intel.f90

    104       END_RUN     = .TRUE.
    105       RESULT = DLGSET      (DLG,STOP_EXECUTION,.FALSE.,DLG_ENABLE)                                 !Disable 'Stop'    button
    106       RESULT = DLGSET      (DLG,RUN,           .TRUE., DLG_ENABLE)                                 !Enable  'Run'     button
    107       RESULT = CLOSEHANDLE (HTHREAD)                                                               !Close thread handle
    108     CASE (RESTART)
    109       STOP_PUSHED    = .FALSE.
    110       RESTART_PUSHED = .TRUE.
    111       END_RUN        = .FALSE.
    112       HTHREAD        =  CREATETHREAD (0,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))          !Start W2 in a new thread    CR
    112 EATETHREAD (NULL_SA,0,LOC(CE_QUAL_W2),LOC(DLG),0,LOC(IDTHREAD))
    113       RESULT         =  DLGSET       (DLG,ENDING_TIME,   ' ')
    114       RESULT         =  DLGSET       (DLG,RUN,           .FALSE.,DLG_ENABLE)                       !Disable 'Run'     button
    115       RESULT         =  DLGSET       (DLG,CLOSE,         .FALSE.,DLG_ENABLE)                       !Disable 'Run'     button
    116       RESULT         =  DLGSET       (DLG,RESTART,       .FALSE.,DLG_ENABLE)                       !Disable 'Restart' button
    117       RESULT         =  DLGSET       (DLG,STOP_EXECUTION,.TRUE., DLG_ENABLE)                       !Enable  'Stop'    button
    118       RESULT         =  DLGSET       (DLG,STATUS,'Executing')                                      !Display execution status
    119     CASE (HIGHEST)
    120       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    121       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_HIGHEST)                                 !Set highest priority
    122       RESULT = DLGSET            (DLG,HIGHEST,.FALSE.,DLG_ENABLE)                                  !Disable 'Highest' button
    123     CASE (HIGH)
    124       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    125       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_ABOVE_NORMAL)                            !Set high    priority
    126       RESULT = DLGSET            (DLG,HIGH,   .FALSE.,DLG_ENABLE)                                  !Disable 'High'   button
    127     CASE (NORMAL)
    128       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    129       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_NORMAL)                                  !Set normal  priority
    130       RESULT = DLGSET            (DLG,NORMAL, .FALSE.,DLG_ENABLE)                                  !Disable 'Normal' button
    131     CASE (LOW)
    132       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    133       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_BELOW_NORMAL)                            !Set low     priority
    134       RESULT = DLGSET            (DLG,LOW,    .FALSE.,DLG_ENABLE)                                  !Disable 'Low'    button
    135     CASE (LOWEST)
    136       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    137       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_LOWEST)                                  !Set lowest  priority
    138       RESULT = DLGSET            (DLG,LOWEST, .FALSE.,DLG_ENABLE)                                  !Disable 'Lowest' button
    139     CASE (IDLE)
    140       CALL ENABLE (DLG)                                                                            !Enable  priority buttons
    141       I      = SETTHREADPRIORITY (HTHREAD,THREAD_PRIORITY_IDLE)                                    !Set idle priority
    142       RESULT = DLGSET            (DLG,IDLE,   .FALSE.,DLG_ENABLE)                                  !Disable 'Idle'   button
    143   END SELECT
    144 RETURN
    145 
