    557     IF(DERIVED_CALC)then
    558       CDAVGW(JWD,CDN(1:NACD(JW),JW))=CDAVGW(JWD,CDN(1:NACD(JW),JW))/QSUMWD
    559 !if(tdgon)then                ! cb 11/6/17
