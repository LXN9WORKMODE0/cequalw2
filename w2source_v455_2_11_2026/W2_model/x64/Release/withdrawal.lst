   3714 !***************************************************************************************************************************
   3714 ********
   3715 !**                                                S E T _ F L O W _ F R A C T I O N S                                      
   3715       **
   3716 !***************************************************************************************************************************
   3716 ********
   3717 ! Entire routine added/modified by S. Rounds, 06/26/13
   3718 Subroutine Set_Flow_Fractions
   3719   Use Selective1USGS                                                          ! This routine sets the flow fractions, and th
   3719 en
   3720   IMPLICIT NONE                                                               ! redistributes flow to other outlets in the s
   3720 ame
   3721   integer :: n, nj, nexcess, j, jb, jst, jwd, j2pref                          ! group when one or more outlets exceed their 
   3721 maximum
   3722   real    :: excess_frac, addfrac                                             ! flow rates.  Excess flow that cannot be acco
   3722 mmodated
   3723 Return                                                                        ! within each group will be discarded.
   3724 
   3725 
   3726 Entry Set_Flow_Fracs(j, jb, j2pref)
   3727   excess_frac = 0.0                                                           ! Excess flow above maximum release rates
   3728   nexcess     = 0                                                             ! Number of group 1 outlets exceeding maximum 
   3728 rates
   3729 
   3730 ! Set and rebalance release fractions for group 1 structures
   3731   if (tspltcntr(j) == '      ST') then
   3732     do n=1,ng1                                                                ! Find maxed-out outlets in group 1; set flows
   3732  to max
   3733       jst = jstsplt(j,nout1(n))
   3734       qstrfrac(jst,jb) = minfrac1(n) + (qfrac1 - sum_minfrac1) / ng1
   3735       if (qstrfrac(jst,jb) > maxfrac1(n)) then
   3736         nexcess = nexcess + 1
   3737         excess_frac = excess_frac + qstrfrac(jst,jb) - maxfrac1(n)
   3738         qstrfrac(jst,jb) = maxfrac1(n)
   3739       end if
   3740     end do
   3741     if (excess_frac > 0.0 .and. ng1 - nexcess > 0) then                       ! Redistribute excess flow to other outlets in
   3741  group
   3742       do nj=1,ng1                                                             ! Iterative process, in case others get maxed-
   3742 out
   3743         if (ng1 == nexcess .or. excess_frac <= 0.00001) exit
   3744         addfrac = excess_frac / (ng1 - nexcess)
   3745         do n=1,ng1
   3746           jst = jstsplt(j,nout1(n))
   3747           if (maxfrac1(n) - qstrfrac(jst,jb) > 0.00001) then

Page 105         Source Listing                  SET_FLOW_FRACTIONS
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

   3748             if (qstrfrac(jst,jb) + addfrac > maxfrac1(n)) then
   3749               nexcess = nexcess + 1
   3750               excess_frac = excess_frac - (maxfrac1(n) - qstrfrac(jst,jb))
   3751               qstrfrac(jst,jb) = maxfrac1(n)
   3752             else
   3753               excess_frac = excess_frac - addfrac
   3754               qstrfrac(jst,jb) = qstrfrac(jst,jb) + addfrac
   3755             end if
   3756           end if
   3757         end do
   3758       end do
   3759     end if
   3760 
   3761 ! Set and rebalance release fractions for group 1 withdrawals
   3762   else
   3763     do n=1,ng1                                                                ! Find maxed-out outlets in group 1; set flows
   3763  to max
   3764       jwd = jstsplt(j,nout1(n))
   3765       qwdfrac(jwd) = minfrac1(n) + (qfrac1 - sum_minfrac1) / ng1
   3766       if (qwdfrac(jwd) > maxfrac1(n)) then
   3767         nexcess = nexcess + 1
   3768         excess_frac = excess_frac + qwdfrac(jwd) - maxfrac1(n)
   3769         qwdfrac(jwd) = maxfrac1(n)
   3770       end if
   3771     end do
   3772     if (excess_frac > 0.0 .and. ng1 - nexcess > 0) then                       ! Redistribute excess flow to other outlets in
   3772  group
   3773       do nj=1,ng1                                                             ! Iterative process, in case others get maxed-
   3773 out
   3774         if (ng1 == nexcess .or. excess_frac <= 0.00001) exit
   3775         addfrac = excess_frac / (ng1 - nexcess)
   3776         do n=1,ng1
   3777           jwd = jstsplt(j,nout1(n))
   3778           if (maxfrac1(n) - qwdfrac(jwd) > 0.00001) then
   3779             if (qwdfrac(jwd) + addfrac > maxfrac1(n)) then
   3780               nexcess = nexcess + 1
   3781               excess_frac = excess_frac - (maxfrac1(n) - qwdfrac(jwd))
   3782               qwdfrac(jwd) = maxfrac1(n)
   3783             else
   3784               excess_frac = excess_frac - addfrac
   3785               qwdfrac(jwd) = qwdfrac(jwd) + addfrac
   3786             end if
   3787           end if
   3788         end do
   3789       end do
   3790     end if
   3791   end if
   3792 
   3793 Entry Set_Flow_Fracs2(j, jb, j2pref)                                          ! Separate entry just for group 2 outlets

