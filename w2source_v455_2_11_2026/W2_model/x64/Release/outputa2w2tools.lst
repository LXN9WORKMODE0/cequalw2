     89 ! BIOEXP MLM
     90   IF (BIOEXP) THEN  
     91     IF (JDAY.GE.NXTBIO) THEN   
     92       NXTBIO = NXTBIO+BIOF(1)  ! mlm3
     93       DO J=1,NIBIO  
     94           
     95         I = IBIO(J)  
     96         DO JW=1,NWB  
     97           IF (I >= US(BS(JW))-1 .AND. I <= DS(BE(JW))+1) EXIT  
     98         END DO  
     99 ! bioexp
    100         DO K = KTWB(JW),KBI(I)  
    101           DO JC = NZOOS,NZOOE  

