    169       read(nunit,*)A_JUNK,AOD500nm
    170       read(nunit,*)A_JUNK,TZONE
    171       CLOSE(NUNIT)
    172   else
    173       cc_lw=0.0017
    174       cc_sw=0.0065
    175       I_lwat=0
    176       I_sw=0
    177   endif
