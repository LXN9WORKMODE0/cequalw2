     48             SW(K,I)    = W(K,I)
     49             T2(K,I)    = T1(K,I)
     50             SAZ(K,I)   = AZ(K,I)
     51             H2(K,I)    = H1(K,I)
     52             BHRATIO(K,I) = BH2(K,I)/BH1(K,I)   ! USED FOR TKE COMPUTATION
     53             BH2(K,I)   = BH1(K,I)

