2026-03-30 08:47                                 ..\..\..\waterbody.f90

    493       EL1 = ELL(K)
    494       IF (ELL(K) == ELR(KR)) KR = KR+1
    495     ELSE
    496       Q1 = 0.0
    497       DO WHILE (ELL(K) <= ELR(KR))
    498         IF (KR /= KTWB(JW)+1) THEN
    499           FRAC = (EL1-ELR(KR))/(H(KR-1,JW))
    500         ELSE
    501           FRAC = (EL1-ELR(KR))/(H2(KT,IU))
    502         END IF
    503         Q1  = Q1+VOLUH2(KR-1,JB)/DLT*FRAC
    504         EL1 = ELR(KR)
    505         KR  = KR+1
    506         IF (KR > KB(IU)+1) EXIT
    507       END DO
    508       IF (H(KR-1,JW) /= 0.0) THEN
    509         FRAC = (EL1-ELL(K))/H(KR-1,JW)
    510         QU(K-1,UHS(JB)) = Q1+FRAC*VOLUH2(KR-1,JB)/DLT
    511       ELSE
    512         QU(K-1,UHS(JB)) = Q1
    513       END IF
    514       QSS(K-1,UHS(JB)) = QSS(K-1,UHS(JB))-QU(K-1,UHS(JB))
    515       IF (KR > KB(IU)+1) EXIT
    516       EL1 = ELL(K)
    517     END IF
    518   END DO
    519 RETURN
