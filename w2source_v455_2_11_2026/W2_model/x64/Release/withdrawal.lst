   2162 !***************************************************************************************************************************
   2162 ********
   2163 !**                                                   S E L E C T I V E                                                     
   2163       **
   2164 !***************************************************************************************************************************
   2164 ********
   2165 
   2166 Subroutine SelectiveUSGS
   2167   Use Selective1USGS; USE MAIN
   2168   USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
   2169   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
   2170   IMPLICIT NONE
   2171 
   2172   integer :: ifile, j2lo, j2hi, j2max, j2min, j2pref, jj, jjw, jst, kk, ks
   2173   integer :: n, ng0, ng1max, ng1min, nj, num_left, num_noflow, prior1, prior2
   2174   real    :: addfrac, blendfrac, daytest, elev1, elev2, elr, etemp, etemp1, etemp2, excess_frac
   2175   real    :: lastfrac, lastfrac2, maxelev, maxtemp, minelev, mintemp, q_notblended, qall
   2176   real    :: sum_minfrac0, sum_maxfrac1, sum_maxfrac2, sumelev, sumfrac, sumtemp, tcomp, tempest, tmod, ttarg, wsel
   2177 
   2178   str_active = .FALSE.
   2179   wd_active  = .FALSE.
   2180   j2pref     = 1
   2181 
   2182 ! Update some date variables and determine which outlets are being actively blended or adjusted.
   2183   if (tspltc == '      ON') then
   2184     do j=1,numtsplt
   2185       if (tsyearly(j) == '     OFF') then
   2186         daytest = jday
   2187       else
   2188         daytest = real(jdayg) + jday - int(jday)
   2189       end if
   2190       if (nxtsplit > tstsrt(j) .and. daytest <= tstsrt(j)) then
   2191         nxtsplit = tstsrt(j)
   2192       end if
   2193       if (daytest >= tstsrt(j) .and. daytest < tstend(j)) then
   2194         do jj=1,nouts(j)
   2195           if (tspltcntr(j) == '      ST') then
   2196             str_active(jstsplt(j,jj),tspltjb(j)) = .TRUE.
   2197           else if (tspltcntr(j) == '      WD') then
   2198             wd_active(jstsplt(j,jj)) = .TRUE.
   2199           end if
   2200         end do
   2201       end if
   2202     end do
   2203   end if
   2204   if (tempc == '      ON') then
   2205     do j=1,numtempc
   2206       if (tcyearly(j) == '     OFF') then
   2207         daytest = jday
   2208       else
   2209         daytest = real(jdayg) + jday - int(jday)
   2210       end if
   2211       if (daytest >= tctsrt(j) .and. daytest < tctend(j)) then
   2212         if (tcntr(j) == '      ST') then
   2213           str_active(tcjs(j),tcjb(j)) = .TRUE.

