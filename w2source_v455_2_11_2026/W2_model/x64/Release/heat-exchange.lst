     50   END IF
     51   else
     52   IF (A0 > 0.0) THEN
     53     SRON(NMet) = (1.0-CC_SW*CLOUD(NMet)*CLOUD(NMet))*24.0*(2.044*A0+0.1296*A0**2-1.941E-3*A0**3+7.591E-6*A0**4)*BTU_FT2_DAY_
     53 TO_W_M2
     54   ELSE
     55     SRON(NMet) = 0.0
     56   END IF
     57   endif
     58   ENDIF
     59   
     60   
     61 RETURN
