      4 USE MAIN
      5 USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
      6   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
      7 ! MACROPHYTEC, POROSITYC, ZOOPLANKTONC removed - water quality related (MACROPHYTE_CALC references are commented out)
      8   IMPLICIT NONE
      9   EXTERNAL RESTART_OUTPUT
