   1519           IF(TCYEARLY(J) == '     OFF')THEN
   1520             DAYTEST=JDAY
   1521           ELSE
   1522             DAYTEST=REAL(JDAYG)+JDAY-INT(JDAY)
   1523           END IF
   1524           IF(DAYTEST >= TCTSRT(J) .AND. DAYTEST < TCTEND(J))THEN
   1525                IF(TCOMP > TCTEMP(J) .AND. TCNELEV(J) > NCOUNTCW(JWD))THEN
   1526 ! MAKING SURE THAT THE NEXT LOWER STRUCTURE FOR A PARTICULAR 'J' IS FOUND
   1527                  DO NN=NCOUNTCW(JWD)+1,TCNELEV(J)                 
   1528                    IF(TCELEV(J,NN) < EWD(JWD))THEN
   1529                       NCOUNTCW(JWD)=NN
   1530                       EWD(JWD)=TCELEV(J,NCOUNTCW(JWD))
   1531                       EXIT
   1532                    END IF                 
   1533                  END DO                                               
   1534                ELSEIF(TCOMP < TCTEMP(J) .AND.  NCOUNTCW(JWD).GT. 1)THEN
   1535 ! TO PREVENT THIS HAPPENING AT EACH TIME IT CHECKS IT AND HENCE OSCIALLTING BACK AND FORTH - CHECK THE TEMP AT THE UPPER OUT
   1535 LET ALSO
   1536                  IF(TCISEG(J) >  0)THEN  
   1537                       TMOD=T2(K,TCISEG(J))                      

