   2203         XDUM=MAX(CBODS(JD),0.0)*CBOD(K,I,JD)*BIBH2(K,I)*RBOD(JD)/O2OM(JW)
   2204         SEDSUMK = SEDSUMK+XDUM*CBODD(K,I,JD)               
