    200 SUBROUTINE MEEUS
    201   USE GLOBAL; USE GDAYC; USE SURFHE; USE TVDC; USE SHADEC; USE MetFileRegion; USE MAIN, ONLY:CC_SW,TZONE
    202   USE Bird_Meeus;use screenc, only: JDAY
    203   IMPLICIT NONE
    204 
    205 ! Calculates Solar position and radiation from Meeus code, currently set up for clear skies only
    206 !if(debug_Meeus==1.and.NIT==0)then
    207 !  open(9595,file='meeus_debug.csv',status='unknown')
    208 !  write(9595,'(A)')'jday,jdaym,t,jd,globalHz,solarzen,RC1,Selev,azimuth,azRad,csz,hourangle,ETime,y,LO,r,ep,EQT,day_decimal
    208 ,year,imon,jdayg,zenith'
    209 !  open(9596,file='meeus_debug2.csv',status='unknown')
    210 !  write(9596,'(A)')'jdaym,Uo,AM,diffuseHz,global_hz,direct_Hz,Ias,toh,tum,tw,taa,am,tr,ta,birdetr,rs,Uw,tdew,sw_BA,sw_albed
    210 o,ELWS(DS(BE(JW))),sw_k1'
    211 !endif
    212       
    213     Jdaym=JDAY-TZONE/24.0
    214 
    215     HOUR_M  =  (Jdaym-INT(Jdaym))*24        
    216     day_decimal = GDAY + HOUR_M/24.0
    217     
    218     if(IMON <= 2)then
    219     year9 = year - 1
    220     month9 = IMON + 12
    221     else
    222     year9=year
    223     month9=imon
    224     end if   
    225 
    226     A9 = FLOOR(year9/100.0)   
    227     B9 = 2.0 - A9 + FLOOR(A9/4.0)   
    228     jd = FLOOR(365.25*(year9+4716.0)) + FLOOR(30.6001*(month9+1))+day_decimal + B9 - 1524.5         ! Eq 7.1, pg 61
    229 
    230 ! time in Julian centuries from epoch J2000.0
    231       t = (jd-2451545.0)/36525.0                                                               ! Eq 25.1, pg 163
    232 ! julian ephemeris millennium
    233       jme  = t/10.0
    234 
    235 ! calculate the Geometric Mean Longitude of the Sun, degrees
    236       LO = 280.46646+t*(36000.76983+0.0003032*t)                                               ! Eq 25.2, pg 163
    237 !      LO = 280.4664567+36000.76982779*t+0.0003032028*(t**2)+(t**3)/49931-(t**4)/15300-(t**5)/2000000 ! Eq 28.2, pg 183, dif
    237 ference with line above is negligible
    238       DO WHILE(LO > 360 .or. LO < 0)
    239        If(LO > 360.0) LO = LO - 360
    240        If(LO < 0.0)   LO = LO + 360
    241       END DO
    242 ! calculate the Geometric Mean Anomaly of the Sun, degrees
    243       M = 357.52911 + t*(35999.05029-0.0001537*t)                                              ! Eq 25.3, pg 163
    244 ! calculate the eccentricity of earth's orbit
    245       e = 0.016708634 - t*(0.000042037+0.0000001267*t)                                         ! Eq 25.4, pg 163
    246 ! calculate the equation of center for the sun, degrees
    247       Mrad = DToR*M
    248       sinM = Sin(Mrad)
    249       sin2M = Sin(2*Mrad)
    250       sin3M = Sin(3*Mrad)
    251       c = sinM*(1.914602-t*(0.004817+0.000014*t))+sin2M*(0.019993-0.000101*t)+sin3M*0.000289   ! Between Eq 25.4 and Eq 25.5
    251 , pg 164

Page 12          Source Listing                  MEEUS
2026-03-30 08:47                                 ..\..\..\heat-exchange.f90

    252 ! calculate the true longitude of the sun, degrees
    253       TLO = LO + c                                                                             ! Between Eq 25.4 and Eq 25.5
    253 , pg 164
    254 ! calculate the true anomaly of the sun, degrees
    255       v = M + c                                                                                ! Between Eq 25.4 and Eq 25.5
    255 , pg 164
    256 ! calculate the distance to the sun in AU
    257       r = (1.000001018*(1 - e*e))/(1 + e*Cos(DToR*v))                                          ! Eq 25.5, pg 164
    258 ! calculate the apparent longitude of the sun, degrees
    259       omega = 125.04 - 1934.136*t                                                              ! Between Eq 25.5 and Eq 25.6
    259 , pg 164
    260 !      omega  = 125.04452 - 1934.136261*t+0.0020708*(t**2)+(t**3)/45000                        ! Equation on page 144, diffe
    260 rence with line above is negligible
    261       lambda = TLO - 0.00569 - 0.00478*Sin(DToR*omega)                                         ! Between Eq 25.5 and Eq 25.6
    261 , pg 164
    262 ! calculate the mean obliquity of the ecliptic, degrees
    263       seconds = 21.448 - t*(46.8150 + t*(0.00059 - 0.001813*t))                                ! Eq 22.2, pg 147
    264       e0 = 23.0 + (26.0 + (seconds/60.0))/60.0                                                 ! Eq 22.2, pg 147
    265 ! calculate the corrected obliquity of the ecliptic, degrees
    266       ep = e0 + 0.00256 * Cos(DToR*omega)
    267 !      ep = e0 + (9.20/3600.0)*Cos(DToR*omega)+(0.57/3600.0)*cos(DToR*2*LO)                    ! Eq on page 144, still trunc
    267 ated though here in code, difference with line above is negligible
    268 
    269 ! earth heliocentric latitude, BB, degrees, Equations 9 to 12, NREL/TP-560-34302
    270 !B0   = 280.0*Cos(3.199+84334.662*jme)+102.0*Cos(5.422+5507.553*jme)+  &
    271 !        80.0*Cos(3.880+ 5223.690*jme)+ 44.0*Cos(3.700+2352.870*jme)+  &
    272 !        32.0*Cos(4.000+ 1577.340*jme)
    273 !B1   =   9.0*Cos(3.900+ 5507.550*jme)+  6.0*Cos(1.730+5223.690*jme)
    274 !BB   = ((B0+B1*jme)/100000000.0)*RToD
    275 ! geocentric latitude, Beta, degrees
    276 !      Beta = -1.0*BB
    277 ! calculate the right ascension of the sun, degrees
    278       tananum = Cos(DToR*ep) * Sin(DToR*lambda)
    279 !      tananum   = Cos(DToR*ep)*Sin(DToR*lambda)-tan(DToR*Beta)*Sin(DToR*ep)                   ! Eq 13.3 on page 93, differe
    279 nce with line above is negligible
    280       tanadenom = Cos(DToR*lambda)                                                             ! Eq 13.3 on page 93
    281 ! Javascript and FORTRAN use same format, Atan2(Y,X)
    282       alpha = RtoD*atan2(tananum, tanadenom)                                                   ! Eq 13.3 on page 93
    283 
    284 ! calculate the declination of the sun, degrees
    285       sint = Sin(DToR*ep) * Sin(DToR*lambda)
    286 !      sint = Sin(DToR*ep)*Sin(DToR*lambda)*Cos(DToR*Beta)+Cos(DToR*ep)*Sin(DToR*Beta)         ! Eq 13.4 on page 93, differe
    286 nce with line above is negligible
    287       theta = RToD*Asin(sint)                                                                  ! Eq 13.4 on page 93
    288 
    289 ! calculate the equation of time, the difference between true solar time
    290 ! and mean solar time, in minutes of time
    291       y = (Tan(DToR*ep/2.0))**2
    292       sin2LO = Sin(2.0*DToR*LO)
    293       cos2LO = Cos(2.0*DToR*LO)
    294       sin4LO = Sin(4.0*DToR*LO)
    295       Etime = y*sin2LO - 2.0*e*sinM + 4.0*e*y*sinM*cos2LO - 0.5*y*y*sin4LO - 1.25*e*e*sin2M    ! Eq 28.3 on page 185
    296       EQT = RToD*Etime*4.0
    297 
    298 ! change sign convention for longitude from negative to positive in western hemisphere
    299       if(LongIT(JW) < 0.0)then
    300        Long2(JW) = LongIT(JW)*-1.0

Page 13          Source Listing                  MEEUS
2026-03-30 08:47                                 ..\..\..\heat-exchange.f90

    301       else
    302        Long2(JW) = LongIT(JW)
    303       end if
    304       if(Lat(JW) > 89.8)  Lat(JW) = 89.8
    305       if(Lat(JW) < -89.8) Lat(JW) = -89.8
    306 
    307       solarTimeFix = EQT - 4.0*Long2(JW) !+ 60.0*TZ(i)  ! in minutes
    308       trueSolarTime = HOUR_M*60.0 + solarTimeFix   !in minutes
    309 
    310       if(trueSolarTime > 1440)then
    311        trueSolarTime = trueSolarTime - 1440
    312       end if
    313             
    314       hourangle = trueSolarTime/4.0 - 180.0
    315 
    316 !Thanks to Louis Schwarzmayr for the next line:
    317       if(hourangle < -180.0)hourangle = hourangle + 360.0
    318 
    319 !Solar zenith (Solar altitude)
    320       harad = DToR*hourangle
    321       csz = Sin(DToR*Lat(JW))*Sin(DToR*theta) + Cos(DToR*Lat(JW))*Cos(DToR*theta)*Cos(harad)
    322       if(csz > 1.0) Then
    323        csz = 1.0
    324       else if(csz < -1.0) Then
    325        csz = -1.0
    326       end if
    327       zenith = RToD*Acos(csz)
    328 
    329 !Solar azimuth
    330       azDenom = Cos(DToR*Lat(JW))*Sin(DToR*zenith)
    331       if(Abs(azDenom) > 0.001)then
    332        azRad = ((Sin(DToR*Lat(JW))*Cos(DToR*zenith)) - Sin(DToR*theta))/azDenom
    333        if(Abs(azRad) > 1.0)then
    334         if(azRad < 0.0)then
    335          azRad = -1.0
    336         else
    337          azRad = 1.0
    338         end if
    339        end if
    340        azimuth = 180.0 - RToD*Acos(azRad)
    341        if(hourangle > 0.0)then
    342         azimuth = azimuth*-1.0
    343        end if
    344       else
    345        if (Lat(JW) > 0.0)then
    346         azimuth = 180.0
    347        else
    348         azimuth = 0.0
    349        end if
    350       end if
    351 
    352       if(azimuth < 0.0)then
    353        azimuth = azimuth + 360.0
    354       end if
    355                         
    356 ! Correction for the effect of atmospheric refraction, NOAA website (SElev is Solar Altitude)
    357       SElev = 90.0 - zenith

Page 14          Source Listing                  MEEUS
2026-03-30 08:47                                 ..\..\..\heat-exchange.f90

    358       if(SElev > 85.0)then
    359        RC1 = 0.0
    360       else
    361        Te = Tan(DToR*SElev)
    362        if(SElev > 5.0 .and. SElev <= 85.0)   RC1 = (58.1/Te - 0.07/(Te**3) + 0.000086/(Te**5))/3600.0
    363        if(SElev > -0.575 .and. SElev <= 5.0) RC1 = (1735-518.2*SElev+103.4*SElev**2-12.79*SElev**3+0.711*SElev**4)/3600.0
    364        if(SElev < -0.575)                    RC1 = (-20.774/Te)/3600.0
    365       end if
    366 
    367        solarzen     = zenith - RC1                    ! solar zenith, corrected, degrees
    368        solarazimuth = azimuth                        ! solar azimuth, degrees
    369        solaralt     = 90.0 - solarzen                ! solar altitude, degrees
    370        solarzen     = solarzen*DToR                  ! solar zenith, radians
    371 
    372        Call Ozone
    373        Call BirdModel
    374        
    375     if(.not.Met_Regions)then
    376     SRON(JW) = globalHz*(1.0-CC_SW*CLOUD(JW)*CLOUD(JW))*0.94      ! assumes 6% reflection
    377     else
    378     SRON(NMet) = globalHz*(1.0-CC_SW*CLOUD(NMet)*CLOUD(NMet))*0.94
    379     END IF
    380   
    381     
    382 !if(debug_Meeus==1)then
    383 !    write(9595,'(19(f14.6,","),i10,",",i10,","i10,",",5(f14.6,","))')jday,jdaym,t,jd,globalHz,solarzen,RC1,Selev,azimuth,az
    383 Rad,csz,hourangle,ETime,y,LO,r,ep,EQT,day_decimal,year,imon,jdayg,zenith
    384 !endif
    385     RETURN
    386 
    387     END SUBROUTINE MEEUS

