   2331    SUBROUTINE HISTOGRAM
   2332    USE Fishy; USE GLOBAL; USE GEOMC; USE MAIN, ONLY: KBI
   2333    IMPLICIT NONE
   2334    REAL :: DepthParticle,V_CRIT,D_CRIT,T_CRIT
   2335    INTEGER :: N,K
   2336     
   2337     N=FN   ! N IS THE FISH NUMBER - THIS ROUTINE IS CALLED FOR EACH FISH FN
   2338 ! Velocity
   2339     K=FKMP
   2340     I=FIMP
   2341     DepthParticle=ELWS(I)-EL(K,I)+FZLOC
   2342     
   2343     IF(HIST_V.OR.HIST_T.OR.HIST_D)sumvolt(N)=sumvolt(N)+dlt   ! ONLY COMPUTED ONCE
   2344      
   2345         IF(HIST_V)THEN
   2346             v_tot(N)=v_tot(N)+u(k,i)*dlt
   2347             v_cnt(N)=v_cnt(N)+dlt
   2348             v_crit=vel_top
   2349             if(u(k,i).ge.vel_top)v_class(N,1)=v_class(N,1)+dlt
   2350             do jj=2,numclass
   2351               if(u(k,i).lt.v_crit.and.u(k,i).ge.v_crit-vel_int)then
   2352                 v_class(N,jj)=v_class(N,jj)+dlt
   2353                 go to 210
   2354               else
   2355                 v_crit=v_crit-vel_int
   2356               end if
   2357               if(jj.eq.numclass.and.u(k,i).lt.v_crit+vel_int)then
   2358                 v_class(N,jj)=v_class(N,jj)+dlt
   2359               end if
   2360             end do
   2361         ENDIF
   2362         
   2363 210       continue
   2364 
   2365              if(HIST_T)then
   2366 
   2367             t_tot(N)=t_tot(N)+t2(k,i)*dlt
   2368             t_cnt(N)=t_cnt(N)+dlt
   2369             t_crit=temp_top
   2370             if(t2(k,i).ge.temp_top)t_class(N,1)=t_class(N,1)+dlt
   2371             do jj=2,numclass
   2372               if(t2(k,i).lt.t_crit.and.t2(k,i).ge.t_crit-temp_int)then
   2373                 t_class(N,jj)=t_class(N,jj)+dlt
   2374                 go to 200
   2375               else
   2376                 t_crit=t_crit-temp_int
   2377               end if
   2378               if(jj.eq.numclass.and.t2(k,i).lt.t_crit+temp_int)then
   2379                 t_class(N,jj)=t_class(N,jj)+dlt
   2380               end if
   2381             end do
   2382           end if
   2383 200       continue    
   2384        
   2385 ! Depth
   2386            IF(HIST_D)THEN

Page 86          Source Listing                  HISTOGRAM
2026-03-30 08:48                                 ..\..\..\particle.f90

   2387             d_tot(N)=d_tot(N)+DepthParticle*dlt           ! SW changed all KB(I to KBI(I    8/2018              d_tot(N)=d_t
   2387 ot(N)+depthb(kbi(i),i)*dlt
   2388             d_cnt(N)=d_cnt(N)+dlt
   2389             d_crit=d_top
   2390             if(DepthParticle.ge.d_top)d_class(N,1)=d_class(N,1)+dlt                   ! if(depthb(kbi(i),i).ge.d_top)d_class
   2390 (N,1)=d_class(N,1)+dlt
   2391             do jj=2,numclass
   2392               if(DepthParticle.lt.d_crit.and.DepthParticle.ge.d_crit-d_int)then    ! if(depthb(kbi(i),i).lt.d_crit.and.depth
   2392 b(kbi(i),i).ge.d_crit-d_int)then
   2393                 d_class(N,jj)=d_class(N,jj)+dlt
   2394                 go to 300
