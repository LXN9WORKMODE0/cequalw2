2026-03-30 08:48                                 ..\..\..\particle.f90

   1498                     YRANGE = .5*H(K-1,WB)+.5*H(K,WB)
   1499                     FLOWFIELD(K,I,1) = (U(K-1,I-1)*(YRANGE-&
   1500                       .5*H(K-1,WB)) + U(K,I-1)*(YRANGE-.5*H(K,WB)))&
   1501                       /YRANGE
   1502                     XRANGE = .5*DLX(I-1)+.5*DLX(I)
   1503                     FLOWFIELD(K,I,2) = ((W(K-1,I-1)*(XRANGE-&
   1504                       .5*DLX(I-1)) + W(K-1,I)*(XRANGE-.5*DLX(I)))&
   1505                       /XRANGE)
   1506                   END IF
   1507                 ELSE
   1508 
   1509 !3rd ORDER NEWTON INTERPOLATING POLYNOMIAL used for interpolation of the Flow Field (i.e. Velocities)
   1510 !                                                 1
   1511 !                   O-----[VV]----O------[VV]------O-----[VV]----O------[VV]------O
   1512 !                   |             |                |             |                |
   1513 !                   |             |                |             |                |
   1514 !                  [HV]          [HV]             [HV]          [HV]             [HV]
   1515 !                   |             |                |             |                |
   1516 !                   |             |               2|             |                |
