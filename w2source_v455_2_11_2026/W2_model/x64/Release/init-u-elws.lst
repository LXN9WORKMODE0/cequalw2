    402       SUBROUTINE INITIAL_U_VELOCITY
    403       
    404       USE GLOBAL; USE GEOMC
    405       USE INITIALVELOCITY
    406       
    407       REAL :: XAREA, WSURF
    408       INTEGER :: K
    409 
    410       DO JW=1,NWB
    411         KT = KTWB(JW)
    412         
    413         DO JB=BS(JW),BE(JW)
    414           IF (SLOPE(JB) > 0.0 .AND. .NOT. LOOP_BRANCH(JB)) THEN
    415             IU = CUS(JB)
    416             ID = DS(JB)
    417             DO I=IU,ID
    418               WSURF=ELWS(I)              
    419               CALL XSECTIONAL_AREA(WSURF,XAREA)
    420               UAVG(I)=QSSI(I)/XAREA
    421               DO K=KT,KB(I)
    422                 U(K,I)=UAVG(I)
    423               END DO
    424             END DO
    425           END IF
    426         END DO
    427       END DO
    428                 
    429       RETURN
    430       END SUBROUTINE INITIAL_U_VELOCITY

