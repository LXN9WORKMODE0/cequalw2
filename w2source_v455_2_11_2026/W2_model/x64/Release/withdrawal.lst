    237 
    238 ENTRY DOWNSTREAM_WITHDRAWAL_ESTIMATE(JS,TEMPEST,ESTRTEST)
    239 
    240 ! VARIABLE INITIALIZATION
    241 
    242   HSWT = 0.0; HSWB = 0.0; VNORM = 0.0; QNEW = 0.0
    243 
    244 ! Water surface elevation
    245 
    246   ELR  = SINA(JB)*DLX(ID)*0.5
    247   WSEL = ELWS(ID)-ELR                   !EL(KT,ID)-Z(ID)*COSA(JB)                                                     !SR 12
    247 /19/2022
    248 
    249 ! Structure layer
    250 
    251   DO K=KT,KB(ID)
    252     IF (EL(K,ID)-ELR < estrtest) EXIT
    253   END DO
    254   KSTR = MAX(K-1,KT)
    255   KSTR = MIN(KSTR,KB(ID))
    256 
    257 ! Initial withdrawal limits
    258 
    259   KTOP = MAX(KTSW(JS,JB),KT)
    260   IF (KSTR < KTOP) KTOP = KSTR
    261   KBOT = MIN(KBSW(JS,JB),KB(ID))
    262   IF (KBOT <= KT .AND. KBOT /= KB(ID)) KBOT = KT+1
    263   IF (KBOT > KB(ID)) KBOT = KB(ID)                                                                                     !SW 0
    263 6/03/02
    264   ELSTR = ESTRTEST
    265   IF (ESTRTEST <= EL(KB(ID)+1,ID+1)-ELR) THEN                                                                       !SW 10/1

Page 6           Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    265 7/01
    266     KSTR  = KB(ID)
    267     ELSTR = EL(KB(ID),ID)-ELR                                                                                          !SW 1
    267 0/17/01
    268   END IF
    269   IF (ESTRTEST > EL(KT,ID)-ELR) ELSTR = WSEL
    270   IF (KBSW(JS,JB) < KSTR) THEN
    271     KSTR  = KTOP         !KT
    272     ELSTR = EL(KTOP,ID)  !WSEL                                                                                              
    272          !SW 10/05/00
    273   END IF
    274 
    275 ! Boundary interference
    276 
    277   COEF = 1.0
    278   IF (WSEL-(EL(KBOT,ID)-ELR) /= 0.0) THEN    ! SR 11/2021
    279     RATIO = (ELSTR-(EL(KBOT,ID)-ELR))/(WSEL-(EL(KBOT,ID)-ELR))                                                         !SW 1
    279 0/17/01
    280     IF (RATIO < 0.1 .OR. RATIO > 0.9) COEF = 2.0
    281   END IF
    282 
    283 ! Withdrawal zone above structure
    284 
    285   DO K=KSTR-1,KTOP,-1
    286 
    287 !** Density frequency
    288 
    289     HT    = (EL(K,ID)-ELR)-ELSTR
    290     RHOFT = MAX(SQRT((ABS(RHO(K,ID)-RHO(KSTR,ID)))/(HT*RHO(KSTR,ID)+NONZERO)*G),NONZERO)
    291 
    292 !** Thickness
    293 
    294     IF (POINT_SINK(JS,JB)) THEN
    295       HSWT = (COEF*QSTR(JS,JB)/RHOFT)**0.333333
    296     ELSE
    297       HSWT = SQRT(2.0*COEF*QSTR(JS,JB)/(WSTR(JS,JB)*RHOFT))
    298     END IF
    299     IF (HT >= HSWT) THEN
    300       KTOP = K; EXIT
    301     END IF
    302   END DO
    303 
    304 ! Reference density
    305 
    306   IF ((ELSTR+HSWT) < WSEL) THEN
    307     DLRHOT = ABS(RHO(KSTR,ID)-RHO(KTOP,ID))
    308   ELSE IF (WSEL == ELSTR) THEN
    309     DLRHOT = NONZERO
    310   ELSE
    311     DLRHOT = ABS(RHO(KSTR,ID)-RHO(KT,ID))*HSWT/(WSEL-ELSTR)
    312   END IF
    313   DLRHOT = MAX(DLRHOT,NONZERO)
    314 
    315 ! Withdrawal zone below structure
    316 
    317   DO K=KSTR+1,KBOT
    318 

Page 7           Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    319 !** Density frequency
    320 
    321     HB    = ELSTR-(EL(K,ID)-ELR)                                                                                       !SW 1
    321 0/17/01
    322     RHOFB = MAX(SQRT((ABS(RHO(K,ID)-RHO(KSTR,ID)))/(HB*RHO(KSTR,ID)+NONZERO)*G),NONZERO)
    323 
    324 !** Thickness
    325 
    326     IF (POINT_SINK(JS,JB)) THEN
    327       HSWB = (COEF*QSTR(JS,JB)/RHOFB)**0.333333
    328     ELSE
    329       HSWB = SQRT(2.0*COEF*QSTR(JS,JB)/(WSTR(JS,JB)*RHOFB))
    330     END IF
    331     IF (HB >= HSWB) THEN
    332       KBOT = K; EXIT
    333     END IF
    334   END DO
    335 
    336 ! Reference density
    337 
    338   IF ((ELSTR-HSWB) > EL(KBOT+1,ID)) THEN
    339     DLRHOB = ABS(RHO(KSTR,ID)-RHO(KBOT,ID))
    340   ELSE IF ((EL(KBOT+1,ID)-ELR) == ELSTR) THEN                                                                          !SR 0
    340 3/24/13
    341     DLRHOB = NONZERO                                                                                                   !SR 0
    341 3/24/13
    342   ELSE
    343     DLRHOB = ABS(RHO(KSTR,ID)-RHO(KBOT,ID))*HSWB/(ELSTR-(EL(KBOT+1,ID)-ELR))                                           !SW 1
    343 0/17/01
    344   END IF
    345   DLRHOB = MAX(DLRHOB,NONZERO)
    346 
    347 ! Velocity profile
    348 
    349   VSUM     = 0.0
    350 !  DLRHOMAX = MAX(DLRHOT,DLRHOB,1.0E-10)
    351   DO K=KTOP,KBOT
    352   IF(K.GT.KSTR)THEN
    353        DLRHOMAX = MAX(DLRHOB,1.0E-10)                          !GH 1/31/08
    354        ELSE
    355        DLRHOMAX = MAX(DLRHOT,1.0E-10)                          !GH 1/31/08
    356        ENDIF
    357        VNORM(K) = 1.0-((RHO(K,ID)-RHO(KSTR,ID))/DLRHOMAX)**2
    358      IF(VNORM(K).GT.1.0) VNORM(K)=1.0                          !GH 1/31/08
    359 	 IF(VNORM(K).LT.0.0) VNORM(K)=0.0                          !GH 1/31/08
    360 	 VNORM(K)=VNORM(K)*BHR2(K,ID)
    361      VSUM= VSUM+VNORM(K)
    362   END DO
    363 
    364 ! Outflows
    365     IF(VSUM==0.0)THEN
    366       WRITE(WRN,'(A,F12.3,A,I5,A,I5,A,I5,A,E12.4,A)')'DOWNSTREAM WITHDRAWAL ESTIMATE: VSUM=0.0 on JDAY:',JDAY,' KTOP:',KTOP,
    366 ' KBOT:',KBOT,' KSTR:',KSTR,' DLRHOMAX:',DLRHOMAX,' SET TO EQUAL WITHDRAWALS WITH DEPTH'
    367       VSUM=1.0
    368       DO K=KTOP,KBOT
    369       VNORM(K)=1.0/(KTOP-KBOT+1)
    370       ENDDO

