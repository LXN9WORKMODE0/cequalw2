      7 SUBROUTINE TOTAL_DISSOLVED_GAS (NSAT,P,NSG,N,T,C)   ! SW 12/1/2025
      8 !  nsat=0 [do], 1 [N2], 2 [DGP]
      9 !  P pressure
     10 !  NSG: gate =1 otherwise spillway (=0)
     11 !  N: spillway or gate number
     12 !  T: temperature C
     13 !  C: Do conc [nsat=0], N2 conc [nsat=1] DGP [nsat=2]
     14 !  Only called when QGT or QSP are > 0 cms
     15 !
     16   USE TDGAS; USE STRUCTURES; USE GLOBAL; USE MAIN, ONLY: EA; USE TVDC, ONLY: TDEW; USE SCREENC, ONLY: JDAY
     17   IMPLICIT NONE
     18   INTEGER      :: N, NSG, NSAT
     19   REAL(R8)     :: T,P,C,CINIT1
     20   REAL         :: SAT,DB,DA,TDG
     21 
     22   IF(NSAT==0)THEN    ! DISSOLVED OXYGEN
     23       SAT = EXP(7.7117-1.31403*(LOG(T+45.93)))*P
     24   ELSE IF(NSAT==1)THEN                ! N2 GAS
     25   EA = DEXP(2.3026D0*(7.5D0*TDEW(JW)/(TDEW(JW)+237.3D0)+0.6609D0))*0.001316   ! in mm Hg   0.0098692atm=7.5006151mmHg
     26    SAT=(1.5568D06*0.79*(P-EA)*(1.8816D-5 - 4.116D-7 * T + 4.6D-9 * T*T))   ! SW 10/27/15    4/20/16 SPEED
     27   ELSE
     28     SAT = p    
     29   ENDIF
     30   
     31   IF (NSG == 0) THEN
     32     IF (EQSP(N) == 1) THEN
     33       TDG = AGASSP(N)*.035313*QSP(N)+BGASSP(N)
     34       IF (TDG > 145.0) TDG = 145.0
     35       C = SAT
     36       IF (TDG >= 100.0) C = TDG*SAT/100.0    
     37     ELSE IF (EQSP(N) == 2) THEN
     38       TDG = AGASSP(N)+BGASSP(N)*EXP(0.035313*QSP(N)*CGASSP(N))
     39       IF (TDG > 145.0)  TDG = 145.0    
     40       C = SAT
     41       IF (TDG >= 100.0) C = TDG*SAT/100.0
     42     ELSE IF (EQSP(N) == 3) THEN
     43       DA = SAT-C                                                                               ! MM 5/21/2009 DA: Deficit up
     43 stream
     44       DB = DA/(1.0+0.38*AGASSP(N)*BGASSP(N)*CGASSP(N)*(1.0-0.11*CGASSP(N))*(1.0+0.046*T))      ! DB: deficit downstream
     45       C  = SAT-DB
     46     ELSE IF (EQSP(N) == 4) THEN  
     47       C = AGASSP(N) * C
     48       IF(CGASSP(N)==1  .AND. C > SAT)C= SAT
     49     ELSE IF (EQSP(N) == 5) THEN  
     50         CINIT1 = C
     51       IF(C >= SAT)THEN
     52           C = SAT
     53           ELSE

Page 2           Source Listing                  TOTAL_DISSOLVED_GAS
2026-03-30 08:47                                 ..\..\..\tdg.f90

     54           C = AGASSP(N)+BGASSP(N) * QSP(N) + CGASSP(N) * C + DGASSP(N) *  T   ! SW 12/1/2025
     55           ENDIF  
     56           IF(CINIT1 < C)C = CINIT1
     57     END IF
     58   ELSE IF (EQGT(N) == 1) THEN
     59     TDG = AGASGT(N)*0.035313*QGT(N)+BGASGT(N)
     60     IF (TDG > 145.0) TDG = 145.0
     61     C = SAT
     62     IF (TDG >= 100.0) C = TDG*SAT/100.0
     63   ELSE IF (EQGT(N) == 2) THEN
     64     TDG = AGASGT(N)+BGASGT(N)*EXP(.035313*QGT(N)*CGASGT(N))
     65     IF (TDG > 145.0) TDG = 145.0
     66     C = SAT
     67     IF (TDG >= 100.0) C = TDG*SAT/100.0
     68   ELSE IF (EQGT(N) == 3) THEN  
     69     DA = SAT-C                                                                               ! MM 5/21/2009 DA: Deficit upst
     69 ream
     70     DB = DA/(1.0+0.38*AGASGT(N)*BGASGT(N)*CGASGT(N)*(1.0-0.11*CGASGT(N))*(1.0+0.046*T))      ! DB: deficit downstream
     71     C  = SAT-DB
     72   ELSE IF (EQGT(N) == 4) THEN  
     73       C = AGASGT(N) * C  
     74       IF(CGASGT(N)==1  .AND. C > SAT)C= SAT
     75   ELSE IF (EQGT(N) == 5) THEN  
     76 ! DEBUG
     77       CINIT1 = C
     78       IF(C >= SAT)THEN
     79           C= SAT
     80           ELSE
     81           C = AGASGT(N)+ BGASGT(N) * QGT(N) + CGASGT(N) * C + DGASGT(N) *  T   ! SW 12/1/2025
     82       ENDIF
     83           IF(CINIT1 > C)C = CINIT1
     84 ! WRITE(22100,'(F12.6,",",I3,",",9(F12.5,","))')JDAY,N,C,CINIT1,SAT,T,QGT(N),AGASGT(N),BGASGT(N),CGASGT(N),DGASGT(N)
     85   END IF
     86 END SUBROUTINE TOTAL_DISSOLVED_GAS

