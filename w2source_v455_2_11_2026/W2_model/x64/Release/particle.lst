    122 !  This Subroutine Calls the Following Subroutines:
    123 !      FIMPBR,GRIDPLOT,WHATJR,SPLINE,RANDOM
    124 !      FINDNEWBR,FISHPLOT,INTERCONST,INTERFLOWF
    125 
    126 
    127       SUBROUTINE FISH
    128 
    129      USE SURFHE; Use Fishy; Use GDAYC;  Use SCREENC; Use GEOMC; USE GLOBAL;   Use MAIN, only: IWD, FISH_PARTICLE_EXIST, KBI,
    129  RESTART_IN 
    130      IMPLICIT NONE
    131      
    132      REAL :: DZ
    133      INTEGER :: JF,KK,N, IW, GROUPLAST
    134 
    135   IF (NIT.EQ.0 .or. restart_in) THEN             ! The very first time the Subroutine FISH is called; SW 6/2025
    136       FXSENSPH=0.0;BXSENSPH=0.0;UZSENSPH=0.0;DZSENSPH=0.0;UFISH=0.0;VFISH=0.0;WFISH=0.0
    137 !***** Open 'Numerical Fish Surrogate' files
    138       Call Read_Fish_Data
    139       IF(.NOT.FISH_PARTICLE_EXIST)RETURN  !STOP ALL PROCESSING
    140       
    141       OPEN (DIAGFN,FILE='Particle_Diagnostic.opt',STATUS='UNKNOWN')                         !FISH
    142       if(debug)then
    143       OPEN (DATADEBUGFN,FILE='Particle_Debug.opt',STATUS='UNKNOWN')                           !FISH
    144       endif
    145       
    146       OPEN (FINALFN,file='finalparticle.csv',status='unknown')                             !FISH
    147       OPEN (INITIALFN,file='initialparticle.csv',status='unknown')
    148 
    149 ! Allocate arrays
    150 ! Read input data files
    151 
    152   Allocate(FISHES(NFISH,FPARA),WQFIELD(KMX,IMX,WQP),FLOWFIELD(KMX,IMX,FFP),NETCATCH(NUMGILLNETS,NFISH,5),&
    153            SNDCATCH(NUMACOUSTICS,3*NFISH,2),RIMPBR(IMX,2),LIMPBR(IMX,2), NODES(KMX,IMX,2),&
    154            NDINFO(IMX*KMX+IMX+KMX-1,4),CORNERS(NBR,IMX*KMX+IMX+KMX-1,4),LASTFIELD(KMX,IMX,2),&
    155            BRCHFISH(NBR,NFISH,FPARA),NBRF(NBR))
    156   ALLOCATE(NEXT_BRANCH(NBR),FNEXT(NBR))
    157   flowfield=0.0
    158   wqfield=0.0
    159   corners=0
    160   ndinfo=0
    161   nodes=0.0
    162   netcatch=0
    163   sndcatch=0.0
    164   lastfield=0.0
    165   brchfish=0.0
    166   nbrf=0
    167   fishes=0.0
    168   wbskip=.false.
    169   showsky=.false.
    170         CALL FIMPBR                  ! Establishes data set of what segments are in each Branch
    171         SEED           = 92          ! Seed for the Random Number Generator
    172 
    173 
    174 !------------------------------------------ PARTICLE DATA INITIALIZATION ------------------------------------------
    175 

Page 12          Source Listing                  FISH
2026-03-30 08:48                                 ..\..\..\particle.f90

    176 !Multiple Particles
    177         NGRPFH = 0                                   ! NGRPFH  = The number of particles/fish being initiated
    178         DO jj=1,nfishseg
    179           DO FK=ifisht(jj),ifishb(jj)                 !KTWB(2),(KB(FI)-2),1   ! Fish will be placed at each one of these Lay
    179 er nodes
    180             DO FATPT=1,nfishpcel                     ! The Number of Fish that will be placed at each drop location
    181               NGRPFH = NGRPFH + 1                        ! NGRPFH  = The number of particles/fish being initiated
    182               FISHES(NGRPFH,1) = ifish(jj)    !FI        ! FIMP    = Initial segment IMP where particle/fish is released
    183               FISHES(NGRPFH,3) = FK                      ! FKMP    = Initial layer KMP where particle/fish is released
    184             end do
    185            end do
    186         end do
    187 !_____________________________________________________
    188 !Data for All Fish
    189         GROUPLAST=1
    190         N=NFISHPCEL
    191         DO FN=1,NFISH
    192          IF(.NOT.LINE)THEN
    193           FISHES(FN,4)  = FZLOCI(FN)   !0.0   ! FZLOC   = Location of fish within layer KMP from top side
    194          ELSE
    195            if(N==NFISHPCEL .OR. GROUPLAST /= GROUP(FN))then
    196             FISHES(FN,4)  = 0.           ! FZLOC   = assumed to be zero for LINE
    197             fimp=fishes(fn,1)
    198             call whatjr
    199             dz=h(fishes(fn,3),fjr)/nfishpcel
    200             GROUPLAST=GROUP(FN)
    201             N=1
    202            else
    203             fishes(fn,4)=fishes(fn-1,4)+dz
    204             N=N+1
    205            endif 
    206          ENDIF
    207           FISHES(FN,2)  = FXLOCI(FN)   !0.0   ! FXLOC   = Location of fish within segment IMP from upstream side
    208           FISHES(FN,5)  = B(INT(FISHES(FN,3)),INT(FISHES(FN,1)))*0.5
    209 ! FYLOC   = Lateral fish release location (from left bank in plan view)
    210 !                     Looking down on a segment
    211 !                                downstream
    212 !        y=0                        y=B/2                       y=B
    213 !         +---------------------------+--------------------------+
    214 !         |                                                      |
    215 !         |                                                      |
    216 !  L      |                           X                          |       R     ! location of particle in lateral
    217 !         |                                                      |
    218 !         |                                                      |
    219 !         |                                                      |
    220 !         +----------------------------+-------------------------+
    221 !                                 upstream
    222           
    223           call findbranch(fishes(fn,1))
    224           FISHES(FN,6)  = real(FNBP)   !6     ! FNBP    = Branch where fish is released
    225           FISHES(FN,7)  = FSIZE   !0.178 ! FSIZE   = Size (i.e., length) of fish in meters (1 inch = 0.0254 meters)
    226           FISHES(FN,8)  = FAGE   !2.0   ! FAGE    = Age of the fish
    227           FISHES(FN,9)  = UFISH   !0.0   ! UFISH   = Initial longitudinal velocity of the fish relative to water
    228           FISHES(FN,10) = VFISH   !0.0   ! VFISH   = Initial lateral velocity of the fish relative to water
    229           FISHES(FN,11) = WFISH   !0.0  ! WFISH   = Initial vertical velocity of the fish relative to water
    230           FISHES(FN,12) = 0          ! ISWITCH = Is fish still in system: Yes=0  No=1
    231           FISHES(FN,13) = 0          ! FSNAG   = Gillnet # fish is snagged in; = 0 if fish not in a gillnet

Page 13          Source Listing                  FISH
2026-03-30 08:48                                 ..\..\..\particle.f90

    232         END DO
    233 
    234         CALL NEXTBRANCH    ! SW 8/2018 ARE BRANCHES CONNECTED BY SPILLWAYS/GATES/PUMPS TO TRANSFER PARTICLES TO OTHER PARTS 
    234 OF THE SYSTEM
    235   END IF
    236 
