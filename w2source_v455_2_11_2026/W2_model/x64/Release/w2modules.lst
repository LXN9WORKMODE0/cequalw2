    438   REAL  FUNCTION FR (TT,TT1,TT2,SK1,SK2)
    439       REAL(R8) :: TT
    440       REAL     :: TT1,TT2,SK1,SK2
    441       FR = SK1*EXP(LOG(SK2*(1.0-SK1)/(SK1*(1.0-SK2)))/(TT2-TT1)*(TT-TT1))
    442     END FUNCTION FR


