   1797 !***********************************************************************
   1798 !***********************************************************************
   1799 !*                                                                    **
   1800 !*     B I L I N E A R   S P L I N E   I N T E R P O L A T I O N      **
   1801 !*                                                                    **
   1802 !***********************************************************************
   1803 !***********************************************************************
   1804 !                                                                      *
   1805 !   Locations:1,2,3,4,5            4 (Above Fish)                      *
   1806 !    (LOCATE)                      ^                                   *
   1807 !                               UZSENSPH                               *
   1808 !                                  |                                   *
   1809 !                                _____Fish                             *
   1810 !  (Behind Fish)             |\_/     \_     (Forward of Fish)         *
   1811 !       3  <--- BXSENSPH --- | _   5   _> ----- FXSENSPH ----->  1     *
   1812 !                            |/ \_____/                                *
   1813 !                                  |                                   *
   1814 !                               DZSENSPH                               *
   1815 !                                  V                                   *
   1816 !                                  2 (Below Fish)                      *
   1817 !                                                                      *
   1818 !     Variables are relative to the fish, and the NFS compensates      *
   1819 !                 if fish x-axis orientation changes                   *
   1820 !                                                                      *
   1821 !***********************************************************************
   1822 
   1823 !  This Subroutine Calls No Other Subroutines
   1824 
   1825 
   1826       SUBROUTINE SPLINE             ! Bilinear Spline Algorithm obtained from
   1827 !   "TWO DIMENSIONAL SPLINE INTERPOLATION
   1828       Use FISHY
   1829       USE GLOBAL                             !    ALGORITHMS - Author: Helmuth Spath"
   1830       Use GEOMC; USE MAIN, ONLY: KBI
   1831       
   1832       IMPLICIT NONE
   1833      
   1834       REAL      XH1,XH2,H3,H4,DV,DW,DX,DY
   1835 
   1836 !Check for Boundary Violations: Horizontal Plane
   1837 
   1838    95 IF (XLOK.GT.DLX(ILOK)) THEN                             ! Must look into the next segment downstream
   1839         IF ((ILOK+1).GT.DS(FNBP)) THEN                        ! Already at most downstream segment in branch
   1840           XLOK = DLX(ILOK)
   1841         ELSE IF (KLOK.GT.KBI(ILOK+1)) THEN                    ! SW USE KBI 8/2018
   1842           XLOK = DLX(ILOK)
   1843         ELSE                                                  ! More segments exist downstream of fish location
   1844           XLOK = XLOK - DLX(ILOK)
   1845           ILOK = ILOK + 1                                     ! Looking into next segment downstream
   1846         END IF
   1847         IF (XLOK.GT.DLX(ILOK)) GOTO 95
   1848       ELSE IF (XLOK.LT.0) THEN                                ! Must look into the next segment upstream
   1849         IF (ILOK.EQ.CUS(FNBP)) THEN                           ! Already at most upstream segment in branch
   1850           XLOK = 0.0
   1851         ELSE IF (KLOK.GT.KBI(ILOK-1)) THEN                    ! SW 8/2018

Page 65          Source Listing                  SPLINE
2026-03-30 08:48                                 ..\..\..\particle.f90

   1852           XLOK = 0.0
   1853         ELSE                                                  ! More segments exist upstream of current segment
   1854           ILOK = ILOK - 1                                     ! Looking into next segment upstream
   1855           XLOK = DLX(ILOK) + XLOK
   1856         END IF
   1857         IF (XLOK.LT.0) GOTO 95
   1858       ELSE
   1859       END IF
   1860 
   1861 !Check for Boundary Violations: Vertical Plane
   1862 
   1863    96 IF (ZLOK.GT.H(KLOK,FJR)) THEN                               ! Must look into the next layer below
   1864         IF (KLOK.EQ.KBI(ILOK)) THEN                            ! Already at water body bottom    SW 8/2018
   1865           ZLOK = H(KLOK,FJR)
   1866         ELSE                                                  ! More layers exist below fish location
   1867           ZLOK = ZLOK - H(KLOK,FJR)
   1868           KLOK = KLOK + 1                                     ! Looking into next layer below
   1869         END IF
   1870         IF (ZLOK.GT.H(KLOK,FJR)) GOTO 96
   1871       ELSE IF (ZLOK.LT.0) THEN                                ! Must look into the next layer above
   1872         IF (KLOK.EQ.KTWBF.or.klok.eq.1) THEN       ! SW 1/17/01        ! Already at water surface layer
   1873           ZLOK = 0.0
   1874         ELSE                                                  ! More layers exist above fish location
   1875           KLOK = KLOK - 1                                     ! Looking into next layer above
   1876           ZLOK = H(KLOK,FJR) + ZLOK
   1877         END IF
   1878         IF (ZLOK.LT.0) GOTO 96
   1879       ELSE
   1880       END IF
   1881 
   1882 !Begin Bilinear Spline Interpolation Algorithm
   1883 
   1884       DV = XLOK-0.0                       ! XLOK = X-coord of interpolated location; 0.0 = X-coord of left nodes
   1885       DW = ZLOK-0.0                       ! ZLOK = Y-coord of interpolated location; 0.0 = Y-coord of upper nodes
   1886       DX = DLX(ILOK)                      ! DX = X distance between left nodes and right nodes
   1887       DY = H(KLOK,FJR)                        ! DY = Y distance between upper nodes and lower nodes
   1888 
   1889       IF (VARIABLE.EQ.1) THEN             ! Horizontal Velocity Calculations
   1890         XH1 = FLOWFIELD(KLOK,ILOK,1)       ! UpperLeft Node
   1891         XH2 = FLOWFIELD(KLOK,ILOK+1,1)     ! UpperRight Node
   1892         H3 = FLOWFIELD(KLOK+1,ILOK,1)     ! LowerLeft Node
   1893         H4 = FLOWFIELD(KLOK+1,ILOK+1,1)   ! LowerRight Node
   1894       ELSE IF (VARIABLE.EQ.2) THEN        ! Vertical Velocity Calculations
   1895         XH1 = FLOWFIELD(KLOK,ILOK,2)       ! XH1,XH2,H3,H4 = Value of Vertical Velocity at 4 cell nodes
   1896         XH2 = FLOWFIELD(KLOK,ILOK+1,2)
   1897         H3 = FLOWFIELD(KLOK+1,ILOK,2)
   1898         H4 = FLOWFIELD(KLOK+1,ILOK+1,2)
   1899       ELSE IF (VARIABLE.EQ.3) THEN        ! Temperature Calculations
   1900         XH1 = WQFIELD(KLOK,ILOK,1)         ! XH1,XH2,H3,H4 = Value of Temperature at 4 cell nodes
   1901         XH2 = WQFIELD(KLOK,ILOK+1,1)
   1902         H3 = WQFIELD(KLOK+1,ILOK,1)
   1903         H4 = WQFIELD(KLOK+1,ILOK+1,1)
   1904       ELSE IF (VARIABLE.EQ.4) THEN        ! Dissolved Oxygen Calculations
   1905         XH1 = WQFIELD(KLOK,ILOK,2)         ! XH1,XH2,H3,H4 = Value of Dissolved Oxygen at 4 cell nodes
   1906         XH2 = WQFIELD(KLOK,ILOK+1,2)
   1907         H3 = WQFIELD(KLOK+1,ILOK,2)
   1908         H4 = WQFIELD(KLOK+1,ILOK+1,2)

Page 66          Source Listing                  SPLINE
2026-03-30 08:48                                 ..\..\..\particle.f90

   1909       ELSE
   1910       END IF
   1911 
   1912       VALUE = XH1+(XH2-XH1)/DX*DV+(H3-XH1)/DY*DW+(H4-H3-XH2+XH1)/(DX*DY)*DV*DW
   1913 !IF(DEBUG)WRITE(DIAGFN,'("Variable:",I2," Value:",f10.3," ILOK:",i4," KLOK:",i4)')VARIABLE,VALUE,ILOK,KLOK
   1914 
   1915 !End Bilinear Spline Interpolation Algorithm
   1916 
   1917       RETURN
   1918       END


