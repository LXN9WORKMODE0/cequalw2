   1518 !                   |             |                |             |                |
   1519 !                   |             |                |             |                |
   1520 !                  [HV]          [HV]             [HV]          [HV]             [HV]
   1521 !                   |             |                |             |                |
   1522 !                  1|            2|                |            3|               4|
   1523 !                   O-----[VV]----O------[VV]------X-----[VV]----O------[VV]------O
   1524 !                   |             |                |             |                |
   1525 !                   |             |                |             |                |
   1526 !                  [HV]          [HV]             [HV]  (K,I)   [HV]             [HV]
   1527 !                   |             |                |             |                |
   1528 !                   |             |               3|             |                |
   1529 !                   O-----[VV]----O------[VV]------O-----[VV]----O------[VV]------O
   1530 !                   |             |                |             |                |
   1531 !                   |             |                |             |                |
   1532 !                  [HV]          [HV]             [HV]          [HV]             [HV]
   1533 !                   |             |                |             |                |
   1534 !                   |             |               4|             |                |
   1535 !                   O-----[VV]----O------[VV]------O-----[VV]----O------[VV]------O
   1536 !
   1537                   XV = 0.0                          ! Location (X ABOVE) of Interpolated Velocity (both U & W)
   1538                   IF (K-1.LT.KTWB(WB)) THEN          !Both Top Nodes are above Water Surface
   1539                     UVERT(1) = U(K,I-1)             ! This Preserves the Horizontal Velocity at the Water Surface
   1540                     UVERT(2) = U(K,I-1)             ! This Preserves the Horizontal Velocity at the Water Surface
   1541                     HVERT(1) = -H(K,WB)/10000.          ! Arbitrary value
   1542                     HVERT(2) = -H(K,WB)/10001.          ! Arbitrary value
   1543                   ELSE IF (K-2.LT.KTWB(WB)) THEN     !Only Top-most Node above Water Surface
   1544                     UVERT(1) = U(K-1,I-1)           ! This Preserves the Horizontal Velocity at the Water Surface
   1545                     UVERT(2) = U(K-1,I-1)
   1546                     HVERT(1) = -H(K-1,WB)              ! Arbitrary value
   1547                     HVERT(2) = -0.5*H(K-1,WB)
   1548                   ELSE                              !Both Top Nodes exist
   1549                     UVERT(1) = U(K-2,I-1)
   1550                     UVERT(2) = U(K-1,I-1)
   1551                     HVERT(1) = -H(K-1,WB)-0.5*H(K-2,WB)
   1552                     HVERT(2) = -0.5*H(K-1,WB)
   1553                   END IF
   1554                   IF (K.GT.KB(I)) THEN              !Both Bottom Nodes are below Water Body Bottom   12/12/2018 Change back 

Page 55          Source Listing                  INTERFLOWF
2026-03-30 08:48                                 ..\..\..\particle.f90

   1554 to KB USE KBI SW 8/2018
   1555                     UVERT(3) = 0.0                    ! Helps satisfy no-slip condition on bottom (i.e., U=0)
   1556                     UVERT(4) = 0.0                    ! Helps satisfy no-slip condition on bottom (i.e., U=0)
   1557                     HVERT(3) = H(K-1,WB)/10001.         ! Arbitrary value
   1558                     HVERT(4) = H(K-1,WB)/10000.         ! Arbitrary value
   1559                   ELSE IF (K+1.GT.KB(I)) THEN       !Only Bottom-most Node below Water Body Bottom   12/12/2018 Change back 
   1559 to KB  USE KBI SW 8/2018
   1560                     UVERT(3) = U(K,I-1)
   1561                     UVERT(4) = 0.0                    ! Helps satisfy no-slip condition on bottom (i.e., U=0)
   1562                     HVERT(3) = 0.5*H(K,WB)
   1563                     HVERT(4) = H(K,WB)                 ! Helps satisfy no-slip condition on bottom (i.e., U=0)
   1564                   ELSE                              !Both Bottom Nodes exist
   1565                     UVERT(3) = U(K,I-1)
   1566                     UVERT(4) = U(K+1,I-1)
   1567                     HVERT(3) = 0.5*H(K,WB)
   1568                     HVERT(4) = H(K,WB)+0.5*H(K+1,WB)
   1569                   END IF
   1570                   IF (I-1.LT.US(JB)) THEN         !Both Left Nodes are Upstream of Water Body
   1571                     WHORZ(1) = 0.0                    ! Helps satisfy no-slip condition at Upstream Boundary
   1572                     WHORZ(2) = 0.0                    ! Helps satisfy no-slip condition at Upstream Boundary
   1573                     DLXHO(1) = -DLX(I)/10000.        ! Arbitrary value
   1574                     DLXHO(2) = -DLX(I)/10001.        ! Arbitrary value
   1575                   ELSE IF (I-2.LT.US(JB)) THEN    !Only Left-most Node Upstream of Water Body
   1576                     WHORZ(1) = 0                    ! Helps satisfy no-slip condition at Upstream Boundary
   1577                     WHORZ(2) = W(K-1,I-1)
   1578                     DLXHO(1) = -DLX(I-1)            ! Arbitrary value
   1579                     DLXHO(2) = -0.5*DLX(I-1)
   1580                   ELSE                              !Both Upstream Nodes exist
   1581                     WHORZ(1) = W(K-1,I-2)
   1582                     WHORZ(2) = W(K-1,I-1)
   1583                     DLXHO(1) = -DLX(I-1)-0.5*DLX(I-2)
   1584                     DLXHO(2) = -0.5*DLX(I-1)
   1585                   END IF
   1586                   IF (I.GT.DS(JB)) THEN           !Both Right Nodes are Downstream of Water Body
   1587                     WHORZ(3) = 0                    ! Helps satisfy no-slip condition at Downstream Boundary
   1588                     WHORZ(4) = 0                    ! Helps satisfy no-slip condition at Downstream Boundary
   1589                     DLXHO(3) = DLX(I-1)/10001       ! Arbitrary value
   1590                     DLXHO(4) = DLX(I-1)/10000       ! Arbitrary value
   1591                   ELSE IF (I+1.GT.DS(JB)) THEN    !Only Right-most Node Downstream of Water Body
   1592                     WHORZ(3) = W(K-1,I)
   1593                     WHORZ(4) = 0                    ! Helps satisfy no-slip condition at Downstream Boundary
   1594                     DLXHO(3) = 0.5*DLX(I)
   1595                     DLXHO(4) = DLX(I)               ! Arbitrary value
   1596                   ELSE                              !Both Downstream Nodes exist
   1597                     WHORZ(3) = W(K-1,I)
   1598                     WHORZ(4) = W(K-1,I+1)
   1599                     DLXHO(3) = 0.5*DLX(I)
   1600                     DLXHO(4) = DLX(I)+0.5*DLX(I+1)
   1601                   END IF
   1602 ! Begin Newton Interpolating Polynomial Algorithm(Algorithm obtained from "NUMERICAL METHODS for Engineers -
   1603 !                                                 Authors: Steven Chapra & Raymond Canale")
   1604                   DO JJZ=1,N+1
   1605                     FDDU(JJZ,1) = UVERT(JJZ)
   1606                     FDDW(JJZ,1) = WHORZ(JJZ)
   1607                   END DO
   1608                   DO J=2,N+1
   1609                     DO JJZ=1,(N+1-J)+1

Page 56          Source Listing                  INTERFLOWF
2026-03-30 08:48                                 ..\..\..\particle.f90

   1610                       FDDU(JJZ,J)=(FDDU(JJZ+1,J-1)-FDDU(JJZ,J-1))/(HVERT(JJZ+J-1)-HVERT(JJZ))
   1611                       FDDW(JJZ,J)=(FDDW(JJZ+1,J-1)-FDDW(JJZ,J-1))/(DLXHO(JJZ+J-1)-DLXHO(JJZ))
   1612                     END DO
   1613                   END DO
   1614                   IF (K.LT.KTWB(WB)) THEN                           !Above Water Surface
   1615                     FLOWFIELD(K,I,1) = 0.0                         ! Horiz. Vel.
   1616                     FLOWFIELD(K,I,2) = 0.0                         ! Vert.  Vel. - Original Vert Vel from W2 are in millimet
   1616 ers
   1617                   ELSE
   1618                     FLOWFIELD(K,I,1) = FDDU(1,1)+FDDU(1,2)*&
   1619                          (XV-HVERT(1))+FDDU(1,3)*(XV-HVERT(1))*&
   1620                          (XV-HVERT(2))+FDDU(1,4)*(XV-HVERT(1))*&
   1621                          (XV-HVERT(2))*(XV-HVERT(3))
   1622                     FLOWFIELD(K,I,2) = (FDDW(1,1)+FDDW(1,2)*&
   1623                          (XV-DLXHO(1))+FDDW(1,3)*(XV-DLXHO(1))*&
   1624                          (XV-DLXHO(2))+FDDW(1,4)*(XV-DLXHO(1))*&
   1625                          (XV-DLXHO(2))*(XV-DLXHO(3)))              ! Original Vertical Vel from W2 are in millimeters
   1626                   END IF
   1627 ! End Newton Interpolating Polynomial Algorithm
   1628                 END IF
   1629 
   1630 
   1631 ! Begin Calculation of Accelerations ==> Time Derivative of Velocity (Backward Differencing)
   1632                 IF (NIT.NE.0) THEN
   1633                   IF ((JDAY-LASTJDAY).EQ.0) THEN
   1634                     FLOWFIELD(K,I,3) = 0.0
   1635                     FLOWFIELD(K,I,4) = 0.0
   1636                   ELSE
   1637                     FLOWFIELD(K,I,3) = (FLOWFIELD(K,I,1)-LASTFIELD(K,I,1))/((JDAY-LASTJDAY)*86400.)    ! 24.*3600.
   1638                     FLOWFIELD(K,I,4) = (FLOWFIELD(K,I,2)-LASTFIELD(K,I,2))/((JDAY-LASTJDAY)*86400.)
   1639                   END IF
   1640                   LASTFIELD(K,I,1) = FLOWFIELD(K,I,1)
   1641                   LASTFIELD(K,I,2) = FLOWFIELD(K,I,2)
   1642                   LASTJDAY = JDAY
   1643                 ELSE                              ! No Time Derivative if Time=0 (i.e., NIT=0)
   1644                   FLOWFIELD(K,I,3) = 0
   1645                   FLOWFIELD(K,I,4) = 0
   1646                   LASTFIELD(K,I,1) = FLOWFIELD(K,I,1)
   1647                   LASTFIELD(K,I,2) = FLOWFIELD(K,I,2)
   1648                   LASTJDAY = JDAY
   1649                 END IF
   1650 ! End Calculation of Accelerations
   1651 
   1652 !ELSE
   1653               END IF
   1654                ENDDO
   1655               ENDDO
   1656           ENDDO
   1657       ENDDO
   1658 
   1659       RETURN
   1660       END

