      7 SUBROUTINE GAS_TRANSFER
      8   USE GLOBAL; USE GEOMC; USE KINETIC
      9   IMPLICIT NONE
     10   REAL, PARAMETER :: THETA_REAERATION = 1.024, M_TO_FT = 3.2808
     11   REAL :: AREA,ADEPTH,UAVG,HDEPTH,S,USTAR,A,BCOEF,DMO2
     12   INTEGER :: K
     13 
     14   IF (REAERC(JW) == '   RIVER') THEN
     15 
     16 !** Average depth in ft
     17 
     18     AREA = 0.0
     19     DO K=KT,KBMIN(I)
     20       AREA = AREA+BHR1(K,I)
     21     END DO
     22     ADEPTH = AREA/BR(KTI(I),I)*M_TO_FT
     23 
     24 !** Average velocity in feet/second
     25 
     26     UAVG = ABS(QC(I))/AREA*M_TO_FT
     27 
     28 !** Reaeration factor
     29 
     30     IF (NEQN(JW) == 0) THEN
     31       IF (ADEPTH <= 2.0) THEN
     32         REAER(I) = 21.64*UAVG**0.67/ADEPTH**1.85
     33       ELSE IF (UAVG <= 1.8) THEN
     34         REAER(I) = 12.96*SQRT(UAVG)/ADEPTH**1.5
     35       ELSE
     36         HDEPTH = -11.875*UAVG+23.375
     37         IF (HDEPTH >= ADEPTH) THEN
     38           REAER(I) = 12.96*SQRT(UAVG)/ADEPTH**1.5
     39         ELSE
     40           REAER(I) = 11.57*UAVG**0.969/ADEPTH**1.673
     41         END IF
     42       END IF
     43     ELSE IF (NEQN(JW) == 1) THEN                                                                              !O'connor-Dobb
     43 ins
     44       REAER(I) = 12.96*SQRT(UAVG)/ADEPTH**1.5                                                                 ! units: day-1
     45     ELSE IF (NEQN(JW) == 2) THEN                                                                              !Churchill
     46       REAER(I) = 11.57*UAVG**0.969/ADEPTH**1.673                                                              ! units: day-1
     47     ELSE IF (NEQN(JW) == 3) THEN                                                                              !Tsivoglou
     48       S = SLOPEC(JB)*5280.0
     49       IF (ABS(QC(I))*35.5 >= 10.0) THEN
     50         REAER(I) = 0.88*S*UAVG
     51       ELSE
     52         REAER(I) = 1.8*S*UAVG
     53       END IF

Page 2           Source Listing                  GAS_TRANSFER
2026-03-30 08:47                                 ..\..\..\gas-transfer.f90

     54     ELSE IF (NEQN(JW) == 4) THEN                                                                              !Owens
     55       REAER(I) = 21.64*UAVG**0.67/ADEPTH**1.85
     56     ELSE IF (NEQN(JW) == 5) THEN                                                                              !Thackston and
     56  Krenkel
     57       USTAR    = SQRT(ADEPTH*SLOPEC(JB)*32.2)                                                                  ! SR 5/10/05
     58       REAER(I) = 24.88*(1.0+SQRT(0.176*UAVG/SQRT(ADEPTH)))*USTAR/ADEPTH                                       ! SR 5/10/05
     59     ELSE IF (NEQN(JW) == 6) THEN                                                                              !Langbien and 
     59 Durum
     60       REAER(I) = 7.60*UAVG/ADEPTH**1.33
     61     ELSE IF (NEQN(JW) == 7) THEN                                                                              !Melching and 
     61 Flores
     62       UAVG = UAVG/M_TO_FT
     63       IF (QC(I) == 0.0) THEN
     64         REAER(I) = 0.0
     65       ELSE IF (ABS(QC(I)) < 0.556) THEN
     66         REAER(I) = 517.0*((UAVG*SLOPEC(JB))**0.524)*ABS(QC(I))**(-0.242)
     67       ELSE
     68         REAER(I) = 596.0*((UAVG*SLOPEC(JB))**0.528)*ABS(QC(I))**(-0.136)
     69       END IF
     70     ELSE IF (NEQN(JW) == 8) THEN                                                                              !Melching and 
     70 Flores
     71       UAVG   = UAVG/M_TO_FT
     72       ADEPTH = ADEPTH/M_TO_FT
     73       IF (ABS(QC(I)) < 0.556) THEN
     74         REAER(I) = 88.0*((UAVG*SLOPEC(JB))**0.313)*ADEPTH**(-0.353)
     75       ELSE
     76         REAER(I) = 142.0*((UAVG*SLOPEC(JB))**0.333)*ADEPTH**(-0.66)*BI(KT,I)**(-0.243)
     77       END IF
     78     ELSE IF (NEQN(JW) == 9) THEN                                                                              !User defined 
     78 SI units
     79       UAVG     = UAVG/M_TO_FT
     80       ADEPTH   = ADEPTH/M_TO_FT
     81       REAER(I) = RCOEF1(JW)*(UAVG**RCOEF2(JW))*(ADEPTH**RCOEF3(JW))*(SLOPEC(JB)**RCOEF4(JW))
     82     ELSE IF (NEQN(JW) == 10) THEN                                                                             ! Thackston an
     82 d Krenkel - updated
     83       USTAR    = SQRT(ADEPTH*SLOPEC(JB)*32.2)                                                                  ! SR 5/10/05
     84       REAER(I) = 4.99*(1.0+9.0*(0.176*UAVG/SQRT(ADEPTH))**0.25)*USTAR/ADEPTH                                  ! SR 5/10/05
     85     END IF
     86 !REAER(I) = REAER(I)*ADEPTH/M_TO_FT - now eliminated since changed computation in DO water quality section
     87     IF(MINKL(JW)>REAER(I))REAER(I)=MINKL(JW)    ! minimum value units day-1
     88   ELSE IF (REAERC(JW) == '    LAKE') THEN
     89     IF (NEQN(JW) == 1) THEN                                                                                   !Broecker
     90       REAER(I) = 0.864*WIND10(I)
     91     ELSE IF (NEQN(JW) == 2) THEN
     92       IF (WIND10(I) <= 3.5) THEN                                                                              !Gelda
     93         A     = 0.2
     94         BCOEF = 1.0
     95       ELSE
     96         A     = 0.057
     97         BCOEF = 2.0
     98       END IF
     99       REAER(I) = A*WIND10(I)**BCOEF
    100     ELSE IF (NEQN(JW) == 3) THEN                                                                              !Banks & Herre
    100 ra
    101       REAER(I) = (0.728*SQRT(WIND10(I))-0.317*WIND10(I)+0.0372*WIND10(I)**2)                                   !units of m/d
    101 ay
    102     ELSE IF (NEQN(JW) == 4) THEN                                                                              !Wanninkhof

Page 3           Source Listing                  GAS_TRANSFER
2026-03-30 08:47                                 ..\..\..\gas-transfer.f90

    103       REAER(I) = 0.0986*WIND10(I)**1.64                                                                         !units of m/
    103 day
    104     ELSE IF (NEQN(JW) == 5) THEN                                                                              !Chen & Kanwis
    104 her
    105       DMO2     = 2.04E-9
    106       REAER(I) = DAY*DMO2/((200.0-60.0*SQRT(MIN(WIND10(I),11.0)))*1.E-6)
    107     ELSE IF (NEQN(JW) == 6) THEN                                                                              !Cole & Buchak
    108       REAER(I) = (0.5+0.05*WIND10(I)*WIND10(I))
    109     ELSE IF (NEQN(JW) == 7) THEN                                                                              !Banks
    110       IF (WIND10(I) <= 5.5) THEN
    111         REAER(I) = 0.362*SQRT(WIND10(I))
    112       ELSE
    113         REAER(I) = 0.0277*WIND10(I)**2
    114       END IF
    115     ELSE IF (NEQN(JW) == 8) THEN                                                                              !Smith
    116       REAER(I) = 0.64+0.128*WIND10(I)**2
    117     ELSE IF (NEQN(JW) == 9) THEN                                                                              !Liss
    118       IF (WIND10(I) <= 4.1) THEN
    119         REAER(I) = 0.156*WIND10(I)**0.63
    120       ELSE
    121         REAER(I) = 0.0269*WIND10(I)**1.9
    122       END IF
    123     ELSE IF (NEQN(JW) == 10) THEN                                                                             !Downing and T
    123 ruesdale
    124       REAER(I) = 0.0276*WIND10(I)**2
    125     ELSE IF (NEQN(JW) == 11) THEN                                                                             !Kanwisher
    126       REAER(I) = 0.0432*WIND10(I)**2
    127     ELSE IF (NEQN(JW) == 12) THEN                                                                             !Yu, et al
    128       REAER(I) = 0.319*WIND10(I)
    129     ELSE IF (NEQN(JW) == 13) THEN                                                                             !Weiler
    130       IF (WIND10(I) <= 1.6) THEN
    131         REAER(I) = 0.398
    132       ELSE
    133         REAER(I) = 0.155*WIND10(I)**2
    134       END IF
    135     ELSE IF (NEQN(JW) == 14) THEN                                                                             !User defined
    136       REAER(I) = RCOEF1(JW)+RCOEF2(JW)*WIND10(I)**RCOEF3(JW)
    137     END IF
    138     IF(MINKL(JW)>REAER(I))REAER(I)=MINKL(JW)    ! minimum value units m day-1
    139     REAER(I) = REAER(I)*BI(KT,I)/BH2(KT,I)                                                         ! conversion from m/d to 
    139 1/d for all wind based equations
    140   ELSE IF (REAERC(JW) == ' ESTUARY') THEN
    141     AREA = 0.0
    142     DO K=KT,KBMIN(I)
    143       AREA = AREA+BHR1(K,I)
    144     END DO
    145  
    146     ADEPTH = AREA/BR(KTI(I),I)
    147     UAVG   = ABS(QC(I))/AREA
    148 
    149 !** Reaeration factor
    150 
    151     IF (NEQN(JW) == 0) THEN
    152     ADEPTH = ADEPTH*M_TO_FT
    153     UAVG   = UAVG*M_TO_FT
    154       IF (ADEPTH <= 2.0) THEN
    155         REAER(I) = 21.64*UAVG**0.67/ADEPTH**1.85                                        ! units of day-1

Page 4           Source Listing                  GAS_TRANSFER
2026-03-30 08:47                                 ..\..\..\gas-transfer.f90

    156       ELSE IF (UAVG <= 1.8) THEN
    157         REAER(I) = 12.96*SQRT(UAVG)/ADEPTH**1.5
    158       ELSE
    159         HDEPTH = -11.875*UAVG+23.375
    160         IF (HDEPTH >= ADEPTH) THEN
    161           REAER(I) = 12.96*SQRT(UAVG)/ADEPTH**1.5
    162         ELSE
    163           REAER(I) = 11.57*UAVG**0.969/ADEPTH**1.673
    164         END IF
    165       END IF
    166     ELSE IF (NEQN(JW) == 1) THEN                                                                           !Thomann and Fitz
    166 patrick
    167       REAER(I) = (0.728*SQRT(WIND10(I))-0.317*WIND10(I)+0.0372*WIND10(I)**2)+3.93*SQRT(UAVG)/(ADEPTH)**0.5 ! units of m/day
    168       REAER(I) = REAER(I)/ADEPTH                                                                           ! units of 1/day
    169     ELSE IF (NEQN(JW) == 2) THEN                                                                           !User defined
    170       REAER(I) = RCOEF1(JW)*(UAVG**RCOEF2(JW))*(ADEPTH**RCOEF3(JW))+(0.5+RCOEF4(JW)*WIND10(I)*WIND10(I))   ! units of 1/day
    171     ENDIF
    172     IF(MINKL(JW)>REAER(I))REAER(I)=MINKL(JW)    ! minimum value units day-1
    173 
    174   END IF
    175 !IF(RCOEF1(JW)>REAER(I))REAER(I)=RCOEF1(JW)    ! minimum value units day-1
    176   REAER(I) = REAER(I)*THETA_REAERATION**(T1(KT,I)-20.0)      ! units of day-1
    177   REAER(I) = REAER(I)/DAY
    178 END SUBROUTINE GAS_TRANSFER


