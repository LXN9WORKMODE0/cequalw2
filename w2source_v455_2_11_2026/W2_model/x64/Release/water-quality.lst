   2827 !**                                                       p H   C O 2                                                       
   2827       **
   2828 !***************************************************************************************************************************
   2828 ********
   2829 
   2830 ENTRY PH_CO2
   2831 
   2832 ! pH and carbonate species
   2833 
   2834   DO I=IU,ID
   2835     DO K=KT,KB(I)
   2836       CART = TIC(K,I)/12000.0                ! CART=equivalents/liter of C    TIC=mg/l C (MW=12g/mole)
   2837       ALKT = ALK(K,I)/5.0E+04                ! ALK=mg/l as CaCO3 (MW=50 g/mole; EQ=50g/eq))      ALKT=equivalents/l
   2838       T1K  = T1(K,I)+273.15
   2839 
   2840 !**** Ionic strength
   2841 
   2842       IF (FRESH_WATER(JW)) S2 = 2.5E-05*TDS(K,I)
   2843       IF (SALT_WATER(JW))  S2 = 1.47E-3+1.9885E-2*TDS(K,I)+3.8E-5*TDS(K,I)*TDS(K,I)
   2844 
   2845 !**** Debye-Huckel terms and activity coefficients
   2846 
   2847       SQRS2  =  SQRT(S2)
   2848       DH1    = -0.5085*SQRS2/(1.0+1.3124*SQRS2)+4.745694E-03+4.160762E-02*S2-9.284843E-03*S2*S2
   2849       DH2    = -2.0340*SQRS2/(1.0+1.4765*SQRS2)+1.205665E-02+9.715745E-02*S2-2.067746E-02*S2*S2
   2850       H2CO3T =  10.0**(0.0755*S2)
   2851       HCO3T  =  10.0**DH1
   2852       CO3T   =  10.0**DH2
   2853       OH     =  HCO3T
   2854 
   2855 !**** Temperature adjustment
   2856 
   2857       KW = 10.0**(-283.971-0.05069842*T1K+13323.0/T1K+102.24447*LOG10(T1K)-1119669.0/(T1K*T1K))/OH
   2858       K1 = 10.0**(-3404.71/T1K+14.8435-0.032786*T1K)*H2CO3T/HCO3T
   2859       K2 = 10.0**(-2902.39/T1K+ 6.4980-0.023790*T1K)*HCO3T/CO3T
   2860 
   2861 !**** pH evaluation
   2862 
   2863       PHT = -PH(K,I)-2.1
   2864       IF (PH(K,I) <= 0.0) PHT = -14.0
   2865       INCR = 10.0
   2866       DO N=1,3
   2867         F    = 1.0
   2868         INCR = INCR/10.0
   2869         ITER = 0
   2870         DO WHILE (F > 0.0 .AND. ITER < 12)
   2871           PHT    = PHT+INCR
   2872           HION   = 10.0**PHT
   2873           BICART = CART*K1*HION/(K1*HION+K1*K2+HION*HION)
   2874           F      = BICART*(HION+2.0*K2)/HION+KW/HION-ALKT-HION/OH
   2875           ITER   = ITER+1
   2876         END DO
   2877         PHT = PHT-INCR
   2878       END DO
   2879 
   2880 !**** pH, carbon dioxide, bicarbonate, and carbonate concentrations

Page 57          Source Listing                  
2026-03-30 08:47                                 ..\..\..\water-quality.f90

   2881 
   2882       HION      =  10.0**PHT
   2883       PH(K,I)   = -PHT
   2884       CO2(K,I)  =  TIC(K,I)/(1.0+K1/HION+K1*K2/(HION*HION))          ! mg/l as C
   2885       IF(CDWBC(HCO3_DER,JW)=='      ON')HCO3(K,I) =  TIC(K,I)/(1.0+HION/K1+K2/HION)                    ! mg/l as C
   2886       IF(CDWBC(CO3_DER,JW)=='      ON') CO3(K,I)  =  TIC(K,I)/((HION*HION)/(K1*K2)+HION/K2+1.0)        ! mg/l as C
   2887     END DO
   2888   END DO
   2889 RETURN
   2890 
