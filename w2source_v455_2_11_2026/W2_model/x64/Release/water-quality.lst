   2212       ELSE
   2213           SEDSUMK = SEDSUMK + POMS(JW)*LPOM(K,I)*LPOMDK(JW)*BIBH2(K,I)+POMS(JW)*RPOM(K,I)*RPOMDK(JW)*BIBH2(K,I)
   2214           SEDSUM  = SEDSUM  + POMS(JW)*LPOM(K,I)*BIBH2(K,I)+POMS(JW)*RPOM(K,I)*BIBH2(K,I)
   2215       END IF
