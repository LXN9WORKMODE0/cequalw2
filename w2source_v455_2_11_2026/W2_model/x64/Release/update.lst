     82                 END DO
     83 
     84                 IF (SEDIMENT_CALC(JW))THEN
     85                   SED(K,I) = MAX(SED(K,I),0.0)
     86                   SEDP(K,I) = DMAX1(SEDP(K,I),0.0D0)
     87                   SEDN(K,I) = DMAX1(SEDN(K,I),0.0D0)
     88                   SEDC(K,I) = DMAX1(SEDC(K,I),0.0D0)
     89                 END IF
     90 
     91                 CSSB(K,I,CN(JC)) = 0.0D0
     92                 C1S(K,I,CN(JC))  = C1(K,I,CN(JC))
     93                 C2(K,I,CN(JC))   = DMAX1(C1(K,I,CN(JC)),0.0D0)
     94               END DO
     95             END DO
     96           END DO
     97         END DO
     98       END DO
     99     END IF
    100 
