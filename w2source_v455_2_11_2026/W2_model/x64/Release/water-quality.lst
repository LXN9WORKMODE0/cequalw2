   1402         PO4ER(K,I) = PO4ER(K,I)+ERR(K,I,JE)*EPC(K,I,JE)*EP(JE)
   1403       endif
   1404       END DO
   1405       PO4EP(K,I)  = PO4ER(K,I)-PO4EG(K,I)
   1406       PO4AP(K,I)  = PO4AR(K,I)-PO4AG(K,I)
