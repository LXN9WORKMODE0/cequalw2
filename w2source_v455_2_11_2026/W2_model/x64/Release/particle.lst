    749       call findnewbr
    750       FISHES(FN,1)  = REAL(FIMP)      ! Segment IMP where fish is located
    751       FISHES(FN,2)  =      FXLOC      ! Location of fish within segment IMP from upstream side
    752       FISHES(FN,3)  = REAL(FKMP)      ! Layer KMP where fish is located
    753       FISHES(FN,4)  =      FZLOC      ! Location of fish within layer KMP from top side
    754       FISHES(FN,5)  =      FYLOC      ! Location of fish laterally from left bank (in plan view)
