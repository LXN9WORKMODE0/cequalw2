   3112 
   3113 ! Function to print a customized error message from a recent system command                           Entire function:  !SR 
   3113 11/28/19
   3114 ! Executing this function will also stop the program
   3115 
   3116 SUBROUTINE PRINT_ERROR_AND_STOP(TYPE_TEXT, TYPE_INDEX)
   3117   USE IFPORT                                           ! For GETLASTERRORXX()
   3118 
   3119   INTEGER       TYPE_INDEX, IRESULT
   3120   CHARACTER(3)  TYPE_TEXT
   3121   CHARACTER(8)  ERR_TEXT
   3122 
   3123   IRESULT = GETLASTERRORQQ()                           ! USE GETLASTERRORQQ TO GET THE ERROR CODE
   3124   WRITE (ERR_TEXT,'(A,I0)') TYPE_TEXT, TYPE_INDEX
   3125   WRITE (*,*)    TRIM(ERR_TEXT),': ERROR EXECUTING BATCH PROGRAM: ERROR CODE:',IRESULT
   3126   WRITE (9911,*) TRIM(ERR_TEXT),': ERROR EXECUTING BATCH PROGRAM: ERROR CODE:',IRESULT
   3127   CLOSE (9911)
   3128   STOP
   3129 END SUBROUTINE PRINT_ERROR_AND_STOP


