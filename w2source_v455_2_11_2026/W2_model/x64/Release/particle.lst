    867 !  This Subroutine Calls No Other Subroutines
    868 
    869       SUBROUTINE FIMPBR
    870 
    871       Use FISHY; Use GEOMC; USE GLOBAL;USE SURFHE
    872       
    873       IMPLICIT NONE
    874       REAL    :: BRANGLE
    875 
    876 ! *** ONLY HERE IS PHI0 used SW 1/14/01, DHS is used here also
    877 
    878       DO 105 I=1,IMX                                !For all segments in the system
    879         NR = 0                                      ! Number of branches connecting to the right bank
    880         NL = 0                                      ! Number of branches connecting to the left bank
    881         RIMPBR(I,1) = 0                             ! Right bank joining segment
    882         RIMPBR(I,2) = 0                             ! Right bank joining branch
    883         LIMPBR(I,1) = 0                             ! Left bank joining segment
    884         LIMPBR(I,2) = 0                             ! Left bank joining branch
    885         DO 100 JB=1,NBR                             !Examine all branches in the system
    886 ! IF(BR_INACTIVE(JB))CYCLE  ! SW 6/12/2017  No Need to do this for an inactive branch since this is called only once to set 
    886 up geometery
    887           IF (I.EQ.DHS(JB)) THEN                    ! If find a connecting branch
    888             IF (PHI0(DS(JB)).GT.PHI0(I)) THEN
    889               BRANGLE = PHI0(DS(JB))-PHI0(I)        ! BRANGLE = Angle of Incoming Branch relative to
    890             ELSE                                    !           Branch I
    891               BRANGLE = PHI0(DS(JB))+(2.*(22./7.)-PHI0(I))
    892             END IF
    893             IF ((BRANGLE.GT.0).AND.(BRANGLE.LT.(22./7.))) THEN  ! From BRANGLE, one can determine if the
    894               NR = NR + 1                                     !   Incoming Branch is on the right or
    895               RIMPBR(I,1) = DS(JB)                            !   left of Branch I
    896               RIMPBR(I,2) = JB
    897             ELSE
    898               NL = NL + 1
    899               LIMPBR(I,1) = DS(JB) 
    900               LIMPBR(I,2) = JB
    901             END IF
    902           ELSE
    903           END IF
    904   100   CONTINUE
    905         IF ((NR.GT.1).OR.(NL.GT.1)) THEN                        ! CHECK: Can only have one Branch join a segment from each s
    905 ide from the same side
    906           IF (DEBUG)WRITE(DATADEBUGFN,*) 'ERROR: More than 1 branch joining segment'
    907           IF (DEBUG)WRITE(DATADEBUGFN,9140) I
    908  9140     FORMAT('ERROR occurred at segment ',I6)
    909           STOP
    910         ELSE
    911         END IF
    912   105 CONTINUE

