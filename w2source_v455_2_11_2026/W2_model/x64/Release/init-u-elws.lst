    371       SUBROUTINE XSECTIONAL_AREA(WSURF,XAREA)
    372       
    373       USE GLOBAL; USE GEOMC; USE MAIN; USE INITIALVELOCITY
    374       
    375       REAL :: XAREA, WSURF     ! 4/5/13 SW
    376       INTEGER :: KTTOP         ! 4/5/13 SW
    377 
    378 !     KTTOP = 2
    379       DO K=2,KMX-1
    380         IF(EL(K,I) < WSURF)THEN
    381           KTTOP=K-1
    382           EXIT
    383         END IF
    384         KTTOP=K     ! CB 8/10/10
    385       END DO
    386 !     DO WHILE (EL(KTTOP,I) > WSURF)
    387 !        KTTOP = KTTOP+1
    388 !     END DO
    389       XAREA=(WSURF-EL(KTTOP+1,I)) * BSAVE(KTTOP,I)
    390       DO K=KTTOP+1,KBI(I)
    391          XAREA = XAREA+BSAVE(K,I)*H(K,JW)
    392       END DO      
    393       
    394       RETURN
    395       END  SUBROUTINE XSECTIONAL_AREA

