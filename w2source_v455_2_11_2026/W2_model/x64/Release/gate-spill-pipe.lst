    155       ELSE
    156         DLEL    =  ELIU-ELID
    157         QSP(JS) =  A2SP(JS)*DLEL**B2SP(JS)
    158       END IF
    159     ELSE
    160       QSP(JS) = 0.0
    161     END IF
    162   END DO
