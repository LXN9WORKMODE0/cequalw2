   1290 !***************************************************************************************************************************
   1290 ********
   1291 !**                                                      FERROUS (FEII)                                                     
   1291       **
   1292 !***************************************************************************************************************************
   1292 ********
   1293 ENTRY FERROUS
   1294   FE2D(:,IU:ID) = 0.0; FEIISR(:,IU:ID) = 0.0
   1295   DO I=IU,ID
   1296     DO K=KT,KB(I)
   1297       
   1298       IF(FEII(K,I) > 1.0E-7)THEN   ! skip calculations if FE2 is negligible anyway
   1299       IF(.NOT. PH_CALC(JW))THEN
   1300           FE2D(K,I)    = -KFE_OXID(JW)*O2(K,I)*FEII(K,I)*FEMN_TEMP(K,I)    ! assuming pH(K,I) = 7.0
   1301       ELSEIF(PH(K,I) <= 4.0)THEN
   1302           FE2D(K,I)    = -KFE_OXID(JW)*O2(K,I)*(1.0E-6)*FEII(K,I)*FEMN_TEMP(K,I) 
   1303       ELSEIF(PH(K,I) >= 8.0)THEN
   1304           FE2D(K,I)    = -KFE_OXID(JW)*O2(K,I)*(1.0E+2)*FEII(K,I)*FEMN_TEMP(K,I) 
   1305       ELSE   
   1306           FE2D(K,I)    = -KFE_OXID(JW)*O2(K,I)*10**(2.0*(pH(K,I)-7.0))*FEII(K,I)*FEMN_TEMP(K,I) 
   1307       ENDIF
   1308       ENDIF
   1309       
   1310       FEIISR(K,I)  = FEIIR(JW)*SODD(K,I)*DO2(K,I)
   1311 
   1312       FEIISS(K,I)  = FEIISR(K,I) + FE2D(K,I) + KFE_RED(JW)*FEMN_TEMP(K,I)*(KFEOOH_HalfSat(JW)/(O2(K,I)+KFEOOH_HalfSat(JW)))*
   1312 FEOOH(K,I)
   1313     END DO 
   1314   END DO
   1315 RETURN
