   1153 ENTRY BACTERIA
   1154   DO I=IU,ID
   1155     if(Met_regions)then
   1156     LIGHT = (1.0-BETA(JW))*SRON(WB_MetRegions(JW))*SHADE(I) 
   1157     else
   1158     LIGHT = (1.0-BETA(JW))*SRON(JW)*SHADE(I)     
   1159     endif
   1160     
   1161     LAM1  = LIGHT
   1162     LAM2  = LIGHT
   1163     DO K=KT,KB(I)
   1164       LAM1  = LAM2
   1165       LAM2  = LAM1*EXP(-GAMMA(K,I)*H2(K,I))
   1166       LIGHT = LAM1*(1.-EXP(-GAMMA(K,I)*H2(K,I)))/(GAMMA(K,I)*H2(K,I))  
   1167 ! SETTELING
   1168       IF(BACTS(JW) >= 0.0)THEN   
   1169         IF(K == KT)THEN
   1170           SET_BACT =  BACTS(JW)*(-BACT(K,I))*BI(K,I)/BH2(K,I) 
   1171         ELSE
   1172           SET_BACT =  BACTS(JW)*(BACT(K-1,I)-BACT(K,I))*BI(K,I)/BH2(K,I)
   1173         END IF
   1174       ELSE IF(BACTS(JW)<0.0)THEN

