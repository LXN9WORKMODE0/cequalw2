    167       N_SPB = 0
    168       DO ig = 1, NGT
    169         IF (GTTYP(ig)=='     SPB') THEN
    170            N_SPB = N_SPB + 1
    171            BAYC(N_SPB)=GTPC(ig)
    172         END IF
    173       END DO
    174 !
    175       ALLOCATE (GTNAME(NGT), TDG_TDP(NGT))
    176       GTNAME=.FALSE.
    177       DO ig=1, NGT
    178           IF (GTTYP(ig)=='      RO') GTNAME(ig)=.TRUE.          ! C IN RO IS UPDATE FROM TDG
    179           IF (ig>=BEGNO .AND. ig<=ENDNO) GTNAME(ig)=.TRUE.      ! GTNAME = GATE IS A SPILLBAY== .TRUE.
    180       END DO
    181 100      RETURN
    182   END SUBROUTINE


