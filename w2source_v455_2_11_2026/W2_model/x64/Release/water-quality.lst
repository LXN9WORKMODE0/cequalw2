   3108 !********************************************************************************************************************
   3109 !**                                             A L K A L I N I T Y                                                **
   3110 !********************************************************************************************************************
   3111 ENTRY ALKALINITY ! entire subroutine added ! SR 01/01/12
   3112 ! According to Stumm and Morgan (1996), table 4.5 on page 173:
   3113 ! Utilization of ammonium during photosynthesis results in an alkalinity decrease: 14 eq. alk per 16 moles ammonium
   3114 ! Utilization of nitrate during photosynthesis results in an alkalinity increase: 18 eq. alk per 16 moles nitrate
   3115 ! Production of ammonium during respiration results in an alkalinity increase: 14 eq. alk per 16 moles ammonium
   3116 ! Nitrification of ammonium results in an alkalinity decrease: 2 eq. alk per 1 mole ammonium
   3117 ! Denitrification of nitrate (to nitrogen gas) results in an alkalinity increase: 1 eq. alk per 1 mole nitrate
   3118 ! Alkalinity is represented as mg/L CaCO3 (MW=100.088). CaCO3 has 2 equivalents of alk per mole.
   3119 ! Nitrogen has an atomic mass of 14.00674. These numbers account for the factor of 50.044/14.00674 used below.
   3120 
   3121  
   3122  DO I=IU,ID
   3123    DO K=KT,KB(I)
   3124        if(noncon_alkalinity)then
   3125      ALKSS(K,I) = (50.044/14.00674) * ( 14./16.*(NH4AP(K,I)+NH4EP(K,I)+NH4ZR(K,I)+NH4MR(K,I)-NH4MG(K,I)) &
   3126                   + 18./16.*(NO3AG(K,I)+NO3EG(K,I)) &
   3127                   - 2.*NH4D(K,I) + NO3D(K,I) + NO3SED(K,I)*(1-FNO3SED(JW)) )
   3128        else
   3129          alkss(k,i)=0.0   ! NW 2/11/16
   3130        end if
   3131    END DO
   3132  END DO
   3133  
   3134 RETURN
   3135 
