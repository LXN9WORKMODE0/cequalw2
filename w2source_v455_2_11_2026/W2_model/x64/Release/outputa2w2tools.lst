     18 ! *** DSI W2_TOOL LINKAGE
     19   REAL*4,SAVE,ALLOCATABLE,DIMENSION(:)::WSEL  
     20   REAL*4,SAVE,ALLOCATABLE,DIMENSION(:,:)::WDSI  
     21     
     22 IF (VECTOR(1).or. WLC=='      ON') THEN          ! SR 12/2024
