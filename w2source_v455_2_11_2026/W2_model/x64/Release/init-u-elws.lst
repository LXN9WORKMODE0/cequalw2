      6 subroutine initial_water_level
      7 
      8 USE MAIN
      9 USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
     10   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
     11   USE INITIALVELOCITY
     12 ! MACROPHYTEC, POROSITYC, ZOOPLANKTONC removed - water quality related
     13   IMPLICIT NONE
     14   EXTERNAL RESTART_OUTPUT
     15   INTEGER :: JBU,JBD, JJW
     16   REAL :: QGATE,WSUP,BRLEN,WLSLOPE,DIST, WLDIFF
     17   
     18   LOOP_BRANCH=.FALSE.
     19     
     20 ! estimating initial flows in each segment
     21      QSSI=0.0
     22             
     23 ! first considering specified flows: upstream inflows, tributaries, distributed tribs, structural withdrawals and withdrawal
     23 s
     24     DO JW=1,NWB
     25       KT = KTWB(JW)
     26       DO JB=BS(JW),BE(JW)
     27         IU = CUS(JB)
     28         ID = DS(JB)
     29         DO I=IU,ID
     30           IF(I == IU .AND. UP_FLOW(JB))THEN
     31              QSSI(I)=QIN(JB)+QSSI(I)
     32           END IF
     33 ! if downstream of structure
     34 !IF (i == iu .and. UHS(JB) < 0) then
     35           IF (I == IU .AND. DAM_INFLOW(JB)) THEN    ! CB 4/27/2011
     36             DO JJW=1,NWB
     37               DO JJB=BS(JJW),BE(JJW)
     38                 IF(DS(JJB) == ABS(UHS(JB)))THEN
     39                   DO JS=1,NSTR(JJB)              
     40                     QSSI(I)=QSSI(I)+QSTR(JS,JJB)
     41                   END DO
     42                 END IF
     43               END DO
     44             END DO
     45           END IF
     46 
     47           IF (TRIBUTARIES) THEN
     48             DO JT=1,NTR
     49               IF(ITR(JT) == I)QSSI(I)=QSSI(I)+QTR(JT)
     50             END DO
     51           END IF
     52           IF (DIST_TRIBS(JB)) THEN
     53             QSSI(I)=QSSI(I)+QDTR(JB)/REAL(ID-IU+1)    ! SINCE INITIAL WL UNKNOWN, DISTRIBUTING FLOW EVENLY BTW. SEGS.

Page 2           Source Listing                  INITIAL_WATER_LEVEL
2026-03-30 08:47                                 ..\..\..\init-u-elws.f90

     54           END IF
     55           IF (WITHDRAWALS) THEN
     56             DO JWD=1,NWD
     57               IF(IWD(JWD) == I)QSSI(I)=QSSI(I)-QWD(JWD)            
     58             END DO
     59           END IF
     60           IF(I == ID)THEN
     61             DO JS=1,NSTR(JB)              
     62               QSSI(I)=QSSI(I)-QSTR(JS,JB)
     63             END DO
     64           END IF
     65         END DO
     66       END DO
     67     END DO
     68     
     69 ! INCLUDING FLOWS WITHIN BRANCH UPSTEAM OF SEGMENT
     70     DO JW=1,NWB
     71       KT = KTWB(JW)
     72       DO JB=BS(JW),BE(JW)
     73         IU = CUS(JB)
     74         ID = DS(JB)
     75         DO I=IU+1,ID
     76           QSSI(I)=QSSI(I)+QSSI(I-1)
     77         END DO
     78       END DO
     79     END DO
     80 
     81     DO JW=1,NWB
     82       KT = KTWB(JW)
     83       DO JB=BS(JW),BE(JW)
     84         IU = CUS(JB)
     85         ID = DS(JB)
     86         DO I=IU,ID          
     87 ! DETERMINING IF SEGMENT IS DOWNSTREAM INTERNAL HEAD BOUNDARY OF ANOTHER *UPSTREAM* BRANCH, AND ADDING FLOW TO SEGMENT AND S
     87 EGMENTS DOWNSTREAM
     88           DO JJW=1,NWB
     89             DO JJB=BS(JJW),BE(JJW)
     90               IF(DHS(JJB) == I)THEN
     91                 DO II=I,ID
     92                   QSSI(II)=QSSI(II)+QSSI(DS(JJB))
     93                 END DO
     94               END IF
     95             END DO
     96           END DO                    
     97 ! DETERMINING IF SEGMENT IS DOWNSTREAM OF SPILLWAY BELOW ANOTHER BRANCH
     98           DO JS=1,NSP
     99             IF(ESP(JS) < EL(2,I))THEN  ! DISREGARDING IF CREST ABOVE GRID
    100               IF(I == IDSP(JS))THEN
    101                 DO II=I,ID
    102                   QSSI(II)=QSSI(II)+QSSI(IUSP(JS))
    103                 END DO
    104               END IF
    105             END IF
    106           END DO
    107 ! DETERMINING IF SEGMENT IS DOWNSTREAM OF GATE BELOW ANOTHER BRANCH
    108           DO JG=1,NGT
    109             IF(EGT(JG) < EL(2,I))THEN  ! DISREGARDING IF CREST ABOVE GRID

Page 3           Source Listing                  INITIAL_WATER_LEVEL
2026-03-30 08:47                                 ..\..\..\init-u-elws.f90

    110               IF(I == IDGT(JG))THEN
    111                 IF(DYNGTC(JG) == '    FLOW')THEN
    112                   QGATE = BGT(JG)
    113                   DO II=I,ID
    114                     QSSI(II)=QSSI(II)+QGATE
    115                   END DO
    116                 ELSE
    117                   DO II=I,ID
    118                     QSSI(II)=QSSI(II)+QSSI(IUGT(JG))
    119                   END DO
    120                 END IF
    121               END IF
    122             END IF
    123           END DO                    
    124         END DO
    125       END DO
    126     END DO
    127 
    128 ! DETERMINING IF BRANCH IS A SECONDARY BRANCH THAT LOOPS AROUND AN ISLAND WITH INTERNAL HEAD BOUNDARIES AT UPSTREAM AND DOWN
    128 STREAM BC
    129 ! ATTACHED TO A SINGLE BRANCH
    130     DO JW=1,NWB
    131       KT = KTWB(JW)
    132       DO JB=BS(JW),BE(JW)
    133         IF(UH_INTERNAL(JB) .AND. DH_INTERNAL(JB))THEN
    134           DO JJW=1,NWB
    135               DO JJB=BS(JJW),BE(JJW)
    136                 IF(UHS(JB) > US(JJB) .AND. UHS(JB) < DS(JJB))THEN
    137                   JBU=JJB
    138                 END IF
    139               END DO
    140           END DO
    141           DO JJW=1,NWB
    142               DO JJB=BS(JJW),BE(JJW)
    143                 IF(DHS(JB) > US(JJB) .AND. DHS(JB) < DS(JJB))THEN       ! WW 8/19/2013
    144                   JBD=JJB
    145                 END IF
    146               END DO
    147           END DO
    148           LOOP_BRANCH(JB) = JBU == JBD
    149         END IF
    150       END DO
    151     END DO
    152               
    153               
    154 ! GIVEN ESTIMATED FLOWS FOR EACH SEGMENT, ESTIMATING WL WITH NORMAL DEPTH EQUATION
    155     DO JW=1,NWB
    156       KT = KTWB(JW)
    157       DO JB=BS(JW),BE(JW)
    158 ! ONLY CONSIDERING BRANCHES WITH SLOPES > 0
    159         IF (SLOPE(JB) > 0.0 .AND. .NOT. LOOP_BRANCH(JB))THEN
    160           IU = CUS(JB)
    161           ID = DS(JB)    
    162           DO I=IU,ID
    163             CALL NORMAL_DEPTH(QSSI(I))
    164           END DO
    165         END IF

Page 4           Source Listing                  INITIAL_WATER_LEVEL
2026-03-30 08:47                                 ..\..\..\init-u-elws.f90

    166       END DO
    167     END DO
    168     
    169 ! SMOOTHING WATER SURFACE ELEVATIONS, FIRST WITHIN BRANCHES
    170     DO JW=1,NWB
    171       KT = KTWB(JW)
    172       DO JB=BS(JW),BE(JW)
    173         IF (SLOPE(JB) > 0.0 .AND. .NOT. LOOP_BRANCH(JB))THEN
    174           IU = CUS(JB)
    175           ID = DS(JB)
    176           DO I=ID-1,IU,-1
    177             IF(ELWS(I+1) > ELWS(I))THEN
    178               ELWS(I) = ELWS(I+1)
    179             END IF          
    180           END DO
    181         END IF
    182       END DO
    183     END DO
    184 
    185 ! SMOOTHING WATER SURFACE ELEVATIONS AT INTERNAL HEAD BOUNDARIES
    186     DO JW=1,NWB
    187       KT = KTWB(JW)
    188       DO JB=BS(JW),BE(JW)
    189         IF (SLOPE(JB) > 0.0 .AND. .NOT. LOOP_BRANCH(JB) .AND. DH_INTERNAL(JB))THEN
    190           IU = CUS(JB)
    191           ID = DS(JB)
    192           IF(ELWS(DHS(JB)) > ELWS(ID))THEN
    193             ELWS(ID)=ELWS(DHS(JB))
    194             DO I=ID-1,IU,-1
    195               IF(ELWS(I+1) > ELWS(I))THEN
    196                 ELWS(I) = ELWS(I+1)
    197               END IF   
    198             END DO
    199           END IF
    200         END IF
    201       END DO
    202     END DO
    203 
    204 ! IF SPILLWAY OR GATE AT DOWNSTREAM END OF BRANCH, MAKING SURE WATER LEVEL IS ABOVE CREST ELEVATION
    205     DO JW=1,NWB
    206       KT = KTWB(JW)
    207       DO JB=BS(JW),BE(JW)
    208         IF (SLOPE(JB) > 0.0 .AND. .NOT. LOOP_BRANCH(JB) .AND. NSTR(JB) == 0)THEN
    209           IU = CUS(JB)
    210           ID = DS(JB)
    211 ! SPILLWAYS
    212           DO JS=1,NSP
    213             IF(ESP(JS) < EL(2,I))THEN  ! DISREGARDING IF CREST ABOVE GRID
    214               IF(ID == IUSP(JS))THEN
    215                  WSUP=ESP(JS)+(QSSI(ID)/A1SP(JS))**(1.0/B1SP(JS))  ! ESTIMATING UPSTREAM WS ELEV
    216                  IF(ELWS(ID) < WSUP)THEN
    217                    IF(IDSP(JS) .NE. 0)THEN    ! CB 8/10/10
    218                    IF(ELWS(IDSP(JS)) > WSUP) WSUP = ELWS(IDSP(JS))   ! CHECKING TO SEE IF DOWNSTREAM WS ELEVATION ISN'T ALRE
    218 ADY 'HIGH'
    219                    ELWS(ID)=WSUP
    220                    END IF                     ! CB 8/10/10
    221                    DO I=ID-1,IU,-1

Page 5           Source Listing                  INITIAL_WATER_LEVEL
2026-03-30 08:47                                 ..\..\..\init-u-elws.f90

    222                      IF(ELWS(I+1) > ELWS(I))THEN
    223                        ELWS(I) = ELWS(I+1)
    224                      END IF   
    225                    END DO
    226                  END IF
    227                END IF
    228             END IF
    229           END DO
    230 ! GATES
    231           DO JG=1,NGT
    232             IF(EGT(JG) < EL(2,I) .AND. DYNGTC(JG) .NE. '    FLOW')THEN  ! DISREGARDING IF CREST ABOVE GRID
    233               IF(ID == IUGT(JG))THEN
    234                 IF(DYNGTC(JG) == '       B')THEN
    235                   WSUP=EGT(JG)+(QSSI(ID)/(A1GT(JG)*BGT(JG)**G1GT(JG)))**(1.0/B1GT(JG))
    236                 END IF
    237                 IF(DYNGTC(JG) == '     ZGT')THEN
    238                   WSUP=EGT(JG)+(QSSI(ID)/A1GT(JG))**(1.0/B1GT(JG))
    239                 END IF
    240                 IF(ELWS(ID) < WSUP)THEN
    241                    IF(ELWS(IDGT(JG)) > WSUP) WSUP = ELWS(IDGT(JG))   ! CHECKING TO SEE IF DOWNSTREAM WS ELEVATION ISN'T ALRE
    241 ADY 'HIGH'  WX 8/21/13
    242                    ELWS(ID)=WSUP
    243                    DO I=ID-1,IU,-1
    244                      IF(ELWS(I+1) > ELWS(I))THEN
    245                        ELWS(I) = ELWS(I+1)
    246                      END IF   
    247                    END DO
    248                 END IF
    249               END IF
    250             END IF
    251           END DO
    252         END IF
    253       END DO
    254     END DO
    255 
    256 ! SMOOTHING WATER LEVEL AROUND LOOP BRANCHES
    257     DO JW=1,NWB
    258       KT = KTWB(JW)
    259       DO JB=BS(JW),BE(JW)
    260         IU = CUS(JB)
    261         ID = DS(JB)
    262         IF (LOOP_BRANCH(JB))THEN
    263           WLDIFF=ELWS(UHS(JB))-ELWS(UHS(JB))          
    264           BRLEN=0.0
    265           DO I=IU,ID
    266             BRLEN=BRLEN+DLX(I)
    267           END DO
    268           WLSLOPE=WLDIFF/BRLEN
    269           DIST=DLX(IU)/2.0
    270           ELWS(IU)=ELWS(UHS(JB))-WLSLOPE*DIST
    271           DO I=IU+1,ID
    272             DIST=DIST+(DLX(I-1)+DLX(I))/2.0
    273             ELWS(IU)=ELWS(UHS(JB))-WLSLOPE*DIST
    274           END DO
    275         END IF
    276       END DO
    277     END DO

