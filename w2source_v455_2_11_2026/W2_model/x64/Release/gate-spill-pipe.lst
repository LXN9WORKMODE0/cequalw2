    909 ********
    910 
    911 SUBROUTINE LUDCMP (A,N,NP,INDX,D)
    912 USE PREC
    913 IMPLICIT NONE
    914 
    915   INTEGER         :: I,J,K,IMAX,NP,N
    916   INTEGER         :: INDX(NP)
    917   REAL(R8)        :: A(NP,NP),D
    918   REAL(R8)        :: VV(500),AAMAX,SUM,DUM
    919   REAL, PARAMETER :: TINY=1.0E-20
    920 
    921 
    922   D = 1.0
    923   DO I=1,N
    924     AAMAX = 0.0
    925     DO J=1,N
    926       IF (ABS(A(I,J)) > AAMAX) AAMAX = ABS(A(I,J))
    927     END DO
    928     VV(I) = 1.0/AAMAX
    929   END DO
    930   DO J=1,N
    931     DO I=1,J-1
    932       SUM = A(I,J)
    933       DO K=1,I-1
    934         SUM = SUM-A(I,K)*A(K,J)
    935       END DO
    936       A(I,J) = SUM
    937     END DO
    938     AAMAX = 0.0
    939     DO I=J,N
    940       SUM = A(I,J)
    941       DO K=1,J-1
    942         SUM = SUM-A(I,K)*A(K,J)
    943       END DO
    944       A(I,J) = SUM
    945       DUM = VV(I)*ABS(SUM)
    946       IF (DUM >= AAMAX) THEN
    947         IMAX  = I
    948         AAMAX = DUM
    949       END IF
    950     END DO
    951     IF (J /= IMAX) THEN
    952       DO K=1,N
    953         DUM       = A(IMAX,K)
    954         A(IMAX,K) = A(J,K)
    955         A(J,K)    = DUM
    956       END DO
    957       D        = -D
    958       VV(IMAX) =  VV(J)
    959     END IF

Page 34          Source Listing                  LUDCMP
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

    960     INDX(J) = IMAX
    961     IF (A(J,J) == 0.0) A(J,J) = TINY
    962     IF (J /= N) THEN
    963       DUM = 1.0/A(J,J)
    964       DO I=J+1,N
    965         A(I,J) = A(I,J)*DUM
    966       END DO
    967     END IF
    968   END DO
    969 END SUBROUTINE LUDCMP


