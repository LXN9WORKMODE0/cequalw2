     59         END DO
     60       END DO
     61     END DO
     62     IF (CONSTITUENTS) THEN
     63       DO JW=1,NWB
     64         KT = KTWB(JW)
     65         DO JB=BS(JW),BE(JW)
     66           DO JC=1,NAC
     67               DO K=KT,MAX(KB(DS(JB)),KB(US(JB)))
     68                   CSSUH2(K,CN(JC),JB) = CSSUH1(K,CN(JC),JB)*DLT            ! SW CODE SPEEDUP 6/15/13
     69                   CSSDH2(K,CN(JC),JB) = CSSDH1(K,CN(JC),JB)*DLT
