    975 SUBROUTINE LUBKSB (A,N,NP,INDX,B)
    976 USE PREC
    977 IMPLICIT NONE
    978 
    979   INTEGER :: N, NP
    980   REAL(R8):: A(NP,NP), B(N),SUM
    981   INTEGER :: INDX(NP)
    982   INTEGER :: I, II, J, LL
    983 
    984   II = 0
    985   DO I=1,N
    986     LL    = INDX(I)
    987     SUM   = B(LL)
    988     B(LL) = B(I)
    989     IF (II /= 0) THEN
    990       DO J=II,I-1
    991         SUM = SUM-A(I,J)*B(J)
    992       END DO
    993     ELSE IF (SUM /= 0.0) THEN
    994       II = I
    995     END IF
    996     B(I) = SUM
    997   END DO
    998   DO I=N,1,-1
    999     SUM = B(I)
   1000     DO J=I+1,N
   1001       SUM = SUM-A(I,J)*B(J)
   1002     END DO
   1003     B(I) = SUM/A(I,I)
   1004   END DO
   1005 END SUBROUTINE LUBKSB

