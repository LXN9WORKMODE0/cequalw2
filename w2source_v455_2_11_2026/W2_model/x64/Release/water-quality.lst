   1175         IF(K == KB(I))THEN
   1176           SET_BACT = -BACTS(JW)*(-BACT(K,I))*BI(K,I)/BH2(K,I)                                         
   1177         ELSE IF(K == KT)THEN
   1178           SET_BACT = -BACTS(JW)*BACT(K+1,I)*BI(K+1,I)*DLX(I)/VOL(K,I)                                    
   1179         ELSE
   1180           SET_BACT = -BACTS(JW)*(BACT(K+1,I)*BI(K+1,I)/BH2(K,I)-BACT(K,I)*BI(K,I)/BH2(K,I))   
   1181         END IF
   1182       END IF
   1183 !FIRST-ORDER DECAY
   1184       IF(BACTQ10(JW) /= 0.0)THEN
   1185         DK1_BACT = -BACT1DK(JW)*BACTQ10(JW)**(T1(K,I)-20.0)*BACT(K,I)*DO3(K,I) 
   1186       ELSE
   1187         DK1_BACT = -BACT1DK(JW)*BACT(K,I)*DO3(K,I) 
   1188       END IF
   1189 !PHOTODEGRADATION
   1190       PHOTO_BACT = -BACTLDK(JW) * LIGHT * BACT(K,I) 
   1191 !
   1192       BACTSS(K,I) = SET_BACT + DK1_BACT + PHOTO_BACT
   1193     END DO
   1194   END DO
