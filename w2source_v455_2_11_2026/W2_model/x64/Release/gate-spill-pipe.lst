    786 !**                                        S U B R O U T I N E   steady state pipe flow                                     
    786       **
    787 !***************************************************************************************************************************
    787 ********
    788 
    789 SUBROUTINE pipe_steady (D1,D2,qout)     ! cb 07/18/19
    790 
    791 !       dia   - diameter of culvert
    792 !      clen   - length of culvert
    793 !      fman   - Manning's friction coefficient
    794 !      closs  - minor loss coefficient
    795 !        cm   - Manning's unit coefficient (cm=1.486, English; cm=1.0, metric)
    796 
    797   USE GLOBAL; USE STRUCTURES    
    798   IMPLICIT NONE     ! SW 10/18/2019
    799 
    800   REAL(R8)    :: qout,hdif,bao,ro,CM,D1,D2,FL
    801  
    802   cm=1.0
    803   
    804   hdif=abs(d1-d2)
    805   bao = pi*dia**2/4.
    806   ro = bao/(pi*dia)
    807   fl = (2.*g*clen*fman**2)/(cm**2*ro**(4./3.))
    808   qout= bao * sqrt(2*g*hdif/(1.+closs+fl))
    809   if(d2 > d1)qout=-qout
    810   
    811   
    812 RETURN
    813 END SUBROUTINE pipe_steady

