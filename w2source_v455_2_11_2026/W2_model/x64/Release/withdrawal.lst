   1538                     IF(TMOD < TCTEMP(J) .AND. TCELEV(J,NCOUNTCW(JWD)-1) < ELWS(IWD(JWD)))THEN                      
   1539 ! MAKING SURE THAT THE NEXT UPPER STRUCTURE FOR A PARTICULAR 'J' IS FOUND
   1540                       DO NN=NCOUNTCW(JWD)-1,1,-1
   1541                         IF(TCELEV(J,NN) > EWD(JWD))THEN
   1542                           NCOUNTCW(JWD)=NN
