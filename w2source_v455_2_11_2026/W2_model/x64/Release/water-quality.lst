    275 !**                                                 K I N E T I C   R A T E S                                               
    275       **
    276 !***************************************************************************************************************************
    276 ********
    277 
    278 ENTRY KINETIC_RATES
    279 
    280 ! Decay rates
    281 !!$OMP PARALLEL DO
    282   DO I=IU,ID
    283       
    284 ! Gas Transfer
    285       IF(GAS_TRANSFER_UPDATE)THEN
    286           CALL GAS_TRANSFER
    287           IF(REDUCE_GAS_TRANSFER)CALL ReduceReaeration
    288       ENDIF
    289 
    290     DO K=KT,KB(I)
    291       DO1(K,I)          = O2(K,I)/(O2(K,I)+KDO)                  
    292       DO2(K,I)          = 1.0 - DO1(K,I)                         !O2(K,I)/(O2(K,I)+KDO)
    293       DO3(K,I)          = (1.0+SIGN(1.0,O2(K,I)-1.E-10)) *0.5
    294       SODTRMDDO3        =   SODTRM(K,I)*SDKV(K,I)*DO3(K,I)
    295       SEDD(K,I)         =   SODTRMDDO3*SED(K,I)    !SODTRM(K,I) *SDKV(K,I)   *SED(K,I) *DO3(K,I)   !CB 10/22/06
    296       SEDDP(K,I)        =   SODTRMDDO3*SEDP(K,I)   !SODTRM(K,I) *SDKV(K,I)   *SEDP(K,I) *DO3(K,I)
    297       SEDDN(K,I)        =   SODTRMDDO3*SEDN(K,I)   !SODTRM(K,I) *SDKV(K,I)   *SEDN(K,I) *DO3(K,I)
    298       SEDDC(K,I)        =   SODTRMDDO3*SEDC(K,I)   !SODTRM(K,I) *SDKV(K,I)   *SEDC(K,I) *DO3(K,I)
    299       
    300       IF(CAC(NFEII)=='      ON' .OR.  CAC(NFEOOH)=='      ON' .OR. CAC(NMNII)=='      ON' .OR.  CAC(NMNO2)=='      ON')THEN
    301           FEMN_TEMP(K,I)=1.05**(T2(K,I)-20.)
    302       ENDIF
    303 
    304       IF(STANDING_BIOMASS_DECAY)THEN
    305       SEDD1(K,I)         =   SODTRM(K,I) *SDK1(jw)   *SED1(K,I) *DO3(K,I)
    306       SEDD2(K,I)         =   SODTRM(K,I) *SDK2(jw)   *SED2(K,I) *DO3(K,I)
    307       ENDIF
    308 
