    389     SUBROUTINE Ozone
    390     USE Bird_Meeus
    391 ! Calculate ozone concentration, Van Heuklon (1979) Eq 4
    392      USE GLOBAL; USE GDAYC; USE SURFHE; USE TVDC; USE SHADEC; USE MetFileRegion
    393   IMPLICIT NONE
    394     Real A7, B7, C7, F7, H7, P7
    395 
    396     if(Lat(jw) >= 0.0)then
    397       A7 = 150.0; C7 = 40.0; F7 = -30.000; H7 = 3.0; B7 = 1.28
    398       if(-Longit(jw) >= 0.0)then   ! Convention in W2 is to use a Long W or a positive #, so actual Longit should be "-" in 
    398 Western hemisphere, hence the minus sign SW
    399        P7 = 20.0
    400       else
    401        P7 =  0.0
    402       end if
    403     else
    404       A7 = 100.0; C7 = 30.0; F7 = 152.625; H7 = 2.0; B7 = 1.50; P7 = -75.0
    405     end if
    406 ! D converts the number of days to a fraction part of 360 degrees, in degrees
    407 !    D  = 360.0/365.25, 0.98562628
    408 ! Uo is calculated in atm-cm
    409     Uo  = (235+(A7+C7*Sin(DToR*0.9856*(int(Jdaym)+F7))+20.0*Sin(DToR*H7*(Longit(JW)+P7)))*(sin(DToR*B7*Lat(jw))**2))/1000.0
    410 
    411 END SUBROUTINE Ozone


