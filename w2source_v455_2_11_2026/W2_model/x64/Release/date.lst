      7 SUBROUTINE GREGORIAN_DATE
      8   USE GDAYC
      9   IMPLICIT NONE
     10   INTEGER :: INCR
     11 
     12 ! Determine if new year (regular or leap) and increment year
     13 
     14   DO WHILE (JDAYG >= 366)
     15     IF (.NOT. LEAP_YEAR .AND. JDAYG >= 366) THEN
     16       JDAYG     = JDAYG-365
     17       YEAR      = YEAR+1
     18       LEAP_YEAR = MOD(YEAR,4) == 0
     19     ELSE IF (JDAYG >= 367) THEN
     20       JDAYG     = JDAYG-366
     21       YEAR      = YEAR+1
     22       LEAP_YEAR = MOD(YEAR,4) == 0
     23     ELSE
     24       EXIT
     25     END IF
     26   END DO
     27   INCR = 0
     28   IF (LEAP_YEAR) INCR = 1
     29 
     30 ! Determine month and day of year
     31 
     32   IF (JDAYG >= 1 .AND. JDAYG < 32) THEN
     33     GDAY  = JDAYG
     34     DAYM  = 31.0
     35     MONTH = '  January'
     36     IMON  = 1
     37   ELSE IF (JDAYG >= 32 .AND. JDAYG < 60+INCR) THEN
     38     GDAY  = JDAYG-31
     39     DAYM  = 29.0
     40     MONTH = ' February'
     41     IMON  = 2
     42   ELSE IF (JDAYG >= 60 .AND. JDAYG < 91+INCR) THEN
     43     GDAY  = JDAYG-59-INCR
     44     DAYM  = 31.0
     45     MONTH = '    March'
     46     IMON = 3
     47   ELSE IF (JDAYG >= 91 .AND. JDAYG < 121+INCR) THEN
     48     GDAY  = JDAYG-90-INCR
     49     DAYM  = 30.0
     50     MONTH = '    April'
     51     IMON  = 4
     52   ELSE IF (JDAYG >= 121 .AND. JDAYG < 152+INCR) THEN
     53     GDAY  = JDAYG-120-INCR
     54     DAYM  = 31.0

