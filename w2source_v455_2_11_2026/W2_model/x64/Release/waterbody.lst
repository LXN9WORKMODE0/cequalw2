    585 ENTRY UPSTREAM_CONSTITUENT(C,SS)
    586   DO JJB=1,NBR
    587     IF (UHS(JB) >= US(JJB) .AND. UHS(JB) <= DS(JJB)) EXIT
    588   END DO
    589   DO JJW=1,NWB
    590     IF (JJB >=BS(JJW) .AND. JJB <= BE(JJW)) EXIT
    591   END DO
    592   DO K=KTWB(JWUH(JB)),KB(UHS(JB))+1
    593     ELL(K) = EL(K,UHS(JB))
    594   END DO
    595   DO K=KT,KB(IU)+1
    596     ELR(K) = EL(K,IU)+SINA(JB)*DLX(IU)*0.5
    597   END DO
    598   ELW  = ELWS(IU)                            !EL(KTWB(JW),IU)-Z(IU)*COSA(JB)
    599   EL1  = ELW+SINA(JB)*DLX(IU)*0.5
    600 !  IF(SLOPE(JB) /= 0.0)THEN

Page 12          Source Listing                  WATERBODY
2026-03-30 08:47                                 ..\..\..\waterbody.f90

    601 !  EL1  = ELW-(ELWS(IU+1)-ELW)/(0.5*(DLX(IU)+DLX(IU+1))*DLX(IU)*0.5   ! SW 7/17/09
    602 !  ELSE
    603 !  EL1=ELW
    604 !  ENDIF
    605   KR   = KT+1
    606   DO K=KTWB(JWUH(JB))+1,KB(UHS(JB))+1
    607     IUT = IU
    608     IF (QU(K-1,UHS(JB)) >= 0.0) IUT = IU-1
    609     IF (ELL(K) >= ELR(KR)) THEN
    610       T1L             = C(KR-1,IUT)
    611       SS(K-1,UHS(JB)) = SS(K-1,UHS(JB))-T1L*QU(K-1,UHS(JB))
    612       EL1             = ELL(K)
    613       IF (ELL(K) == ELR(KR)) KR = KR+1
    614     ELSE
    615       T1L   = 0.0
    616       BRTOT = 0.0
    617       DO WHILE (ELL(K) <= ELR(KR))
    618         IF (KR == KT+1 .AND. K == KTWB(JWUH(JB))+1) THEN
    619           B1    = BH2(KT,IU)
    620         ELSE
    621           B1    = B(KR-1,IU)*(EL1-ELR(KR))
    622         END IF
    623         BRTOT = BRTOT+B1
    624         T1L = T1L+B1*C(KR-1,IUT)
    625         EL1 = ELR(KR)
    626         KR  = KR+1
    627         IF (KR > KB(IU)+1) EXIT
    628       END DO
    629       B1              =  B(KR-1,IU)*(EL1-ELL(K))
    630       BRTOT           =  BRTOT+B1
    631       T1L             = (T1L+B1*C(KR-1,IUT))/BRTOT
    632       SS(K-1,UHS(JB)) = SS(K-1,UHS(JB))-T1L*QU(K-1,UHS(JB))
    633       IF (KR > KB(IU)+1) EXIT
    634       EL1 = ELL(K)
    635     END IF
    636   END DO
    637 RETURN
