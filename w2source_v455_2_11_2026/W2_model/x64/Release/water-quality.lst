   2641 ENTRY REFRACTORY_POM_C
   2642   RPOMCMP(:,IU:ID)=0.0
   2643   DO I=IU,ID
   2644     DO K=KT,KB(I)
   2645       DO M=1,NMC
   2646         IF(MACROPHYTE_CALC(JW,M))THEN
