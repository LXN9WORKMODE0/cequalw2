   1195 !************************************************************
   1196     SUBROUTINE SteadyStatePipeFlow(KE,EL1,EL2,QOUT,DEBUGP)
   1197     USE STRUCTURES;USE Pipe; USE GLOBAL, ONLY:G;USE SCREENC, ONLY: JDAY
   1198 !  PROGRAM:    steady-state pipe variables
   1199 !       dia   - diameter of culvert
   1200 !      clen   - length of culvert
   1201 !      fman   - Manning's friction coefficient
   1202 !      closs  - minor loss coefficient KE Entrance loss coefficients from 0 to 1:  Concrete Pipe Mitered to conform to fill 
   1202 slope 0.7 End section conformed to fill slope 0.5 [NOT READ IN]
   1203 !        cm   - Manning's unit coefficient (cm=1.486, English; cm=1.0, metric)
   1204 !        ec   - calibration parameter (1.0 default)
   1205 !
   1206 !****************************************************************************
   1207 !c     this function computes the flow of a culvert that has a steep
   1208 !c     slope and is inlet controlled and has a unsubmerged entrance decision sequence for circular culverts
   1209     IMPLICIT NONE
   1210     REAL(R8) :: EL1,EL2,QOUT,KE,HEAD,PI=3.14159,TYPE4,TYPE5,TYPE6,TYPE7
   1211     CHARACTER*8 :: AID
   1212     CHARACTER*2 :: DEBUGP
   1213 
   1214     FALL=UPIE-DNIE
   1215     DIST=CLEN
   1216     EC=KE
   1217     HDIF=ABS(EL1-EL2)
   1218     if(el1.gt.el2)then
   1219         head=el1-upie
   1220         hdn=el2-dnie
   1221         if(upie.ge.dnie)then
   1222           go to 225
   1223         else
   1224           go to 325
   1225         end if
   1226       end if
   1227 
   1228       if(el2.gt.el1)then
   1229         head=el2-dnie
   1230         hdn=el1-upie
   1231         fall=-fall
   1232         if(upie.ge.dnie)then
   1233           go to 325
   1234         else
   1235           go to 225
   1236         end if
   1237       end if
   1238 !c     if direction of flow is in the downhill slope direction
   1239 
   1240 225     if(head.ge.dia.and.hdn.ge.dia)then
   1241            QOUT=type4(HEAD)
   1242            AID='Type4a'
   1243           GO TO 499
   1244         end if
   1245         if(head.le.dia.and.hdn.lt.dia)then
   1246           if(hdn.gt.0.0)then
   1247              QOUT=type7(HEAD)
   1248              AID='Type7a'
   1249           else
   1250             hdn=0.0

Page 50          Source Listing                  STEADYSTATEPIPEFLOW
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

   1251             if(el1.gt.el2)then
   1252               hdif=el1-dnie
   1253             else
   1254               hdif=el2-upie
   1255             end if
   1256             QOUT=type7(HEAD)
   1257             AID='Type7b'
   1258           end if
   1259           GO TO 499
   1260         end if
   1261 
   1262 
   1263 !c     if outlet is not submerged and inlet head is > 1.2*diameter,
   1264 !c     flow is either type 5 or type 6
   1265 
   1266         if(head.gt.dia.and.hdn.lt.dia)then
   1267           qt5=type5(HEAD)
   1268           sf=10.3*(fman*qt5)**2/(cm**2*dia**5.33)
   1269           cl= (((qt5/(3.14*dia**2/4.))**2/(2.*g))*(1.-1./ec**2)+ dia - 0.74*dia)/(fall/dist - sf)
   1270           if(cl.le.dist)then
   1271              QOUT=qt5
   1272              AID='Type5'
   1273           else
   1274              QOUT=type6(HEAD)
   1275              AID='Type6a'
   1276           end if
   1277           GO TO 499
   1278         end if
   1279 
   1280 !c     when the direction of flow is in the uphill slope direction
   1281 
   1282 325     if(head.ge.dia.and.hdn.ge.dia)then
   1283            QOUT=type4(HEAD)
   1284            AID='Type4b'
   1285         else if(head.ge.dia.and.(hdn+abs(fall)).gt.dia)then
   1286            theta=acos(abs(fall)/clen)
   1287            dist=clen-(dia-hdn)/(tan((pi/2.)-theta))
   1288             QOUT=type4(HEAD)
   1289             AID='Type4c'
   1290         else if(head.ge.dia)then
   1291             QOUT=type6(HEAD)
   1292             AID='Type6b'
   1293         else if(head.lt.dia.and.hdn.lt.0.0)then
   1294           hdn=0.0
   1295           if(el1.gt.el2)then
   1296             hdif=el1-dnie
   1297           else
   1298             hdif=el2-upie
   1299           end if
   1300            QOUT=type7(HEAD)
   1301            AID='Type7c'
   1302         else
   1303            QOUT=type7(HEAD)
   1304            AID='Type7d'
   1305         end if       
   1306         
   1307 499     CONTINUE

