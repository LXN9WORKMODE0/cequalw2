   2895 ENTRY PH_CO2_NEW ! Enhancements added for buffering by ammonia, phosphate, and OM ! SR 01/01/12
   2896 ! pH and carbonate species
   2897  DO I=IU,ID
   2898    DO K=KT,KB(I)
   2899      T1K = T1(K,I)+273.15
