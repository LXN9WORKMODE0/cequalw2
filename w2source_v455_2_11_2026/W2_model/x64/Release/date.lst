     55     MONTH = '      May'
     56     IMON     = 5
     57   ELSE IF (JDAYG >= 152 .AND. JDAYG < 182+INCR) THEN
     58     GDAY  = JDAYG-151-INCR
     59     DAYM  = 30.0
     60     MONTH = '     June'
     61     IMON     = 6
     62   ELSE IF (JDAYG >= 182 .AND. JDAYG < 213+INCR) THEN
     63     GDAY  = JDAYG-181-INCR
     64     DAYM  = 31.0
     65     MONTH = '     July'
     66     IMON     = 7
     67   ELSE IF (JDAYG >= 213 .AND. JDAYG < 244+INCR) THEN
     68     GDAY  = JDAYG-212-INCR
     69     DAYM  = 31.0
     70     MONTH = '   August'
     71     IMON     = 8
     72   ELSE IF (JDAYG >= 244 .AND. JDAYG < 274+INCR) THEN
     73     GDAY  = JDAYG-243-INCR
     74     DAYM  = 30.0
     75     MONTH = 'September'
     76     IMON     = 9
     77   ELSE IF (JDAYG >= 274 .AND. JDAYG < 305+INCR) THEN
     78     GDAY  = JDAYG-273-INCR
     79     DAYM  = 31.0
     80     MONTH = '  October'
     81     IMON     = 10
     82   ELSE IF (JDAYG >= 305 .AND. JDAYG < 335+INCR) THEN
     83     GDAY  = JDAYG-304-INCR
     84     DAYM  = 30.0
     85     MONTH = ' November'
     86     IMON     = 11
     87   ELSE IF (JDAYG >= 335 .AND. JDAYG < 366+INCR) THEN
     88     GDAY  = JDAYG-334-INCR
     89     DAYM  = 31.0
     90     MONTH = ' December'
     91     IMON     = 12
     92   END IF
     93 END SUBROUTINE GREGORIAN_DATE

