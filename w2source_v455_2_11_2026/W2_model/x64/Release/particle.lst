    797     SUBROUTINE NEXTBRANCH   ! SW 8/7/2016
    798     USE Fishy; Use GLOBAL; USE STRUCTURES
    799     IMPLICIT NONE
    800     INTEGER :: JS, JG, JP
    801     NEXT_BRANCH=.FALSE.      ! Set all branch connections to FALSE
    802     DO JB=1,NBR
    803       IF(DHS(JB) == 0)THEN
    804           DO JS=1,NSP
    805               IF(IUSP(JS)==DS(JB).AND.IDSP(JS).NE.0)THEN
    806                  FNEXT(JB)=IDSP(JS)
    807                  NEXT_BRANCH(JB)=.TRUE.
    808                  EXIT
    809               ENDIF
    810           ENDDO
    811           DO JG=1,NGT
    812                IF(IUGT(JG)==DS(JB).AND.IDGT(JG).NE.0)THEN
    813                  FNEXT(JB)=IDGT(JG)
    814                  NEXT_BRANCH(JB)=.TRUE.
    815                  EXIT
    816               ENDIF
    817           ENDDO
    818           DO JP=1,NPU
    819                  IF(IUPU(JP)==DS(JB).AND.IDPU(JP).NE.0)THEN
    820                  FNEXT(JB)=IDPU(JP)
    821                  NEXT_BRANCH(JB)=.TRUE.
    822                  EXIT
    823                 ENDIF
    824           ENDDO
    825       ENDIF
    826     ENDDO
    827     
    828       
    829       RETURN
    830     
    831     
    832     
    833     END SUBROUTINE NEXTBRANCH

