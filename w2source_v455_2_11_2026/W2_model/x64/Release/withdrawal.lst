    585 
    586 ! VARIABLE INITIALIZATION
    587 
    588   VNORM = 0.0; QSW(:,JJWD) = 0.0; HWDT = 0.0; HWDB = 0.0
    589 
    590 ! Structure layer
    591 
    592   K = KT
    593   DO K=KT,KB(I)
    594     IF (EL(K,I) < estrtest) EXIT
    595   END DO
    596   KWD = MAX(K-1,KT)
    597   KWD = MIN(KWD,KB(I))
    598 
    599 ! Initial withdrawal limits
    600 
    601   KTOP = MAX(KTWD(JJWD),KT)
    602   IF (KWD < KTOP) KTOP = KWD
    603   KBOT = MIN(KBWD(JJWD),KB(I))
    604   IF (KBOT <= KT .AND. KB(I) /= KBOT) KBOT = KT+1
    605   IF (KBOT > KB(I)) KBOT = KB(I)
    606   ELWD = ESTRTEST
    607   IF (ESTRTEST <= EL(KB(I)+1,I)) THEN
    608     KWD  = KB(I)
    609     ELWD = EL(KB(I),I)
    610   END IF
    611   IF (ESTRTEST > EL(KT,I)) ELWD = EL(KT,I)
    612   IF (KBWD(JJWD) < KWD) THEN
    613     KWD  = KTOP        ! KT
    614     ELWD = EL(KTOP,I)  ! EL(KT,I)
    615   END IF
    616 
    617 ! Boundary interference
    618 
    619   COEF = 1.0
    620   IF (KT /= KBOT) THEN
    621     RATIO = (ELWD-EL(KBOT,I))/(EL(KT,I)-EL(KBOT,I))
    622     IF (RATIO < 0.1 .OR. RATIO > 0.9) COEF = 2.0
    623   END IF
    624 
    625 ! Withdrawal zone above structure
    626 
    627   DO K=KWD-1,KTOP,-1
    628 
    629 !** Density frequency
    630 
    631     HT    = EL(K,I)-ELWD
    632     RHOFT = MAX(SQRT((ABS(RHO(K,I)-RHO(KWD,I)))/(HT*RHO(KWD,I)+NONZERO)*G),NONZERO)
    633 
    634 !** Thickness
    635 
    636     HWDT = (COEF*QWD(JJWD)/RHOFT)**0.333333
    637     IF (HT >= HWDT) THEN
    638       KTOP = K; EXIT
    639     END IF
    640   END DO
    641 

Page 18          Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    642 ! Reference density
    643 
    644   IF ((ELWD+HWDT) < EL(KT,I)) THEN
    645     DLRHOT = ABS(RHO(KWD,I)-RHO(KTOP,I))
    646   ELSE IF (EL(KT,I) == ELWD) THEN
    647     DLRHOT = NONZERO
    648   ELSE
    649     DLRHOT = ABS(RHO(KWD,I)-RHO(KT,I))*HWDT/(EL(KT,I)-ELWD)
    650   END IF
    651   DLRHOT = MAX(DLRHOT,NONZERO)
    652 
    653 ! Withdrawal zone below structure
    654 
    655   DO K=KWD+1,KBOT
    656 
    657 !** Density frequency
    658 
    659     HB    = ELWD-EL(K,I)
    660     RHOFB = MAX(SQRT((ABS(RHO(K,I)-RHO(KWD,I)))/(HB*RHO(KWD,I)+NONZERO)*G),NONZERO)
    661 
    662 !** Thickness
    663 
    664     HWDB = (COEF*QWD(JJWD)/RHOFB)**0.333333
    665     IF (HB >= HWDB) THEN
    666       KBOT = K; EXIT
    667     END IF
    668   END DO
    669 
    670 ! Reference density
    671 
    672   IF ((ELWD-HWDB) > EL(KBOT+1,I)) THEN
    673     DLRHOB = ABS(RHO(KWD,I)-RHO(KBOT,I))
    674   ELSE IF (EL(KBOT+1,I) == ELWD) THEN                                                                                  !SR 0
    674 3/24/13
    675     DLRHOB = NONZERO                                                                                                   !SR 0
    675 3/24/13
    676   ELSE
    677     DLRHOB = ABS(RHO(KWD,I)-RHO(KBOT,I))*HWDB/(ELWD-EL(KBOT+1,I))
    678   END IF
    679   DLRHOB = MAX(DLRHOB,NONZERO)
    680 
    681 ! Velocity profile
    682 
    683   VSUM     = 0.0
    684 !  DLRHOMAX = MAX(DLRHOT,DLRHOB,1.0E-10)                                                                             ! SW 1/
    684 24/05
    685   DO K=KTOP,KBOT
    686 !    VNORM(K) = ABS(1.0-((RHO(K,I)-RHO(KWD,I))/DLRHOMAX)**2)*BHR2(K,I)
    687  	   IF(K.GT.KWD)THEN
    688        DLRHOMAX = MAX(DLRHOB,1.0E-10)                          !GH 1/31/08
    689        ELSE
    690        DLRHOMAX = MAX(DLRHOT,1.0E-10)                          !GH 1/31/08
    691        ENDIF
    692      VNORM(K) = 1.0-((RHO(K,I)-RHO(KWD,I))/DLRHOMAX)**2
    693  	 IF(VNORM(K).GT.1.0) VNORM(K)=1.0                          !GH 1/31/08
    694 	 IF(VNORM(K).LT.0.0) VNORM(K)=0.0                          !GH 1/31/08
    695 	 VNORM(K)=VNORM(K)*BHR2(K,I)

Page 19          Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    696      VSUM = VSUM+VNORM(K)
    697   END DO
    698 
    699 ! Outflows
    700   
    701     IF(VSUM==0.0)THEN
    702       WRITE(WRN,'(A,F12.3,A,I5,A,I5,A,I5,A,E12.4,A)')'LATERAL WITHDRAWAL ESTIMATE: VSUM=0.0 on JDAY:',JDAY,' KTOP:',KTOP,' K
    702 BOT:',KBOT,' KWD:',KWD,' DLRHOMAX:',DLRHOMAX,' SET TO EQUAL WITHDRAWALS WITH DEPTH'
    703       VSUM=1.0
    704       DO K=KTOP,KBOT
    705       VNORM(K)=1.0/(KTOP-KBOT+1)
    706       ENDDO
    707   ENDIF
    708 
    709 
    710   TEMPEST = 0.0                                                                                                       !SR 12
    710 /19/2022
    711   DO K=KTOP,KBOT
    712     tempest=tempest+t2(k,i)*(VNORM(K)/VSUM)*QWD(JJWD)
    713   END DO
    714   if(qwd(Jjwd).gt.0.0)tempest=tempest/qwd(Jjwd)
    715   KTW(JJWD) = KTOP
    716   KBW(JJWD) = KBOT
    717   return
    718 
    719 
    720 END SUBROUTINE WITHDRAWAL
