    115     DO JB=BS(JW),BE(JW)
    116       IU = US(JB)
    117       ID = DS(JB)
    118       DO I=IU-1,ID+1
    119         B(1,I) = B(2,I)
    120         DO K=KB(I)+1,KMX
    121           B(K,I) = B(KB(I),I)
    122         END DO
    123       END DO
    124     END DO
    125   END DO
    126   DO JW=1,NWB
    127     KT = KTWB(JW)
    128     DO JB=BS(JW),BE(JW)
    129       IU    = US(JB)
    130       ID    = DS(JB)
    131       IEXIT = 0
    132       DO K=1,KMX-1
    133         B(K,IU-1) = B(K,IU)
    134         IF (UH_INTERNAL(JB) .OR. HEAD_FLOW(JB)) THEN
    135           IF (JBUH(JB) >= BS(JW) .AND. JBUH(JB) <= BE(JW)) THEN
    136             B(K,IU-1) = B(K,UHS(JB))
    137           ELSE
    138             ELR = EL(K,IU)+SINA(JB)*DLX(IU)*0.5
    139             ELL = EL(2,UHS(JB))-SINA(JBUH(JB))*DLX(UHS(JB))*0.5
    140             IF (ELR >= ELL) THEN
    141               B(K,IU-1) = B(2,UHS(JB))
    142             ELSE
    143               DO KUP=2,KMX-1
    144                 ELL1 = EL(KUP,UHS(JB))-SINA(JBUH(JB))*DLX(UHS(JB))*0.5
    145                 ELL2 = EL(KUP+1,UHS(JB))-SINA(JBUH(JB))*DLX(UHS(JB))*0.5
    146                 IF (ELL1 > ELR .AND. ELL2 <= ELR) THEN
    147                   IF (KUP > KB(UHS(JB))) THEN
    148                     KB(IU-1)    = K-1
    149                     KBMIN(IU-1) = MIN(KB(IU),KB(IU-1))
    150                     IEXIT       = 1
    151                     EXIT
    152                   END IF
    153                   ELR2 = EL(K+1,IU)+SINA(JB)*DLX(IU)*0.5
    154                   IF (ELR2 >= ELL2) THEN
    155                     B(K,IU-1) = B(KUP,UHS(JB)); EXIT
    156                   ELSE
    157                     K1 = KUP+1
    158                     IF (K1 > KMX) EXIT
    159                     B11 = 0.0
    160                     EL1 = ELR
    161                     EL2 = EL(K1,UHS(JB))-SINA(JBUH(JB))*DLX(IU)*0.5
    162                     DO WHILE (ELR2 <= EL2)
    163                       B11 = B11+(EL1-EL2)*B(K1-1,UHS(JB))
    164                       EL1 = EL2
    165                       K1  = K1+1
    166                       IF (K1 >= KMX+1 .OR. EL2 == ELR2) EXIT
    167                       EL2 = EL(K1,UHS(JB))-SINA(JBUH(JB))*DLX(UHS(JB))*0.5
    168                       IF (EL2 <= ELR2) EL2 = ELR2
    169                     END DO
    170                     B(K,IU-1) = B11/H(K,JW); EXIT
    171                   END IF

