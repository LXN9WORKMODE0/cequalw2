    818 ********
    819 
    820 SUBROUTINE GRID_AREA1 (EL1,EL2,DIFF,BTOP)
    821   USE GLOBAL; USE GEOMC; USE PREC
    822   IMPLICIT NONE
    823 
    824   REAL(R8) :: BAREA1,BAREA2,DIST,DIST1,SLPE,DIST2
    825   INTEGER  :: K,K1,K2
    826   REAL(R8) :: EL1,EL2,DIFF,BTOP
    827 
    828 ! Difference in areas for trapezoidal geometry
    829 
    830   DO K=2,KB(I)
    831     IF (EL(K,I) <= EL1) THEN
    832       K1 = K
    833       EXIT
    834     END IF
    835   END DO
    836   DO K=2,KB(I)
    837     IF (EL(K,I) <= EL2) THEN
    838       K2 = K
    839       EXIT
    840     END IF
    841   END DO
    842   BAREA1 = 0.0
    843   BAREA2 = 0.0
    844   DO K=KB(I),K1,-1
    845     BAREA1 = BAREA1+BH(K,I)
    846   END DO
    847   DIST = EL1-EL(K1,I)
    848   IF (H(K1-1,JW)/2.0 < DIST) THEN
    849     DIST1  =  H(K1-1,JW)*0.5
    850     SLPE   = (B(K1-1,I)-BB(K1-1,I))/(0.5*H(K1-1,JW))
    851     BAREA1 =  BAREA1+BB(K1-1,I)*DIST1+0.5*SLPE*DIST1*DIST1
    852     DIST2  =  DIST-H(K1-1,JW)*0.5
    853     SLPE   = (BB(K1-2,I)-B(K1-1,I))/(0.5*H(K1-1,JW))
    854     BAREA1 =  BAREA1+B(K1-1,I)*DIST2+0.5*SLPE*DIST2*DIST2
    855     BTOP   =  B(K1-1,I)+DIST2*SLPE
    856   ELSE
    857     SLPE   = (B(K1-1,I)-BB(K1-1,I))/(0.5*H(K1-1,JW))
    858     BAREA1 =  BAREA1+BB(K1-1,I)*DIST+0.5*SLPE*DIST*DIST
    859     BTOP   =  BB(K1-1,I)+DIST*SLPE
    860   END IF
    861   DO K=KB(I),K2,-1
    862     BAREA2 = BAREA2+BH(K,I)
    863   END DO
    864   DIST = EL2-EL(K2,I)
    865   IF (H(K2-1,JW)/2. < DIST) THEN
    866     DIST1  =  H(K2-1,JW)*0.5
    867     SLPE   = (B(K2-1,I)-BB(K2-1,I))/(0.5*H(K2-1,JW))

Page 29          Source Listing                  GRID_AREA1
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

    868     BAREA2 =  BAREA2+BB(K2-1,I)*DIST1+0.5*SLPE*DIST1*DIST1
    869     DIST2  =  DIST-H(K2-1,JW)*0.5
    870     SLPE   = (BB(K2-2,I)-B(K2-1,I))/(0.5*H(K2-1,JW))
    871     BAREA2 =  BAREA2+B(K2-1,I)*DIST2+0.5*SLPE*DIST2*DIST2
    872   ELSE
    873     SLPE   = (B(K2-1,I)-BB(K2-1,I))/(0.5*H(K2-1,JW))
    874     BAREA2 =  BAREA2+BB(K2-1,I)*DIST+0.5*SLPE*DIST*DIST
    875   END IF
    876   DIFF = BAREA1-BAREA2
    877   RETURN
    878 END SUBROUTINE


