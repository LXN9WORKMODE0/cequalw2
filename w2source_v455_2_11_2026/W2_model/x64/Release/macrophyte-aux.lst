2026-03-30 08:48                                 ..\..\..\macrophyte-aux.f90

    172                 END IF
    173               END DO
    174               IF (EL(KMX,UHS(JB)) > EL(K,IU)) B(K,IU-1) = B(K-1,IU-1)
    175               IF (B(K,IU-1) == 0.0) B(K,IU-1) = B(K-1,IU-1)
    176               IF (IEXIT == 1) EXIT
    177             END IF
    178           END IF
    179         END IF
    180       END DO
    181       IEXIT = 0
    182       DO K=1,KMX-1
    183         B(K,ID+1) = B(K,ID)
    184         IF (DH_INTERNAL(JB)) THEN
    185           IF (JBDH(JB) >= BS(JW) .AND. JBDH(JB) <= BE(JW)) THEN
    186             B(K,ID+1) = B(K,DHS(JB))
    187           ELSE
    188             ELL = EL(K,ID)-SINA(JB)*DLX(ID)*0.5
    189             ELR = EL(2,DHS(JB))+SINA(JBDH(JB))*DLX(DHS(JB))*0.5
    190             IF (ELL >= ELR) THEN
    191               B(K,ID+1) = B(2,DHS(JB))
    192             ELSE
    193               DO KDN=2,KMX-1
    194                 ERR1 = EL(KDN,DHS(JB))  +SINA(JBDH(JB))*DLX(DHS(JB))*0.5
    195                 ERR2 = EL(KDN+1,DHS(JB))+SINA(JBDH(JB))*DLX(DHS(JB))*0.5
    196                 IF (ERR1 >= ELL .AND. ERR2 < ELL) THEN
    197                   IF (KDN > KB(DHS(JB))) THEN
    198                     KB(ID+1)  = K-1
    199                     KBMIN(ID) = MIN(KB(ID),KB(ID+1))
    200                     IEXIT     = 1
    201                     EXIT
    202                   END IF
    203                   ELL2 = EL(K+1,ID)-SINA(JB)*DLX(ID)*0.5
    204                   IF (ELL2 >= ERR2) THEN
    205                     B(K,ID+1) = B(KDN,DHS(JB)); EXIT
    206                   ELSE
    207                     K1  = KDN+1
    208                     IF (K1 > KMX) EXIT
    209                     B11 = 0.0
    210                     EL2 = ELL
    211                     EL1 = EL(K1,DHS(JB))+SINA(JBDH(JB))*DLX(DHS(JB))*0.5
    212                     DO WHILE (ELL2 <= EL1)
    213                       B11 = B11+(EL2-EL1)*B(K1-1,DHS(JB))
    214                       EL2 = EL1
    215                       K1  = K1+1
    216                       IF (K1 >= KMX+1 .OR. EL1 == ELL2) EXIT
    217                       EL1 = EL(K1,DHS(JB))+SINA(JBDH(JB))*DLX(DHS(JB))*0.5
    218                       IF (EL1 <= ELL2) EL1 = ELL2
    219                     END DO
    220                     B(K,ID+1) = B11/H(K,JW); EXIT
    221                   END IF
    222                 END IF
    223               END DO
    224               IF (EL(KMX,DHS(JB)) > EL(K,ID)) B(K,ID+1) = B(K-1,ID+1)
    225               IF (B(K,ID+1) == 0.0) B(K,ID+1) = B(K-1,ID+1)
    226               IF (IEXIT == 1) EXIT
    227             END IF
    228           END IF

