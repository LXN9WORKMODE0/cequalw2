    118 
    119 ! Partial water vapor pressure of air (mm hg)
    120 
    121 IF(.NOT.Met_regions)then
    122   EA = DEXP(2.3026D0*(7.5D0*TDEW(JW)/(TDEW(JW)+237.3D0)+0.6609D0))
    123 else
    124   EA = DEXP(2.3026D0*(7.5D0*TDEW(NMet)/(TDEW(NMet)+237.3D0)+0.6609D0))
    125 endif
    126 
    127 
    128 ! Partial water vapor pressure at the water surface
    129 
    130   IF(TSUR<0.0)THEN
    131   ES = DEXP(2.3026D0*(9.5D0*TSUR/(TSUR+265.5D0)+0.6609D0))
    132   ELSE
    133   ES = DEXP(2.3026D0*(7.5D0*TSUR/(TSUR+237.3D0)+0.6609D0))
    134   ENDIF
    135 
    136 ! Wind function
    137 
    138   IF (RH_EVAP(JW)) THEN
    139     if(.not.Met_Regions)then
    140     TAIRV = (TAIR(JW)+273.0D0)/(1.0D0-0.378D0*EA/760.0D0)
    141     else
    142     TAIRV = (TAIR(NMet)+273.0D0)/(1.0D0-0.378D0*EA/760.0D0)
    143     endif
    144     DTV   = (TSUR+273.0D0)/(1.0D0-0.378D0*ES/760.0D0)-TAIRV
    145     DTVL  =  0.0084D0*WIND2(I)**3
    146     IF (DTV < DTVL) DTV = DTVL
    147     FW = (3.59D0*DTV**0.3333D0+4.26D0*WIND2(I))
    148   ELSE
    149     FW = AFW(JW)+BFW(JW)*WIND2(I)**CFW(JW)
    150   END IF
    151 
    152 ! Evaporative flux
    153 
    154   RE(I) = FW*(ES-EA)
    155 !IF(RE(I) < 0.0)RE(I)=0.0     ! SW 6/22/2016  SHOULD WE USE THIS AS AN ANALOG FOR CONDENSATION WHEN LESS THAN 0? TVA(1972) S
    155 UGGESTS YOU CAN - SEE SECTION 4 AND 5 but Ryan, Harleman suggest setting RE=0 if less than zero since the condensation coeff
    155 icients are unknown...
    156 
    157 ! Conductive flux
    158  if(.not.Met_Regions)then
    159   RC(I) = FW*BOWEN_CONSTANT*(TSUR-TAIR(JW))
    160  else
    161   RC(I) = FW*BOWEN_CONSTANT*(TSUR-TAIR(NMet))  
    162  endif
    163  
    164 
    165 ! Back radiation flux
    166 
    167   RB(I) = 5.51D-8*(TSUR+273.15D0)**4
    168   RETURN  
    169 END SUBROUTINE HEAT_EXCHANGE
