    220 !end if
    221   end if
    222 ELSE
    223   TAVG(JS,JB)=-99.0
    224   IF(CONSTITUENTS)CAVG(JS,JB,CN(1:NAC))=-99.0
    225   IF(DERIVED_CALC)CDAVG(JS,JB,CDN(1:NACD(JW),JW))=-99.0
