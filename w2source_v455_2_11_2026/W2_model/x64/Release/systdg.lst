    110       CLOSE(CONTDG)       
    111 ELSE
    112       READ (CONTDG, '(///(8X,A72))') (TITLESYSTDG(i), i=1,10)
    113       READ (CONTDG, '(//8x,5A8)')SYSTDGC, N2BNDC, DOBNDC, TDG2BNDC,TDGTAC
    114       READ (CONTDG,'(//(:8X,A8,F8.2))') (GTTYP(IG), GTPC(IG), IG=1,NGT) 
    115 
    116       DO IG = 1, NGT
    117          IF (GTTYP(IG)=='     POW') POWNO = POWNO + 1
    118          IF (GTTYP(IG)=='     FLD') FLNO  = FLNO  + 1
    119          IF (GTTYP(IG)=='      RO')  NRO   = NRO  + 1
    120          IF (GTTYP(IG)=='     SPB') NBAY  = NBAY  + 1
    121       END DO                                                                                             
    122 
    123       READ (CONTDG,'(//8X,2F8.3,I8,F8.3,2A8,2F8.3)') FBE, TWCE, TWEMOD, TWE, TWETSC, TDGLOC, QSPILL, TDGSPMN      
    124       READ (CONTDG,'(//8X,I8,8F8.3)') TDGEQ, TDGP1, TDGP2, TDGP3, TDGP4, TDGP12, TDGP22, TDGP32, TDGP42    
    125       IF (NRO>0) READ (CONTDG,'(8X,I8,4F8.5)') TDGROEQ, ROP1, ROP2, ROP3, ROP4                             
    126       READ (CONTDG,'(//8X,I8,4F8.3)') TDGENTEQ, TDGE1, TDGE2, TDGE12, TDGE22                               
    127       READ (CONTDG,'(//(8X,A72))')  TWEFN                                                             
    128       CLOSE(CONTDG)
    129 ENDIF
    130 IF(SYSTDGC == '     OFF')GO TO 100          ! DO NOT ALLOCATE ARRAYS IF WE ARE NOT USING SYSTDG
    131       IF (POWNO>0) THEN 
    132           ALLOCATE (POWGTNO(POWNO), TDG_PHS(POWNO))
    133       ELSE
    134           ALLOCATE (POWGTNO(1), TDG_PHS(1))
    135           POWGTNO(1)=0
    136       END IF
    137       IF (FLNO>0) THEN 
    138           ALLOCATE (FLGTNO(FLNO), TDG_FLS(FLNO))
    139       ELSE
    140          ALLOCATE (FLGTNO(1), TDG_FLS(1))
    141          FLGTNO(1)=0
    142       END IF
    143       N_POW = 0
    144       N_FLD = 0
    145       DO ig = 1, NGT
    146          IF (GTTYP(ig)=='     POW') THEN
    147             N_POW = N_POW + 1
    148             POWGTNO(N_POW)=ig
    149          END IF
    150          IF (GTTYP(ig)=='     FLD') THEN
    151             N_FLD = N_FLD + 1
    152             FLGTNO(N_FLD)=ig
    153          END IF
    154       END DO
    155       DO ig = 1, NGT
    156          IF (GTTYP(ig)=='     SPB') THEN
    157             BEGNO = ig
    158             EXIT
    159          END IF
    160       END DO
    161       ENDNO = BEGNO + NBAY -1
    162       IF (NBAY/=0) THEN
    163          ALLOCATE (BAYC(NBAY), QBAY(NBAY))
    164       ELSE
    165         ALLOCATE (BAYC(1), QBAY(1))
    166       END IF

