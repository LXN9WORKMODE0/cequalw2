     16   SUBROUTINE CALCULATE_AZ
     17 ! USE GEOMC; USE GLOBAL; USE TRANS; USE PREC; USE EDDY; USE KINETIC; use macrophytec; USE LOGICC; USE MAIN, ONLY:WARNING_OPE
     17 N
     18   USE AZ_LOCAL
     19   IMPLICIT NONE
     20   SAVE
     21   SIG(1)=1.0D0; SIG(2)=1.3D0
     22 
     23   IF     (AZC(JW) == '     TKE') THEN
     24     CALL CALCULATE_TKE
     25   ELSEIF (AZC(JW) == '    TKE1') THEN
     26     CALL CALCULATE_TKE1
     27   ELSE
     28     DO K=KT,KBMIN(I)-1
     29     VSH(K,I) = ((U(K+1,I)-U(K,I))/((AVH2(K,I)+AVH2(K,I+1))*0.5))**2
     30     END DO
     31 
     32     DO K=KT,KBMIN(I)-1
     33       CALL CALCULATE_AZ0
     34       BUOY    = (RHO(K+1,I)-RHO(K,I)+RHO(K+1,I+1)-RHO(K,I+1))/(AVH2(K,I)+AVH2(K,I+1))            ! 2.0*AVH2(K,I)
     35       RIAZ0   =  DLOG(AZ0/AZMAX(JW))*0.666666667D0                                                  ! /1.5
     36       RI      =  G*BUOY/(RHOW*VSH(K,I)+NONZERO)
     37       RIAZ1   =  DMAX1(RI,RIAZ0)
     38       RIAZ1   =  DMIN1(RIAZ1,10.0D0)
     39       EXPAZ   =  DEXP(-1.5D0*RIAZ1)
     40       AZ(K,I) = DMAX1(AZMIN,AZ0*EXPAZ+AZMIN*(1.0D0-EXPAZ))              ! AZ computed at lower edge of cell
     41       DZT(K,I) = DMAX1(DZMIN,FRAZDZ*(AZ0*EXPAZ+DZMIN*(1.0-EXPAZ)))     ! DZ computed at lower edge of cell - later averaged 
     41 to cell center lower edge
     42     END DO
     43   END IF
     44 RETURN
     45 END SUBROUTINE CALCULATE_AZ

