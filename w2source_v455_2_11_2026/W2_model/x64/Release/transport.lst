     52 
     53 ENTRY INTERPOLATION_MULTIPLIERS
     54 
     55 ! Positive horizontal flows
     56 
     57   DO I=2,IMX-1
     58     DO K=2,KMX-1
     59       DLXT = DLX(I-1)
     60       IF (K > KB(I-1) .OR. INTERNAL_WEIR(K,I)) DLXT = DLX(I)
     61       DLXMIN       =  DMIN1(DLX(I+1),DLX(I))
     62       SF1X(K,I)    = (DLX(I+1)+DLX(I))*0.5D0
     63       SF2X(K,I,1)  =  DLX(I)/(DLX(I)+DLX(I+1))
     64 !SF3X(K,I,1)  =  DLX(I)**2
     65       SF3X(K,I,1)  =  DLX(I)*DLX(I)          ! SW 4/20/16 SPEED
     66       SF4X(K,I,1)  =  DLX(I+1)/(DLX(I)+DLX(I+1))
     67       SF5X(K,I,1)  =  0.25D0*(DLXT+2.0D0*DLX(I)+DLX(I+1))*(DLXT+DLX(I))
     68       SF6X(K,I,1)  = -0.25D0*(         DLX(I)+DLX(I+1))*(DLXT+DLX(I))
     69       SF7X(K,I,1)  =  0.25D0*(DLX(I)+DLX(I+1))*(DLXT+2.0D0*DLX(I)+DLX(I+1))
     70       SF8X(K,I,1)  =  0.50D0*(         DLX(I)-DLX(I+1))*DLXMIN
     71       SF9X(K,I,1)  =  0.50D0*(DLXT+2.0D0*DLX(I)-DLX(I+1))*DLXMIN
     72       SF10X(K,I,1) =  0.50D0*(DLXT+3.0D0*DLX(I))         *DLXMIN
     73 !SF11X(K,I,1) =  SF8X(K,I,1) /SF5X(K,I,1)/SF1X(K,I)
     74 !SF12X(K,I,1) =  SF9X(K,I,1) /SF6X(K,I,1)/SF1X(K,I)
     75 !SF13X(K,I,1) =  SF10X(K,I,1)/SF7X(K,I,1)/SF1X(K,I)
     76       SF11X(K,I,1) =  SF8X(K,I,1) /(SF5X(K,I,1)*SF1X(K,I))             ! SW 4/20/16 SPEED
     77       SF12X(K,I,1) =  SF9X(K,I,1) /(SF6X(K,I,1)*SF1X(K,I))
     78       SF13X(K,I,1) =  SF10X(K,I,1)/(SF7X(K,I,1)*SF1X(K,I))
     79     END DO
     80   END DO
     81 
     82 ! Negative horizontal flows
     83 
     84   DO I=2,IMX-2
     85     DO K=2,KMX-1
     86       DLXT = DLX(I+2)
     87       IF (K > KB(I+2)) DLXT = DLX(I+1)
     88       DLXMIN       =  DMIN1(DLX(I),DLX(I+1))
     89       SF1X(K,I)    = (DLX(I+1)+DLX(I))*0.5D0
     90       SF2X(K,I,2)  =  DLX(I+1)/(DLX(I)+DLX(I+1))
     91 !SF3X(K,I,2)  =  DLX(I+1)**2
     92       SF3X(K,I,2)  =  DLX(I+1)*DLX(I+1)            ! SW 4/20/16 SPEED
     93       SF4X(K,I,2)  =  DLX(I)/(DLX(I)+DLX(I+1))
     94       SF5X(K,I,2)  =  0.25D0*(DLX(I)+2.0D0*DLX(I+1)+DLXT)*(DLX(I)+DLX(I+1))
     95       SF6X(K,I,2)  = -0.25D0*(           DLX(I+1)+DLXT)*(DLX(I)+DLX(I+1))
     96       SF7X(K,I,2)  =  0.25D0*(DLX(I)+2.0D0*DLX(I+1)+DLXT)*(DLX(I+1)+DLXT)
     97       SF8X(K,I,2)  = -0.50D0*(       3.0D0*DLX(I+1)+DLXT)*DLXMIN
     98       SF9X(K,I,2)  =  0.50D0*(DLX(I)-2.0D0*DLX(I+1)-DLXT)*DLXMIN
     99       SF10X(K,I,2) =  0.50D0*(DLX(I)-DLX(I+1))*DLXMIN
    100 !SF11X(K,I,2) =  SF8X(K,I,2) /SF5X(K,I,2)/SF1X(K,I)
    101 !SF12X(K,I,2) =  SF9X(K,I,2) /SF6X(K,I,2)/SF1X(K,I)
    102 !SF13X(K,I,2) =  SF10X(K,I,2)/SF7X(K,I,2)/SF1X(K,I)
    103       SF11X(K,I,2) =  SF8X(K,I,2) /(SF5X(K,I,2)*SF1X(K,I))         ! SW 4/20/16 SPEED
    104       SF12X(K,I,2) =  SF9X(K,I,2) /(SF6X(K,I,2)*SF1X(K,I))
    105       SF13X(K,I,2) =  SF10X(K,I,2)/(SF7X(K,I,2)*SF1X(K,I))
    106     END DO

