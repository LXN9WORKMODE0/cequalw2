      7 SUBROUTINE WITHDRAWAL
      8   USE GLOBAL; USE GEOMC; USE TVDC; USE SELWC; USE LOGICC
      9   USE MAIN, ONLY: DERIVED_CALC,CDN,TDGON,JSG,NNSG,NDO,JWD,EA,SYSTDG,NN2,NDGP,O2DG_DER,TDG_DER
     10   USE modSYSTDG, ONLY: GTNAME, UPDATE_TDGC, SYSTDG_TDG;    ! systdg
     11   USE SCREENC, ONLY: JDAY
     12   USE KINETIC, ONLY: CAC
     13   IMPLICIT NONE
     14   REAL :: HSWT,HSWB,ELR,WSEL,ELSTR,COEF,RATIO,HT,RHOFT,DLRHOT,HB,RHOFB,DLRHOB,VSUM,DLRHOMAX,HWDT,HWDB,ELWD,TEMPEST,ESTRTEST,
     14 QSUMJS
     15   REAL(R8) :: FRACV,QSUMWD
     16   REAL(R8)  :: dosat, n2sat   ! cb 11/7/17
     17   INTEGER :: K,JS,KSTR,KTOP,KBOT,KWD,JJWD     
     18 RETURN
     19 
     20 !***************************************************************************************************************************
     20 ********
     21 !**                                             D O W N S T R E A M   W I T H D R A W A L                                   
     21       **
     22 !***************************************************************************************************************************
     22 ********
     23 
     24 ENTRY DOWNSTREAM_WITHDRAWAL (JS)
     25 
     26 ! Variable initialization
     27 
     28   HSWT = 0.0; HSWB = 0.0; VNORM = 0.0; QNEW = 0.0
     29 
     30 ! Water surface elevation
     31 
     32   ELR  = SINA(JB)*DLX(ID)*0.5
     33   WSEL = ELWS(ID)-ELR                   !EL(KT,ID)-Z(ID)*COSA(JB)
     34 
     35 ! Structure layer
     36 
     37   DO K=KT,KB(ID)
     38     IF (EL(K,ID)-ELR < ESTR(JS,JB)) EXIT
     39   END DO
     40   KSTR = MAX(K-1,KT)
     41   KSTR = MIN(KSTR,KB(ID))
     42 
     43 ! Initial withdrawal limits
     44 
     45   KTOP = MAX(KTSW(JS,JB),KT)
     46   IF (KSTR < KTOP) KTOP = KSTR
     47   KBOT = MIN(KBSW(JS,JB),KB(ID))
     48   IF (KBOT <= KT .AND. KBOT /= KB(ID)) KBOT = KT+1
     49   IF (KBOT > KB(ID)) KBOT = KB(ID)
     50   ELSTR = ESTR(JS,JB)

Page 2           Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

     51   IF (ESTR(JS,JB) <= EL(KB(ID)+1,ID+1)-ELR) THEN
     52     KSTR  = KB(ID)
     53     ELSTR = EL(KB(ID),ID)-ELR
     54   END IF
     55   IF (ESTR(JS,JB) > EL(KT,ID)-ELR) ELSTR = WSEL
     56   IF (KBSW(JS,JB) < KSTR) THEN
     57     KSTR  = KTOP          ! KT
     58     ELSTR = EL(KTOP,ID)   !WSEL
     59   END IF
     60 
     61 ! Boundary interference
     62 
     63   COEF = 1.0
     64   IF (WSEL-(EL(KBOT,ID)-ELR) /= 0.0) THEN   ! SR 11/2021
     65     RATIO = (ELSTR-(EL(KBOT,ID)-ELR))/(WSEL-(EL(KBOT,ID)-ELR))
     66     IF (RATIO < 0.1 .OR. RATIO > 0.9) COEF = 2.0
     67   END IF
     68 
     69 ! Withdrawal zone above structure
     70 
     71   DO K=KSTR-1,KTOP,-1
     72 
     73 !** Density frequency
     74 
     75     HT    = (EL(K,ID)-ELR)-ELSTR
     76     RHOFT = MAX(SQRT((ABS(RHO(K,ID)-RHO(KSTR,ID)))/(HT*RHO(KSTR,ID)+NONZERO)*G),NONZERO)
     77 
     78 !** Thickness
     79 
     80     IF (POINT_SINK(JS,JB)) THEN
     81       HSWT = (COEF*QSTR(JS,JB)/RHOFT)**0.333333
     82     ELSE
     83       HSWT = SQRT(2.0*COEF*QSTR(JS,JB)/(WSTR(JS,JB)*RHOFT))
     84     END IF
     85     IF (HT >= HSWT) THEN
     86       KTOP = K; EXIT
     87     END IF
     88   END DO
     89 
     90 ! Reference density
     91 
     92   IF ((ELSTR+HSWT) < WSEL) THEN
     93     DLRHOT = ABS(RHO(KSTR,ID)-RHO(KTOP,ID))
     94   ELSE IF (WSEL == ELSTR) THEN
     95     DLRHOT = NONZERO
     96   ELSE
     97     DLRHOT = ABS(RHO(KSTR,ID)-RHO(KT,ID))*HSWT/(WSEL-ELSTR)
     98   END IF
     99   DLRHOT = MAX(DLRHOT,NONZERO)
    100 
    101 ! Withdrawal zone below structure
    102 
    103   DO K=KSTR+1,KBOT
    104 
    105 !** Density frequency
    106 
    107     HB    = ELSTR-(EL(K,ID)-ELR)

Page 3           Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    108     RHOFB = MAX(SQRT((ABS(RHO(K,ID)-RHO(KSTR,ID)))/(HB*RHO(KSTR,ID)+NONZERO)*G),NONZERO)
    109 
    110 !** Thickness
    111 
    112     IF (POINT_SINK(JS,JB)) THEN
    113       HSWB = (COEF*QSTR(JS,JB)/RHOFB)**0.333333
    114     ELSE
    115       HSWB = SQRT(2.0*COEF*QSTR(JS,JB)/(WSTR(JS,JB)*RHOFB))
    116     END IF
    117     IF (HB >= HSWB) THEN
    118       KBOT = K; EXIT
    119     END IF
    120   END DO
    121 
    122 ! Reference density
    123 
    124   IF ((ELSTR-HSWB) > EL(KBOT+1,ID)) THEN
    125     DLRHOB = ABS(RHO(KSTR,ID)-RHO(KBOT,ID))
    126   ELSE IF ((EL(KBOT+1,ID)-ELR) == ELSTR) THEN                                                                          !SR 0
    126 3/24/13
    127     DLRHOB = NONZERO                                                                                                   !SR 0
    127 3/24/13
    128   ELSE
    129     DLRHOB = ABS(RHO(KSTR,ID)-RHO(KBOT,ID))*HSWB/(ELSTR-(EL(KBOT+1,ID)-ELR))
    130   END IF
    131   DLRHOB = MAX(DLRHOB,NONZERO)
    132 
    133 ! Velocity profile
    134 
    135   VSUM     = 0.0
    136 !  DLRHOMAX = MAX(DLRHOT,DLRHOB,1.0E-10)                      ! GH 1/31/08
    137   DO K=KTOP,KBOT
    138 !    VNORM(K) = ABS(1.0-((RHO(K,ID)-RHO(KSTR,ID))/DLRHOMAX)**2)*BHR2(K,ID)
    139  	   IF(K.GT.KSTR)THEN
    140        DLRHOMAX = MAX(DLRHOB,1.0E-10)                          !GH 1/31/08
    141        ELSE
    142        DLRHOMAX = MAX(DLRHOT,1.0E-10)                          !GH 1/31/08
    143        ENDIF
    144      VNORM(K) = 1.0-((RHO(K,ID)-RHO(KSTR,ID))/DLRHOMAX)**2
    145  	 IF(VNORM(K).GT.1.0) VNORM(K)=1.0                         !GH 1/31/08
    146 	 IF(VNORM(K).LT.0.0) VNORM(K)=0.0                         !GH 1/31/08
    147 	 VNORM(K)=VNORM(K)*BHR2(K,ID)
    148      VSUM     = VSUM+VNORM(K)
    149   END DO
    150 
    151 ! OUTFLOWS
    152   QSUMJS=0.0                                                  ! SW 7/30/09
    153   TAVG(JS,JB)=0.0                                                    ! CB 5/12/10
    154   IF(CONSTITUENTS)CAVG(JS,JB,CN(1:NAC))=0.0
    155   IF(DERIVED_CALC)CDAVG(JS,JB,CDN(1:NACD(JW),JW))=0.0
    156   IF(VSUM==0.0)THEN
    157       WRITE(WRN,'(A,F12.3,A,I5,A,I5,A,I5,A,E12.4,A)')'DOWNSTREAM WITHDRAWAL: VSUM=0.0 on JDAY:',JDAY,' KTOP:',KTOP,' KBOT:',
    157 KBOT,' KSTR:',KSTR,' DLRHOMAX:',DLRHOMAX,' SET TO EQUAL WITHDRAWALS WITH DEPTH'
    158       VSUM=1.0
    159       DO K=KTOP,KBOT
    160       VNORM(K)=1.0/(KTOP-KBOT+1)
    161       ENDDO

