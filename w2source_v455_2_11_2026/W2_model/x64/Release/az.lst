    387   USTAR = SQRT(1.25*CZ(I)*WIND10(I)**2/RHO(KT,I))
    388   IF (MANNINGS_N(JW)) THEN
    389 	HRAD = BH1(KT,I)/(B(KTI(I),I)-B(KT+1,I)+2.*AVH1(KT,I))                   !HRAD = BHR1(KT,I)/(BR(KTI(I),I)-BR(KT+1,I)
    389 +2.*AVH1(KT,I))
    390 	GC2  = G*FRIC(I)*FRIC(I)/HRAD**0.333
    391   ELSE
    392 	GC2 = 0.0
    393 	IF (FRIC(I) /= 0.0) GC2 = G/(FRIC(I)*FRIC(I))
    394   END IF
    395   USTARBKT	  = SQRT(GC2)*ABS(0.5*(U(KT,I)+U(KT,I-1)))
    396   TKE(KT,I,1) = (3.33*(USTAR*USTAR+USTARBKT*USTARBKT))*BHRATIO(KT,I)   !*(BH2(KT,I)/BH1(KT,I))
    397   TKE(KT,I,2) = (USTAR*USTAR*USTAR+USTARBKT*USTARBKT*USTARBKT)*5.0/H1(KT,I)*BHRATIO(KT,I)   !*(BH2(KT,I)/BH1(KT,I))
    398 	DO J=1,2
    399 	  K=KT			
    400 	  AT(K,I) = 0.0
    401 	  CT(K,I) = 0.0
    402 	  VT(K,I) = 1.0
    403 	  DT(K,I) = TKE(K,I,J)	
    404 	  DO K = KT+1,KB(I)-1
    405 		 IF(IMPTKE(JW)=='     IMP')THEN
    406 		   AT(K,I) =  -DLT/BH1(K,I)*(BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) + 0.5*W(K-1,I)*BB(K-1,I))
    407 		   CT(K,I) =  -DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) - 0.5*W(K,I)*BB(K,I))
    408 		   VT(K,I) =  1 +&
    409 				      DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) +&
    410 				      BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) +&
    411 					  0.5*(W(K,I)*BB(K,I)-W(K-1,I)*BB(K-1,I)))
    412 		   DT(K,I) =  TKE(K,I,J)
    413 		 ELSE
    414 		   AT(K,I) = -DLT/BH1(K,I)*BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I)
    415 		   CT(K,I) = -DLT/BH1(K,I)*BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I)
    416 		   VT(K,I) =  1.0-AT(K,I)-CT(K,I)
    417 		   DT(K,I) =  TKE(K,I,J)
    418 		 ENDIF
    419 	  END DO
    420 	  K = KB(I)
    421 	  AT(K,I) = 0.0
    422 	  CT(K,I) = 0.0
    423 	  VT(K,I) = 1.0
    424 	  DT(K,I) = TKE(K,I,J)
    425 	  CALL TRIDIAG(AT(:,I),VT(:,I),CT(:,I),DT(:,I),KT,KB(I),KMX,TKE(:,I,J))
    426 	END DO
    427   ELSE
    428     WARNING_OPEN    = .TRUE.
    429     WRITE(WRN,*)'UNKNOWN TKEBC OPTION CHECK W2_CON.NPT'
    430     WRITE(WRN,*)'Setting TKE calculation to TKEBC(JW)=3'
    431     TKEBC(JW)=3
    432     GOTO 500
    433   ENDIF
    434 
    435   DO K=KT,KB(I)
    436     TKE(K,I,1) = MAX(TKE(K,I,1),TKEMIN1)
    437     TKE(K,I,2) = MAX(TKE(K,I,2),TKEMIN2)
    438     AZT(K,I)     = 0.09*TKE(K,I,1)*TKE(K,I,1)/TKE(K,I,2)
    439   END DO
    440 
    441   DO K=KT,KB(I)-1
    442 	AZ(K,I) = 0.5*(AZT(K,I)+AZT(K+1,I))

Page 16          Source Listing                  CALCULATE_TKE1
2026-03-30 08:47                                 ..\..\..\az.f90

    443 	AZ(K,I) = MAX(AZMIN,AZ(K,I))
    444 	AZ(K,I) = MIN(AZMAX(JW),AZ(K,I))
    445 	DZ(K,I) = MAX(DZMIN,FRAZDZ*AZ(K,I))      ! No need to average further, DZ is now defined at cell bottom, AZ will nee
    445 d to be averaged to the RHS of cell
    446   END DO
    447   AZ(KB(I),I) = AZMIN
    448   AZT(KB(I),I)= AZMIN
    449 RETURN
    450 END SUBROUTINE CALCULATE_TKE1


