    169 SUBROUTINE PIPE_FLOW_INITIALIZE
    170   USE GLOBAL; USE GEOMC; USE STRUCTURES; USE SCREENC, ONLY: NIT, JDAY; USE ENVIRPMOD, ONLY: CONE
    171   IMPLICIT NONE  
    172   REAL(R8) :: DTQ,DLTX,EL1,EL2,HIE,EPS,DCHECK,D1,D2,DTEST,VTOT,TOTT,DCRIT,DEPTHCRIT
    173   real(R8) :: upcl,dncl,d1sum,d2sum,EC                     ! cb 07/17/19
    174   integer  :: kup,kdn                      ! cb 07/17/19
    175 
    176   INTEGER  :: JP,K,niter     
    177   CHARACTER*2 :: SSP,ADEBUG
    178   LOGICAL :: SteadyStatePipe
    179   SAVE
    180 
    181 
    182   ALLOCATE (BEGIN(NPI), WLFLAG(NPI), VMAX(NPI))
    183   QOLD   =  0.01;  VMAX   =  0.01
    184   BEGIN  = .TRUE.; WLFLAG = .TRUE. 
    185   
    186 ! pipe-steady-state.npt
    187   SteadyStatePipe=.FALSE. 
    188   SSP='0F'
    189   INQUIRE(FILE='steady-state-pipe.npt', EXIST=SteadyStatePipe)   ! file_exists will be TRUE if the file
    190   	IF(SteadyStatePipe) THEN
    191     OPEN(CONE,FILE='steady-state-pipe.npt',STATUS='OLD')
    192       READ(CONE,*)
    193       READ(CONE,*)SSP
    194       IF(SSP/='ON')SteadyStatePipe=.FALSE.
    195       READ(CONE,*)
    196       READ(CONE,*)EC
    197       IF(EC==0.0)EC=1.0   ! CALIBRATION PARAMETER DEFAULT VALUE FOR EC WHICH IS THE ENTRANCE LOSS COEFFICIENT KE
    198       READ(CONE,*)
    199       READ(CONE,*)ADEBUG
    200       IF(ADEBUG=='ON')OPEN(9977,FILE='SS_Pipe_debug_output.csv',STATUS='UNKNOWN')
    201       CLOSE(CONE)
    202 	ENDIF
    203 
    204 RETURN
    205 
    206 ENTRY PIPE_FLOW      
    207   DTQ = DLT/10.0
    208   DO JP=1,NPI
    209     DIA   = WPI(JP)
    210     CLEN  = DLXPI(JP)
    211     FMAN  = FPI(JP)
    212     CLOSS = FMINPI(JP)
    213     UPIE  = EUPI(JP)
    214     DNIE  = EDPI(JP)
    215     DLTX  = CLEN/(REAL(NC-1)*0.5)
    216     IF (LATERAL_PIPE(JP)) THEN
    217       EL1   = ELWS(IUPI(JP))                                                                 !EL(KTWB(JWUPI(JP)),IUPI(JP))-Z

