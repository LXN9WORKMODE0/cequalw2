    524 
    525 FUNCTION RTBIS(X1,X2,XACC,U,Y,V)
    526 USE GLOBAL, ONLY:WRN,JW; USE EDDY, ONLY:AZC; USE SCREENC, ONLY:JDAY; USE PREC
    527 IMPLICIT NONE
    528 REAL(R8), INTENT(IN) :: X1,X2,XACC,U,Y,V
    529 REAL(R8) :: RTBIS,SEMILOG
    530 EXTERNAL SEMILOG
    531 INTEGER, PARAMETER :: MAXIT=70                                                    !80
    532 ! USING BISECTION, FIND THE ROOT OF A FUNCTION FUNC KNOWN TO LIE BETWEEN X1 AND X2. THE
    533 ! ROOT, RETURNED AS RTBIS, WILL BE REFINED UNTIL ITS ACCURACY IS �XACC.
    534 ! PARAMETER: MAXIT IS THE MAXIMUM ALLOWED NUMBER OF BISECTIONS.
    535 INTEGER  :: J
    536 REAL(R8) :: DX,F,FMID,XMID
    537   FMID = SEMILOG(X2,U,Y,V)
    538   F = SEMILOG(X1,U,Y,V)
    539   IF (F*FMID >= 0.0) THEN
    540           WRITE(WRN,*)'RTBIS: ROOT MUST BE BRACKETED IN TKE1 ROUTINE ON JDAY:',JDAY
    541 		  WRITE(WRN,*)'Setting TKE calculation to TKE from TKE1'
    542 		  RTBIS=X1
    543 		  AZC(JW)='     TKE'
    544           RETURN
    545   ENDIF
    546   IF (F < 0.0) THEN !ORIENT THE SEARCH SO THAT F>0 LIES AT X+DX.
    547     RTBIS = X1
    548     DX = X2-X1
    549   ELSE
    550     RTBIS = X2
    551     DX = X1-X2
    552   END IF
    553   DO J=1,MAXIT !BISECTION LOOP.
    554     DX = DX*0.5
    555     XMID = RTBIS+DX
    556     FMID = SEMILOG(XMID,U,Y,V)
    557     IF (FMID <= 0.0) RTBIS=XMID
    558     IF (ABS(DX) < XACC .OR. FMID == 0.0) THEN
    559 	  RETURN
    560 	ENDIF
    561   END DO
    562   WRITE(WRN,*)'RTBIS: TOO MANY BISECTIONS IN TKE1 ROUTINE ON JDAY:',JDAY
    563   WRITE(WRN,*)'Setting TKE calculation to TKE from TKE1'
    564   AZC(JW)='     TKE'
    565 END FUNCTION RTBIS

