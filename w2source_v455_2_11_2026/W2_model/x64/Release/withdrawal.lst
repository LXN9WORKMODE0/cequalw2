   3500                 ELSE
   3501                     READ (SELD(J),'(1000F8.0)') NXSEL(J),TEMP2(J)
   3502                 ENDIF   
   3503 !READ (SELD(J),'(1000F8.0)') NXSEL(J),TEMP2(J)
   3504         END DO
   3505       END IF
   3506     END DO
   3507 
   3508     do j=1,numtempc
   3509 
   3510 ! Structures
   3511       if (tcntr(j) == '      ST') then
   3512         js = tcjs(j)                                 ! set structure index
   3513         jb = tcjb(j)                                 ! set branch index
   3514         DO JW=1,NWB                                  ! set waterbody index
   3515           IF (JB >= BS(JW) .AND. JB <= BE(JW)) EXIT
   3516         END DO
   3517 
   3518         if (tciseg(j) .eq. 0) then
   3519           tcomp = tavg(js,jb)               !cb 9/8/06
   3520         else if (tciseg(j) < 0) then
   3521           tcomp = twdo(abs(tciseg(j)))      ! sw 11/26/10
   3522         else
   3523 
   3524 ! Check to see if the monitoring segment tciseg is in the same branch and waterbody as the structure
   3525           DO JJB=1,NBR
   3526             IF (tciseg(j) >= US(JJB) .AND. tciseg(j) <= DS(JJB)) exit
   3527           end do
   3528           DO JJW=1,NWB
   3529             IF (JjB >= BS(JJW) .AND. JJB <= BE(JJW)) EXIT
   3530           END DO
   3531 
   3532           IF (tcklay(j) < 0) THEN
   3533             K = INT(ABS(tcklay(j)))
   3534           ELSE
   3535             DO K=KTWB(JJW),KB(tciseg(j))
   3536               IF (DEPTHB(K,tciseg(j)) > tcklay(j)) EXIT
   3537             END DO
   3538             K = MIN(K,KB(tciseg(j)))
   3539           END IF
   3540           tcomp = t2(k,tciseg(j))
   3541         end if
   3542         if (tcyearly(j) == '     OFF') then
   3543           daytest = jday
   3544         else
   3545           daytest = real(jdayg) + jday - int(jday)
   3546         end if
   3547         if (daytest >= tctsrt(j) .and. daytest < tctend(j)) then
   3548           estr(js,jb) = tcelev(j,ncountc(js,jb))                  ! initialize the structure elevation
   3549 
   3550           if (tcomp > tctemp(j) .and. tcnelev(j) > ncountc(js,jb)) then
   3551 ! making sure that the next lower structure for a particular 'j' is found
   3552             do nj=ncountc(js,jb)+1,tcnelev(j)

Page 90          Source Listing                  SELECTIVEUSGS
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

   3553               if (tcelev(j,nj) < estr(js,jb)) then
   3554                 ncountc(js,jb) = nj
   3555                 estr(js,jb)    = tcelev(j,ncountc(js,jb))
   3556                 exit
   3557               end if
   3558             end do
   3559 
   3560           else if (tcomp < tctemp(j) .and. ncountc(js,jb) .gt. 1) then
   3561 ! to prevent this happening at each time it checks it and hence oscillating back and forth - check the temp at the upper out
   3561 let also
   3562             if (tciseg(j) > 0) then
   3563               if (jb .eq. jjb) then
   3564                 wsel = elws(ds(jb)) - sina(jb) * dlx(ds(jb)) * 0.5                        ! compute water-surface elevation 
   3564 !SR 03/24/13
   3565                 do ks=ktwb(jw),kb(ds(jb))
   3566 ! if (depthb(ks,tciseg(j)) > tcelev(j,ncountc(js,jb)-1)) exit             !??can't be right-- SR 03/24/13
   3567                   if (wsel - depthb(ks,tciseg(j)) < tcelev(j,ncountc(js,jb)-1)) exit      !SR 03/24/13
   3568                 end do
   3569                 ks   = min(ks,kb(tciseg(j)))
   3570                 tmod = t2(ks,ds(jb))
   3571               else
   3572                 tmod = t2(k,tciseg(j))
   3573               end if
   3574               if (tmod < tctemp(j) .and. tcelev(j,ncountc(js,jb)-1) < elws(ds(jb))) then
   3575 ! making sure that the next upper structure for a particular 'j' is found
   3576                 do nj=ncountc(js,jb)-1,1,-1
   3577                   if (tcelev(j,nj) > estr(js,jb)) then
   3578                     ncountc(js,jb) = nj
   3579                     estr(js,jb)    = tcelev(j,ncountc(js,jb))
   3580                     exit
   3581                   end if
   3582                 end do
   3583               end if
   3584 
   3585             else if (tciseg(j) .eq. 0) then
   3586 ! calculate the estimated outflow temperature at higher ports when tcomp < tctemp(j),
   3587 ! and move up if higher port still meets criteria - this doesn't happen when tciseg < 0
   3588               do nj=1,ncountc(js,jb)-1
   3589                 id = ds(jb)
   3590                 kt = ktwb(jw)
   3591                 call downstream_withdrawal_estimate(js,tempest,tcelev(j,nj))
   3592                 if (tempest < tctemp(j) .and. tcelev(j,nj) < elws(ds(jb))) then
   3593                   ncountc(js,jb) = nj
   3594                   estr(js,jb)    = tcelev(j,ncountc(js,jb))
   3595                   exit
   3596                 end if
   3597               end do
   3598             end if
   3599           end if
   3600           if (tcelevcon(j) == '      ON' .and. tcnelev(j) > ncountc(js,jb) .and. estr(js,jb) > elws(ds(jb)-MINWL(J))) then
   3601             ncountc(js,jb) = ncountc(js,jb)+1
   3602             estr(js,jb)    = tcelev(j,ncountc(js,jb))
   3603           end if
   3604         end if
   3605 
   3606 ! Withdrawals
   3607       else if (tcntr(j) == '      WD') then

