   1308                   WQFIELD(K,I,2) = 0.0
   1309                 ELSE IF ((K.EQ.KTWB(WB)).AND.(I.EQ.US(JB))) THEN       !Analogous to Node 1 above
   1310                   WQFIELD(K,I,1) = T2(K,I)
   1311                   WQFIELD(K,I,2) = O2(K,I)
   1312                 ELSE IF ((K.EQ.KTWB(WB)).AND.(I.EQ.DS(JB)+1)) THEN     !Analogous to Node 3 above
   1313                   WQFIELD(K,I,1) = T2(K,I-1)
   1314                   WQFIELD(K,I,2) = O2(K,I-1)
   1315                 ELSE IF (K.EQ.KTWB(WB)) THEN                             !Analogous to Node 2 above
   1316                   XRANGE = .5*DLX(I-1)+.5*DLX(I)
   1317                   WQFIELD(K,I,1) = (T2(K,I-1)*(XRANGE-.5*DLX(I-1))+ T2(K,I)*(XRANGE-.5*DLX(I)))/XRANGE
   1318                   WQFIELD(K,I,2) = (O2(K,I-1)*(XRANGE-.5*DLX(I-1))+O2(K,I)*(XRANGE-.5*DLX(I)))/XRANGE
   1319                 ELSE IF ((K.EQ.KBI(I)+1).AND.(I.EQ.US(JB))) THEN       !Analogous to Node 7 above                   K.EQ.KB(
   1319 I)+1).AND.(I.EQ.US(JB)))
   1320                   WQFIELD(K,I,1) = T2(K-1,I)
   1321                   WQFIELD(K,I,2) = O2(K-1,I)
   1322                 ELSE IF ((K.EQ.KBI(I)+1).AND.(I.EQ.DS(JB)+1)) THEN     !Analogous to Node 9 above                    K.EQ.KB
   1322 (I)+1).AND.(I.EQ.DS(JB)+1))
   1323                   WQFIELD(K,I,1) = T2(K-1,I-1)
   1324                   WQFIELD(K,I,2) = O2(K-1,I-1)
   1325                 ELSE IF (K.EQ.KBI(I)+1) THEN                             !Analogous to Node 8 above                (K.EQ.KB(
   1325 I)+1)
   1326                   IF(KB(I) /= KBI(I))THEN
   1327                     WQFIELD(K,I,1) = T2(KTWB(WB),I-1)   ! SW 8/20/2018 IN CASE OF LOWERING OF RIVER WATER LEVEL BECAUSE OF A
   1327  "NOTCH"
   1328                     WQFIELD(K,I,2) = O2(KTWB(WB),I-1)
   1329                   ELSE
   1330                   XRANGE = .5*DLX(I-1)+.5*DLX(I)
   1331                   WQFIELD(K,I,1) = (T2(K-1,I-1)*(XRANGE-.5*DLX(I-1))+&
   1332                                    T2(K-1,I)*(XRANGE-.5*DLX(I)))/XRANGE
   1333                   WQFIELD(K,I,2) = (O2(K-1,I-1)*(XRANGE-.5*DLX(I-1))+&
   1334                                    O2(K-1,I)*(XRANGE-.5*DLX(I)))/XRANGE
   1335                   ENDIF
   1336                 ELSE IF (I.EQ.US(JB)) THEN                            !Analogous to Node 4 above
   1337                   YRANGE = .5*H(K-1,WB)+.5*H(K,WB)
   1338                   WQFIELD(K,I,1) = (T2(K-1,I)*(YRANGE-.5*H(K-1,WB))+&
   1339                                     T2(K,I)*(YRANGE-.5*H(K,WB)))/YRANGE
   1340                   WQFIELD(K,I,2) = (O2(K-1,I)*(YRANGE-.5*H(K-1,WB))+&
   1341                                     O2(K,I)*(YRANGE-.5*H(K,WB)))/YRANGE
   1342                 ELSE IF (I.EQ.DS(JB)+1) THEN                          !Analogous to Node 6 above
   1343                   YRANGE = .5*H(K-1,WB)+.5*H(K,WB)

Page 49          Source Listing                  INTERCONST
2026-03-30 08:48                                 ..\..\..\particle.f90

   1344                   WQFIELD(K,I,1) = (T2(K-1,I-1)*(YRANGE-.5*H(K-1,WB))+&
   1345                                    T2(K,I-1)*(YRANGE-.5*H(K,WB)))/&
   1346                                    YRANGE
   1347                   WQFIELD(K,I,2) = (O2(K-1,I-1)*(YRANGE-.5*H(K-1,WB))+&
   1348                                    O2(K,I-1)*(YRANGE-.5*H(K,WB)))/&
   1349                                    YRANGE
   1350                 ELSE                                               ! Analogous to Node 5 above (i.e., in the middle)
   1351 ! Begin Bilinear Spline Interpolation Algorithm (Algorithm obtained from "TWO DIMENSIONAL SPLINE INTERPOLATION
   1352 !                                                ALGORITHMS - Author: Helmuth Spath")
   1353                   DV = 0.0-(-0.5*DLX(I-1))           ! 0.0 = X-coord of the desired interpolated location
   1354                   DW = 0.0-(-0.5*H(K-1,WB))             ! 0.0 = Y-coord of the desired interpolated location
   1355                   DX = 0.5*DLX(I)-(-0.5*DLX(I-1))
   1356                   DY = 0.5*H(K,WB)-(-0.5*H(K-1,WB))
   1357                   H1T = T2(K-1,I-1)                  ! H1T,H2T,H3T,H4T = Value of Temperature at 4 cell centers as
   1358                   H2T = T2(K-1,I)                    !   established in W2
   1359                   H3T = T2(K,I-1)
   1360                   H4T = T2(K,I)
   1361                   H1DO = O2(K-1,I-1)                 ! H1DO,H2DO,H3DO,H4DO = Value of Diss. Oxyg. at 4 cell centers as
   1362                   H2DO = O2(K-1,I)                   !   established in W2
   1363                   H3DO = O2(K,I-1)
   1364                   H4DO = O2(K,I)
   1365                   WQFIELD(K,I,1) = H1T+(H2T-H1T)/DX*DV+(H3T-H1T)  &                ! Temperature at grid node
   1366                           /DY*DW+(H4T-H3T-H2T+H1T)/(DX*DY)*DV*DW
   1367                   WQFIELD(K,I,2) = H1DO+(H2DO-H1DO)/DX*DV+(H3DO-H1DO) &            ! Dissolved Oxygen at grid node
   1368                           /DY*DW+(H4DO-H3DO-H2DO+H1DO)/(DX*DY)*DV*DW
   1369 ! End Bilinear Spline Interpolation Algorithm
   1370                 END IF
   1371 
   1372 
   1373 !ELSE
   1374               END IF
   1375 !130       CONTINUE
