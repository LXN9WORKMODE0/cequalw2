    426   CONTAINS
    427   REAL    FUNCTION SATO (T,SAL,P,SALT_WATER)
    428       REAL(R8) :: T,SAL
    429       REAL(R8) :: P
    430       LOGICAL  :: SALT_WATER
    431       SATO = EXP(7.7117-1.31403*(LOG(T+45.93)))*P
    432       IF (SALT_WATER) THEN
    433           SATO = EXP(LOG(SATO)-SAL*(1.7674E-2-1.0754E1/(T+273.15)+2.1407E3/(T+273.15)**2))            ! SAL is in ppt
    434       ELSEIF(SAL > 100.)THEN
    435           SATO = EXP(LOG(SATO)-(SAL/1000.)*(1.7674E-2-1.0754E1/(T+273.15)+2.1407E3/(T+273.15)**2))    ! SAL is in mg/l
    436       ENDIF
    437     END FUNCTION SATO

