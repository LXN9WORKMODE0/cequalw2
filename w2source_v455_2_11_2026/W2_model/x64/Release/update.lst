     13 ********
     14     
     15     SZ     = Z
     16     SELWS  = ELWS
     17     SKTI   = KTI
     18     SBKT   = BKT
     19     VOLUH2 = QUH1  *DLT
     20     VOLDH2 = QDH1  *DLT
     21     TSSUH2 = TSSUH1*DLT
     22     TSSDH2 = TSSDH1*DLT
     23     DO JW=1,NWB
     24      KT = KTWB(JW)
     25       ELKT(JW) = ELWS(DS(BS(JW)))     !EL(KT,DS(BS(JW)))-Z(DS(BS(JW)))*COSA(BS(JW))
     26       DO JB=BS(JW),BE(JW)
     27           
     28 !** Horizontal diffusivities   ! SW 8/2/2017
     29       IF(DXI(JW) < 0.0)THEN
     30       DO I=CUS(JB),DS(JB)-1
     31         DO K=KT,KBMIN(I)
     32           DX(K,I) = ABS(U(K,I))*ABS(DXI(JW))
     33           IF (INTERNAL_WEIR(K,I)) DX(K,I) = 0.0
     34         END DO
     35       END DO
     36       ENDIF
     37           
     38 ! CODE MOVED to after wse computation       ELWS(CUS(JB):DS(JB)+1) = EL(KT,CUS(JB):DS(JB)+1)-Z(CUS(JB):DS(JB)+1)*COSA(JB)
     39 !DO I=US(JB)-1,DS(JB)
