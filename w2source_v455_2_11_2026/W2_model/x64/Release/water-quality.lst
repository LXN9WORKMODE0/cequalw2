   1329       FEOOHSS(K,I) = -FE2D(K,I) - KFE_RED(JW)*FEMN_TEMP(K,I)*(KFEOOH_HalfSat(JW)/(O2(K,I)+KFEOOH_HalfSat(JW)))*FEOOH(K,I) + 
