    344 
    345       SUBROUTINE MANNINGS_EQN(FLOW,DEPTH,FUNCVALUE)
    346       
    347       USE GLOBAL; USE GEOMC; USE EDDY; USE LOGICC
    348       
    349       REAL(R8) :: FLOW
    350       REAL     :: WSURF, DEPTH, XAREA, WPER, HRAD,FMANN, FUNCVALUE
    351 
    352 !     WSURF=EL(KB(I)-1,I)+DEPTH
    353       WSURF=EL(KB(I)+1,I)+DEPTH   ! CB 7/7/10
    354       CALL XSECTIONAL_AREA(WSURF,XAREA)
    355       WPER=B(KTI(I),I)+2.0*DEPTH
    356       HRAD=XAREA/WPER
    357       IF(MANNINGS_N(JW))THEN
    358         FMANN=FRIC(I)
    359       ELSE
    360         FMANN=HRAD**0.166666667/FRIC(I)
    361       END IF
    362       FUNCVALUE=FLOW-XAREA*HRAD**0.6667*SLOPEC(JB)**0.5/FMANN            ! SW 4/5/2013
    363       
    364       RETURN
    365       END SUBROUTINE MANNINGS_EQN

