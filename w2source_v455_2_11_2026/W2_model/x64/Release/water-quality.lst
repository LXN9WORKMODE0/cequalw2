   2257 !***************************************************************************************************************************
   2257 ********
   2258 !*                                                         E P I P H Y T O N                                                
   2258       **
   2259 !***************************************************************************************************************************
   2259 ********
   2260 
   2261 ENTRY EPIPHYTON (J)
   2262   DO I=IU,ID
   2263 
   2264 !** Limiting factor
   2265     if(Met_regions)then
   2266     LIGHT = (1.0-BETA(JW))*SRON(WB_MetRegions(JW))*SHADE(I)/ESAT(J)
   2267     else
   2268     LIGHT = (1.0-BETA(JW))*SRON(JW)*SHADE(I)/ESAT(J)    
   2269     endif
   2270     
   2271     LAM2  =  LIGHT
   2272     LAM1  =  LIGHT
   2273     DO K=KT,KB(I)
   2274 
   2275 !**** Limiting factor
   2276 
   2277       LAM1          = LAM2
   2278       LAM2          = LAM1*EXP(-GAMMA(K,I)*H1(K,I))
   2279       FDPO4         = 1.0-FPSS(K,I)-FPFE(K,I)
   2280       ELLIM(K,I,J)  = 2.718282*(EXP(-LAM2)-EXP(-LAM1))/(GAMMA(K,I)*H1(K,I))
   2281       IF (EHSP(J)  /= 0.0) EPLIM(K,I,J) =  FDPO4*PO4(K,I)/(FDPO4*PO4(K,I)+EHSP(J)+NONZERO)
   2282       IF (EHSN(J)  /= 0.0) ENLIM(K,I,J) = (NH4(K,I)+NO3(K,I))/(NH4(K,I)+NO3(K,I)+EHSN(J)+NONZERO)
   2283       IF (EHSSI(J) /= 0.0) ESLIM(K,I,J) =  DSI(K,I)/(DSI(K,I)+EHSSI(J)+NONZERO)
   2284       LIMIT         =  MIN(EPLIM(K,I,J),ENLIM(K,I,J),ESLIM(K,I,J),ELLIM(K,I,J))
   2285       BLIM          =  1.0-(EPD(K,I,J)/(EPD(K,I,J)+EHS(J)))
   2286 
   2287 !**** Sources/sinks
   2288 
   2289       EGR(K,I,J) =  MIN(ETRM(K,I,J)*EG(J)*LIMIT*BLIM,PO4(K,I)/(EP(J)*DLT*EPD(K,I,J)/H1(K,I)+NONZERO),(NH4(K,I)+NO3(K,I))/(EN
   2289 (J)   &
   2290                     *DLT*EPD(K,I,J)/H1(K,I)+NONZERO))
   2291       ERR(K,I,J) =  ETRM(K,I,J)*ER(J)*DO3(K,I)
   2292       EMR(K,I,J) = (ETRMR(K,I,J)+1.0-ETRMF(K,I,J))*EM(J)
   2293       EER(K,I,J) =  MIN((1.0-ELLIM(K,I,J))*EE(J)*ETRM(K,I,J),EGR(K,I,J))
   2294 !      EPD(K,I,J) =  MAX(EPD(K,I,J)+EPD(K,I,J)*(EGR(K,I,J)-ERR(K,I,J)-EMR(K,I,J)-EER(K,I,J)-EBR(K,I,J)/(H1(K,I)*0.0025))*DLT
   2294 ,0.0)
   2295 !      EPD(K,I,J) =  MAX(EPD(K,I,J)+EPD(K,I,J)*(EGR(K,I,J)-ERR(K,I,J)-EMR(K,I,J)-EER(K,I,J)-EBR(K,I,J)/H1(K,I))*DLT,0.00)   
   2295 ! cb 5/18/06
   2296       EPD(K,I,J) =  MAX(EPD(K,I,J)+EPD(K,I,J)*(EGR(K,I,J)-ERR(K,I,J)-EMR(K,I,J)-EER(K,I,J)-EBR(K,I,J))*DLT,0.00)   ! SW 3/20

Page 46          Source Listing                  
2026-03-30 08:47                                 ..\..\..\water-quality.f90

   2296 19
   2297       if(k == kb(i)) then      ! SW 12/16/07
   2298       EPM(K,I,J) =  EPD(K,I,J)*(BI(K,I)+2.0*H1(K,I))*DLX(I)
   2299 	  else
   2300       EPM(K,I,J) =  EPD(K,I,J)*(BI(K,I)-BI(K+1,I)+2.0*H1(K,I))*DLX(I)
   2301 	  endif
   2302       EPC(K,I,J) =  EPM(K,I,J)/VOL(K,I)
   2303     END DO
   2304   END DO
   2305 RETURN
   2306 
