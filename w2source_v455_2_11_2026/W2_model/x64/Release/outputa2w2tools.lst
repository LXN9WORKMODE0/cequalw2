    133       DO JB=1,NBR            ! SR 12/2024
    134         DO I=US(JB),DS(JB)
    135           IF (I.LT.CUS(JB) .OR. BR_INACTIVE(JB)) THEN
    136             WSEL(I) = -999
    137           ELSE
    138             WSEL(I) = ELWS(I)
    139           END IF
    140         END DO
    141       END DO     
    142       WRITE(WLFN,'(f10.3,",",*(f8.3,","))')jday,((wsel(i),i=us(jb),ds(jb)),jb=1,nbr)      
    143       ENDIF
    144   ENDIF
