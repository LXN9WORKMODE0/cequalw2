    904  /ELAPSED TIME IN S/1000 G/KG == KG/D  !ZZ 11/23
    905                 KFJW(JW,KFCN(JAF,JW)) = KFJW(JW,KFCN(JAF,JW))+KFS(K,I,KFCN(JAF,JW))  ! SUM UP FOR ENTIRE WATERBODY
    906               END DO  
    907             END DO  
    908           END DO  
