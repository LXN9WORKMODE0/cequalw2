    383 !**                                                L A T E R A L   W I T H D R A W A L                                      
    383       **
    384 !***************************************************************************************************************************
    384 ********
    385 
    386 ENTRY LATERAL_WITHDRAWAL
    387 
    388 ! Variable initialization
    389 
    390   VNORM = 0.0; QSW(:,JWD) = 0.0; HWDT = 0.0; HWDB = 0.0
    391 
    392 ! Structure layer
    393 
    394   K = KT
    395   DO K=KT,KB(I)
    396     IF (EL(K,I) < EWD(JWD)) EXIT
    397   END DO
    398   KWD = MAX(K-1,KT)
    399   KWD = MIN(KWD,KB(I))
    400 
    401 ! Initial withdrawal limits
    402 
    403   KTOP = MAX(KTWD(JWD),KT)
    404   IF (KWD < KTOP) KTOP = KWD
    405   KBOT = MIN(KBWD(JWD),KB(I))
    406   IF (KBOT <= KT .AND. KB(I) /= KBOT) KBOT = KT+1
    407   IF (KBOT > KB(I)) KBOT = KB(I)
    408   ELWD = EWD(JWD)
    409   IF (EWD(JWD) <= EL(KB(I)+1,I)) THEN
    410     KWD  = KB(I)
    411     ELWD = EL(KB(I),I)
    412   END IF
    413   IF (EWD(JWD) > EL(KT,I)) ELWD = EL(KT,I)
    414   IF (KBWD(JWD) < KWD) THEN
    415     KWD  = KTOP        ! KT  !SW 8/13/2024
    416     ELWD = EL(KTOP,I)  ! EL(KT,I)
    417   END IF
    418 
    419 ! Boundary interference
    420 
    421   COEF = 1.0
    422   IF (KT /= KBOT) THEN
    423     RATIO = (ELWD-EL(KBOT,I))/(EL(KT,I)-EL(KBOT,I))
    424     IF (RATIO < 0.1 .OR. RATIO > 0.9) COEF = 2.0

Page 9           Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    425   END IF
    426 
    427 ! Withdrawal zone above structure
    428 
    429   DO K=KWD-1,KTOP,-1
    430 
    431 !** Density frequency
    432 
    433     HT    = EL(K,I)-ELWD
    434     RHOFT = MAX(SQRT((ABS(RHO(K,I)-RHO(KWD,I)))/(HT*RHO(KWD,I)+NONZERO)*G),NONZERO)
    435 
    436 !** Thickness
    437 
    438     HWDT = (COEF*QWD(JWD)/RHOFT)**0.333333
    439     IF (HT >= HWDT) THEN
    440       KTOP = K; EXIT
    441     END IF
    442   END DO
    443 
    444 ! Reference density
    445 
    446   IF ((ELWD+HWDT) < EL(KT,I)) THEN
    447     DLRHOT = ABS(RHO(KWD,I)-RHO(KTOP,I))
    448   ELSE IF (EL(KT,I) == ELWD) THEN
    449     DLRHOT = NONZERO
    450   ELSE
    451     DLRHOT = ABS(RHO(KWD,I)-RHO(KT,I))*HWDT/(EL(KT,I)-ELWD)
    452   END IF
    453   DLRHOT = MAX(DLRHOT,NONZERO)
    454 
    455 ! Withdrawal zone below structure
    456 
    457   DO K=KWD+1,KBOT
    458 
    459 !** Density frequency
    460 
    461     HB    = ELWD-EL(K,I)
    462     RHOFB = MAX(SQRT((ABS(RHO(K,I)-RHO(KWD,I)))/(HB*RHO(KWD,I)+NONZERO)*G),NONZERO)
    463 
    464 !** Thickness
    465 
    466     HWDB = (COEF*QWD(JWD)/RHOFB)**0.333333
    467     IF (HB >= HWDB) THEN
    468       KBOT = K; EXIT
    469     END IF
    470   END DO
    471 
    472 ! Reference density
    473 
    474   IF ((ELWD-HWDB) > EL(KBOT+1,I)) THEN
    475     DLRHOB = ABS(RHO(KWD,I)-RHO(KBOT,I))
    476   ELSE IF (EL(KBOT+1,I) == ELWD) THEN                                                                                  !SR 0
    476 3/24/13
    477     DLRHOB = NONZERO                                                                                                   !SR 0
    477 3/24/13
    478   ELSE
    479     DLRHOB = ABS(RHO(KWD,I)-RHO(KBOT,I))*HWDB/(ELWD-EL(KBOT+1,I))

Page 10          Source Listing                  WITHDRAWAL
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

    480   END IF
    481   DLRHOB = MAX(DLRHOB,NONZERO)
    482 
    483 ! Velocity profile
    484 
    485   VSUM     = 0.0
    486 !  DLRHOMAX = MAX(DLRHOT,DLRHOB,1.0E-10)                                                                             ! SW 1/
    486 24/05
    487       
    488   DO K=KTOP,KBOT
    489 !    VNORM(K) = ABS(1.0-((RHO(K,I)-RHO(KWD,I))/DLRHOMAX)**2)*BHR2(K,I)
    490  	   IF(K.GT.KWD)THEN
    491        DLRHOMAX = MAX(DLRHOB,1.0E-10)                          !GH 1/31/08
    492        ELSE
    493        DLRHOMAX = MAX(DLRHOT,1.0E-10)                          !GH 1/31/08
    494        ENDIF
    495      VNORM(K) = 1.0-((RHO(K,I)-RHO(KWD,I))/DLRHOMAX)**2
    496  	 IF(VNORM(K).GT.1.0) VNORM(K)=1.0                         !GH 1/31/08
    497 	 IF(VNORM(K).LT.0.0) VNORM(K)=0.0                         !GH 1/31/08
    498 	 VNORM(K)=VNORM(K)*BHR2(K,I)
    499      VSUM     = VSUM+VNORM(K)
    500   END DO
    501   
    502 ! Outflows
    503   QSUMWD=0.0                                                  ! SW 7/30/09
    504   TAVGW(JWD)=0.0
    505   IF(CONSTITUENTS)CAVGW(JWD,CN(1:NAC))=0.0
    506   IF(DERIVED_CALC)CDAVGW(JWD,CDN(1:NACD(JW),JW))=0.0
    507   
    508     IF(VSUM==0.0)THEN
    509       WRITE(WRN,'(A,F12.3,A,I5,A,I5,A,I5,A,E12.4,A)')'LATERAL WITHDRAWAL: VSUM=0.0 on JDAY:',JDAY,' KTOP:',KTOP,' KBOT:',KBO
    509 T,' KWD:',KWD,' DLRHOMAX:',DLRHOMAX,' SET TO EQUAL WITHDRAWALS WITH DEPTH'
    510       VSUM=1.0
    511       DO K=KTOP,KBOT
    512       VNORM(K)=1.0/(KTOP-KBOT+1)
    513       ENDDO
    514   ENDIF
    515 
    516   DO K=KTOP,KBOT
    517     FRACV=(VNORM(K)/VSUM)
    518     QSW(K,JWD) = QSW(K,JWD)+FRACV*QWD(JWD)
    519     TAVGW(JWD)=TAVGW(JWD)+FRACV*QWD(JWD)*T2(K,I)                  ! SW 7/30/09
    520     IF(CONSTITUENTS)CAVGW(JWD,CN(1:NAC))=CAVGW(JWD,CN(1:NAC))+FRACV*QWD(JWD)*C2(K,I,CN(1:NAC))  
    521     IF(DERIVED_CALC)CDAVGW(JWD,CDN(1:NACD(JW),JW))=CDAVGW(JWD,CDN(1:NACD(JW),JW))+FRACV*QWD(JWD)*CD(K,I,CDN(1:NACD(JW),JW))
    522     QSUMWD=QSUMWD+FRACV*QWD(JWD)
    523   END DO
    524 ! Debug
    525 !if(qwd(jwd)>0.0 .and. qsumwd <= 0.0)then
    526 !    write(9575,'(A,f8.3,1x,i5,1x,i5,1x,i5,f8.4,1x,f8.4,1x,f10.2)')'JDAY, ktop, kbot, kwd, qwd, qsumwd, elwd:',JDAY, ktop, k
    526 bot, kwd, qwd, qsumwd, elwd
    527 !endif
    528 ! Debug
    529   IF(QSUMWD.GT.0.0)THEN
    530     TAVGW(JWD)=TAVGW(JWD)/QSUMWD               ! SW 7/30/09
    531     IF(CONSTITUENTS)then                       ! cb 1/16/13
    532       CAVGW(JWD,CN(1:NAC))=CAVGW(JWD,CN(1:NAC))/QSUMWD  
    533       if(tdgon)then

