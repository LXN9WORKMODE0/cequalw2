   1308         IF(DEBUGP=='ON')write(9977,'(A,A,F10.2,A,F10.4,A,F10.4,A,F10.4)')AID,', FLOW:,',QOUT,', JDAY:,',JDAY,', HEAD:,',HEAD
   1308 ,', HDIF:,',HDIF
