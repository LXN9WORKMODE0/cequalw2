      7 SUBROUTINE GATE_FLOW
      8   USE STRUCTURES; USE GLOBAL; USE GEOMC    !;use SCREENC, only:JDAY
      9   IMPLICIT NONE
     10     INTEGER :: JG,ISUB,IGT
     11     REAL(R8)    :: ELIU,ELID,HTAIL,HENERGY,DLEL
     12 
     13 
     14   DO JG=1,NGT
     15    IF(DYNGTC(JG) == '    FLOW'  .or. DYNGTC(JG) == 'FLOW_ZGT' )THEN    
     16     QGT(JG) = BGT(JG)
     17    ELSE
     18 
     19 !   ELIU =  ELWS(IUGT(JG))       !EL(KTWB(JWUGT(JG)),IUGT(JG))-Z(IUGT(JG))*COSA(BS(JWUGT(JG)))
     20     IF (LATERAL_GATE(JG)) THEN
     21       ELIU =  ELWS(IUGT(JG))      !EL(KTWB(JWUGT(JG)),IUGT(JG))-Z(IUGT(JG))*COSA(BS(JWUGT(JG)))
     22     ELSE
     23 !ELIU=ELWS(IUGT(JG))-SINA(JBUGT(JG))*DLX(IUGT(JG))*0.5     !EL(KTWB(JWUGT(JG)),IUGT(JG))-Z(IUGT(JG))*COSA(BS(JWUGT(JG)))-SIN
     23 A(JBUGT(JG))*DLX(IUGT(JG))*0.5
     24       ELIU= ELWS(IUGT(JG)) + (ELWS(IUGT(JG))-ELWS(IUGT(JG)-1))/(0.5*(DLX(IUGT(JG))+DLX(IUGT(JG)-1)))*DLX(IUGT(JG))*0.5     !
     24  LINEAR INTERPOLATION OF THE WATER LEVEL TO THE EDGE
     25     END IF
     26     IF (IDGT(JG) /= 0)THEN
     27       IF (US(JBDGT(JG)) /= IDGT(JG)) THEN
     28         ELID = ELWS(IDGT(JG))     !EL(KTWB(JWDGT(JG)),IDGT(JG))-Z(IDGT(JG))*COSA(BS(JWDGT(JG)))
     29       ELSE
     30 !ELID = ELWS(IDGT(JG))+SINA(JBDGT(JG))*DLX(IDGT(JG))*0.5          !EL(KTWB(JWDGT(JG)),IDGT(JG))-Z(IDGT(JG))*COSA(BS(JWDGT(JG
     30 )))+SINA(JBDGT(JG))*DLX(IDGT(JG))*0.5
     31         ELID = ELWS(IDGT(JG)) - (ELWS(IDGT(JG)+1) - ELWS(IDGT(JG)))/(0.5*(DLX(IDGT(JG))+DLX(IDGT(JG)+1)))*DLX(IDGT(JG))*0.5 
     31  
     32       END IF
     33     ELSE
     34       ELID = -100.0
     35     END IF
     36     IF (BGT(JG) /= 0.0) THEN
     37       IF (ELID > EGT(JG) .OR. ELIU > EGT(JG)) THEN
     38         ISUB = 0
     39         IF (A2GT(JG) /= 0.0 .AND. IDGT(JG) /= 0) THEN                                    ! SW 8/21/2013
     40           HTAIL =  ELID-EGT(JG)                                                          ! SW 5/10/05
     41           IF (HTAIL > 0) THEN
     42             HENERGY = (U(KTWB(JWUGT(JG)),IUGT(JG))**2)/(2.0*G)+ELIU-EGT(JG)              ! SW 5/10/05
     43             IF (HTAIL/HENERGY > 0.67) ISUB = 1
     44           END IF
     45         END IF
     46         IGT = 0
     47         IF (BGT(JG) >= 0.8*(ELIU-EGT(JG)) .AND. GTA1(JG) /= 0.0) IGT = 1
     48         IF (IGT == 0) THEN
     49           IF (ISUB == 0) THEN
     50             DLEL = ELIU-EGT(JG)

Page 2           Source Listing                  GATE_FLOW
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

     51             IF (A2GT(JG) == 0.0 .AND. G2GT(JG) /= 0.0) DLEL = ELIU-G2GT(JG)
     52             IF (DLEL < 0.0) THEN
     53               DLEL    = -DLEL
     54               IF(G1GT(JG)/=0.0)THEN
     55               QGT(JG) = -A1GT(JG)*(DLEL**B1GT(JG))*BGT(JG)**G1GT(JG)
     56             ELSE
     57               QGT(JG) = -A1GT(JG)*(DLEL**B1GT(JG))
     58               ENDIF
     59             ELSE
     60                IF(G1GT(JG)/=0.0)THEN
     61               QGT(JG) =  A1GT(JG)*(DLEL**B1GT(JG))*BGT(JG)**G1GT(JG)  
     62                ELSE
     63                 QGT(JG) =  A1GT(JG)*(DLEL**B1GT(JG))  
     64                ENDIF
     65             END IF
     66           ELSE IF (ELID > ELIU) THEN
     67             DLEL    =  ELID-ELIU
     68             IF(G2GT(JG)/=0.0)THEN
     69             QGT(JG) = -A2GT(JG)*DLEL**B2GT(JG)*BGT(JG)**G2GT(JG)
     70           ELSE
     71             QGT(JG) = -A2GT(JG)*DLEL**B2GT(JG)  
     72             ENDIF
     73           ELSE
     74             DLEL    =  ELIU-ELID
     75             IF(G2GT(JG)/=0.0)THEN
     76             QGT(JG) =  A2GT(JG)*DLEL**B2GT(JG)*BGT(JG)**G2GT(JG)
     77             ELSE
     78             QGT(JG) =  A2GT(JG)*DLEL**B2GT(JG) 
     79             ENDIF
     80           END IF
     81         ELSE IF (ISUB == 0) THEN
     82           DLEL = ELIU-EGT(JG)
     83           IF (ELID > EGT(JG)) DLEL = ELIU-ELID
     84           IF (DLEL < 0.0) THEN
     85             DLEL    = -DLEL
     86             QGT(JG) = -GTA1(JG)*DLEL**GTB1(JG)
     87           ELSE
     88             QGT(JG) =  GTA1(JG)*DLEL**GTB1(JG)
     89           END IF
     90         ELSE IF (ELID > ELIU) THEN
     91           DLEL    =  ELID-ELIU
     92           QGT(JG) = -GTA2(JG)*DLEL**GTB2(JG)
     93         ELSE
     94           DLEL    =  ELIU-ELID
     95           QGT(JG) =  GTA2(JG)*DLEL**GTB2(JG)
     96         END IF
     97       ELSE
     98         QGT(JG) = 0.0
     99       END IF
    100     ELSE
    101       QGT(JG) = 0.0
    102     END IF
    103    endif
    104   END DO
    105   
    106 END SUBROUTINE GATE_FLOW

