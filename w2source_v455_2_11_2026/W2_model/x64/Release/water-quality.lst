   1225       DO K=KT,KB(I)
   1226         DOSAT = SATO(T1(K,I),TDS(K,I),PALT(I),SALT_WATER(JW))
   1227         TDG(K,I) = 100.*((0.79*N2(K,I)/N2SAT) + O2(K,I)/DOSAT*0.21)
   1228       END DO 
