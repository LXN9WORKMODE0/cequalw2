    384 ENTRY DOWNSTREAM_BRANCH
    385   DO JJW=1,NWB
    386     IF (JJB >= BS(JJW) .AND. JJB <= BE(JJW)) EXIT
    387   END DO
    388   DO K=KT,KB(I)+1
    389     ELR(K) = EL(K,I)
    390   END DO
    391   DO K=KTWB(JJW),KB(DS(JJB))+1
    392     ELL(K) = EL(K,DS(JJB))+SINA(JJB)*DLX(DS(JJB))*0.5
    393   END DO
    394   ELW = ELWS(DS(JJB))                                      !EL(KTWB(JJW),DS(JJB))-Z(DS(JJB))*COSA(JJB)
    395   EL1  = ELW-SINA(JJB)*DLX(DS(JJB))*0.5
    396 !  IF(SLOPE(JJB) /= 0.0)THEN
    397 !  EL1  = ELW+(ELW-ELWS(DS(JJB)-1))/(0.5*(DLX(DS(JJB)+DLX(DS(JJB)+1))*DLX(DS(JJB))*0.5   ! SW 7/17/09
    398 !  ELSE
    399 !  EL1=ELW
    400 !  ENDIF
    401   KL   = KTWB(JJW)+1
    402   DO K=KT+1,KB(I)+1
    403     IF (ELR(K) >= ELL(KL)) THEN
    404       Q1 = VOLDH2(KL-1,JJB)/DLT
    405       B1 = BHR(KL-1,DS(JJB)-1)
    406       IF (KL == KTWB(JJW)+1) B1 = BHR2(KT,DS(JJB))
    407       U1 = U(KL-1,DS(JJB)-1)*B1
    408       HT = H2(KL-1,JJW)
    409       IF (KL == KTWB(JJW)+1) HT = H2(KT,DS(JJB))
    410       Q1 = Q1*((EL1-ELR(K))/HT)
    411       B2 = BHR(K-1,I)
    412       IF (K == KTWB(JW)+1) B2 = BHR2(KT,I)
    413       UXBR(K-1,I) = UXBR(K-1,I)+(ABS((U1/B2)*COS(BETABR)*Q1)/DLX(I))
    414       UYBR(K-1,I) = UYBR(K-1,I)+ABS(Q1*SIN(BETABR))
    415       EL1 = ELR(K)
    416       IF (ELR(K) == ELL(KL)) KL = KL+1
    417     ELSE
    418       U1    = 0.0
    419       Q1    = 0.0
    420       BRTOT = 0.0
    421       DO WHILE (ELR(K) <= ELL(KL))
    422         IF (KL /= KTWB(JJW)+1) THEN
    423           FRAC = (EL1-ELL(KL))/H(KL-1,JJW)
    424           B1   = BHR(KL-1,DS(JJB)-1)
    425         ELSE
    426           FRAC = (EL1-ELL(KL))/H2(KT,DS(JJB))
    427           B1   = BHR2(KT,DS(JJB))
    428         END IF
    429         U1  = U1+U(KL-1,DS(JJB))*B1*FRAC
    430         Q1  = Q1+(VOLDH2(KL-1,JJB)/DLT)*FRAC
    431         EL1 = ELL(KL)
    432         KL  = KL+1
    433         IF (KL > KB(DS(JJB)+1)) EXIT
    434       END DO
    435       IF (K == KTWB(JW)+1) THEN
    436         B2 = BHR2(KT,I)
    437       ELSE
    438         B2 = BHR(K-1,I)

Page 9           Source Listing                  WATERBODY
2026-03-30 08:47                                 ..\..\..\waterbody.f90

    439       END IF
    440       IF (H(KL-1,JJW) /= 0.0) THEN
    441         IF (KL-1 == KTWB(JJW)) THEN
    442           HT = H2(KT,DS(JJB))
    443         ELSE
    444           HT = H2(KL-1,JJW)
    445         END IF
    446         FRAC        = (EL1-ELL(KL-1))/HT
    447         Q1          =  Q1+FRAC*(VOLDH2(KL-1,JJB)/DLT)
    448         UXBR(K-1,I) =  UXBR(K-1,I)+(ABS((U1/B2)*COS(BETABR)*Q1)/DLX(I))
    449         UYBR(K-1,I) =  UYBR(K-1,I)+ABS(Q1*SIN(BETABR))
    450       END IF
    451       IF (KL > KB(DS(JJB)+1)) EXIT
    452       EL1 = ELR(K)
    453     END IF
    454   END DO
    455 RETURN
