    133               SROSED    =  SROOUT*TSEDF(JW)
    134               ELSE
    135               SROSED    =  SROOUT*(1.0D0-BI(KT+1,I)/BI(KT,I))*TSEDF(JW)
    136               ENDIF
    137               TSS(KT,I) =  TSS(KT,I)+SROSED
    138               TSSS(JB)  =  TSSS(JB) +SROSED*DLT
    139               SROIN     =  SROOUT*B(KT+1,I)/BI(KT,I)
    140               DO K=KT+1,KB(I)
    141                 SROOUT   = SROIN*DEXP(-GAMMA(K,I)*(H1(K,I)))
    142                 SRONET   = SROIN-SROOUT
    143                 IF(K /= KB(I))THEN                                         ! SW 1/18/08
    144                 SROSED   = SROOUT*(1.0D0-BI(K+1,I)/BI(K,I))*TSEDF(JW)
    145                 ELSE
    146                 SROSED   = SROOUT*TSEDF(JW)
    147                 ENDIF
    148                 TSS(K,I) = TSS(K,I)+ SRONET+SROSED
    149                 TSSS(JB) = TSSS(JB)+(SRONET+SROSED)*DLT
    150                 SROIN    = SROOUT*B(K+1,I)/B(K,I)
    151               END DO

