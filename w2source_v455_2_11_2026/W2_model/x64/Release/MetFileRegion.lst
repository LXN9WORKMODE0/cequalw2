     10     
     11     Contains
     12     
     13     Subroutine ReadMetRegions
     14     Use MAIN, ONLY: CON    
     15     Implicit None   
     16     Integer :: J
     17 
     18         
     19       Met_Regions=.FALSE.
     20       INQUIRE(FILE='w2_MetRegions.csv',EXIST=Met_Regions)    
     21      if(Met_regions)then
     22               FNMetRegion=CON
     23               OPEN(FNMetRegion,FILE='W2_MetRegions.csv',status='old')
     24               READ(FNMetRegion,*)
     25               READ(FNMetRegion,'(A2)')MetRegOn
     26           if(MetRegOn =='ON') then
     27                   READ(FNMetRegion,*)
     28                   READ(FNMetRegion,*)NMetFileRegions
     29                   ALLOCATE(MetRegWB(NMetFileRegions),MetRegStart(NMetFileRegions),MetRegEnd(NMetFileRegions),FNMetFileReg(NM
     29 etFileRegions))
     30                   READ(FNMetRegion,*)
     31               DO J=1,NMetFileRegions
     32                   READ(FNMetRegion,*)IJUNK,MetRegStart(J),MetRegEnd(J),FNMetFileReg(J)
     33               ENDDO
     34           else
     35                   Met_Regions=.FALSE.            
     36           endif
     37           CLOSE(CON)
     38      endif
     39 
     40     RETURN
     41     
     42     End Subroutine ReadMetRegions

