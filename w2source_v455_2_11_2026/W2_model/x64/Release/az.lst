    169     
    170 SUBROUTINE CALCULATE_TKE1
    171   USE AZ_LOCAL
    172   IMPLICIT NONE
    173   SAVE
    174 ! Subroutine based on work of Gould(2006) RODI WITHOUT WIND
    175 ! SW 6-28-04 DEADSEA  TKE
    176 ! BASED ON SUBROUTINE FIRST DEVELOPED BY CHAPMAN AND COLE (1995)
    177 ! BUG FIXES, CORRECTIONS, ADDITIONS SCOTT WELLS (2001)
    178 
    179 ! BOTTOM LAYER BC
    180   IF(ABS((U(KB(I),I)+U(KB(I),I-1))*.5)>NONZERO)THEN
    181 	USTARB = WALLFUNCTION()
    182 ! ERROR TRAPPING
    183     IF(USTARB == 0.0)THEN
    184 !	        IF (MANNINGS_N(JW)) THEN
    185 !	        HRAD = BH1(KT,I)/(B(KTI(I),I)-B(KT+1,I)+2.*AVH1(KT,I))
    186 !            if(macrophyte_on.and.mannings_n(jw))then
    187 !                call macrophyte_friction(hrad,fric(i),effric,kt,i)
    188 !                gc2=g*effric*effric/hrad**0.33333333
    189 !            else if(.not.macrophyte_on.and.mannings_n(jw))then
    190 !                gc2=g*fric(i)*fric(i)/hrad**0.33333333
    191 !            end if
    192 !            ELSE
    193 !            GC2 = 0.0
    194 !            IF (FRIC(I) /= 0.0) GC2 = G/(FRIC(I)*FRIC(I))
    195 !            END IF
    196 !	    USTARB = SQRT(GC2)*ABS(0.5*(U(KB(I),I)+U(KB(I),I-1)))
    197 ! END ERROR TRAPPING
    198 	ENDIF
    199 	TKE(KB(I),I,1) = (3.33*USTARB*USTARB)
    200 	TKE(KB(I),I,2) = (USTARB*USTARB*USTARB)/(0.41*(H(KB(I),JW))*0.5)                      !/2.0
    201     USTARBTKE(I) = USTARB
    202 	IF(STRICKON(JW))THEN
    203 	  CALL CALCFRIC()
    204 	ENDIF
    205   ELSE
    206 	USTARB = 0
    207 	TKE(KB(I),I,1) = TKEMIN1
    208 	TKE(KB(I),I,2) = TKEMIN2
    209     USTARBTKE(I) = USTARB
    210   ENDIF
    211 
    212 !INLET SET TO MOLECULAR CONDITIONS
    213 ! IUT = FIRSTI(JW)
    214   IF(I==IUT)THEN
    215 	DO K= KT, KB(I)
    216 	  TKE(K,IUT-1,2) = TKEMIN2
    217 	  TKE(K,IUT-1,1) = TKEMIN1
    218 	ENDDO
    219   ENDIF
    220 !OUTLET SET TO EQUAL TO I=I_OUTLET - 1
    221 !IDT = LASTI(JW)
    222   IF(I==IDT-1)THEN
    223     DO K= KT, KB(I)
    224 	  TKE(K,IDT,2) = TKE(K,IDT-1,2)
    225 	  TKE(K,IDT,1) = TKE(K,IDT-1,1)

Page 12          Source Listing                  CALCULATE_TKE1
2026-03-30 08:47                                 ..\..\..\az.f90

    226 	ENDDO
    227   ENDIF
    228 
    229 !CALCULATE HORIZONTAL PORTION OF THE SPLIT K-E EQUATIONS FOR INTERIOR LAYERS
    230   DO K = KT+1,KB(I)-1		
    231 	IF (MANNINGS_N(JW)) THEN
    232 	   HRAD = BH1(KT,I)/(B(KTI(I),I)-B(KT+1,I)+2.D0*AVH1(KT,I))                                !HRAD = BHR(K,I)/(BR(K,I)
    232 -BR(K+1,I)+2.0*H(K,JW))
    233 	   GC2  = G*FRIC(I)*FRIC(I)/HRAD**0.333
    234 	ELSE
    235            GC2 = 0.0
    236            IF (FRIC(I) /= 0.0) GC2 = G/(FRIC(I)*FRIC(I))
    237 	END IF
    238 
    239 	BOUK = DMAX1(AZ(K,I)*G*(RHO(K+1,I)-RHO(K,I))/(H(K,JW)*RHOW),0.0D0)
    240 	PRDK = AZ(K,I)*(0.5D0*(U(K,I)+U(K,I-1)-U(K+1,I)-U(K+1,I-1))/(H(K,JW)*0.5D0 + H(K+1,JW)*0.5D0))**2.0                 
    240 !/2.0  /2.0
    241 	IF(.NOT.TKELATPRD(JW))THEN
    242 	  PRHE = 0.0
    243 	  PRHK = 0.0
    244 	ELSE
    245 	  PRHE = TKELATPRDCONST(JW)*GC2**1.25*DABS(0.5D0*(U(K,I)+U(K,I-1)))**4.0/(0.5D0*B(K,I))**2.0
    246       PRHK = GC2/(0.5D0*B(K,I))*DABS(0.5D0*(U(K,I)+U(K,I-1)))**3.0
    247     ENDIF
    248 	UNST	   = PRDK-TKE(K,I,2)
    249 	UNSE	   = 1.44D0*TKE(K,I,2)/TKE(K,I,1)*PRDK-1.92D0*(TKE(K,I,2)/TKE(K,I,1)*TKE(K,I,2))
    250 
    251 	UDR		= (1.0D0+DSIGN(1.0D0,U(K,I)))*0.5D0
    252 	UDL		= (1.0D0+DSIGN(1.0D0,U(K,I-1)))*0.5D0
    253 	CONVKX 	= DLT/(DLX(I)*BH1(K,I))*((U(K,I)*(UDR*TKE(K,I,1)+(1.0-UDR)*TKE(K,I+1,1))*BR(K,I)*H2(K,I)-U(K,I-1)*(UDL*TKE(K
    253 ,I-1,1)+(1.0-UDL)*TKE(K,I,1))*BR(K,I-1)*H2(K,I-1)))
    254 	CONVEX 	= DLT/(DLX(I)*BH1(K,I))*((U(K,I)*(UDR*TKE(K,I,2)+(1.0-UDR)*TKE(K,I+1,2))*BR(K,I)*H2(K,I)-U(K,I-1)*(UDL*TKE(K
    254 ,I-1,2)+(1.0-UDL)*TKE(K,I,2))*BR(K,I-1)*H2(K,I-1)))
    255 	IF(IMPTKE(JW) == '     IMP')THEN
    256 	  TKE(K,I,1) = TKE(K,I,1) - CONVKX + DLT*(UNST+PRHK-BOUK)		
    257 	  TKE(K,I,2) = TKE(K,I,2) - CONVEX + DLT*(UNSE+PRHE)
    258 	ELSE
    259 	  ATA		  = (1.D00+DSIGN(1.0D0,W(K-1,I)))*0.5D0
    260 	  AB		  = (1.0D0+DSIGN(1.0D0,W(K,I)))*0.5D0
    261 	
    262 	  CONVKZ	  = DLT/(H2(K,I)*BH1(K,I))*((AB*TKE(K,I,1)+(1.0-AB)*TKE(K+1,I,1))*W(K,I)*BB(K,I)*AVH2(K,I)-(ATA*(TKE
    262 (K-1,I,1)+(1.0-ATA)*TKE(K,I,1))*W(K-1,I)*BB(K-1,I)*AVH2(K-1,I)))
    263       CONVEZ	  = DLT/(H2(K,I)*BH1(K,I))*((AB*TKE(K,I,2)+(1.0-AB)*TKE(K+1,I,2))*W(K,I)*BB(K,I)*AVH2(K,I)-(ATA*(TKE(K-1,I,2
    263 )+(1.0-ATA)*TKE(K,I,2))*W(K-1,I)*BB(K-1,I)*AVH2(K-1,I)))
    264 
    265 	  TKE(K,I,1) = TKE(K,I,1) - CONVKX - CONVKZ + DLT*(UNST+PRHK-BOUK)		
    266 	  TKE(K,I,2) = TKE(K,I,2) - CONVEX - CONVEZ + DLT*(UNSE+PRHE)
    267 	ENDIF
    268   END DO
    269 
    270 !CALCULATE TOP LAYER BOUNDARY CONDITION AND SOLVE THE K-E EQUATION USING TRIDIAGONAL SOLVER
    271 500 IF(TKEBC(JW)==1)THEN
    272 !RODI NOWIND
    273     DEPTHL = (ELWS(I)-EL(KB(I),I)	  +H2(KB(I),I)	*COSA(JB))/COSA(JB)                                !EL(KT,I)  -Z(I) 
    273  *COSA(JB)
    274     DEPTHR = (ELWS(I+1)-EL(KB(I+1),I+1)+H2(KB(I+1),I)*COSA(JB))/COSA(JB)                                !EL(KT,I+1)-Z(I+1)*C
    274 OSA(JB)

Page 13          Source Listing                  CALCULATE_TKE1
2026-03-30 08:47                                 ..\..\..\az.f90

    275     DEPTH = (DEPTHR+DEPTHL)*0.5
    276 	DO J=1,2
    277 	  K=KT	
    278 	  IF(J==1)THEN		
    279 		AT(K,I) = 0.0
    280 		CT(K,I) =-1.0
    281 		VT(K,I) = 1.0
    282 		DT(K,I) = 0.0
    283 	  ELSE
    284 		TKE(KT,I,2) = TKE(K,I,1)**(1.5)/(ARODI(JW)*DEPTH)*BHRATIO(K,I)   !*BH2(KT,I)/BH1(KT,I)                      
    284                !3.0/2.0
    285 		AT(K,I) = 0.0
    286 		CT(K,I) = 0.0
    287 		VT(K,I) = 1.0
    288 		DT(K,I) = TKE(KT,I,2)
    289 	  ENDIF
    290 	  DO K = KT+1,KB(I)-1
    291 		 IF(IMPTKE(JW)=='     IMP')THEN
    292 		   AT(K,I) =  -DLT/BH1(K,I)*(BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) + 0.5*W(K-1,I)*BB(K-1,I))
    293 		   CT(K,I) =  -DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) - 0.5*W(K,I)*BB(K,I))
    294 		   VT(K,I) =  1 +&
    295 				      DLT/BH1(K,I)*(BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I) +&
    296 				      BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I) +&
    297 					  0.5*(W(K,I)*BB(K,I)-W(K-1,I)*BB(K-1,I)))
    298 		   DT(K,I) =  TKE(K,I,J)
    299 		 ELSE
    300 		   AT(K,I) = -DLT/BH1(K,I)*BB(K-1,I)/SIG(J)*AZ(K-1,I)/AVH1(K-1,I)
    301 		   CT(K,I) = -DLT/BH1(K,I)*BB(K,I)/SIG(J)*AZ(K,I)/AVH1(K,I)
    302 		   VT(K,I) =  1.0-AT(K,I)-CT(K,I)
    303 		   DT(K,I) =  TKE(K,I,J)
    304 		 ENDIF
    305 	  END DO
    306 	  K = KB(I)
    307 	  AT(K,I) = 0.0
    308 	  CT(K,I) = 0.0
    309 	  VT(K,I) = 1.0
    310 	  DT(K,I) = TKE(K,I,J)
    311 	  CALL TRIDIAG(AT(:,I),VT(:,I),CT(:,I),DT(:,I),KT,KB(I),KMX,TKE(:,I,J))
    312 	END DO
    313   ELSEIF(TKEBC(JW)==2)THEN
    314 !RODI WIND
    315     DEPTHL = (EL(KT,I)  -Z(I)  *COSA(JB)-EL(KB(I),I)	  +H2(KB(I),I)	*COSA(JB))/COSA(JB)
    316     DEPTHR = (EL(KT,I+1)-Z(I+1)*COSA(JB)-EL(KB(I+1),I+1)+H2(KB(I+1),I)*COSA(JB))/COSA(JB)
    317     DEPTH = (DEPTHR+DEPTHL)*0.5
    318 	DO JJ=1,3
    319 	  IF(JJ==1)THEN
    320 		J=1
    321 		DO K = KT+1,KB(I)-1
    322 		  TKE(K,I,3) = TKE(K,I,1)
    323 		ENDDO
    324 	  ELSEIF(JJ==2)THEN
    325 		J=1
    326 	  ELSEIF(JJ==3)THEN
    327 		J=2
    328 	  ENDIF
    329 ! WIND SHEAR AT SURFACE
    330 	  USTAR = SQRT(1.25*CZ(I)*WIND10(I)**2/RHO(KT,I))	

