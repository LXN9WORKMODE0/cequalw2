   1665 !*                                                                    **
   1666 !*         P R E P A R E   F I S H   F O R   D I S P L A Y            **
   1667 !*                                                                    **
   1668 !***********************************************************************
   1669 !***********************************************************************
   1670 ! Number of TecPlot Zones       = # of timesteps            (Animation by Zone)
   1671 !           TecPlot Limit     ==> 32,700 per Data Set
   1672 ! Number of TecPlot Data Points = # of nodes                (for Grid Display)
   1673 !                                 # of fish                 (for Fish Display)
   1674 !           TecPlot Limit     ==> 2 billion per Variable
   1675 ! Number of TecPlot Variables   = # of flow & const. param  (for Grid Display)
   1676 !                                 # of fish parameters      (for Fish Display)
   1677 !           TecPlot Limit     ==> 32,700 per Data Set
   1678 ! Number of TecPlot Data Sets   = 2*(# of branches)         (for Grid & Fish Displays)
   1679 !           TecPlot Limit     ==> 128
   1680 
   1681 !  This Subroutine Calls No Other Subroutines
   1682 
   1683 
   1684       SUBROUTINE FISHPLOT                ! This Subroutine preps fish information for TecPlot
   1685 
   1686       
   1687       Use FISHY; Use GEOMC; USE GLOBAL; Use GDAYC; Use SCREENC
   1688       
   1689       IMPLICIT NONE
   1690             
   1691       REAL        XLOC,ZLOC,YLOC,FSZ,FAG,UF,VF,WF
   1692 
   1693       INTEGER     WB,FISHNBP
   1694       INTEGER     BRF,FBRCH,WATER,K
   1695 
   1696       CHARACTER    FTYP1*1,FTYP2*2
   1697       CHARACTER*4 :: FILE_PREFIX='Part'
   1698       CHARACTER*4 :: FILE_SUFFIX='.dat'
   1699       CHARACTER*10 FILENAME
   1700 
   1701       IF (NIT.EQ.0) NZONES = 0                        ! This # is inputted into a TecPlot Macro for animation
   1702       NZONES = NZONES + 1                             ! This # is inputted into a TecPlot Macro for animation
   1703       DO 132 WB=1,NWB                                 ! WB = Water Body # / NWB = Total # of Water Bodies
   1704         DO 133 JB=BS(WB),BE(WB)                     ! JB = Branch #
   1705           NBRF(JB) = 0                              ! NBRF(JB) = # of Fish in Branch JB
   1706           DO 134 FN=1,NFISH                           ! NFISH = Total # of Fish in System
   1707             IF (INT(FISHES(FN,12)).EQ.1 .or. DELAYDATE(FN)> JDAY) GOTO 134     ! If Fish left system do not output its info 
   1707 to TecPlot
   1708             FISHNBP = INT(FISHES(FN,6))               ! FISHNBP = Branch where current fish resides
   1709             IF (FISHNBP.EQ.JB) THEN
   1710               NBRF(JB) = NBRF(JB) + 1                     ! NBRF    = # of Fish in Branch JB
   1711               BRCHFISH(JB,NBRF(JB),1) =  FISHES(FN,1)     ! FIMP    = Segment IMP where fish is located
   1712               BRCHFISH(JB,NBRF(JB),2) =  FISHES(FN,2)     ! FXLOC   = Fish location within segment IMP
   1713               BRCHFISH(JB,NBRF(JB),3) =  FISHES(FN,3)     ! FKMP    = Layer KMP where fish is located
   1714               BRCHFISH(JB,NBRF(JB),4) =  FISHES(FN,4)     ! FZLOC   = Fish location within layer KMP
   1715               BRCHFISH(JB,NBRF(JB),5) =  FISHES(FN,5)     ! FYLOC   = Lateral fish location
   1716               BRCHFISH(JB,NBRF(JB),6) =  FISHES(FN,6)     ! FNBP    = Branch where fish is located

