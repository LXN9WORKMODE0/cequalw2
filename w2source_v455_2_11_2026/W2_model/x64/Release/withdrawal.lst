   1513                 IF (DEPTHB(K,TCISEG(J)) > TCKLAY(J)) EXIT                                                                   
   1513    
   1514               END DO
   1515               K = MIN(K,KB(TCISEG(J)))                                                                                      
   1515    
   1516             END IF
   1517             TCOMP=T2(K,TCISEG(J))
