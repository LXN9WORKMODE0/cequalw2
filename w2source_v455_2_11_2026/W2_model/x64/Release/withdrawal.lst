    799         WRITE(IFILE,*)'Withdrawals: # of withdrawals:',nwd,' outlet temperatures'
    800         WRITE(IFILE,'("      JDAY",<nwd>(6x,"T(C)"),<nwd>(3x,"Q(m3/s)"),<nwd>(4x,"ELEVCL"))')
