   1088 REAL (R8) FUNCTION ZBRENT1 (X1,X2,TOL,BARG)
   1089 USE PREC
   1090 IMPLICIT NONE
   1091 
   1092   EXTERNAL   CDFUNC
   1093   REAL, PARAMETER :: FACTOR=0.1,NTRY=50,ITMAX=100,EPS=3.E-8
   1094   INTEGER         :: I,J,ITER
   1095   REAL(R8)            :: F1,F2,X1,X2,TOL,BARG,BA,B,FA,FB,FC,CDFUNC
   1096   REAL(R8)            :: C,D,E,TOL1,XM,S,P,Q,R
   1097 
   1098   F1 = CDFUNC(X1,BARG)
   1099   F2 = CDFUNC(X2,BARG)
   1100   IF (F1 <= 0.0) THEN
   1101     DO I=1,40
   1102       X1 = X1/10.0
   1103       F1 = CDFUNC(X1,BARG)
   1104       IF (F1 > 0.0) EXIT
   1105     END DO
   1106   END IF
   1107   DO J=1,NTRY
   1108     IF (F1*F2 < 0.0) EXIT
   1109     IF (ABS(F1) < ABS(F2)) THEN
   1110       X1 = X1+FACTOR*(X1-X2)
   1111       F1 = CDFUNC(X1,BARG)
   1112     ELSE
   1113       X2 = X2+FACTOR*(X2-X1)
   1114       F2 = CDFUNC(X2,BARG)
   1115     END IF
   1116   END DO
   1117   BA = X1
   1118   B  = X2
   1119   FA = CDFUNC(BA,BARG)
   1120   FB = CDFUNC(B,BARG)
   1121   FC = FB
   1122   DO ITER=1,ITMAX
   1123     IF (FB*FC > 0.0) THEN
   1124       C  = BA
   1125       FC = FA
   1126       D  = B-BA
   1127       E  = D
   1128     END IF
   1129     IF (ABS(FC) < ABS(FB)) THEN
   1130       BA = B
   1131       B  = C
   1132       C  = BA
   1133       FA = FB
   1134       FB = FC
   1135       FC = FA
   1136     END IF

Page 44          Source Listing                  ZBRENT1
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

   1137     TOL1 = 2.0*EPS*ABS(B)+0.5*TOL
   1138     XM   = 0.5*(C-B)
   1139     IF (ABS(XM) <= TOL1 .OR. FB == 0.0) THEN
   1140       ZBRENT1 = B; EXIT
   1141     END IF
   1142     IF (ABS(E) >= TOL1 .AND. ABS(FA) > ABS(FB)) THEN
   1143       S = FB/FA
   1144       IF (BA == C) THEN
   1145         P = 2.0*XM*S
   1146         Q = 1.0-S
   1147       ELSE
   1148         Q =  FA/FC
   1149         R =  FB/FC
   1150         P =  S*(2.*XM*Q*(Q-R)-(B-BA)*(R-1.0))
   1151         Q = (Q-1.0)*(R-1.0)*(S-1.0)
   1152       END IF
   1153       IF (P > 0.0) Q = -Q
   1154       P = ABS(P)
   1155       IF (2.0*P < MIN(3.0*XM*Q-ABS(TOL1*Q),ABS(E*Q))) THEN
   1156         E = D
   1157         D = P/Q
   1158       ELSE
   1159         D = XM
   1160         E = D
   1161       END IF
   1162     ELSE
   1163       D = XM
   1164       E = D
   1165     END IF
   1166     BA = B
   1167     FA = FB
   1168     IF (ABS(D) > TOL1) THEN
   1169       B = B+D
   1170     ELSE
   1171       B = B+SIGN(TOL1,XM)
   1172     END IF
   1173     FB = CDFUNC(B,BARG)
   1174   END DO
   1175   ZBRENT1 = B
   1176     END FUNCTION ZBRENT1

