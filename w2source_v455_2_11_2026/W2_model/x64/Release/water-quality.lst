   2317       END DO
   2318       DO JE=1,NEP
   2319         IF (EPIPHYTON_CALC(JW,JE))LDOMPEP(K,I) = LDOMPEP(K,I)+(EER(K,I,JE)+(1.0-EPOM(JE))*EMR(K,I,JE))*EPC(K,I,JE)*EP(JE)
   2320       END DO
   2321       DO M=1,NMC
   2322         IF(MACROPHYTE_CALC(JW,M))THEN
