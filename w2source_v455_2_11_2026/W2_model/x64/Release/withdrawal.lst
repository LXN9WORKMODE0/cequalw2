   1499           ELSE
   1500 
   1501 ! CHECKING TO SEE IF THE MONITORING SEGMENT TCISEG IS IN THE SAME BRANCH AND WATER BODY AS THE WITHDRAWAL
   1502             DO JJB=1,NBR
   1503               IF (TCISEG(J) >= US(JJB) .AND. TCISEG(J) <= DS(JJB)) EXIT
   1504             END DO
   1505             DO JJW=1,NWB
