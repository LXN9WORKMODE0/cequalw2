     67 ENTRY EQUILIBRIUM_TEMPERATURE
     68 
     69 ! British units
     70   if(.not.Met_Regions)then
     71   TDEW_F   = DEG_F(TDEW(JW))
     72   TAIR_F   = DEG_F(TAIR(JW))
     73   SRO_BR   = SRON(JW)*W_M2_TO_BTU_FT2_DAY*SHADE(I)
     74   else
     75   TDEW_F   = DEG_F(TDEW(NMet))
     76   TAIR_F   = DEG_F(TAIR(NMet))
     77   SRO_BR   = SRON(NMet)*W_M2_TO_BTU_FT2_DAY*SHADE(I)   
     78   endif
     79   
     80 !WIND_MPH = WIND(JW)*WSC(I)*MPS_TO_MPH
     81 !WIND2M   = WIND_MPH*DLOG(2.0D0/Z0(JW))/DLOG(WINDH(JW)/Z0(JW))+NONZERO     ! SW 11/28/07  old version z0=0.003
     82   WIND2M=WIND2(I)*MPS_TO_MPH    ! ALREADY COMPUTED IN w2 MAIN PROGRAM
     83   ACONV    = W_M2_TO_BTU_FT2_DAY
     84   IF (CFW(JW) == 1.0) BCONV = 3.401062
     85   IF (CFW(JW) == 2.0) BCONV = 1.520411
     86 ! SW Issues: CFW not determined for other values of CFW
     87 
     88 ! Equilibrium temperature and heat exchange coefficient
     89 
     90   ET(I)   =  TDEW_F
     91   TSTAR   = (ET(I)+TDEW_F)*0.5
     92   BETA    =  0.255-(8.5E-3*TSTAR)+(2.04E-4*TSTAR*TSTAR)
     93   FW      =  ACONV*AFW(JW)+BCONV*BFW(JW)*WIND2M**CFW(JW)
     94   CSHE(I) =  15.7+(0.26+BETA)*FW
     95   RA      =  3.1872E-08*(TAIR_F+459.67)**4   ! original is missing the effect of cloud cover
     96   ETP     = (SRO_BR+RA-1801.0)/CSHE(I)+(CSHE(I)-15.7)*(0.26*TAIR_F+BETA*TDEW_F)/(CSHE(I)*(0.26+BETA))
     97   J       =  0
     98   DO WHILE (ABS(ETP-ET(I)) > 0.05 .AND. J < 10)
     99     ET(I)   =  ETP
    100     TSTAR   = (ET(I)+TDEW_F)*0.5
    101     BETA    =  0.255-(8.5E-3*TSTAR)+(2.04E-4*TSTAR*TSTAR)
    102     CSHE(I) =  15.7+(0.26+BETA)*FW

Page 3           Source Listing                  HEAT_EXCHANGE
2026-03-30 08:47                                 ..\..\..\heat-exchange.f90

    103     ETP     = (SRO_BR+RA-1801.0)/CSHE(I)+(CSHE(I)-15.7)*(0.26*TAIR_F+BETA*TDEW_F)/(CSHE(I)*(0.26+BETA))
    104     J       =  J+1
    105   END DO
    106 
    107 ! SI units
    108 
    109   ET(I)   = DEG_C(ET(I))
    110   CSHE(I) = CSHE(I)*FLUX_BR_TO_FLUX_SI/RHOWCP
    111 RETURN
    112 
