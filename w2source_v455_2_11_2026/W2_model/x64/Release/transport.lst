    107   END DO
    108 
    109 ! Ultimate multipliers
    110 
    111   IF (ULTIMATE(JW)) THEN
    112     DO JB=BS(JW),BE(JW)
    113       DO I=US(JB),DS(JB)    !CONCURRENT(I=US(JB):DS(JB))                                                         !DO I=US(JB
    113 ),DS(JB)
    114         RATD(I)  =  DLXR(I-1)/DLXR(I)
    115 !CURX1(I) =  2.0D0*DLX(I)**2/(DLXR(I)+DLXR(I-1))/DLXR(I-1)   ! code speed improvement SW 4/20/16
    116 !CURX2(I) = -2.0D0*DLX(I)**2/(DLXR(I)*DLXR(I-1))
    117 !CURX3(I) =  2.0D0*DLX(I)**2/(DLXR(I)+DLXR(I-1))/DLXR(I)
    118         CURX1(I) =  2.0D0*DLX(I)*DLX(I)/((DLXR(I)+DLXR(I-1))*DLXR(I-1))
    119         CURX2(I) = -2.0D0*DLX(I)*DLX(I)/(DLXR(I)*DLXR(I-1))
    120         CURX3(I) =  2.0D0*DLX(I)*DLX(I)/((DLXR(I)+DLXR(I-1))*DLXR(I))
    121       END DO
    122     END DO
    123   END IF
    124 
    125 ! Vertical positive flows
    126 
    127   DO K=2,KMX-1
    128     HT            =  H(K-1,JW)
    129     HM            =  H(K,JW)
    130     HB            =  H(K+1,JW)
    131     HMIN          =  DMIN1(HB,HM)
    132     SF1Z(K,JW)    = (HB+HM)*0.5D0
    133 !SF2Z(K,1,JW)  =  HM**2
    134     SF2Z(K,1,JW)  =  HM*HM       ! SW 4/20/16
    135     SF3Z(K,1,JW)  =  HM/(HM+HB)
    136     SF4Z(K,1,JW)  =  HB/(HM+HB)
    137     SF5Z(K,1,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HT+HM)
    138     SF6Z(K,1,JW)  = -0.25D0*(HM+HB)*(HT+HM)
    139     SF7Z(K,1,JW)  =  0.25D0*(HM+HB)*(HT+2.0D0*HM+HB)
    140     SF8Z(K,1,JW)  =  0.50D0*(HM-HB)*HMIN
    141     SF9Z(K,1,JW)  =  0.50D0*(HT+2.0D0*HM-HB)*HMIN
    142     SF10Z(K,1,JW) =  0.50D0*(HT+3.0D0*HM)*HMIN
    143   END DO
    144 
    145 ! Vertical negative flows
    146 
    147   DO K=2,KMX-2
    148     HT            =  H(K,JW)
    149     HM            =  H(K+1,JW)
    150     HB            =  H(K+2,JW)
    151     HMIN          =  DMIN1(HT,HM)
    152     SF1Z(K,JW)    = (HM+HT)*0.5D0
    153 !SF2Z(K,2,JW)  =  HM**2
    154     SF2Z(K,2,JW)  =  HM*HM      ! SW 4/20/16
    155     SF3Z(K,2,JW)  =  HM/(HT+HM)
    156     SF4Z(K,2,JW)  =  HT/(HT+HM)
    157     SF5Z(K,2,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HT+HM)
    158     SF6Z(K,2,JW)  = -0.25D0*(HM+HB)*(HT+HM)
    159     SF7Z(K,2,JW)  =  0.25D0*(HT+2.0D0*HM+HB)*(HM+HB)
    160     SF8Z(K,2,JW)  = -0.50D0*(3.0D0*HM+HB)*HMIN
    161     SF9Z(K,2,JW)  =  0.50D0*(HT-2.0D0*HM-HB)*HMIN
    162     SF10Z(K,2,JW) =  0.50D0*(HT-HM)*HMIN

