     15     
     16 SUBROUTINE AERATE
     17   USE GLOBAL;USE MAIN; USE KINETIC; USE TRANS; USE SCREENC; USE HYPOAERATION
     18   IMPLICIT NONE
     19   LOGICAL :: CSVFORMAT
     20   SAVE
     21   
     22   CSVFORMAT=.FALSE.
     23   ALLOCATE(DZMULT(KMX,IMX))
     24    DZMULT=1.0
     25    OPEN(AERATEFN,FILE='W2_AERATE.NPT',STATUS='OLD')
     26     READ(AERATEFN,'(//A)')HEADER
     27      DO J=1,30
     28          IF(HEADER(J:J)==',')THEN
     29              CSVFORMAT=.TRUE.
     30              EXIT
     31          ENDIF
     32      ENDDO
     33    REWIND(AERATEFN)
     34    
     35   IF(CSVFORMAT)THEN
     36        READ (AERATEFN,*)
     37        READ (AERATEFN,*)
     38        READ (AERATEFN,*)NAER,CONAER
     39    ELSE
     40        READ (AERATEFN,'(//I8,A16)')NAER,CONAER
     41    ENDIF
     42 
     43      IF(NAER.EQ.0)NAER=1    
     44      ALLOCATE(DZMULTA(NAER),IASEG(NAER),KTOPA(NAER),KBOTA(NAER),SMASS(NAER),ATIMON(NAER),ATIMOFF(NAER),DOOFF(NAER),DOON(NAER
     44 ),IPRB(NAER),KPRB(NAER),ACTUAL_MASS(NAER),AERATEO2(NAER),CUMDOMASS(NAER))
     45      DZMULTA=0.0; ACTUAL_MASS=0.0; CUMDOMASS=0.0
     46      READ(AERATEFN,1013)
     47 1013 FORMAT(/)
     48       DO I=1,NAER
     49         IF(CSVFORMAT)THEN
     50           READ(AERATEFN,*)IASEG(I),KTOPA(I),KBOTA(I),SMASS(I),ATIMON(I),ATIMOFF(I),DZMULTA(I),DOOFF(I),DOON(I),IPRB(I),KPRB(
     50 I)
     51           ELSE 
     52           READ(AERATEFN,'(I8,I8,I8,F8.0,F8.0,F8.0,3F8.0,2I8)')IASEG(I),KTOPA(I),KBOTA(I),SMASS(I),ATIMON(I),ATIMOFF(I),DZMUL
     52 TA(I),DOOFF(I),DOON(I),IPRB(I),KPRB(I)
     53         ENDIF  
     54       END DO
     55 
     56 	CLOSE(AERATEFN)
     57 
     58 IF(RESTART_IN)THEN
     59   OPEN(AERATEFN,FILE=CONAER,POSITION='APPEND')
     60         JDAY1=0.0
     61         REWIND (AERATEFN)
     62         READ   (AERATEFN,'(//)')
     63         DO WHILE (JDAY1 < JDAY)
     64           READ (AERATEFN,'(F9.0)',END=106) JDAY1
     65         END DO
     66         BACKSPACE (AERATEFN)
     67         106     JDAY1=0.0
     68 ELSE

Page 3           Source Listing                  AERATE
2026-03-30 08:48                                 ..\..\..\aerate.f90

     69   OPEN(AERATEFN,FILE=CONAER,STATUS='UNKNOWN')
     70   WRITE(AERATEFN,'(A,I3,A)')'OUTPUT FILE FOR AERATION INPUT WITH',NAER,' INPUT(S).'
     71   WRITE(AERATEFN,'(A114)')'JDAY,INSTMASSRATE#1(KGO2/D),CUMMASS#1(KGO2),DOPROBE#1(MG/L),INSTMASSRATE#2(KGO2/D),CUMMASS#2(KGO2
     71 ),DOPROBE#2(MG/L)'
     72 ENDIF
     73   DZMULT=1.0  ! ALWAYS RESET MIXING COEFFICIENT FOR AERATION SW IPC 2/01/01
     74  RETURN
     75  
     76 !ENTRY DZAERATE   ! FROM W2_ MAIN CODE
     77 !   DO I=1,NAER
     78 !   DZ(KTOPA(I):KBOTA(I),IASEG(I))=DZ(KTOPA(I):KBOTA(I),IASEG(I))*DZMULT(KTOPA(I):KBOTA(I),IASEG(I))
     79 !   ENDDO
     80 !RETURN
     81     
     82  ENTRY AERATEMASS   ! FROM WQ_CONSTITUENTS
     83 
     84 ! SECTION FOR HYPOLIMNETIC AERATION
     85  DZMULT=1.0   ! ALWAYS RESET TO 1.0 IN CASE NO AERATION
     86               DO II=1,NAER
     87                 IF(JDAY.GE.ATIMON(II).AND.JDAY.LE.ATIMOFF(II))THEN
     88 
     89 ! FIND BRANCH AND WATERBODY FOR ISEG
     90                   DO JJB=1,NBR
     91                     IF(BR_INACTIVE(JJB))CYCLE  ! SW 6/12/2017
     92                     IF(IASEG(II).GE.US(JJB).AND.IASEG(II).LE.DS(JJB))THEN
     93                       EXIT
     94                     END IF
     95                   END DO
     96 
     97                   IF(JJB.EQ.JB)THEN   ! IF THIS BRANCH DOESN'T HAVE AERATION SKIP IT
     98 
     99                     KTOP=MAX(KTWB(JW),KTOPA(II))
    100                     KBOT=MIN(KB(IASEG(II)),KBOTA(II))
    101 
    102                     NLAYERS=KBOT-KTOP+1
    103 
    104                     AERATEO2(II)=.TRUE.
    105 
    106                     IF(O2(KPRB(II),IPRB(II)).GT.DOON(II).AND.O2(KPRB(II),IPRB(II)).GT.DOOFF(II))THEN
    107                       AERATEO2(II)=.FALSE.
    108                       ACTUAL_MASS(II)=0.0
    109                     END IF
    110 
    111                     IF(AERATEO2(II))THEN
    112                       ACTUAL_MASS(II)=SMASS(II)  ! SW 12/28/01
    113                       CUMDOMASS(II)=CUMDOMASS(II)+SMASS(II)*DLT/86400.
    114                       DO K=KTOP,KBOT
    115             
    116                         DZMULT(K,IASEG(II))=DZMULTA(II)   ! THIS MEANS THE INCREASE IN DZ IS LAGGED ONE TIME STEP
    117                         CSSB(K,IASEG(II),NDO)=CSSB(K,IASEG(II),NDO)+SMASS(II)/(86.4*REAL(NLAYERS))
    118 ! UNITS OF SMASS ARE IN KG/DAY
    119 ! TYPICAL UNITS OF CSSB: (MG/L)*(M3/S) TO OONVERT MULTIPLY BY (1KG/10^6MG)*(1000L/1M3)*(86400S/DAY)==86.4
    120                         
    121                       END DO          
    122                     END IF
    123                   END IF
    124                 ELSE

Page 4           Source Listing                  AERATE
2026-03-30 08:48                                 ..\..\..\aerate.f90

    125                 AERATEO2(II)=.FALSE.
    126                 ACTUAL_MASS(II)=0.0
    127                 END IF
    128                 
    129               END DO
    130 
    131 RETURN
    132 
    133 ENTRY AERATEOUTPUT     ! FROM W2_MAIN CODE
    134 
    135         WRITE(AERATEFN,'(F9.3,<NAER>(1X,E12.3,1X,E12.3,1X,F8.3))')JDAY,(ACTUAL_MASS(II),CUMDOMASS(II),O2(KPRB(II),IPRB(II)),
    135 II=1,NAER)
    136 
    137 RETURN
    138 ENTRY DEALLOCATE_AERATE


