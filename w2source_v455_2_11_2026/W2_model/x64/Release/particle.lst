   2435         write(CONE,'(" Sum of fractions, ",<nfish>(e12.4,","))')(t_sum(N),N=1,NFISH)
   2436         write(CONE,'(1x)')
   2437         write(CONE,'(" Average, ",<nfish>(e12.4,","))')(t_avg(N), N=1,NFISH)
   2438         close(CONE)
   2439         end if
   2440 
