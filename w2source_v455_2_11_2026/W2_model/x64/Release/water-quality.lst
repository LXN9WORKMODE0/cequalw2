    869                 IF(ASETTLE(K+1,I,JA) >= 0)THEN    ! incoming velocity from cell below
    870                     AIN = 0                
    871                 ELSE 
    872                     AIN = -ASETTLE(K+1,I,JA)
    873                 ENDIF             
    874                 IF(ASETTLE(K,I,JA) >= 0)THEN    ! outgoing velocity for surface layer cell
    875                     AOUT = ASETTLE(K,I,JA)
    876                 ELSE 
    877                     AOUT = 0
    878                 ENDIF             
    879                 ASR(K,I,JA) =  -AOUT*(ALG(K,I,JA))*BI(K,I)/BH2(K,I) + AIN*ALG(K+1,I,JA)*BI(K+1,I)*DLX(I)/VOL(K,I)           
    879        
    880             ELSEIF(K==KB(I))THEN
    881                 IF(ASETTLE(K-1,I,JA) >= 0)THEN    ! incoming velocity from cell ABOVE
    882                     AIN = ASETTLE(K-1,I,JA)              
    883                 ELSE 
    884                     AIN = 0
    885                 ENDIF    
    886                 IF(ASETTLE(K,I,JA) >= 0)THEN    ! outgoing velocity for BOTTOM layer cell
    887                     AOUTB = ASETTLE(K,I,JA)
    888                 ELSE 
    889                     AOUTA = -ASETTLE(K,I,JA)
    890                 ENDIF      
    891                 ASR(K,I,JA) = (AIN*ALG(K-1,I,JA) - (LOSS_FRAC(MIGI)*AOUTB + AOUTA)*ALG(K,I,JA))*BI(K,I)/BH2(K,I)      
    892             ELSE
    893                 IF(ASETTLE(K-1,I,JA) >= 0)THEN    ! incoming velocity from cell ABOVE
    894                     AINA = ASETTLE(K-1,I,JA)              
    895                 ELSE 
    896                     AINA = 0
    897                 ENDIF    
    898                 IF(ASETTLE(K+1,I,JA) >= 0)THEN    ! incoming velocity from cell below
    899                     AINB = 0                
    900                 ELSE 
    901                     AINB = -ASETTLE(K+1,I,JA)
    902                 ENDIF  
    903                 AOUT = ABS(ASETTLE(K,I,JA))
    904                 ASR(K,I,JA) =  (AINA*ALG(K-1,I,JA)-AOUT*ALG(K,I,JA))*BI(K,I)/BH2(K,I) + AINB*ALG(K+1,I,JA)*BI(K+1,I)/BH2(K,I
    904 )    ! NOT NECESSARY TO DO THE DIVISION - JUST DIVIDE BY H !SP 8/27/07
    905             ENDIF
