     24 subroutine W2_DIALOG
     25   USE IFLOGM; USE MSCLIB          !DFLOGM
     26   INTEGER       :: RESULT
     27   LOGICAL       :: RSO_EXISTS=.FALSE., RESTARTED, RESULTLOG
     28   TYPE (DIALOG) :: DLG
     29   EXTERNAL RUN_W2
     30 
     31   RESTARTED = .FALSE.                                                                               
     32   OPEN (1,FILE='rso.opt',STATUS='OLD',IOSTAT=RESULT); CLOSE (1)                                   !Does restart file exist?
     33   RSO_EXISTS = RESULT == 0                                                                        !Restart file exists
     34   RESULTLOG = DLGINIT   (OUTPUT_DIALOG,DLG)                                                          !Initialize dialog box
     35   RESULTLOG = DLGSET    (DLG,STATUS,'Pending execution')                                             !Display execution stat
     35 us
     36   RESULTLOG = DLGSET    (DLG,RESTART,        RSO_EXISTS,DLG_ENABLE)                                  !Enable  'Restart' butt
     36 on
     37   RESULTLOG = DLGSET    (DLG,RUN,           .FALSE.,    DLG_ENABLE)
     38   RESULTLOG = DLGSET    (DLG,STOP_EXECUTION,.FALSE.,    DLG_ENABLE)                                  !Disable 'Stop'    butt
     38 on
     39   RESULTLOG = DLGSETSUB (DLG,OUTPUT_DIALOG,RUN_W2)
     40   RESULTLOG = DLGSETSUB (DLG,RUN,            RUN_W2)                                                 !Set 'Run'     callback
     41   RESULTLOG = DLGSETSUB (DLG,STOP_EXECUTION, RUN_W2)                                                 !Set 'Stop'    callback
     42   RESULTLOG = DLGSETSUB (DLG,RESTART,        RUN_W2)                                                 !Set 'Restart' callback
     43   RESULTLOG = DLGSETSUB (DLG,HIGHEST,        RUN_W2)                                                 !Set 'Highest' callback
     44   RESULTLOG = DLGSETSUB (DLG,HIGH,           RUN_W2)                                                 !Set 'High'    callback
     45   RESULTLOG = DLGSETSUB (DLG,NORMAL,         RUN_W2)                                                 !Set 'Normal'  callback
     46   RESULTLOG = DLGSETSUB (DLG,LOW,            RUN_W2)                                                 !Set 'Low'     callback
     47   RESULTLOG = DLGSETSUB (DLG,LOWEST,         RUN_W2)                                                 !Set 'Lowest'  callback
     48   RESULTLOG = DLGSETSUB (DLG,IDLE,           RUN_W2)                                                 !Set 'Idle'    callback
     49   RESULTLOG = DLGSETSUB (DLG,IDOK,RUN_W2)
     50   RESULTLOG = DLGMODAL  (DLG)                                                                        !Show dialog box
     51   CALL DLGUNINIT     (DLG)                                                                        !Close dialog box
     52 END subroutine W2_DIALOG

