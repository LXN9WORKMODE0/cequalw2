    678           N2_SAT(JT) = (1.5568D06*0.79*(PALT(ITR(JT))-EA)*(1.8816D-5 - 4.116D-7 * TTR(JT) + 4.6D-9 * TTR(JT)*TTR(JT)))
    679           CTR(NN2,JT) = N2_SAT(JT) * CTR(NN2,JT)
    680         END IF
