   1717               BRCHFISH(JB,NBRF(JB),7) =  FISHES(FN,7)     ! FSIZE   = Size (i.e., length) of fish in meters
   1718               BRCHFISH(JB,NBRF(JB),8) =  FISHES(FN,8)     ! FAGE    = Age of the fish
   1719               BRCHFISH(JB,NBRF(JB),9) =  FISHES(FN,9)     ! UFISH   = Longitudinal velocity of the fish
   1720               BRCHFISH(JB,NBRF(JB),10) = FISHES(FN,10)    ! VFISH   = Lateral velocity of the fish
   1721               BRCHFISH(JB,NBRF(JB),11) = FISHES(FN,11)    ! WFISH   = Vertical velocity of the fish
   1722             END IF
   1723   134     CONTINUE
   1724 
   1725           IF (NIT.EQ.0) THEN
   1726               
   1727           IF (JB.LT.10) THEN                        ! Creating the output file names based on Branch #
   1728             WRITE(FTYP1,9120) JB
   1729             FILENAME=FILE_PREFIX//FTYP1//FILE_SUFFIX
   1730  9120       FORMAT(I1)
   1731           ELSE IF (JB.LE.64) THEN                   ! TecPlot is limited to 128 Data Sets (i.e. Data Files)
   1732             WRITE(FTYP2,9130) JB                    !   That leaves: 64 Data Sets for Grid Display and
   1733             FILENAME=FILE_PREFIX//FTYP2//FILE_SUFFIX  !                64 Data Sets for Fish Display
   1734  9130       FORMAT(I2)
   1735           ELSE                                        ! CHECK
   1736             IF (DEBUG)WRITE(DATADEBUGFN,*) 'ERROR: Exceeded Maximum Number of TecPlot Data Sets ==># Data Sets = # of Branch
   1736 es'
   1737             STOP
   1738           END IF                  
   1739               
   1740             OPEN(30000+JB,FILE=FILENAME,STATUS='UNKNOWN')             ! Opening the Output Files Based on Branch #
   1741             WRITE(30000+JB,9300) JB                                 ! Creating Output File Header for TecPlot
   1742  9300       FORMAT('TITLE = "PARTICLE INFO for Branch',I6,'"')
   1743             WRITE(30000+JB,9310)                                      ! Creating Output File Header for TecPlot
   1744  9310       FORMAT('VARIABLES = "X", "Z", "FSIZE", "FAGE", "WATER", "ISEG", "K"')
   1745           ELSE
   1746             WRITE(30000+JB,*) ' '
   1747           END IF
   1748           WRITE(30000+JB,9320) JDAY,(1+NBRF(JB))                    ! Creating Output File Header for TecPlot
   1749  9320     FORMAT('ZONE T="JDAY ',F9.2,'", I=',I7,', F=POINT')
   1750           WRITE(30000+JB,9330) 0.01,0.01,0.0,0.0,-1,0,0         ! This is a dumby fish so TecPlot can at least
   1751 !   open the file if no fish are in JB
   1752           DO 135 BRF=1,NBRF(JB)                             ! NBRF = # of Fish in Branch JB
   1753             K = INT(BRCHFISH(JB,BRF,3))                     ! K = Layer # where Fish is located
   1754             I = INT(BRCHFISH(JB,BRF,1))                     ! I = Segment # where Fish is located
   1755             XLOC = NODES(K,I,1) + BRCHFISH(JB,BRF,2)        ! XLOC = X Distance (within Branch) where Fish is located
   1756             IF (K.LT.KTWB(WB)) THEN
   1757 !     ZLOC = NODES(KTWB(WB),I,2) - 0                   ! ZLOC(Adjusted): Due to inability of TecPlot to show
   1758             zloc=elws(i)   ! SW 5/2015 CHANGE TO ELEVATION RATHER THAN DEPTH
   1759             ELSE                                              !                 actual Water Surface
   1760 !     ZLOC = NODES(K,I,2) - BRCHFISH(JB,BRF,4)      ! ZLOC = Z Distance where Fish is located
   1761             zloc=el(k,i)- BRCHFISH(JB,BRF,4)   ! SW 5/2015
   1762             END IF
   1763             YLOC = BRCHFISH(JB,BRF,5)                       ! YLOC = Y Distance where Fish is located
   1764             FBRCH = INT(BRCHFISH(JB,BRF,6))                 ! FBRCH = Branch # where Fish is located
   1765             FSZ = BRCHFISH(JB,BRF,7)                        ! FSZ = Fish Size
   1766             FAG = BRCHFISH(JB,BRF,8)                        ! FAG = Fish Age
   1767             WATER = 1                                         ! WATER = 1 (for value-blanking purposes in TecPlot)
   1768             UF = BRCHFISH(JB,BRF,9)                         ! UF = Fish Horizontal Velocity (m/s)
   1769             VF = BRCHFISH(JB,BRF,10)                        ! VF = Fish Lateral Velocity (m/s)
   1770             WF = BRCHFISH(JB,BRF,11)                        ! WF = Fish Vertical Velocity (m/s)
   1771             IF (WBSKIP.AND.(WB.NE.WBRUN)) GOTO 135            ! Option:Skip output for all Water Bodies, except WBRUN
   1772             WRITE(30000+JB,9330) XLOC,ZLOC,FSZ,FAG,WATER,I,K

