   2774 ! Meteorological/light extinction data
   2775 IF(.NOT.Met_Regions)THEN
   2776   DO JW=1,NWB
   2777     IF (INTERP_METEOROLOGY(JW)) THEN
   2778       RATIO     = (NXMET1(JW)-JDAY)/(NXMET1(JW)-NXMET2(JW))
   2779       TDEW(JW)  = (1.0-RATIO)*TDEWNX(JW)+RATIO*TDEWO(JW)
   2780       WIND(JW)  = (1.0-RATIO)*WINDNX(JW)+RATIO*WINDO(JW)
   2781 ! CONVERT PHIO AND PHINX TO LESS THAN 2*PI     SW 2/13/15
   2782       DO WHILE(PHIO(JW)>2.*PI)
   2783           PHIO(JW)=PHIO(JW)-2.*PI
   2784       ENDDO
   2785       DO WHILE(PHINX(JW)>2.*PI)
   2786           PHINX(JW)=PHINX(JW)-2.*PI
   2787       ENDDO     
   2788       IF (PHIO(JW)-PHINX(JW) > PI) THEN                      
   2789         PHI(JW) = (1.0-RATIO)*(PHINX(JW)+2.0*PI)+RATIO*PHIO(JW)
   2790       ELSEIF (PHIO(JW)-PHINX(JW) < -PI) THEN                       ! WX 2/13/15
   2791         PHI(JW) = (1.0-RATIO)*PHINX(JW)+RATIO*(PHIO(JW) +2.0*PI)   ! WX 2/13/15
   2792       ELSE
   2793         PHI(JW) = (1.0-RATIO)*PHINX(JW)+RATIO*PHIO(JW)
   2794       END IF
