   3639         if (daytest >= tctsrt(j) .and. daytest < tctend(j)) then
   3640           ewd(jwd) = tcelev(j,ncountcw(jwd))                  ! initialize the withdrawal elevation
   3641 
   3642           if (tcomp > tctemp(j) .and. tcnelev(j) > ncountcw(jwd)) then
   3643 ! making sure that the next lower structure for a particular 'j' is found
   3644             do nj=ncountcw(jwd)+1,tcnelev(j)
   3645               if (tcelev(j,nj) < ewd(jwd)) then
   3646                 ncountcw(jwd) = nj
   3647                 ewd(jwd)      = tcelev(j,ncountcw(jwd))
   3648                 exit
   3649               end if
