    371   ENDIF
    372 
    373 
    374   tempest=0.0
    375   DO K=KTOP,KBOT
    376     tempest=tempest+t2(k,id)*(VNORM(K)/VSUM)*QSTR(JS,JB)
    377   END DO
    378 
    379   if(qstr(js,jb).gt.0.0)tempest=tempest/qstr(js,jb)
    380 
    381 RETURN
