   2230 
   2231     Function Gasdev(idum3)
   2232 IMPLICIT NONE    
   2233 INTEGER :: IDUM3,ISET
   2234 REAL :: V1,V2,R,FAC,GSET,GASDEV
   2235 
   2236 ! From S. Li, PSU, PArticle Transport Algorithm
   2237       data iset /0/
   2238       if (iset.eq.0)then
   2239  1       v1=2.*ran(idum3)-1
   2240 	 v2=2.*ran(idum3)-1
   2241 	 r=v1**2+v2**2
   2242 	 if(r.ge.1)goto 1
   2243 	 fac=sqrt(-2.*log(r)/r)
   2244 	 gset=v1*fac
   2245 	 gasdev=v2*fac
   2246 	 iset=1
   2247       else
   2248 	 gasdev=gset
   2249 	 iset=0
   2250       endif
   2251       return
   2252 
   2253     End Function Gasdev


