    651 !Check for Boundary Violations: Vertical Direction Check (2 of 2)
    652 
    653    30   IF (FZLOC >= H(FKMP,FJR)) THEN                     ! Did fish move down below current layer?  -- YES
    654           IF (DEBUG) WRITE(DATADEBUGFN,*) 'FZLOC GT H'
    655           IF (FKMP+1.GT.KBI(FIMP)) THEN                 ! Did fish move below bottom layer? -- YES   USE KBI RATHER THAN KB 
    655 SW 8/2018
    656                 IF(HITSTICKBOTTOM)THEN
    657 ! PARTICLE LOST FROM SYSTEM
    658 ! LOSE PARTCLE
    659                 ISWITCH = 1
    660                 fishes(fn,14)=JDAY               ! Time fish left system
    661                 fishes(fn,15)=JDAY-DELAYDATE(FN)     ! Detention time of fish in system
    662                 fishes(fn,12)=1.0                ! FISH LEAVES SYSTEM
    663                 fishes(fn,16)=2.0  ! Particle hits bottom and sticks
    664                 WRITE(DIAGFN,*) 'Particle Hit and Stick Bottom: Particle Leaves System on JDAY:',jday, 'Data:',fishes(fn,:)
    665                   ELSE
    666                     FZLOC = H(FKMP,FJR)*(1-ZBOTREFL)               !    Logic for rebounding off of the bottom
    667                   ENDIF
    668                   
    669           ELSE                                         ! Did fish move below bottom layer? -- NO
    670             FZLOC = FZLOC - H(FKMP,FJR)
    671             FKMP = FKMP + 1
    672             IF (FZLOC.GT.H(FKMP,FJR)) GOTO 30              ! Did fish move down more than one layer
    673           END IF
    674         ELSE IF (FZLOC.LT.0) THEN                      ! Did fish move up?  --  YES
    675           IF (DEBUG) WRITE(DATADEBUGFN,'(A,i5,f10.3,f10.3,i5,i5,f9.3)') 'FZLOC LT 0; fn,fzloc,fxloc,fimp,fkmp,jday:', fn,fzl
    675 oc,fxloc,fimp,fkmp,jday
    676           IF (FKMP.EQ.(KTWBF+1)) THEN                   ! Is fish just below surface layer KTWBF?  --  YES
    677             IF (DEBUG) WRITE(DATADEBUGFN,'(A,i5,f10.3,f10.3,i5,i5,f9.3)') 'FKMP EQ KTWBF+1; fn,fzloc,fxloc,fimp,fkmp,jday:',
    677  fn,fzloc,fxloc,fimp,fkmp,jday
    678             IF (ABS(FZLOC).GT.(H(KTWBF,FJR)-Z(FIMP))) THEN  ! Did fish move above water surface?  --  YES
    679               FROMKTBOT = (H(KTWBF,FJR)-Z(FIMP))*(1-ZSURREFL)
    680             ELSE                                       ! Did fish move above water surface?  --  NO
    681               FROMKTBOT = ABS(FZLOC)
    682             END IF
    683             SURFCALC = 1
    684           ELSE IF (FKMP.EQ.KTWBF) THEN
    685             IF (DEBUG) WRITE(DATADEBUGFN,'(A,i5,f10.3,f10.3,i5,i5,f9.3)') 'FKMP EQ KTWBF; fn,fzloc,fxloc,fimp,fkmp,jday:', f
    685 n,fzloc,fxloc,fimp,fkmp,jday
    686             IF ((ABS(FZLOC)+H(KTWBF,FJR)).GT.(H(KTWBF,FJR)-Z(FIMP))) THEN
    687               FROMKTBOT = (H(KTWBF,FJR)-Z(FIMP))*(1-ZSURREFL)
    688             ELSE
    689               FROMKTBOT = ABS(FZLOC) + H(KTWBF,FJR)
    690             END IF
    691             SURFCALC = 1
    692           ELSE IF (FKMP.LE.(KTWBF-1)) THEN
    693             IF (DEBUG) WRITE(DATADEBUGFN,'(A,i5,f10.3,f10.3,i5,i5,f9.3)') 'FKMP LE KTWBF-1; fn,fzloc,fxloc,fimp,fkmp,jday:',
    693  fn,fzloc,fxloc,fimp,fkmp,jday
    694             FROMKTBOT = 0.0
    695             DO 40 KK = KTWBF,(FKMP+1),-1
    696               FROMKTBOT = FROMKTBOT + H(KK,FJR)    
    697    40       CONTINUE
    698             FROMKTBOT = FROMKTBOT + ABS(FZLOC)
    699             IF (FROMKTBOT.GT.(H(KTWBF,FJR)-Z(FIMP))) THEN
    700               FROMKTBOT = (H(KTWBF,FJR)-Z(FIMP))*(1-ZSURREFL)
    701             ELSE
    702               FROMKTBOT = FROMKTBOT

