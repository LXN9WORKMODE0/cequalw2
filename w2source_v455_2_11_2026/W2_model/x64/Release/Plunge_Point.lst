      1 # 1 "..\..\..\Plunge_Point.f90"
      2 Subroutine Plunge_Point
      3 ! SW 5/2024 Estimate of plunge point in a reservoir
      4   USE MAIN
      5   USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
      6   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
      7   
      8   IMPLICIT NONE
      9   REAL :: FRDN
     10   
     11   IF(NIT==0)THEN
     12       OPEN(2020,FILE='Plunge_Point_Estimate.csv',STATUS='unknown')
     13       write(2020,'(A)')'JDAY,I,JB,KT,RHO(KT I),RHO(KT I+1),T2(KT I),T2(KT I+1),W(KT I),U(KT I),U(KT I+1), Froude#'
     14   ENDIF
     15   
     16 !IF(JDAY>96.0)THEN
     17 !    PAUSE
     18 !ENDIF
     19   
     20   
     21   DO JW=1,NWB
     22       KT=KTWB(JW)
     23   DO JB=BS(JW),BE(JW)
     24       IF(BR_INACTIVE(JB))CYCLE
     25       DO I=CUS(JB),DS(JB)-1
     26           IF(T2(KT,I) <= 10.0)CYCLE
     27           
     28           IF(I==CUS(JB))THEN
     29                 IF(RHO(KT,I) > RHO(KT,I+1) .AND.  U(KT,I) < U(KT-1,I) .AND. U(KB(I),I) > 0.0 .AND. T2(KT,I) < T2(KT,I+1) .an
     29 d. u(kt,i) > 0.0)THEN                      !W(KT,I) > 0.0 .AND.
     30                               FRDN=u(kt,i)/(sqrt(((rho(kt,i)-rho(kt,i+1))/rho(kt,i))*g*depthm(kt,i)))
     31                     WRITE(2020,'(F10.3,",",I4,",",I4,",",I4,",",8(F12.4,","))')JDAY,I,JB,KT,RHO(KT,I),RHO(KT,I+1),T2(KT,I),T
     31 2(KT,I+1),W(KT,I),U(KT,I),U(KT,I+1),frdn
     32                 ENDIF
     33           CYCLE    
     34           ENDIF
     35           IF(RHO(KT,I) > RHO(KT,I+1) .AND.  U(KT,I) > 0.0 .AND. U(KT,I+1)< 0.0 .AND. T2(KT,I) < T2(KT,I+1) .and. u(kt,i) > 0
     35 .0)THEN                      !W(KT,I) > 0.0 .AND.
     36                         FRDN=u(kt,i)/(sqrt((rho(kt,i)-rho(kt,i+1))/rho(kt,i))*g*depthm(kt,i))
     37               WRITE(2020,'(F10.3,",",I4,",",I4,",",I4,",",8(F12.4,","))')JDAY,I,JB,KT,RHO(KT,I),RHO(KT,I+1),T2(KT,I),T2(KT,I
     37 +1),W(KT,I),U(KT,I),U(KT,I+1),frdn
     38           ENDIF
     39       ENDDO
     40   ENDDO
     41   ENDDO
     42   
     43   RETURN
     44   END SUBROUTINE Plunge_Point

