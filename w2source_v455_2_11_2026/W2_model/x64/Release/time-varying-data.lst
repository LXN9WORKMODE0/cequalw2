    225          AGASSP(N)=AGASSPNX(N)
    226         ELSEIF(GASSPC(N)=='      ON' .AND.  EQSP(N)==5)THEN  
    227          FGASSP(N)=NPT; NPT=NPT+1
    228          WRITE (SEGNUM,'(I0)') N 
    229          SEGNUM = ADJUSTL(SEGNUM)  
    230          L = LEN_TRIM(SEGNUM) 
