    154 ! Open input files
    155   
    156 ! Check for presence of w2_met.csv
    157   INQUIRE(FILE="W2_Met.csv", EXIST=INPUT_FILE_EXISTS)   ! file_exists will be TRUE if the file
    158   if(INPUT_FILE_EXISTS)then
    159       open(nunit,file='w2_Met.csv',status='old')
    160       read(nunit,*);read(nunit,*)
    161       read(nunit,*)A_JUNK,I_LWAT
    162       read(nunit,*)A_JUNK,CC_LW
    163       read(nunit,*)A_JUNK,CC_SW
