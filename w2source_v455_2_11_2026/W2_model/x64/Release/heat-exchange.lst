      7 SUBROUTINE HEAT_EXCHANGE
      8   USE GLOBAL; USE GDAYC; USE SURFHE; USE TVDC; USE SHADEC; USE PREC; USE MetFileRegion; USE MAIN, ONLY:CC_SW, I_SW
      9   IMPLICIT NONE
     10 
     11 ! Type declaration
     12   REAL     :: JDAY, LOCAL
     13   REAL(R8) :: TSUR
     14   REAL(R8) :: MPS_TO_MPH=2.23714D0,W_M2_TO_BTU_FT2_DAY=7.60796D0,FLUX_BR_TO_FLUX_SI=0.23659D0,BOWEN_CONSTANT=0.47D0
     15   REAL(R8) :: DEG_F,DEG_C,BTU_FT2_DAY_TO_W_M2=0.1314D0
     16   REAL(R8) :: STANDARD,HOUR,TAUD,SINAL,A0,TDEW_F,TAIR_F,SRO_BR,WIND_MPH,WIND2M,ACONV,BCONV
     17   REAL(R8) :: TSTAR,BETA,FW,RA,ETP,EA,ES,TAIRV,DTV,DTVL
     18   INTEGER  :: IDAY,J
     19 
     20 RETURN
     21 
