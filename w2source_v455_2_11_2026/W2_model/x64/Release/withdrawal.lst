   2127             if (tspltcntr(j) .eq. tcntr(jj) .and. (tspltcntr(j) .eq. '      WD' .or. tspltjb(j) == tcjb(jj))) then
   2128               do n=1,nouts(j)
   2129                 if (jstsplt(j,n) == tcjs(jj)) then
   2130                   write (w2err, '(A,I0,A)') 'w2_selective.npt USGS ERROR-- Outlet number ',tcjs(jj),' used in tower and blen
   2130 ding group at same time.'
   2131                   ERROR_OPEN = .TRUE.       ! will trigger the program to end when this subroutine is completed
   2132                 end if
   2133               end do
   2134             end if
   2135           end if
   2136         end do
   2137       end do
   2138     end if
   2139   end if
   2140 
   2141   if (tempc == '      ON') then
   2142     do j=1,numtempc-1
   2143       do jj=j+1,numtempc
   2144         if ((tctsrt(jj) >= tctsrt(j) .and. tctsrt(jj) <  tctend(j)) .or.                                                    
   2144        &
   2145             (tctend(jj) >  tctsrt(j) .and. tctend(jj) <= tctend(j))) then
   2146           if (tcntr(j) .eq. tcntr(jj) .and. (tcntr(j) .eq. '      WD' .or. tcjb(j) == tcjb(jj))) then
   2147             if (tcjs(j) == tcjs(jj)) then
   2148               write (w2err, '(A,I0,A)') 'w2_selective.npt USGS ERROR-- Tower outlet number ', tcjs(j), ' used more than once
   2148  for overlapping dates.'
   2149               ERROR_OPEN = .TRUE.       ! will trigger the program to end when this subroutine is completed
   2150             end if
   2151           end if

