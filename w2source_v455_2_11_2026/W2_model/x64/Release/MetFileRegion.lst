     43     
     44     Subroutine MetRegionsWB
     45     Use GLOBAL
     46     Implicit None    
     47     integer :: NMet
     48 
     49     Allocate(WB_MetRegions(NWB),I_MetRegions(IMX))
     50     MetRegWB=0
     51     WB_MetRegions=0
     52     I_MetRegions=0
     53     DO NMet=1,NMetFileRegions
     54     
     55     DO JW=1,NWB
     56             IF(MetRegStart(NMet) >= US(BS(JW))-1 .AND. MetRegEnd(NMet) <=  DS(BE(JW))+1)THEN
     57                  MetRegWB(NMet)=JW
     58                  WB_MetRegions(JW)=NMet
     59                  EXIT
     60             ENDIF
     61     ENDDO
     62     if(MetRegWB(NMet)==0)then
     63         DO JW=1,NWB
     64         if(MetRegStart(NMet) >= US(BS(JW))-1.and.MetRegStart(NMet) <= DS(BS(JW))-1 )THEN
     65                  MetRegWB(NMet)=JW
     66                  EXIT
     67         ENDIF
     68         ENDDO
     69     endif
     70     ENDDO
     71     
     72     DO JW=1,NWB
     73         if(WB_MetRegions(JW)==0)then
     74         DO NMet=1,NMetFileRegions
     75         IF(MetRegStart(NMet) <= US(BS(JW))-1 .AND. MetRegEnd(NMet) >=  DS(BE(JW))+1)then
     76             WB_MetRegions(JW)=NMet
     77             exit
     78         endif
     79         ENDDO
     80         endif
     81     ENDDO
     82     
     83     DO JW=1,NWB
     84     DO I=US(BS(JW))-1,DS(BE(JW))+1
     85         DO NMet=1,NMetFileRegions
     86         IF(MetRegStart(NMet) <= I .and. MetRegEnd(NMet) >= I)then
     87             I_MetRegions(I)=NMet
     88             exit
     89         ENDIF   
     90     ENDDO
     91     ENDDO
     92     ENDDO
     93     
     94     RETURN
     95     
     96     End Subroutine MetRegionsWB

