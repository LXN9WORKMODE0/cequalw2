   2943           PHT = PHT+INCR
   2944           HION = 10.0**PHT
   2945           F = CART*K1*(HION+2.0*K2)/(HION*HION+K1*HION+K1*K2)+KW/HION-ALKT-HION/HT ! SR 01/01/12
   2946           IF (AMMONIA_BUFFERING) THEN ! SR 01/01/12
   2947             F = F + AMMT*KAMM/(HION+KAMM) ! SR 01/01/12
   2948           END IF ! SR 01/01/12
   2949           IF (PHOSPHATE_BUFFERING) THEN ! SR 01/01/12
   2950             F = F + PHOST*( KP1*KP2*HION + 2*KP1*KP2*KP3 - HION*HION*HION ) &
   2951                 /( HION*HION*HION + KP1*HION*HION + KP1*KP2*HION + KP1*KP2*KP3) ! SR 01/01/12
   2952           END IF ! SR 01/01/12
   2953           IF (OM_BUFFERING) THEN ! SR 01/01/12
   2954             DO JA=1,NAG ! SR 01/01/12
   2955               F = F + OMCT*SDEN(JA)*( 1.0/(1.0+HION*(10.0**PK(JA))) - 1.0/(1.0+(10.0**(PK(JA)-4.5))) ) ! SR 01/01/12
   2956             END DO ! SR 01/01/12
   2957           END IF ! SR 01/01/12
   2958           ITER = ITER+1
   2959         END DO
   2960         PHT = PHT-INCR
   2961      END DO
   2962 !**** pH, carbon dioxide, bicarbonate, and carbonate concentrations
   2963      HION = 10.0**PHT
   2964      PH(K,I) = -PHT
   2965      CO2(K,I) = TIC(K,I)/(1.0+K1/HION+K1*K2/(HION*HION))
   2966      IF(CDWBC(HCO3_DER,JW)=='      ON')HCO3(K,I) = TIC(K,I)/(1.0+HION/K1+K2/HION)
   2967      IF(CDWBC(CO3_DER,JW)=='      ON') CO3(K,I) = TIC(K,I)/((HION*HION)/(K1*K2)+HION/K2+1.0)
   2968    END DO
   2969  END DO
   2970 RETURN
