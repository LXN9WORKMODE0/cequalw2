    186   IF(INFORMAT=='$')THEN
    187       READ(SHD,'(/)')
    188       DO I=1,IMX
    189           READ (SHD,*)J,SHADEI(I)    ! SW 3/14/2018 ADDED TO BE COMPATIBLE WITH PREPROCESSOR
    190           IF(SHADEI(I)<0.0)THEN
    191           BACKSPACE(SHD)
    192           READ (SHD,*) J,SHADEI(I),TTLB(I),TTRB(I),CLLB(I),CLRB(I),SRLB1(I),SRLB2(I),SRRB1(I),SRRB2(I),(TOPO(I,J),J=1,IANG),
    192 SRFJD1(I),SRFJD2(I)
    193           ENDIF
    194       ENDDO
    195   ELSE
    196   READ (SHD,'(//(8X,29F8.0))') (SHADEI(I),TTLB(I),TTRB(I),CLLB(I),CLRB(I),SRLB1(I),SRLB2(I),SRRB1(I),SRRB2(I),        &
    197                                       (TOPO(I,J),J=1,IANG),SRFJD1(I),SRFJD2(I),I=1,IMX)
    198   ENDIF
    199   SHADE = SHADEI
    200   WSH = NPT; NPT = NPT+1
    201   OPEN (WSH,FILE=WSCFN,STATUS='OLD')
    202   READ( WSH,'(A1)')INFORMAT
    203   IF(INFORMAT=='$')WSHF=.TRUE.
    204   IF(WSHF)THEN
    205   READ (WSH,'(/)')
    206   READ (WSH,*) NXWSC,(WSCNX(I),I=1,IMX)
    207   WSC = WSCNX
    208   READ (WSH,*)    NXWSC,(WSCNX(I),I=1,IMX)  
    209   ELSE
    210   READ (WSH,'(//10F8.0:/(8X,9F8.0))') NXWSC,(WSCNX(I),I=1,IMX)
    211   WSC = WSCNX
    212   READ (WSH,'(10F8.0:/(8X,9F8.0))')    NXWSC,(WSCNX(I),I=1,IMX)
    213   ENDIF
