    429                       TPIN(JW) = TPIN(JW) + (TPALG+TPBOD+TPZ+CIN(NPO4,JB)+CIN(NLDOMP,JB)+CIN(NRDOMP,JB)+CIN(NLPOMP,JB)+CIN(N
    429 RPOMP,JB))*QINF(K,JB)*QIN(JB)*DLT/1000.
    430                       TNIN(JW) = TNIN(JW) + (TNALG+TNBOD+TNZ+CIN(NNH4,JB)+CIN(NNO3,JB)+CIN(NLDOMN,JB)+CIN(NRDOMN,JB)+CIN(NLP
    430 OMN,JB)+CIN(NRPOMN,JB))*QINF(K,JB)*QIN(JB)*DLT/1000.
    431                 END IF
    432               END DO
