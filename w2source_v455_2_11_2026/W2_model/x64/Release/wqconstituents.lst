     35         IF(STANDING_BIOMASS_DECAY)THEN  ! SW 5/26/15
     36           IF (SEDIMENT_CALC1(JW))then
     37             CALL SEDIMENT1            
     38           end if
     39           IF (SEDIMENT_CALC2(JW))then
     40             CALL SEDIMENT2            
     41           end if
     42         ENDIF
     43 
     44         IF(MACROPHYTE_ON)THEN
     45 !C  IF DEPTH IN KTI LAYER BECOMES GREATER THAN THRESHOLD, SETTING
     46 !C      MACROPHYTE CONC. IN KTI COLUMN TO INITIAL CONC.
     47           DO I=IU,ID
     48 !            IF (EL(KT,I)-Z(I)*COSA(JB) > EL(KTI(I),I)) THEN
     49 !!C  KEEPING TRACK IF COLUMN KTI HAS MACROPHYTES
     50 !                  IF(KTI(I).GT.2)KTICOL(I)=.FALSE.
     51 !            ELSE
     52 !                  KTICOL(I)=.TRUE.
     53 !            ENDIF
     54               
     55             DEPKTI=ELWS(I)-EL(KTI(I)+1,I)
     56 
     57 !******* MACROPHYTES, SETTING CONC. OF MACROPHYTES IN NEW COLUMNS TO

