    183   
    184 !===========================================================================================================================
    185 ! allocate and initialize all input parameter
    186   SUBROUTINE SYSTDG_qs
    187     IMPLICIT NONE
    188     REAL(R8)          :: SUMQ, SUMQ1
    189     SUMQ = 0.0
    190     SUMQ1 = 0.0
    191     DO ib = 1, NBAY
    192       SUMQ = SUMQ + QBAY(ib)**BAYC(ib)
    193       SUMQ1 = SUMQ1 + QBAY(ib)**(BAYC(ib) - 1.0)
    194     END DO
    195     IF (SUMQ1 /= 0.0) qs = SUMQ / SUMQ1 *35.3147/1000.0    ! CMS TO KCFS
    196   END SUBROUTINE SYSTDG_qs


