   2396                 d_crit=d_crit-d_int
   2397               end if
   2398               if(jj.eq.numclass.and.DepthParticle.lt.d_crit+d_int)then                !if(jj.eq.numclass.and.depthb(kbi(i),i
   2398 ).lt.d_crit+d_int)then
   2399                 d_class(N,jj)=d_class(N,jj)+dlt
