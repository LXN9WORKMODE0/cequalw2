   1978     ENDIF
   1979       DO JA=1,NAL
   1980         IF(ALG_CALC(JA))SEDAS(K,I) = SEDAS(K,I)+MAX(AS(JA),0.0)*ALG(K,I,JA)*BIBH2(K,I)                !BI(K,I)/BH2(K,I)*(1.0
   1980 -BI(K+1,I)/BI(K,I))
   1981       END DO
   1982       SEDEM = 0.0   ! CB 5/19/06
   1983       DO JE=1,NEP
