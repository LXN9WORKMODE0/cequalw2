   1011 REAL (R8) FUNCTION BAREA (DEPTH,DIA)
   1012   USE PREC
   1013   IMPLICIT NONE
   1014 
   1015   REAL(R8), PARAMETER ::PI=3.14159265359D0
   1016   REAL(R8) :: DEPTH,DIA
   1017   IF (DEPTH < DIA) THEN
   1018     BAREA = (DEPTH-DIA*0.5D0)*DSQRT(DEPTH*DIA-DEPTH**2)+(DIA**2*0.25D0)*DASIN((2.0D0/DIA)*(DEPTH-DIA*0.5D0))+(PI*DIA**2)/8.0
   1018 D0
   1019   ELSE
   1020     BAREA = (PI*DIA**2)*0.25D0
   1021   END IF
   1022 END FUNCTION BAREA


