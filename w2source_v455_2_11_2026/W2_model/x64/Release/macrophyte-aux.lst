2026-03-30 08:48                                 ..\..\..\macrophyte-aux.f90

    229         END IF
    230       END DO
    231 
    232 !**** AREAS AND BOTTOM WIDTHS
    233 
    234       IF (.NOT. TRAPEZOIDAL(JW)) THEN                                                                                  !SW 0
    234 7/16/04
    235         DO I=IU-1,ID+1
    236           DO K=1,KMX-1
    237             BH2(K,I) = B(K,I)*H(K,JW)
    238             BH(K,I)  = B(K,I)*H(K,JW)
    239             BB(K,I)  = B(K,I)-(B(K,I)-B(K+1,I))/(0.5*(H(K,JW)+H(K+1,JW)))*H(K,JW)*0.5                                  !SW 0
    239 8/02/04
    240           END DO
    241           BH(KMX,I) = BH(KMX-1,I)
    242         END DO
    243 !****** DERIVED GEOMETRY
    244 
    245         DO I=IU-1,ID+1
    246           BH2(KT,I) = B(KTI(I),I)*(EL(KT,I)-EL(KTI(I)+1,I)-Z(I)*COSA(JB))/COSA(JB)
    247           IF (KT == KTI(I)) BH2(KT,I) = H2(KT,I)*B(KT,I)
    248           DO K=KTI(I)+1,KT
    249             BH2(KT,I) = BH2(KT,I)+BH(K,I)
    250           END DO
    251           BKT(I)   = BH2(KT,I)/H2(KT,I)
    252           BI(KT,I) = B(KTI(I),I)
    253         END DO
    254       ELSE                                                                                                             !SW 0
    254 7/16/04
    255         DO I=IU-1,ID+1
    256           DO K=1,KMX-1
    257             BB(K,I)  = B(K,I)-(B(K,I)-B(K+1,I))/(0.5*(H(K,JW)+H(K+1,JW)))*H(K,JW)*0.5
    258           END DO
    259           BB(KB(I),I) = B(KB(I),I)*0.5
    260           BH2(1,I)    = B(1,I)*H(1,JW)
    261           BH(1,I)     = BH2(1,I)
    262           DO K=2,KMX-1
    263             BH2(K,I) = 0.25*H(K,JW)*(BB(K-1,I)+2.*B(K,I)+BB(K,I))
    264             BH(K,I)  = BH2(K,I)
    265           END DO
    266           BH(KMX,I) = BH(KMX-1,I)
    267         END DO
    268         DO I=IU-1,ID+1
    269           CALL GRID_AREA1(EL(KT,I)-Z(I),EL(KT+1,I),BH2(KT,I),BI(KT,I))
    270           BKT(I) = BH2(KT,I)/H2(KT,I)
    271         END DO
    272       END IF
    273       DO I=IU-1,ID
    274         DO K=1,KMX-1
    275           AVH2(K,I) = (H2(K,I) +H2(K+1,I)) *0.5
    276           AVHR(K,I) =  H2(K,I)+(H2(K,I+1)-H2(K,I))/(0.5*(DLX(I)+DLX(I+1)))*0.5*DLX(I)                                  !SW 0
    276 7/29/04
    277         END DO
    278         AVH2(KMX,I) = H2(KMX,I)
    279         DO K=1,KMX
    280           BR(K,I)   = B(K,I)  +(B(K,I+1)  -B(K,I))  /(0.5*(DLX(I)+DLX(I+1)))*0.5*DLX(I)                                !SW 0
    280 7/29/04

Page 6           Source Listing                  POROSITY
2026-03-30 08:48                                 ..\..\..\macrophyte-aux.f90

    281           BHR(K,I)  = BH(K,I) +(BH(K,I+1) -BH(K,I)) /(0.5*(DLX(I)+DLX(I+1)))*0.5*DLX(I)                                !SW 0
    281 7/29/04
    282           BHR2(K,I) = BH2(K,I)+(BH2(K,I+1)-BH2(K,I))/(0.5*(DLX(I)+DLX(I+1)))*0.5*DLX(I)                                !SW 0
    282 7/29/04
    283            IF(CONSTRICTION(K,I))THEN    ! SW 6/26/2018
    284               IF(BR(K,I) > BCONSTRICTION(I))          BR(K,I)  = BCONSTRICTION(I)
    285               IF(BHR(K,I) > BCONSTRICTION(I)*H(K,JW)) BHR(K,I) = BCONSTRICTION(I)*H(K,JW)
    286               IF(BHR2(K,I) > BCONSTRICTION(I)*H(K,JW))BHR2(K,I)= BCONSTRICTION(I)*H(K,JW)
    287           ENDIF
    288 
    289         END DO
    290       END DO
    291       DO K=1,KMX-1
    292         AVH2(K,ID+1) = (H2(K,ID+1)+H2(K+1,ID+1))*0.5
    293         BR(K,ID+1)   =   B(K,ID+1)
    294         BHR(K,ID+1)  =   BH(K,ID+1)
    295       END DO
    296       AVH2(KMX,ID+1) = H2(KMX,ID+1)
    297       AVHR(KT,ID+1)  = H2(KT,ID+1)
    298       BHR2(KT,ID+1)  = BH2(KT,ID+1)
    299       IUT = IU
    300       IF (UP_HEAD(JB)) IUT = IU-1
    301       DO I=IUT,ID
    302         DO K=1,KMX-1
    303           VOL(K,I) = B(K,I)*H2(K,I)*DLX(I)
    304         END DO
    305         VOL(KT,I)    = BH2(KT,I)*DLX(I)
    306         DEPTHB(KT,I) = H2(KT,I)
    307         DEPTHM(KT,I) = H2(KT,I)*0.5
    308         DO K=KT+1,KMX
    309           DEPTHB(K,I) = DEPTHB(K-1,I)+ H2(K,I)
    310           DEPTHM(K,I) = DEPTHM(K-1,I)+(H2(K-1,I)+H2(K,I))*0.5
    311         END DO
    312       END DO
    313     END DO
    314   END DO
    315 
    316 10 CONTINUE
    317 
    318     RETURN
    319     END SUBROUTINE POROSITY

