   1479     
   1480 ! this function calculates the friction head loss in the culvert
   1481 
   1482 !REAL (R8) function floss()
   1483 !USE STRUCTURES; USE PIPE;IMPLICIT NONE
   1484 !
   1485 !if(num.eq.3)depth=hdn
   1486 !if(num.eq.2)depth=depthcrit(FLOW)
   1487 !
   1488 !floss = (flow * fman)**2 * wetper(DEPTH,DIA)**(4./3.) * dist/(cm**2 * barea(DEPTH,DIA)**(10./3.))
   1489 !
   1490 !end
   1491 ! ZBRENT2
   1492 REAL (R8) function zbrent2(func,BARG)     !(func,x1,x2,tol,barg,num)
   1493       USE STRUCTURES;USE Pipe;USE GLOBAL, ONLY:W2ERR; USE MAIN, ONLY: ERROR_OPEN  
   1494       IMPLICIT NONE
   1495       REAL(R8) :: F1,F2,FUNC,BA,B,FA,FB,FC,C,D,E,TOL1,XM,S,P,Q,R,BARG
   1496       INTEGER :: I,ITER
   1497 
   1498       external func
   1499       eps=3.e-8
   1500 
   1501 !c     root bracketing algorithm used to ensure x1 and x2  bracket the root
   1502 
   1503       factor = 2.00
   1504 
   1505       if(x1.eq.x2)THEN
   1506           WRITE(W2ERR,*) 'PIPE STEADY STATE ZBRENT2: X1=X2 you have to guess an initial range'
   1507           ERROR_OPEN=.TRUE. 
   1508       ENDIF
   1509       
   1510       f1 = func(x1,barg)
   1511       f2 = func(x2,barg)
   1512 
   1513 !c     setting lower bracket
   1514 
   1515       if(num.le.5.and.f1.gt.0.)then
   1516         do 25 i=1,100
   1517           x1=x1/10.
   1518           f1 = func(x1,barg)
   1519            if(f1.lt.0.)go to 69
   1520 25        continue
   1521           WRITE(W2ERR,*) 'PIPE STEADY STATE: ZBRENT2: could not make t#func(x1) less than zero'
   1522           ERROR_OPEN=.TRUE. 
   1523       end if
   1524 69        continue
   1525 
   1526 !c     setting upper bracket
   1527 
   1528       if(num.gt.4)factor=2.
   1529       if(num.le.5.and.f2.lt.0.)then
   1530         do 45 i=1,100
   1531           x2=x2*factor
   1532           f2 = func(x2,barg)
   1533            if(f2.gt.0.)go to 89
   1534 45        continue
   1535           WRITE(W2ERR,*) 'PIPE STEADY STATE: ZBRENT2:could not make typef(x2) greater than zero'

Page 65          Source Listing                  ZBRENT2
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

   1536           ERROR_OPEN=.TRUE. 
   1537       end if
   1538 89        continue
   1539 
   1540 !c     Brent's root finding algorithm
   1541 
   1542       ba=x1
   1543       b=x2
   1544       fa = func(ba,barg)
   1545       fb = func(b,barg)
   1546 
   1547       if(fb*fa.gt.0.)THEN
   1548           WRITE(W2ERR,*) 'PIPE STEADY STATE: ZBRENT2: root must be bracketed for zbrent2'
   1549           ERROR_OPEN=.TRUE. 
   1550       ENDIF
   1551       
   1552       fc=fb
   1553       do 11 iter=1,itmax
   1554         if(fb*fc.gt.0.)then
   1555           c=ba
   1556           fc=fa
   1557           d=b-ba
   1558           e=d
   1559         end if
   1560         if(abs(fc).lt.abs(fb))then
   1561           ba=b
   1562           b=c
   1563           c=ba
   1564           fa=fb
   1565           fb=fc
   1566           fc=fa
   1567         end if
   1568 !c     convergence check
   1569         tol1=2.*eps*abs(b)+0.5*tol
   1570         xm=.5*(c-b)
   1571         if(abs(xm).le.tol1.or.fb.eq.0.)then
   1572          zbrent2=b
   1573          go to 22
   1574         end if
   1575         if(abs(e).ge.tol1.and.abs(fa).gt.abs(fb))then
   1576           s=fb/fa
   1577           if(ba.eq.c)then
   1578             p=2.*xm*s
   1579             q=1.-s
   1580           else
   1581             q=fa/fc
   1582             r=fb/fc
   1583             p=s*(2.*xm*q*(q-r)-(b-ba)*(r-1.))
   1584             q=(q-1.)*(r-1.)*(s-1.)
   1585           end if
   1586           if(p.gt.0.)q=-q
   1587           p=abs(p)
   1588           if(2.*p.lt.min(3.*xm*q-abs(tol1*q),abs(e*q)))then
   1589             e=d
   1590             d=p/q
   1591           else
   1592             d=xm

Page 66          Source Listing                  ZBRENT2
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

   1593             e=d
   1594           end if
   1595         else
   1596           d=xm
   1597           e=d
   1598         end if
   1599         ba=b
   1600         fa=fb
   1601         if(abs(d).gt.tol1)then
   1602           b=b+d
   1603         else
   1604           b=b+sign(tol1,xm)
   1605         end if
   1606         fb= func(b,barg)
   1607 11    continue
   1608       WRITE(W2ERR,*) 'PIPE STEADY STATE: zbrent2 exceeding maximum number of iterations'
   1609       ERROR_OPEN=.TRUE. 
   1610       zbrent2=b
   1611 22    continue
   1612 
   1613       end


