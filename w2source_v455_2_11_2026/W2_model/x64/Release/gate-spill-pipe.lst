    487 SUBROUTINE OPEN_CHANNEL_INITIALIZE
    488   USE GLOBAL; USE STRUCTURES; USE SCREENC, ONLY: JDAY
    489   IMPLICIT NONE
    490   REAL(R8), PARAMETER :: THETA=0.55
    491   REAL(R8)    :: DLTX,PHI,VTOT,SLOPE,DIST,BEPR1,BEPR2,BC1,EL1,BC2,EL2,WLSLOPE,DLTX2,BAR1,BAREA,RAD1,RAD2
    492   REAL(R8)    :: TWIDTH,VAVG,QSUM,QAVG,QOUT,WETPER,BAR2
    493 
    494 
    495 ! Type declarations
    496 
    497   INTEGER                              :: J,IC,N,NP,NQCNT
    498   REAL(R8)                                 :: DT,D,DTMIN, QAVGNEW
    499   REAL(R8),    ALLOCATABLE, DIMENSION(:)   :: Y,   B,   V,   CAREA, TOPW,  BELEV, Q, VOLD, YOLD     ! CB 10/4/07
    500   REAL(R8),    ALLOCATABLE, DIMENSION(:)   :: YT,  VT, VPR, YPR, TAREA, TOPWT, RT
    501   REAL(R8),    ALLOCATABLE, DIMENSION(:,:) :: DAA, AL
    502   INTEGER, ALLOCATABLE, DIMENSION(:)   :: INDX
    503   LOGICAL                              :: SMOOTH_WATER_LEVELS      !, OPENWRN
    504   SAVE
    505 
    506 ! Allocation declarations
    507 
    508   ALLOCATE (Y(NN),    V(NN),     CAREA(NN),  TOPW(NN),   BELEV(NN),  Q(NN),     VOLD(NN), YOLD(NN), B(NN))         ! CB 10/4
    508 /07
    509   ALLOCATE (YT(NN),   VT(NN),    VPR(NN),    YPR(NN),    TAREA(NN),  TOPWT(NN), RT(NN),   INDX(NN))
    510   ALLOCATE (AL(NN,2), DAA(NN,NN))
    511 RETURN
    512 
    513 ENTRY OPEN_CHANNEL (EL1,EL2,QOUT,IC,DT)
    514 
    515 ! Variable initializtion
    516 
    517   B     = 0.0; Y     = 0.0; V = 0.0; VT = 0.0; YT = 0.0; RT = 0.0; DAA = 0.0; YPR = 0.0; VPR = 0.0; TOPW = 0.0; TOPWT = 0.0
    518   CAREA = 0.0; TAREA = 0.0; DTMIN=0.1  ! SW 10/17/2019
    519   BELEV(1)  = UPIE
    520   BELEV(NC) = DNIE
    521   PHI       = ASIN((UPIE-DNIE)/CLEN)
    522   DLTX      = CLEN/(REAL(NC-1)*0.5)
    523   DO J=2,NC-1
    524     DLTX2    =  DLTX*0.5
    525     SLOPE    = (UPIE-DNIE)/CLEN
    526     DIST     = (REAL(J-1)*DLTX2)
    527     BELEV(J) =  UPIE-SLOPE*DIST
    528   END DO
    529   BEPR1 =  UPIE+SLOPE*DLTX2
    530   BEPR2 =  DNIE-SLOPE*DLTX2
    531   BC1   = (EL1-BEPR1)*COS(PHI)

Page 17          Source Listing                  OPEN_CHANNEL_INITIALIZE
2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

    532   IF (BC1 <= 0.0) BC1 = EL1-UPIE
    533   BC2 = (EL2-BEPR2)*COS(PHI)
    534   IF (BC2 <= 0.0) BC2 = EL2-DNIE
    535   IF (.NOT. BEGIN(IC)) THEN
    536     IF (WLFLAG(IC)) THEN
    537       DO J=2,NC-1,2
    538         WLSLOPE = ((BC1-BC2)/(CLEN+DLTX))*DCOS(PHI)
    539         DIST    = (REAL(J-1)*0.5*DLTX)+DLTX2
    540         Y(J)    =  BC1-WLSLOPE*DIST
    541         YT(J)   =  Y(J)
    542         DTP(IC) =  DT
    543       END DO
    544     ELSE
    545       DO I=2,NC-1,2
    546         Y(I)  = YS(I,IC)
    547         YT(I) = YST(I,IC)
    548       END DO
    549     END IF
    550   END IF
    551   DO I=1,NC,2
    552     V(I)  = VS(I,IC)
    553     VT(I) = VST(I,IC)
    554   END DO
    555   IF (BEGIN(IC)) THEN
    556     BEGIN(IC) = .FALSE.
    557     DO J=2,NC-1,2
    558       WLSLOPE = ((BC1-BC2)/(CLEN+DLTX))*DCOS(PHI)
    559       DIST    = (REAL(J-1)*0.5*DLTX)+DLTX2
