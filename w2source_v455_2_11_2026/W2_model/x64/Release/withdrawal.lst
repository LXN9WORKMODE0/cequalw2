   1398           IF(TCISEG(J).EQ.0)THEN
   1399             TCOMP=TAVG(TCJS(J),TCJB(J))   !CB 9/8/06   TAVG(JSMON(J),JBMON(J))
   1400           ELSEIF(TCISEG(J) < 0)THEN
   1401             TCOMP=TWDO(ABS(TCISEG(J)))      ! SW 11/26/10
   1402           ELSE
   1403 
   1404 ! CHECKING TO SEE IF THE MONITORING SEGMENT TCISEG IS IN THE SAME BRANCH AND WATER BODY AS THE STRUCTURE
   1405             DO JJB=1,NBR
   1406               IF (TCISEG(J) >= US(JJB) .AND. TCISEG(J) <= DS(JJB)) EXIT
   1407             END DO
   1408             DO JJW=1,NWB
   1409               IF (JJB >= BS(JJW) .AND. JJB <= BE(JJW)) EXIT
   1410             END DO
   1411 
   1412             IF (TCKLAY(J)< 0) THEN                                                                                       
   1413               K = INT(ABS(TCKLAY(J)))
   1414             ELSE
   1415               DO K=KTWB(JJW),KB(TCISEG(J))
   1416                 IF (DEPTHB(K,TCISEG(J)) > TCKLAY(J)) EXIT                                                                   
   1416    
   1417               END DO
   1418               K = MIN(K,KB(TCISEG(J)))                                                                                      
   1418    
   1419             END IF
   1420             TCOMP=T2(K,TCISEG(J))
   1421           ENDIF
   1422           IF(TCYEARLY(J) == '     OFF')THEN
   1423             DAYTEST=JDAY
   1424           ELSE
   1425             DAYTEST=REAL(JDAYG)+JDAY-INT(JDAY)
   1426           END IF          
   1427           IF(DAYTEST >= TCTSRT(J) .AND. DAYTEST < TCTEND(J))THEN
   1428                ACTIVE_RULE_W2SELECTIVE(JS,JB)=.TRUE.
   1429                IF(TCOMP > TCTEMP(J) .AND. TCNELEV(J) > NCOUNTC(JS,JB))THEN
   1430 ! MAKING SURE THAT THE NEXT LOWER STRUCTURE FOR A PARTICULAR 'J' IS FOUND

Page 38          Source Listing                  SELECTIVE
2026-03-30 08:47                                 ..\..\..\withdrawal.f90

   1431                  DO NN=NCOUNTC(JS,JB)+1,TCNELEV(J)                 
   1432                    IF(TCELEV(J,NN) < ESTR(JS,JB))THEN
   1433                       NCOUNTC(JS,JB)=NN
   1434                       ESTR(JS,JB)=TCELEV(J,NCOUNTC(JS,JB))
   1435                       EXIT
   1436                    END IF                 
   1437                  END DO                                               
   1438                ELSEIF(TCOMP < TCTEMP(J) .AND.  NCOUNTC(JS,JB).GT. 1)THEN
   1439 ! TO PREVENT THIS HAPPENING AT EACH TIME IT CHECKS IT AND HENCE OSCIALLTING BACK AND FORTH - CHECK THE TEMP AT THE UPPER OUT
   1439 LET ALSO
   1440                  IF(TCISEG(J) > 0)THEN  
   1441                     IF(JB.EQ.JJB)THEN
   1442                       DO KS=KTWB(JW),KB(DS(JB))
   1443                         IF (DEPTHB(KS,TCISEG(J)) > TCELEV(J,NCOUNTC(JS,JB)-1)) EXIT                                         
   1443                                  !TC 01/03/02
   1444                       END DO
   1445                       KS = MIN(KS,KB(TCISEG(J)))
   1446                       TMOD= T2(KS,DS(JB))
   1447                     ELSE
   1448                       TMOD=T2(K,TCISEG(J))                      
   1449                     END IF
   1450                     IF(TMOD < TCTEMP(J) .AND. TCELEV(J,NCOUNTC(JS,JB)-1) < ELWS(DS(JB)))THEN                      
   1451 ! MAKING SURE THAT THE NEXT UPPER STRUCTURE FOR A PARTICULAR 'J' IS FOUND
   1452                       DO NN=NCOUNTC(JS,JB)-1,1,-1
   1453                         IF(TCELEV(J,NN) > ESTR(JS,JB))THEN
   1454                           NCOUNTC(JS,JB)=NN
   1455                           ESTR(JS,JB)=TCELEV(J,NCOUNTC(JS,JB))
   1456                           EXIT
   1457                         END IF                 
   1458                       END DO
   1459                     ENDIF
   1460                  END IF  ! CB 9/8/06
   1461                  IF(TCISEG(J).EQ.0)THEN
   1462 ! CALCULATE THE ESTIMATED OUTFLOW TEMPERATURE AT HIGHER PORTS WHEN TCOMP<TCTEMP(J), AND MOVE UP IF HIGHER PORT STILL MEETS T
   1462 O CRITERIA - THIS DOESN'T HAPPEN WHEN TCISEG < 0
   1463                    DO NN=1,NCOUNTC(JS,JB)-1
   1464                      ID=DS(JB)
   1465                      KT=KTWB(JW)                     
   1466                      CALL DOWNSTREAM_WITHDRAWAL_ESTIMATE(JS,TEMPEST,TCELEV(J,NN))
   1467                      IF(TEMPEST < TCTEMP(J) .AND. TCELEV(J,NN) < ELWS(DS(JB)))THEN
   1468                        NCOUNTC(JS,JB)=NN
   1469                        ESTR(JS,JB)=TCELEV(J,NCOUNTC(JS,JB))
   1470                        EXIT
   1471                      END IF
   1472                    END DO
   1473                  END IF
   1474                ENDIF
   1475                IF(TCELEVCON(J) =='      ON' .AND. TCNELEV(J) > NCOUNTC(JS,JB).AND. ESTR(JS,JB) > (ELWS(DS(JB))-MINWL(J)))THE
   1475 N  
   1476                  NCOUNTC(JS,JB)=NCOUNTC(JS,JB)+1
   1477                  ESTR(JS,JB)=TCELEV(J,NCOUNTC(JS,JB))
   1478                END IF
   1479           ELSE
   1480               ACTIVE_RULE_W2SELECTIVE(JS,JB)=.FALSE.
   1481           ENDIF          
   1482       ENDIF            
   1483      END DO

