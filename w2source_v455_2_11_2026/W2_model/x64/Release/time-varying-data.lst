   3081 !***************************************************************************************************************************
   3081 ********
   3082 
   3083 ! Function to read a standard input file and return the last available JDAY                           Entire function:  !SR 
   3083 11/28/19
   3084 ! File name is passed to the function, and file is guaranteed to exist.
   3085 
   3086 REAL FUNCTION GET_LAST_JDAY(FNAME)
   3087     USE MAIN, ONLY: CON                     ! Control file already read and closed
   3088     REAL            LAST_JDAY
   3089     CHARACTER(1)    INFORMAT
   3090     CHARACTER(72)   FNAME
   3091 
   3092     OPEN (CON,FILE=FNAME,STATUS='OLD')      ! File was previously tested for existence
   3093     READ (CON,'(A1)') INFORMAT              ! Assumption that 3-line header is in place, with at least one line of data
   3094     READ (CON,'(/)')
   3095     IF (INFORMAT=='$') THEN
   3096       DO WHILE (.NOT. EOF(CON))
   3097         READ (CON,*) LAST_JDAY              ! Free format, probably comma-delimited
   3098       END DO
   3099     ELSE

Page 87          Source Listing                  GET_LAST_JDAY
2026-03-30 08:47                                 ..\..\..\time-varying-data.f90

   3100       DO WHILE (.NOT. EOF(CON))
   3101         READ (CON,'(F8.0)') LAST_JDAY       ! Fixed format, needed if fixed-format file did not have space after JDAY
   3102       END DO
   3103     END IF
   3104     CLOSE (CON)
   3105     GET_LAST_JDAY = LAST_JDAY
   3106 END FUNCTION GET_LAST_JDAY


