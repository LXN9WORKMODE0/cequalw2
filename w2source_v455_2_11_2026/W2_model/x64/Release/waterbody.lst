    461 ENTRY UPSTREAM_FLOW
    462   DO JJB=1,NBR
    463     IF (UHS(JB) >= US(JJB) .AND. UHS(JB) <= DS(JJB)) EXIT
    464   END DO
    465   DO JJW=1,NWB
    466     IF (JJB >=BS(JJW) .AND. JJB <= BE(JJW)) EXIT
    467   END DO
    468   DO K=KTWB(JWUH(JB)), KB(UHS(JB))+1
    469     ELL(K) = EL(K,UHS(JB))
    470   END DO
    471   DO K=KT,KB(IU)+1
    472     ELR(K) = EL(K,IU)+SINA(JB)*DLX(IU)*0.5
    473   END DO
    474   ELW = ELWS(IU)                                  !EL(KTWB(JW),IU)-Z(IU)*COSA(JB)
    475   EL1  = ELW+SINA(JB)*DLX(IU)*0.5
    476 !  IF(SLOPE(JB) /= 0.0)THEN
    477 !  EL1  = ELW-(ELWS(IU+1)-ELW)/(0.5*(DLX(IU)+DLX(IU+1))*DLX(IU)*0.5   ! SW 7/17/09
    478 !  ELSE
    479 !  EL1=ELW
    480 !  ENDIF
    481   KR   = KT+1
    482   DO K=KTWB(JWUH(JB))+1,KB(UHS(JB))+1
    483     IF (ELL(K) >= ELR(KR)) THEN
    484       Q1 = VOLUH2(KR-1,JB)/DLT
    485       HT = H2(KR-1,JW)
    486       IF (KR == KTWB(JW)+1) THEN
    487         QU(K-1,UHS(JB))  = Q1
    488         QSS(K-1,UHS(JB)) = QSS(K-1,UHS(JB))-Q1
    489       ELSE
    490         QU(K-1,UHS(JB))  = Q1*((EL1-ELL(K))/HT)
    491         QSS(K-1,UHS(JB)) = QSS(K-1,UHS(JB))-QU(K-1,UHS(JB))
    492       END IF

