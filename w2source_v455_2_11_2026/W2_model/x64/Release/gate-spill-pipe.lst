2026-03-30 08:47                                 ..\..\..\gate-spill-pipe.f90

    217 (IUPI(JP))*COSA(JBUPI(JP))
    218     ELSE
    219       EL1   = ELWS(IUPI(JP))-SINA(JBDPI(JP))*DLX(IUPI(JP))*0.5                               !EL(KTWB(JWUPI(JP)),IUPI(JP))-Z
    219 (IUPI(JP))*COSA(JBUPI(JP))-SINA(JBDPI(JP))*DLX(IUPI(JP))*0.5
    220 !  EL1 = ELWS(IUPI(JP)) + (ELWS(IUPI(JP))-ELWS(IUPI(JP)-1))/(0.5*(DLX(IUPI(JP))+DLX(IUPI(JP)-1)))*DLX(IUPI(JP))*0.5     ! LI
    220 NEAR INTERPOLATION OF THE WATER LEVEL TO THE EDGE
    221     END IF
    222     IF (IDPI(JP) /= 0) THEN
    223       IF (US(JBDPI(JP)) /= IDPI(JP)) THEN
    224         EL2   = ELWS(IDPI(JP))                                                               !EL(KTWB(JWDPI(JP)),IDPI(JP))-Z
    224 (IDPI(JP))*COSA(JBDPI(JP))
    225       ELSE
    226         EL2   = ELWS(IDPI(JP))+SINA(JBDPI(JP))*DLX(IDPI(JP))*0.5                             !EL(KTWB(JWDPI(JP)),IDPI(JP))-Z
    226 (IDPI(JP))*COSA(JBDPI(JP))+SINA(JBDPI(JP))*DLX(IDPI(JP))*0.5
    227 !  EL2 = ELWS(IDPI(JP)) - (ELWS(IDPI(JP)+1) - ELWS(IDPI(JP)))/(0.5*(DLX(IDPI(JP))+DLX(IDPI(JP)+1)))*DLX(IDPI(JP))*0.5
    228       END IF
    229     ELSE
    230       EL2 = -1.0
    231     END IF
    232     HIE = MAX(UPIE,DNIE)
    233     IF (DIA == 0.0) THEN
    234       QPI(JP)    =  0.0
    235       WLFLAG(JP) = .TRUE.
    236       GO TO 140
    237     END IF
    238     EPS = 0.001
    239     IF ((HIE+EPS) >= EL1 .AND. (HIE+EPS) >= EL2) THEN
    240       QPI(JP)    =  0.0
    241       WLFLAG(JP) = .TRUE.
    242       GO TO 140
    243     END IF
    244     IF (EL1 > EL2) THEN
    245       DCHECK = EL1-UPIE
    246     ELSE
    247       DCHECK = EL2-DNIE
    248     END IF
    249     IF (DCHECK < 0.02) THEN
    250       QPI(JP)    =  0.0
    251       WLFLAG(JP) = .TRUE.
    252       GO TO 140
    253     END IF
    254     IF (ABS(QOLD(JP)) < 0.001) QOLD(JP) = 0.001
    255     IF (EL1 >= (UPIE+DIA) .AND. EL2 >= (DNIE+DIA)) THEN
    256       D1 = EL1
    257       D2 = EL2
    258       GO TO 120
    259     END IF
    260 
    261     IF (EL1 > EL2) THEN
    262       DTEST = EL2-DNIE
    263     ELSE
    264       DTEST = EL1-UPIE
    265     END IF
    266     DCRIT = DEPTHCRIT(ABS(QOLD(JP)))
    267 !IF (DTEST <= DCRIT) THEN
    268 !  IF (EL1 <= EL2) THEN
