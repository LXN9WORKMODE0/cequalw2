    219     
    220     SUBROUTINE SYSTDG_TDG
    221     USE SCREENC, ONLY:JDAY; 
    222       IMPLICIT NONE
    223       REAL(R8)         :: P1, P2, P3, P4, E1, E2
    224       REAL(R8)         :: qs_RO, W2FBE, Q_SUM, TEMP_TW, SUM_TDGPHK
    225       REAL(R8)         :: Q_ROSP, QRO, QSP, QPH, QTOT, TDG_QROSP, TDG_QPH, TDG_QTOT, TDG_QENT
    226       REAL(R8)         :: SUM_TDG_ROS, SUM_TDG_SPS, SUM_TDG_PHS
    227       REAL(R8)         :: TDG_RO, TDG_SP, TDG_PH
    228       INTEGER*8        :: SUM_K, IK
    229       REAL             :: SUM_QGT2
    230       Q_SUM = 0.0
    231 ! ADD QRO AND QSP
    232       DO ig = 1, NGT
    233          IF (GTTYP(ig)=='      RO') THEN
    234             Q_SUM = Q_SUM + QGT(ig)
    235          ELSE
    236             IF (ig>=BEGNO.AND. ig<=ENDNO)  Q_SUM = Q_SUM + QGT(ig)
    237          END IF
    238       END DO
    239       TDG_ROSP = 0.0
    240       IF (Q_SUM/=0.0) THEN
    241           TDG_TDP(:)  = 0.0                                                ! INITIAL TDG FOR GATES
    242 !
    243           SUM_TDG_ROS = 0.0                                                ! INITIAL SUM TDG FOR RO
    244           QRO         = 0.0                                                ! INITIAL SUM Q FOR RO
    245           DO ig = 1, NGT
    246              IF (GTTYP(ig)=='      RO') THEN                               
    247                  QRO = QRO + QGT(ig)
    248              END IF 
    249           END DO
    250           qs_RO = QRO * 35.3147/1000.0                                     ! CMS TO KCFS
    251           DO ig = 1, NGT
    252              IF (GTTYP(ig)=='      RO' .AND. QGT(ig)>0.0) THEN
    253                 TDG_TDP(ig)= (ROP1 * (1 - EXP(ROP3 * qs_RO)) + PALT(IUGT(ig))*760.0)/(PALT(IUGT(ig))*760.0) *100.0     ! RO 
    253 USE EQ 1     ! (mmgh) TO TDG (%)
