     16 
     17 !** Water surface minimum thickness
     18 
     19     DO JW=1,NWB
     20       KT       =  KTWB(JW)
     21       ZMIN(JW) = -1000.0
     22       KTMAX    =  2                                                                                                 ! SR 10/
     22 17/05
     23       DO JB=BS(JW),BE(JW)
     24          IF(BR_INACTIVE(JB))THEN 
     25           IF(DS(JB)-US(JB)+1>=3)THEN
     26               I_BR_NUM=DS(JB)-2
     27           ELSE
     28               I_BR_NUM=DS(JB)-1    ! FOR BRANCHES WITH LESS THAN 3 SEGMENTS
     29           ENDIF
     30           
     31 ! Test to determine whether to re-activate an inactivated branch.  Original test is commented out below.      !SR 11/30/2021
     32 ! IF(CUS(JBDH(JB))<=DHS(JB) .AND. ELWS(DHS(JB))>EL(KB(I_BR_NUM),I_BR_NUM))THEN     ! ***
     33 
     34 ! That test was odd and didn't take into account slope or the NLMIN requirement.  And when the branch         !SR 11/30/2021
     35 ! was re-activated, only the last two segments of that branch were re-activated, regardless of I_BR_NUM.      !SR 11/30/2021
     36 ! I will ignore I_BR_NUM, assume that only branches with a slope of zero ever get inactivated, do the         !SR 11/30/2021
     37 ! standard NLMIN test, and require that at least the 2 downstream-most segments meet the NLMIN criteria.      !SR 11/30/2021
     38 ! Two segments makes sense because two must be active to avoid inactivation in the code's initial tests,      !SR 11/30/2021
     39 ! and 2 segments is the inactivation test that I applied (code change) later in this source file.             !SR 11/30/2021
     40 
     41 ! Note that re-activation requires DHS(JB)>0, but inactivation does not.  Perhaps that can be fixed later.    !SR 11/30/2021
     42 ! Re-activation requires DHS(JB)>0 because initialization of many variables depends on DHS(JB)>0.             !SR 11/30/2021
     43 ! Maybe branches with downstream flow and external head boundaries don't get inactivated because JB=JBDN(JW). !SR 11/30/2021
     44 
     45           IUT = US(JB)                                                                                                !SR 11
     45 /30/2021
     46           DO I=US(JB),DS(JB)                                                                                          !SR 11
     46 /30/2021
     47             IF (KB(I)-KT < NL(JB)-1) IUT = I+1                                                                        !SR 11
     47 /30/2021
     48           END DO                                                                                                      !SR 11
     48 /30/2021
     49           IF (DHS(JB) > 0 .AND. .NOT. BR_INACTIVE(JBDH(JB)) .AND. CUS(JBDH(JB))<=DHS(JB) .AND. IUT<=DS(JB)-1) THEN    !SR 11

