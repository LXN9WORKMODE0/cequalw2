    452 REAL(R8) FUNCTION WALLFUNCTION()
    453 USE GLOBAL;USE GEOMC;USE EDDY;USE LOGICC;USE MAIN, ONLY:WARNING_OPEN; USE SCREENC, ONLY:JDAY
    454 IMPLICIT NONE
    455 EXTERNAL SEMILOG, RTBIS
    456 REAL(R8) :: KS, UBOUND,LBOUND,VISCK,SEMILOG,RTBIS,UST,PERIMETER,AREA,BS1                                  !,USTARB
    457 REAL(R8) :: V
    458 INTEGER :: K,MULTIPLIER
    459     VISCK = DEXP(-(T2(KB(I),I)+495.691)*0.026746764)                                                     !/(-37.3877)
    460     IF (T2(KB(I),I) > 30.0)  VISCK = DEXP(-(T2(KB(I),I)+782.190)*0.01731301939)                          !/(-57.7600)
    461   	UBOUND = ABS((U(KB(I),I)+U(KB(I),I-1))*.5)
    462     IF(SEMILOG(UBOUND,ABS((U(KB(I),I)+U(KB(I),I-1))*.5),(H(KB(I),JW))/2.0,VISCK)>0) THEN               !FRIC(I),
    463 	  MULTIPLIER = 2
    464 	  DO WHILE(SEMILOG(UBOUND,ABS((U(KB(I),I)+U(KB(I),I-1))*.5),(H(KB(I),JW))/2.0,VISCK)>0)            !,FRIC(I)
    465   		UBOUND = ABS((U(KB(I),I)+U(KB(I),I-1))*.5)*REAL(MULTIPLIER)
    466 		MULTIPLIER = MULTIPLIER + 1
    467 		IF(MULTIPLIER>30)THEN
    468 		  WARNING_OPEN    = .TRUE.
    469 		  WRITE(WRN,*)'WALLFUNCTION: UPPER BOUND NOT FOUND IN TKE1 ROUTINE ON JDAY:',JDAY
    470 		  WRITE(WRN,*)'Setting TKE calculation to TKE from TKE1'
    471 		  AZC(JW)='     TKE'
    472 		  WALLFUNCTION=0.0
    473 		  RETURN
    474 		ENDIF
    475 	  ENDDO
    476 	ENDIF
    477 	LBOUND = VISCK/(E(I)*(H(KB(I),JW))/2.0D0)+NONZERO
    478 	MULTIPLIER = 1
    479 	DO WHILE(SEMILOG(LBOUND,DABS((U(KB(I),I)+U(KB(I),I-1))*.5D0),(H(KB(I),JW))/2.0D0,VISCK)<0)
    480  		LBOUND = VISCK/(E(I)*(H(KB(I),JW))/2.0)+10**MULTIPLIER*NONZERO
    481 		MULTIPLIER = MULTIPLIER + 1
    482 		IF(MULTIPLIER>30)THEN
    483 		  WARNING_OPEN    = .TRUE.
    484 		  WRITE(WRN,*)'WALLFUNCTION: LOWER BOUND NOT FOUND IN TKE1 ROUTINE ON JDAY:',JDAY
    485 		  WRITE(WRN,*)'Setting TKE calculation to TKE from TKE1'
    486 		  AZC(JW)='     TKE'
    487 		  WALLFUNCTION=0.0
    488 		  RETURN
    489 		ENDIF
    490 	ENDDO    	
    491     WALLFUNCTION = RTBIS(LBOUND,UBOUND,1D-15,DABS((U(KB(I),I)+U(KB(I),I-1))*.5D0),(H(KB(I),JW))/2.0D0,VISCK)           !,FRI
    491 C(I)
    492     IF(STRICKON(JW))THEN
    493 	  V = VISCK
    494 	  UST = WALLFUNCTION
    495 	  IF (MANNINGS_N(JW)) THEN
    496         KS = ((STRICK(JW)*FRIC(I))**6)
    497 	  ELSE
    498         PERIMETER = B(KB(I),I)+2.0D0*H(KB(I),JW)
    499         DO K=KT,KB(I)-1
    500           PERIMETER = PERIMETER + (B(K,I)-B(K+1,I)+2.0D0*H(K,JW))
    501         END DO
    502         AREA = 0
    503         DO K=KT,KB(I)
    504           AREA = AREA + BH1(K,I)
    505         END DO
    506 	    KS = ((STRICK(JW)*1.0D0/FRIC(I)*(AREA/PERIMETER)**(0.16666666667D0))**6)        !1.0/6.0

Page 21          Source Listing                  WALLFUNCTION
2026-03-30 08:47                                 ..\..\..\az.f90

    507 	  ENDIF
    508       IF(UST*KS/V>1.0)THEN
    509         BS1 = (5.5D0+2.5D0*DLOG(UST*KS/V))*DEXP(-0.217D0*DLOG(UST*KS/V)**2)+8.5D0*(1-DEXP(-0.217D0*DLOG(UST*KS/V)**2))
    510         E(I) = DEXP((.41*BS1)/(UST*KS/V))
    511       ELSE
    512         E(I) = 9.535D0
    513       ENDIF	
    514 	ENDIF
    515 ENDFUNCTION WALLFUNCTION


