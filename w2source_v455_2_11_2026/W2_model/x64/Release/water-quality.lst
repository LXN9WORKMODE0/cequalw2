   3137 , BIBH2)
   3138   DEALLOCATE (LAM2M, ALGAE_SETTLING,FE,FEMN_TEMP)       
   3139   IF(MIGRATION == 'ON')DEALLOCATE (ASETTLE, DEN_AVG, DENP, DEN1, DEN2, ALLIM_OLD, DEN, AMP, PHASE, C_COEFF_EXT, RAD, MIND, M
   3139 AXD, DENSI, DENBI, T_DEC, C_DENINC, C_DENDEC, DEPTH_LIM, LOSS_FRAC, TWQ, &
   3140       I_C, C_DENINC_1, C_DENINC_2, C_DENDEC_1, C_DENDEC_2, DENP_MINS, DENP_MINB, DENP_MIN, DEN_COR, MIGRATE_GROUP, MIGRATE_M
   3140 ODEL, TS_DEC, DEPTH_LIM_ONOFF,&
