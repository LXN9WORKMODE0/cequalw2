    171     CALL GREGORIAN_DATE
    172     IF(CONSTITUENTS.AND.YEAR/=YEAROLD.AND.CO2YEARLYPPM=='      ON')THEN   ! UPDATE PCO2 FOR PH/TIC IF YEAR CHANGES STEP CHAN
    172 GES
    173             IF(YEAR<1980)THEN
    174 !PCO2 = (0.000041392*REAL(YEAR*YEAR*YEAR) - 0.231409975*REAL(YEAR*YEAR) + 430.804190829*REAL(YEAR) - 266735.857433224)*PALT(
    174 DS(BE(1)))*1.0E-6      ! PPM CO2 AND ALTITUDE CORRECTION
    175              PCO2 = (0.000041392*REAL(YEAR)*real(YEAR)*real(YEAR) - 0.231409975*REAL(YEAR)*real(YEAR) + 430.804190829*REAL(Y
    175 EAR) - 266735.857433224)*PALT(DS(BE(1)))*1.0E-6  
    176             ELSE
    177 !PCO2  = (0.015903*YEAR*YEAR - 61.799598*YEAR + 60357.055057)*PALT(DS(BE(1)))*1.0E-6
    178               PCO2  = (0.015903*real(YEAR)*real(year) - 61.799598*real(YEAR) + 60357.055057)*PALT(DS(BE(1)))*1.0E-6         
    178    ! SW 2/29/2024
    179             ENDIF
    180         YEAROLD=YEAR
    181     ENDIF
    182     
    183     UPDATE_KINETICS = .FALSE.
    184     IF ((CUF > 0 .AND. MOD(NIT,INT(CUF)) == 0) .OR. (CUF <= 0 .AND. JDAY >= NXTMUK)) THEN      !SR 07/03/2023
    185         UPDATE_KINETICS = .TRUE.
    186         IF (CUF <= 0) NXTMUK = JDAY + ABS(CUF)                  !SR 07/03/2023
    187     ENDIF
    188 
    189     
    190     RETURN
    191     END SUBROUTINE UPDATE

