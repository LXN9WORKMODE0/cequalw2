   1581       DO JE=1,NEP
   1582         IF (EPIPHYTON_CALC(JW,JE))DSIEG(K,I) = DSIEG(K,I)+EGR(K,I,JE)*EPC(K,I,JE)*ESI(JE)
   1583       END DO
   1584       DSID(K,I)  =  PSIDK(JW)*PSI(K,I)
   1585       DSISD(K,I) =  SEDD(K,I)*ORGSI(JW)
