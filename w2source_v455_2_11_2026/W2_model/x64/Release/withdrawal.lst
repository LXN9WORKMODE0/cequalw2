    740 SUBROUTINE SELECTIVEINIT
    741 
    742 USE SELECTIVE1;   USE MAIN
    743   USE GLOBAL;     USE NAMESC; USE GEOMC;  USE LOGICC; USE PREC;  USE SURFHE;  USE KINETIC; USE SHADEC; USE EDDY
    744   USE STRUCTURES; USE TRANS;  USE TVDC;   USE SELWC;  USE GDAYC; USE SCREENC; USE TDGAS;   USE RSTART
    745 
    746   IMPLICIT NONE
    747   
