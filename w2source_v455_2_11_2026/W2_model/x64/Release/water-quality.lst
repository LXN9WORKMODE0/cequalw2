   1233 !***************************************************************************************************************************
   1233 ********
   1234 !**                                                      SULFIDE (H2S)                                                      
   1234       **
   1235 !***************************************************************************************************************************
   1235 ********
   1236 ENTRY SULFIDE
   1237   H2SD(:,IU:ID) = 0.0; H2SREAER(:,IU:ID) = 0.0; H2SSR(:,IU:ID) = 0.0
   1238   DO I=IU,ID
   1239     DO K=KT,KB(I) 
   1240       IF(H2SQ10(JW) /= 0.0)THEN
   1241         H2SD(K,I) = -H2S1DK(JW)*H2SQ10(JW)**(T1(K,I)-20.0)*H2S(K,I)*DO3(K,I) 
   1242       ELSE
   1243         H2SD(K,I) = -H2S1DK(JW)*H2S(K,I)*DO3(K,I) 
   1244       END IF
   1245       H2SSR(K,I)  = H2SR(JW)*SODD(K,I)*DO2(K,I)
   1246       H2SSS(K,I)  = H2SD(K,I) + H2SSR(K,I)
   1247     END DO
   1248 !
   1249     IF(.NOT. ICE(I))THEN
   1250       H2SREAER(KT,I) = 0.984*REAER(I)*(-H2S(KT,I))                  !This computation is done in gas-transfer.f90: *BI(KT,I)
   1250 /BH2(KT,I)      REAER in units of s-1
   1251       H2SSS(KT,I) = H2SSS(KT,I)+H2SREAER(KT,I)
   1252     END IF
   1253   END DO
   1254 RETURN
